@using Sim_Card_Managment.Models
@{
    var recentEmployees = ViewBag.RecentEmployees as IEnumerable<Employee>;
    int index = 1;
}
@{
    var recentSims = ViewBag.RecentSims as IEnumerable<Sim> ?? new List<Sim>();
    int indexCounter = 1;

    var chartData = recentSims
        .Where(s => s.RegisteredAt >= DateTime.Today.AddDays(-6))
        .GroupBy(s => s.RegisteredAt.DayOfWeek)
        .ToDictionary(g => g.Key, g => g.Count());

    var daysOfWeek = new[] { DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
    var chartCounts = daysOfWeek.Select(d => chartData.ContainsKey(d) ? chartData[d] : 0).ToArray();
}
@functions {
    string GetSimLogo(Sim sim)
    {
        if (!string.IsNullOrEmpty(sim.ServiceProvider?.LogoPath))
            return sim.ServiceProvider.LogoPath;

        if (sim.PhoneNumber != null)
        {
            if (sim.PhoneNumber.StartsWith("010")) return "/img/fodafone.png";
            if (sim.PhoneNumber.StartsWith("012")) return "/img/orange.png";
            if (sim.PhoneNumber.StartsWith("011")) return "/img/etisalat.png";
        }
        return "/img/we.png";
    }
}

<style>
    .bg-brand {
        background-color: #E24D17 !important;
    }

    .text-brand {
        color: #E24D17 !important;
    }

    .btn-brand {
        background-color: #E24D17;
        color: #ffffff;
        border: 1px solid #E24D17;
    }

        .btn-brand:hover {
            background-color: #c84112;
            color: #ffffff;
            border-color: #c84112;
        }

    .btn-outline-brand {
        background-color: transparent;
        color: #E24D17;
        border: 1px solid #E24D17;
    }

        .btn-outline-brand:hover {
            background-color: #E24D17;
            color: #ffffff;
        }

    .badge-brand-subtle {
        background-color: rgba(226, 77, 23, 0.1);
        color: #E24D17;
    }
</style>

<header class="bg-brand text-white pt-5 shadow-sm">
    <div class="container text-center py-4">
        <h1 class="fw-bold display-4 mb-3">
            <span class="fw-light fs-2 d-block text-white-50">Streamline Your</span> Staff SIM Cards
        </h1>
        <p class="lead maxW_Hero mx-auto text-white-50">
            Efficiently manage staff SIM cards, data plans, and assignments from a single dashboard.
        </p>
    </div>
</header>

<main class="bg-light py-5">
    <!-- Dashboard Stats Section -->
    <div class="container mb-5">
        <div class="row g-4 align-items-stretch">
            <!-- Left Stats Column -->
            <div class="col-12 col-lg-4 d-flex flex-column gap-3">
                <!-- SIM Stats Card -->
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 position-relative overflow-hidden">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge badge-brand-subtle p-3 rounded-circle fs-4">
                            <i class="fa-solid fa-sim-card"></i>
                        </span>
                        <span class="fs-2 fw-bold text-dark">@ViewBag.ActiveSims</span>
                    </div>
                    <h5 class="fw-bold text-secondary mb-3">Active SIM Cards</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">@ViewBag.LostSims Lost</span>
                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">@ViewBag.ReplacedSims Replaced</span>
                        <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">@ViewBag.ReturnedSims Returned</span>
                    </div>
                </div>

                <!-- USB Stats Card -->
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 position-relative overflow-hidden">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge bg-secondary-subtle text-secondary p-3 rounded-circle fs-4">
                            <i class="fa-solid fa-usb"></i>
                        </span>
                        <span class="fs-2 fw-bold text-dark">@ViewBag.ActiveUsbs</span>
                    </div>
                    <h5 class="fw-bold text-secondary mb-3">Active USB Modems</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">@ViewBag.ReplacedUsbs Replaced</span>
                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">@ViewBag.LostUsbs Lost</span>
                        <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">@ViewBag.ReturnedUsbs Returned</span>
                    </div>
                </div>
            </div>

            <!-- Right Chart Column -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <h5 class="fw-bold text-dark mb-3">SIM Card Registrations (Last 7 Days)</h5>
                    <div id="sim-usage-chart" class="w-100 h-100 min-vh-25"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Employees Section -->
    <div class="container mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold text-dark mb-0">Employees</h3>
            @if (recentEmployees != null && recentEmployees.Any())
            {
                <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-brand rounded-pill px-4">
                    View All <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            }
        </div>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="py-3 px-4 text-center">#</th>
                            <th scope="col" class="py-3 px-4">Name</th>
                            <th scope="col" class="py-3 px-4">Employee ID</th>
                            <th scope="col" class="py-3 px-4">National ID</th>
                            <th scope="col" class="py-3 px-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentEmployees != null && recentEmployees.Any())
                        {
                            foreach (var emp in recentEmployees)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-muted px-4">@(index++)</td>
                                    <td class="fw-semibold text-dark px-4">@emp.Name</td>
                                    <td class="px-4">@emp.Id</td>
                                    <td class="px-4">@emp.NationalID</td>
                                    <td class="px-4">
                                        @if (emp.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">No employee data available.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- SIM Cards Section -->
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold text-dark mb-0">Explore SIM Cards</h3>
            @if (recentSims.Any())
            {
                <a asp-controller="SIM" asp-action="Index" class="btn btn-outline-brand rounded-pill px-4">
                    View All SIMs <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            }
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="py-3 px-4 text-center">#</th>
                            <th scope="col" class="py-3 px-4">Provider</th>
                            <th scope="col" class="py-3 px-4">Serial Number</th>
                            <th scope="col" class="py-3 px-4">Phone Number</th>
                            <th scope="col" class="py-3 px-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!recentSims.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">No SIM cards available at the moment.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var sim in recentSims)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-muted px-4">@(indexCounter++)</td>
                                    <td class="px-4">
                                        <img src="@GetSimLogo(sim)" alt="@(sim.ServiceProvider?.Name ?? "Provider")" style="height: 28px; width: 28px;" class="rounded-circle object-fit-cover" />
                                    </td>
                                    <td class="px-4 fw-medium">@sim.SerialNumber</td>
                                    <td class="px-4">@sim.PhoneNumber</td>
                                    <td class="px-4">
                                        <span class="badge @(sim.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") px-3 py-2 rounded-pill">
                                            @(sim.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<script src="~/js/highcharts.js"></script>