@using Sim_Card_Managment.Models
@{
    var recentEmployees = ViewBag.RecentEmployees as IEnumerable<Employee>;
    int index = 0;
}
@{
    var recentSims = ViewBag.RecentSims as IEnumerable<Sim> ?? new List<Sim>();
    int indexCounter = 0;

    // 1. Group recent sims by day of the week for the dynamic chart data
    // Assumes your Sim model has a creation/assignment date property (e.g., CreatedAt or AssignmentDate)
    var chartData = recentSims
        .Where(s => s.RegisteredAt >= DateTime.Today.AddDays(-6)) // Last 7 days
        .GroupBy(s => s.RegisteredAt.DayOfWeek)
        .ToDictionary(g => g.Key, g => g.Count());

    var daysOfWeek = new[] { DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
    var chartCounts = daysOfWeek.Select(d => chartData.ContainsKey(d) ? chartData[d] : 0).ToArray();
}
@functions {
    string GetSimLogo(Sim sim)
    {
        if (!string.IsNullOrEmpty(sim.ServiceProvider?.LogoPath))
            return sim.ServiceProvider.LogoPath;

        if (sim.PhoneNumber.StartsWith("010")) return "/img/fodafone.png";
        if (sim.PhoneNumber.StartsWith("012")) return "/img/orange.png";
        if (sim.PhoneNumber.StartsWith("011")) return "/img/etisalat.png";
        return "/img/we.png";
    }
}



<header class="hero_bg">
    <section class=" text-white pt-5 pb-5" id="hero_home">
        <div class="maxW_Hero text-center mx-auto my-auto mt-4 mb-5">
            <h2 class="fw-bolder display-1 mb-4"><span class="fs-1 fw-normal">Streamline Your </span> <br /> Staff SIM Cards</h2>
            <p class="fs-3 fw-light">
                Efficiently manage staff SIM cards, data plans, and assignments from a single dashboard
            </p>
        </div>
    </section>
</header>

<main>
    <section class="position-relative py-5 px-5 bg-light-gray">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-12 col-lg-2 d-flex flex-column gap-4">
                    <div class="position-relative overflow-hidden p-4 rounded-4 shadow-sm text-white stat-card rounded-31">
                        <svg class="position-absolute pe-none stat-svg-bg-sim" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
                            <path d="M176,120v72H80V120Z" opacity="0.2" />
                            <path d="M213.65723,82.34277l-56-56A8.00235,8.00235,0,0,0,152,24H55.99219a16.01833,16.01833,0,0,0-16,16V216a16.01833,16.01833,0,0,0,16,16H200a16.01833,16.01833,0,0,0,16-16V88A8.00235,8.00235,0,0,0,213.65723,82.34277ZM200,216H55.99219V40h92.69433L200,91.314l.00977,124.68555ZM176,112H80a8.00039,8.00039,0,0,0-8,8v72a8.00039,8.00039,0,0,0,8,8h96a8.00039,8.00039,0,0,0,8-8V120A8.00039,8.00039,0,0,0,176,112Zm-8,72H152V152a8,8,0,0,0-16,0v32H120V152a8,8,0,0,0-16,0v32H88V128h80Z" />
                        </svg>
                        <div class="d-flex align-items-center justify-content-center mb-4 position-relative z-1 bg-white rounded icon-box">
                            <img src="~/images/ph_sim_card.svg" alt="SIM" class="icon-img">
                        </div>
                        <div class="display-4 fw-bolder lh-1 position-relative z-1 tight-spacing">@ViewBag.ActiveSims</div>
                        <div class="display-5 fw-bold lh-1 mb-4 position-relative z-1 tight-spacing">SIM</div>
                        <div class="d-flex flex-wrap gap-2 position-relative z-1">
                            <div class="rounded-pill px-3 py-1 fw-bold text-white shadow-sm badge-custom badge-lost">
                                @ViewBag.LostSims Lost
                            </div>
                            <div class="rounded-pill px-3 py-1 fw-bold text-white shadow-sm badge-custom badge-replaced">
                                @ViewBag.ReplacedSims Replaced
                            </div>
                            <div class="rounded-pill px-3 py-1 fw-bold text-white shadow-sm badge-custom badge-returned">
                                @ViewBag.ReturnedSims Returned
                            </div>
                        </div>
                    </div>

                    <div class="position-relative overflow-hidden p-4 rounded-4 shadow-sm text-white stat-card rounded-31">
                        <svg class="position-absolute pe-none stat-svg-bg-usb" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.5 9H16.5V16.5H13.5V9ZM19.5 9H22.5V16.5H19.5V9Z" />
                            <path d="M30 19.5H28.5V4.5C28.5 3.675 27.825 3 27 3H9C8.175 3 7.5 3.675 7.5 4.5V19.5H6C5.175 19.5 4.5 20.175 4.5 21V28.5C4.5 30.975 6.525 33 9 33H27C29.475 33 31.5 30.975 31.5 28.5V21C31.5 20.175 30.825 19.5 30 19.5ZM10.5 6H25.5V19.5H10.5V6ZM28.5 28.5C28.5 29.325 27.825 30 27 30H9C8.175 30 7.5 29.325 7.5 28.5V22.5H28.5V28.5Z" />
                        </svg>
                        <div class="d-flex align-items-center justify-content-center mb-4 position-relative z-1 bg-white rounded icon-box">
                            <img src="~/images/boxicons_usb.svg" alt="USB" class="icon-img">
                        </div>
                        <div class="display-4 fw-bolder lh-1 position-relative z-1 tight-spacing">@ViewBag.ActiveUsbs</div>
                        <div class="display-5 fw-bold lh-1 mb-4 position-relative z-1 tight-spacing">USB</div>
                        <div class="d-flex flex-wrap gap-2 position-relative z-1">
                            <div class="rounded-pill px-3 py-1 fw-bold text-white shadow-sm badge-custom badge-replaced">
                                @ViewBag.ReplacedUsbs Replaced
                            </div>
                            <div class="rounded-pill px-3 py-1 fw-bold text-white shadow-sm badge-custom badge-lost">
                                @ViewBag.LostUsbs Lost
                            </div>
                            <div class="rounded-pill px-3 py-1 fw-bold text-white shadow-sm badge-custom badge-returned">
                                @ViewBag.ReturnedUsbs Returned
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-9 offset-1">
                    <div class="bg-white p-4 rounded-4 shadow-sm h-100 d-flex flex-column rounded-31">
                        <div id="sim-usage-chart" class="chart-container"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-white text-white py-5">
        <div class="px-5">
            <h2 class="fw-bold mb-4 section-title">Employees</h2>
            <div class="position-relative">
                <div class="position-absolute table-decor-bg"></div>
                <div class="bg-white rounded-4 overflow-hidden position-relative z-1 table-card rounded-31">
                    <div class="table-responsive">
                        <table class="table table-borderless mb-0 align-middle position-relative custom-table">
                            <thead class="table-header">
                                <tr>
                                    <th scope="col" class="py-3 px-3 text-center fw-normal border-right-light w-60"></th>
                                    <th scope="col" class="py-3 px-4 fw-normal border-right-light">Name</th>
                                    <th scope="col" class="py-3 px-4 fw-normal border-right-light">Id</th>
                                    <th scope="col" class="py-3 px-4 fw-normal border-right-light">National ID</th>
                                    <th scope="col" class="py-3 px-4 fw-normal">Status</th>
                                </tr>
                            </thead>
                            <tbody style="min-height: 200px">
                                @if (recentEmployees != null && recentEmployees.Any())
                                {
                                    foreach (var emp in recentEmployees)
                                    {
                                        <tr>
                                            <td class="py-3 px-3 text-center">@(index++)</td>
                                            <td class="py-3 px-4 table-text-dark">@emp.Name</td>
                                            <td class="py-3 px-4">@emp.Id</td>
                                            <td class="py-3 px-4">@emp.NationalID</td>
                                            <td class="py-3 px-4">
                                                @if (emp.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-black">No data available.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (recentEmployees != null && recentEmployees.Any())
                        {
                            <div class="position-absolute bg-white start-0 end-0 bottom-0 pointer-events-none table-fade"></div>
                        }
                    </div>

                    @if (recentEmployees != null && recentEmployees.Any())
                    {
                        <a asp-controller="Employee" asp-action="Index" class="btn position-absolute text-white fw-bold d-flex align-items-center gap-2 btn-custom-primary">
                            View All
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14"></path>
                                <path d="M12 5l7 7-7 7"></path>
                            </svg>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="px-5 mt-5">
            <h2 class="fw-bold mb-3 section-title-lg">Explore SIM Cards</h2>
            <div class="d-flex justify-content-between flex-nowrap align-items-center">
                <div class="d-flex gap-2 mb-4">
                    <div class="bg-white rounded-3 d-flex justify-content-center align-items-center provider-logo-box">
                        <button class="rounded-circle d-flex justify-content-center align-items-center cursor border-0 bg-transparent">
                            <img src="~/img/we.png" alt="Alternate Text" />
                        </button>
                    </div>
                    <div class="bg-white rounded-3 d-flex justify-content-center align-items-center provider-logo-box">
                        <div>
                            <button class="d-flex justify-content-center align-items-center cursor border-0 bg-transparent">
                                <img src="~/img/fodafone.png" alt="Alternate Text" />
                            </button>
                        </div>
                    </div>
                    <div class="bg-white rounded-3 d-flex justify-content-center align-items-center provider-logo-box">
                        <button class="rounded-circle d-flex justify-content-center align-items-center cursor border-0 bg-transparent">
                            <img src="~/img/orange.png" alt="Alternate Text" />
                        </button>
                    </div>
                    <button class="bg-white rounded-3 d-flex justify-content-center align-items-center cursor provider-logo-box border-0 bg-transparent">
                        <img src="~/img/etisalat.png" alt="Alternate Text" />
                    </button>
                </div>
                <button class=" border-0 rounded-3 icon">
                    <i class="fa-solid fa-filter-circle-xmark text-white"></i>
                </button>
            </div>
           

            <div class="position-relative">
                <div class="position-absolute table-decor-bg"></div>
                <div class="bg-white rounded-4 overflow-hidden position-relative z-1 table-card rounded-31">
                    <div class="table-responsive">
                        <table class="table table-borderless mb-0 align-middle position-relative custom-table">
                            <thead class="table-header">
                                <tr>
                                    <th scope="col" class="py-3 px-3 text-center fw-normal border-right-light w-60"></th>
                                    <th scope="col" class="py-3 px-4 fw-normal border-right-light w-200">Provider</th>
                                    <th scope="col" class="py-3 px-4 fw-normal border-right-light">Id / Serial</th>
                                    <th scope="col" class="py-3 px-4 fw-normal border-right-light">Phone</th>
                                    <th scope="col" class="py-3 px-4 fw-normal">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!recentSims.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-black">No SIM cards available at the moment.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var sim in recentSims)
                                    {
                                        <tr>
                                            <td class="py-3 px-3 text-center">@indexCounter</td>
                                            <td class="py-3 px-4">
                                                <div class="rounded-circle d-flex">
                                                    <img src="@GetSimLogo(sim)" alt="@(sim.ServiceProvider?.Name ?? "Provider")" />
                                                </div>
                                            </td>
                                            <td class="py-3 px-4">@sim.SerialNumber</td>
                                            <td class="py-3 px-4">@sim.PhoneNumber</td>
                                            <td class="py-3 px-4">
                                                <span class="badge @(sim.IsActive ? "bg-success" : "bg-warning")">@(sim.IsActive ? "Active" : "Inactive")</span>
                                            </td>
                                        </tr>
                                        indexCounter++;
                                    }
                                }
                            </tbody>

                        </table>
                        @if (recentEmployees != null && recentEmployees.Any())
                        {
                            <div class="position-absolute bg-white start-0 end-0 bottom-0 table-fade"></div>

                        }
                    </div>
                </div>

                @if (recentSims.Any())
                {
                    <a asp-controller="SIM" asp-action="Index" class="btn position-absolute text-white fw-bold d-flex align-items-center gap-2 z-3 btn-custom-primary">
                        View All
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="M12 5l7 7-7 7"></path>
                        </svg>
                    </a>
                }
            </div>
        </div>
    </section>
</main>

<script src="~/js/highcharts.js"></script>