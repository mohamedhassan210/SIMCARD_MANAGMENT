@model Sim_Card_Managment.Viewmodel.BranchEditViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Branch Settings</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />

</head>

<section class="be-body">

    <main class="container px-3">

        <div class="be-card">

            <div class="be-card-header d-flex align-items-center gap-3">
                <div class="be-icon-wrapper">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">Edit Branch Details</h3>
                    <p class="m-0 text-muted small">Update branch name, codes, VPN status, and notes</p>
                </div>
            </div>

           
            <form id="be-edit-form" asp-controller="Branch" asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="px-4 pt-4">
                        <div class="be-alert be-alert-danger" role="alert">
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="p-4 p-md-5">
                    <div class="row g-4">

                        <div class="col-12">
                            <label for="be-name-input" class="be-label">
                                <i class="fa-regular fa-building me-1"></i> Branch Name <span class="text-danger">*</span>
                            </label>
                            <div class="be-input-group">
                                <i class="fa-solid fa-building"></i>
                                <input id="be-name-input" asp-for="Name" class="be-input" placeholder="Enter branch name" required maxlength="100">
                            </div>
                            <span id="be-name-error" class="be-error">Branch name is required.</span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="SiteCode" class="be-label">
                                <i class="fa-solid fa-id-badge me-1"></i> Site Code (HR)
                            </label>
                            <div class="be-input-group">
                                <i class="fa-solid fa-id-badge"></i>
                                <input asp-for="SiteCode" class="be-input" placeholder="e.g., HR-014" maxlength="50">
                            </div>
                            <span asp-validation-for="SiteCode" class="be-error"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="BranchCode" class="be-label">
                                <i class="fa-solid fa-tag me-1"></i> Branch Code (Retail)
                            </label>
                            <div class="be-input-group">
                                <i class="fa-solid fa-tag"></i>
                                <input asp-for="BranchCode" class="be-input" placeholder="e.g., RT-014" maxlength="50">
                            </div>
                            <span asp-validation-for="BranchCode" class="be-error"></span>
                        </div>

                        <div class="col-12">
                            <label for="be-vpn-select" class="be-label">
                                <i class="fa-solid fa-globe me-1"></i> VPN Over Internet Status
                            </label>
                            <select id="be-vpn-select" asp-for="VpnOverInternetStatus" class="cs-select">
                                <option value="">Not Configured</option>
                                <option value="true">Enabled</option>
                                <option value="false">Disabled</option>
                            </select>
                        </div>

                        <!-- 🏢 FIREWALL TYPES (only relevant when VPN over internet is enabled) -->
                        <div class="col-12" id="be-firewall-section" style="display: none;">
                            <label class="be-label">
                                <i class="fa-solid fa-shield-halved me-1"></i> Firewall Types
                            </label>
                            <div class="be-checkbox-list">
                                @if (Model.FireWallTypes != null && Model.FireWallTypes.Any())
                                {
                                    foreach (var fireWallType in Model.FireWallTypes)
                                    {
                                        var fireWallTypeId = int.Parse(fireWallType.Value);
                                        var isChecked = Model.SelectedFireWallTypeIds.Contains(fireWallTypeId);
                                        <label class="be-checkbox-row">
                                            <input type="checkbox" name="SelectedFireWallTypeIds" value="@fireWallType.Value" checked="@(isChecked ? "checked" : null)">
                                            <span>@fireWallType.Text</span>
                                        </label>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">No firewall types configured yet.</span>
                                }
                            </div>
                            <span class="text-muted small d-block mt-1">Select one or more firewall types used for this branch's VPN over internet connection.</span>
                        </div>

                        <style>
                            .be-checkbox-list {
                                display: flex;
                                flex-direction: column;
                                gap: 4px;
                                border: 1px solid var(--card-border, #E2E8F0);
                                border-radius: 12px;
                                padding: 10px 14px;
                                background: #FFFFFF;
                            }

                            .be-checkbox-row {
                                display: flex;
                                align-items: center;
                                gap: 10px;
                                padding: 6px 4px;
                                width: 100%;
                                cursor: pointer;
                                font-size: 0.9rem;
                            }

                                .be-checkbox-row input[type="checkbox"] {
                                    width: 16px;
                                    height: 16px;
                                    flex-shrink: 0;
                                    cursor: pointer;
                                }
                        </style>

                        <div class="col-12">
                            <label asp-for="Note" class="be-label">
                                <i class="fa-regular fa-note-sticky me-1"></i> Note
                            </label>
                            <textarea asp-for="Note" class="be-input" rows="3" placeholder="Optional notes about this branch..." maxlength="1000"></textarea>
                            <span asp-validation-for="Note" class="be-error"></span>
                        </div>

                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="be-btn be-btn-secondary">
                            <i class="fa-solid fa-times"></i> Cancel
                        </a>
                        <button type="submit" id="be-submit-btn" class="be-btn be-btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Save Changes
                        </button>
                    </div>

                </div>
            </form>

        </div>

    </main>

   

</section>
<script>

    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('be-edit-form');
        const nameInput = document.getElementById('be-name-input');
        const nameError = document.getElementById('be-name-error');
        const submitBtn = document.getElementById('be-submit-btn');

        function validateName() {
            const value = nameInput.value.trim();

            if (!value) {
                nameInput.classList.add('is-invalid');
                nameError.textContent = 'Branch name is required.';
                nameError.classList.add('show');
                return false;
            }

            if (value.length < 2) {
                nameInput.classList.add('is-invalid');
                nameError.textContent = 'Branch name must be at least 2 characters.';
                nameError.classList.add('show');
                return false;
            }

            if (value.length > 100) {
                nameInput.classList.add('is-invalid');
                nameError.textContent = 'Branch name cannot exceed 100 characters.';
                nameError.classList.add('show');
                return false;
            }

            nameInput.classList.remove('is-invalid');
            nameError.classList.remove('show');
            return true;
        }

        nameInput.addEventListener('input', function () {
            validateName();
            updateSubmitButton();
        });

        nameInput.addEventListener('blur', function () {
            validateName();
            updateSubmitButton();
        });

        function updateSubmitButton() {
            const isNameValid = validateName();
            submitBtn.disabled = !isNameValid;
        }

        form.addEventListener('submit', function (e) {
            const isNameValid = validateName();

            if (!isNameValid) {
                e.preventDefault();
                nameInput.focus();
                nameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
        });

        // Initial validation
        updateSubmitButton();

        // ============================================
        // 🏢 SHOW/HIDE FIREWALL TYPES BASED ON VPN STATUS
        // ============================================
        const vpnSelect = document.getElementById('be-vpn-select');
        const firewallSection = document.getElementById('be-firewall-section');

        function toggleFirewallSection() {
            if (vpnSelect.value === 'true') {
                firewallSection.style.display = '';
            } else {
                firewallSection.style.display = 'none';
                firewallSection.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
            }
        }

        vpnSelect.addEventListener('change', toggleFirewallSection);
        toggleFirewallSection();
    });
</script>
