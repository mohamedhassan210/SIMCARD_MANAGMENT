@model IEnumerable<Sim_Card_Managment.Viewmodel.BranchListItemViewModel>

@{
   
}

<!DOCTYPE html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Branches </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />


</head>

<section class="bi-body">

    @Html.AntiForgeryToken()

    
    <header class="bi-page-header p-100">
        <div class="container-fluid px-lg-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="bi-page-title m-0">Branches Directory</h1>
                    <p class="bi-text-muted m-0 small mt-1">Manage organization branches and VPN configuration status</p>
                </div>
                <div>
                    <a asp-action="Create" class="bi-btn bi-btn-primary">
                        <i class="fa-solid fa-plus"></i> New Branch
                    </a>
                </div>
            </div>
        </div>
    </header>

   
    <main class="container-fluid px-lg-5">

        <div class="bi-table-card">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

                <div class="bi-search-box col-12 col-md-5">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="bi-search-input" type="text" placeholder="Search by branch name..." autocomplete="off">
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="bi-text-muted small fw-bold">Active Status:</span>
                    <select id="bi-active-filter" class="bi-filter-select">
                        <option value="ALL">All</option>
                        <option value="ACTIVE">Active</option>
                        <option value="INACTIVE">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="bi-table" id="bi-branch-table">
                    <thead>
                        <tr>
                            <th>Branch Name</th>
                            <th>VPN Over Internet</th>
                            <th>Is Active</th>
                            <th>Created At</th>
                            <th>Created By</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="bi-table-body">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var branch in Model)
                            {
                                <tr class="bi-row" data-active="@(branch.IsActive ? "ACTIVE" : "INACTIVE")" data-href="/Branch/Details/@branch.Id">
                                    <td><strong>@branch.Name</strong></td>
                                    <td>
                                        @if (branch.VpnOverInternetStatus == true)
                                        {
                                            <span class="bi-badge-enabled"><i class="fa-solid fa-circle"></i> Enabled</span>
                                        }
                                        else if (branch.VpnOverInternetStatus == false)
                                        {
                                            <span class="bi-badge-disabled"><i class="fa-solid fa-circle"></i> Disabled</span>
                                        }
                                        else
                                        {
                                            <span class="bi-text-muted">Not Configured</span>
                                        }
                                    </td>
                                    <td>
                                        @if (branch.IsActive)
                                        {
                                            <span class="bi-badge-active">Active</span>
                                        }
                                        else
                                        {
                                            <span class="bi-badge-inactive">Inactive</span>
                                        }
                                    </td>
                                    <td><span class="bi-text-muted">@branch.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                                    <td><span class="bi-text-muted">@branch.CreatedByUsername</span></td>
                                    <td style="text-align: right;">
                                        <div class="d-inline-flex gap-1 bi-action-buttons">
                                            <a href="/Branch/Edit/@branch.Id" class="bi-btn-action" title="Edit Branch"><i class="fa-solid fa-pen"></i></a>
                                            <button type="button" class="bi-btn-action bi-btn-delete" title="Delete" onclick="biDeleteBranch(@branch.Id, '@branch.Name', event)"><i class="fa-solid fa-trash-can"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        <tr id="bi-no-results" style="display: @((Model != null && Model.Any()) ? "none" : "");">
                            <td colspan="6" class="bi-no-results">
                                No matching branches found.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>

    </main>



</section>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
   
    function biGetToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    document.addEventListener('DOMContentLoaded', function () {
        const rows = document.querySelectorAll('.bi-row');
        rows.forEach(row => {
            row.addEventListener('click', function (e) {
                if (e.target.closest('.bi-action-buttons')) {
                    return;
                }
                const targetUrl = this.getAttribute('data-href');
                if (targetUrl) {
                    window.location.href = targetUrl;
                }
            });
        });
    });


    const searchInput = document.getElementById('bi-search-input');
    const activeFilter = document.getElementById('bi-active-filter');

    function biFilterTable() {
        const query = searchInput.value.toLowerCase().trim();
        const selectedActive = activeFilter.value;
        const rows = document.querySelectorAll('#bi-table-body tr.bi-row');
        let hasVisibleRow = false;

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const rowActive = row.getAttribute('data-active');

            const matchesQuery = text.includes(query);
            const matchesActive = (selectedActive === 'ALL') || (rowActive === selectedActive);

            if (matchesQuery && matchesActive) {
                row.style.display = '';
                hasVisibleRow = true;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('bi-no-results').style.display = hasVisibleRow ? 'none' : '';
    }

    searchInput.addEventListener('input', biFilterTable);
    activeFilter.addEventListener('change', biFilterTable);

    function biDeleteBranch(branchId, branchName, event) {
        if (event) event.stopPropagation();

        Swal.fire({
            title: 'Delete Branch?',
            text: `Are you sure you want to delete "${branchName}"?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#DC2626',
            cancelButtonColor: '#64748B',
            confirmButtonText: 'Yes, Delete',
            customClass: { popup: 'rounded-4' }
        }).then(async (result) => {
            if (result.isConfirmed) {
                const formData = new FormData();
                formData.append('__RequestVerificationToken', biGetToken());

                try {
                    const res = await fetch(`/Branch/Delete/${branchId}`, {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok || res.redirected) {
                        window.location.reload();
                    } else {
                        Swal.fire('Error', 'Failed to delete branch.', 'error');
                    }
                } catch (error) {
                    Swal.fire('Error', 'An error occurred while deleting.', 'error');
                }
            }
        });
    }
</script>
