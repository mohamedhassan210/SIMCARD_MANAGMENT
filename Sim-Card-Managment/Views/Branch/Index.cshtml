@model IEnumerable<Sim_Card_Managment.Viewmodel.BranchListItemViewModel>

@{
    ViewData["Title"] = "Branches Directory";
    var branchList = Model?.ToList() ?? new List<Sim_Card_Managment.Viewmodel.BranchListItemViewModel>();
    var totalBranches = branchList.Count;
    var activeBranches = branchList.Count(b => b.IsActive);
    var vpnEnabledCount = branchList.Count(b => b.VpnOverInternetStatus == true);
    var vpnDisabledCount = branchList.Count(b => b.VpnOverInternetStatus == false);
}

<style>
    /* Theme & Layout Variables */
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
        --primary-orange-light: #FFF8F6;
        --bg-light: #f8f9fa;
        --text-muted: #64748B;
        --card-border: #e0e0e0;
    }

    /* Page Header */
    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    /* Primary Header Button */
    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    /* Table Action Buttons with Text */
    .btn-view-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-view-action:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    .btn-delete-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #dc3545;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

        .btn-delete-action:hover {
            border-color: #dc3545;
            background-color: #fff8f8;
            color: #b02a37;
        }

    .btn-outline-custom {
        background-color: #f1f3f5;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        cursor: pointer;
    }

        .btn-outline-custom:hover {
            background-color: #e9ecef;
            color: #1a1a1a;
        }

    /* Seamless Unified Search Bar */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.92rem;
            color: #333333;
            padding: 4px 0;
        }

    /* Custom Dropdown Filter */
    .custom-select-filter {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 8px 36px 8px 14px;
        background-color: #ffffff;
        font-size: 0.9rem;
        color: #495057;
        transition: border-color 0.2s ease;
    }

        .custom-select-filter:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
            outline: none;
        }

    /* Status Badges */
    .badge-status-active {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
    }

    .badge-status-inactive {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
    }

    .badge-vpn-enabled {
        background-color: #cff4fc;
        color: #055160;
        border: 1px solid #b6effb;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
    }

    .badge-vpn-disabled {
        background-color: #e2e3e5;
        color: #41464b;
        border: 1px solid #d3d6d8;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
    }
</style>

<div class="container-fluid px-4 p-100">
    @Html.AntiForgeryToken()

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">Branches Directory</h1>
            <p class="page-header-subtitle mb-0">Manage organization branches and VPN configuration status.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New Branch</span>
            </a>
            <a href="#" id="exportBranchExcelBtn" class="btn-outline-custom shadow-sm">
                <i class="fas fa-file-excel"></i>
                <span>Excel</span>
            </a>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total Branches</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalBranches</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #E24D17;">
                        <i class="fas fa-code-branch fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Active Branches</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@activeBranches</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">VPN Enabled</span>
                        <h3 class="fw-bold mb-0 mt-1" style="color: #055160;">@vpnEnabledCount</h3>
                    </div>
                    <div class="rounded-circle p-3" style="background-color: #cff4fc; color: #055160;">
                        <i class="fas fa-globe fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">VPN Disabled</span>
                        <h3 class="fw-bold text-secondary mb-0 mt-1">@vpnDisabledCount</h3>
                    </div>
                    <div class="rounded-circle bg-secondary bg-opacity-10 p-3 text-secondary">
                        <i class="fas fa-globe fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <div class="row g-3 justify-content-between align-items-center mb-4">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label text-muted small mb-1">Search</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="tableSearchInput" placeholder="Search by Branch Name, Site Code, or Branch Code...">
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-md-end align-items-end mt-3 mt-md-0">
                <div class="w-100 w-md-auto">
                    <label class="form-label text-muted small mb-1">Status Filter</label>
                    <select id="statusFilter" class="form-select custom-select-filter">
                        <option value="">All Statuses</option>
                        <option value="Active">Active Only</option>
                        <option value="Inactive">Inactive Only</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Table View -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="branchTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th scope="col">Branch Name</th>
                        <th scope="col">Site Code</th>
                        <th scope="col">Branch Code</th>
                        <th scope="col">VPN Over Internet</th>
                        <th scope="col">Is Active</th>
                        <th scope="col">Created At</th>
                        <th scope="col">Created By</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="branchTableBody">
                    @if (!branchList.Any())
                    {
                        <tr id="noDataRow">
                            <td colspan="8" class="text-center text-muted py-4">No branches found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var branch in branchList)
                        {
                            <tr class="branch-row" data-active="@(branch.IsActive ? "Active" : "Inactive")">
                                <td class="fw-bold text-dark">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-orange bg-opacity-10 text-danger p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: rgba(226, 77, 23, 0.1);">
                                            <i class="fas fa-store fa-sm" style="color: #E24D17;"></i>
                                        </div>
                                        <span>@branch.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(branch.SiteCode) ? "N/A" : branch.SiteCode)</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(branch.BranchCode) ? "N/A" : branch.BranchCode)</span>
                                </td>
                                <td>
                                    @if (branch.VpnOverInternetStatus == true)
                                    {
                                        <span class="badge-vpn-enabled">
                                            <i class="fas fa-circle me-1" style="font-size: 7px;"></i> Enabled
                                        </span>
                                    }
                                    else if (branch.VpnOverInternetStatus == false)
                                    {
                                        <span class="badge-vpn-disabled">
                                            <i class="fas fa-circle me-1" style="font-size: 7px;"></i> Disabled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not Configured</span>
                                    }
                                </td>
                                <td>
                                    @if (branch.IsActive)
                                    {
                                        <span class="badge-status-active availability-cell" data-active="true">
                                            <i class="fas fa-circle me-1" style="font-size: 7px;"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-inactive availability-cell" data-active="false">
                                            <i class="fas fa-circle me-1" style="font-size: 7px;"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">@branch.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@branch.CreatedByUsername</span>
                                </td>
                                <td class="text-end action-cell">
                                    <div class="d-inline-flex gap-2">
                                        <!-- View Details Button -->
                                        <a asp-controller="Branch" asp-action="Details" asp-route-id="@branch.Id" class="btn-view-action" title="View Details">
                                            <i class="fas fa-eye"></i> Details
                                        </a>

                                        <!-- Edit Button -->
                                        <a asp-controller="Branch" asp-action="Edit" asp-route-id="@branch.Id" class="btn-view-action" title="Edit Branch">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>

                                        <!-- Delete Button -->
                                        <button type="button" class="btn-delete-action" title="Delete Branch" onclick="biDeleteBranch(@branch.Id, '@branch.Name', event)">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="8" class="text-center text-muted py-4">No matching branches found.</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function biGetToken() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

         const exportBranchExcelBtn = document.getElementById('exportBranchExcelBtn');
    if (exportBranchExcelBtn) {
        exportBranchExcelBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const url = new URL('@Url.Action("ExportBranchesExcel", "Branch")', window.location.origin);
            const statusVal = document.getElementById('statusFilter').value; // read directly, no closure dependency
            if (statusVal) url.searchParams.set('status', statusVal);
            window.location.href = url.toString();
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById('tableSearchInput');
        const statusFilter = document.getElementById('statusFilter');
        const rows = document.querySelectorAll('#branchTable tbody tr.branch-row');
        const noResultsRow = document.getElementById('noResultsRow');

        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const selectedStatus = statusFilter.value;
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const statusCell = row.querySelector('.availability-cell');
                const isActive = statusCell ? statusCell.getAttribute('data-active') === 'true' : false;

                const matchesSearch = !searchTerm || text.includes(searchTerm);

                let matchesStatus = true;
                if (selectedStatus === 'Active') {
                    matchesStatus = isActive === true;
                } else if (selectedStatus === 'Inactive') {
                    matchesStatus = isActive === false;
                }

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noResultsRow) {
                noResultsRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
            }
        }

        searchInput.addEventListener('input', filterTable);
        statusFilter.addEventListener('change', filterTable);
    });

    function biDeleteBranch(branchId, branchName, event) {
        if (event) event.stopPropagation();

        Swal.fire({
            title: 'Delete Branch?',
            text: `Are you sure you want to delete "${branchName}"?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#DC2626',
            cancelButtonColor: '#64748B',
            confirmButtonText: 'Yes, Delete',
            customClass: { popup: 'rounded-4' }
        }).then(async (result) => {
            if (result.isConfirmed) {
                const formData = new FormData();
                formData.append('__RequestVerificationToken', biGetToken());

                try {
                    const res = await fetch(`/Branch/Delete/${branchId}`, {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok || res.redirected) {
                        window.location.reload();
                    } else {
                        Swal.fire('Error', 'Failed to delete branch.', 'error');
                    }
                } catch (error) {
                    Swal.fire('Error', 'An error occurred while deleting.', 'error');
                }
            }
        });
    }
</script>