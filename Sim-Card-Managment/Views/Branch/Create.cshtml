@model Sim_Card_Managment.Viewmodel.BranchCreateViewModel

@{
}

<!DOCTYPE html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Branch</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>

<section class="bc-body">

    <main class="container px-3 p-100">

        <div class="bc-card">

            <!-- ========================================== -->
            <!-- 🏢 CARD HEADER                           -->
            <!-- ========================================== -->
            <div class="bc-card-header d-flex align-items-center gap-3">
                <div class="bc-icon-wrapper">
                    <i class="fa-solid fa-code-branch"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">Create New Branch</h3>
                    <p class="m-0 text-muted small">Add a new organization location</p>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- 🏢 FORM                                 -->
            <!-- ========================================== -->
            <form id="bc-create-form" asp-controller="Branch" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="px-4 pt-4">
                        <div class="bc-alert bc-alert-danger" role="alert">
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="p-4 p-md-5">
                    <div class="row g-4">

                        <!-- 🏢 BRANCH NAME -->
                        <div class="col-12">
                            <label for="bc-name-input" class="bc-label">
                                <i class="fa-regular fa-building me-1"></i> Branch Name <span class="text-danger">*</span>
                            </label>
                            <div class="bc-input-group">
                                <i class="fa-solid fa-building"></i>
                                <input id="bc-name-input" asp-for="Name" class="bc-input" placeholder="e.g., Cairo Main Branch" required maxlength="100">
                            </div>
                            <span id="bc-name-error" class="bc-error" style="display:none;">Branch name is required.</span>
                            <span asp-validation-for="Name" class="bc-error"></span>
                        </div>

                        <!-- 🏢 SITE CODE (HR) -->
                        <div class="col-12 col-md-6">
                            <label asp-for="SiteCode" class="bc-label">
                                <i class="fa-solid fa-id-badge me-1"></i> Site Code (HR)
                            </label>
                            <div class="bc-input-group">
                                <i class="fa-solid fa-id-badge"></i>
                                <input asp-for="SiteCode" class="bc-input" placeholder="e.g., HR-014" maxlength="50">
                            </div>
                            <span asp-validation-for="SiteCode" class="bc-error"></span>
                        </div>

                        <!-- 🏢 BRANCH CODE (RETAIL) -->
                        <div class="col-12 col-md-6">
                            <label asp-for="BranchCode" class="bc-label">
                                <i class="fa-solid fa-tag me-1"></i> Branch Code (Retail)
                            </label>
                            <div class="bc-input-group">
                                <i class="fa-solid fa-tag"></i>
                                <input asp-for="BranchCode" class="bc-input" placeholder="e.g., RT-014" maxlength="50">
                            </div>
                            <span asp-validation-for="BranchCode" class="bc-error"></span>
                        </div>

                        <!-- 🏢 VPN OVER INTERNET STATUS -->
                        <div class="col-12">
                            <label for="bc-vpn-select" class="bc-label">
                                <i class="fa-solid fa-globe me-1"></i> VPN Over Internet Status
                            </label>
                            <select id="bc-vpn-select" asp-for="VpnOverInternetStatus" class="cs-select">
                                <option value="">Not Configured</option>
                                <option value="true">Enabled</option>
                                <option value="false">Disabled</option>
                            </select>
                        </div>

                        <!-- 🏢 FIREWALL TYPES (only relevant when VPN over internet is enabled) -->
                        <div class="col-12" id="bc-firewall-section" style="display: none;">
                            <label class="bc-label">
                                <i class="fa-solid fa-shield-halved me-1"></i> Firewall Types
                            </label>
                            <div class="bc-checkbox-list">
                                @if (Model.FireWallTypes != null && Model.FireWallTypes.Any())
                                {
                                    foreach (var fireWallType in Model.FireWallTypes)
                                    {
                                        <label class="bc-checkbox-row">
                                            <input type="checkbox" name="SelectedFireWallTypeIds" value="@fireWallType.Value">
                                            <span>@fireWallType.Text</span>
                                        </label>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">No firewall types configured yet.</span>
                                }
                            </div>
                            <span class="text-muted small d-block mt-1">Select one or more firewall types used for this branch's VPN over internet connection.</span>
                        </div>

                        <style>
                            .bc-checkbox-list {
                                display: flex;
                                flex-direction: column;
                                gap: 4px;
                                border: 1px solid var(--card-border, #E2E8F0);
                                border-radius: 12px;
                                padding: 10px 14px;
                                background: #FFFFFF;
                            }

                            .bc-checkbox-row {
                                display: flex;
                                align-items: center;
                                gap: 10px;
                                padding: 6px 4px;
                                width: 100%;
                                cursor: pointer;
                                font-size: 0.9rem;
                            }

                                .bc-checkbox-row input[type="checkbox"] {
                                    width: 16px;
                                    height: 16px;
                                    flex-shrink: 0;
                                    cursor: pointer;
                                }
                        </style>

                        <!-- 🏢 NOTE -->
                        <div class="col-12">
                            <label asp-for="Note" class="bc-label">
                                <i class="fa-regular fa-note-sticky me-1"></i> Note
                            </label>
                            <textarea asp-for="Note" class="bc-input" rows="3" placeholder="Optional notes about this branch..." maxlength="1000"></textarea>
                            <span asp-validation-for="Note" class="bc-error"></span>
                        </div>

                    </div>

                    <!-- 🏢 ACTION BUTTONS -->
                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-action="Index" class="bc-btn bc-btn-secondary">
                            <i class="fa-solid fa-times"></i> Cancel
                        </a>
                        <button type="submit" id="bc-submit-btn" class="bc-btn bc-btn-primary">
                            <i class="fa-solid fa-plus"></i> Create Branch
                        </button>
                    </div>

                </div>
            </form>

        </div>

    </main>

    <script>
        // ============================================
        // 🏢 FORM VALIDATION
        // ============================================
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('bc-create-form');
            const nameInput = document.getElementById('bc-name-input');
            const nameError = document.getElementById('bc-name-error');
            const submitBtn = document.getElementById('bc-submit-btn');

            // Validate branch name
            function validateName() {
                const value = nameInput.value.trim();

                if (!value) {
                    nameInput.classList.add('is-invalid');
                    nameError.textContent = 'Branch name is required.';
                    nameError.style.display = 'block';
                    return false;
                }

                if (value.length < 2) {
                    nameInput.classList.add('is-invalid');
                    nameError.textContent = 'Branch name must be at least 2 characters.';
                    nameError.style.display = 'block';
                    return false;
                }

                if (value.length > 100) {
                    nameInput.classList.add('is-invalid');
                    nameError.textContent = 'Branch name cannot exceed 100 characters.';
                    nameError.style.display = 'block';
                    return false;
                }

                nameInput.classList.remove('is-invalid');
                nameError.style.display = 'none';
                return true;
            }

            // Real-time validation on input
            nameInput.addEventListener('input', function () {
                validateName();
                updateSubmitButton();
            });

            nameInput.addEventListener('blur', function () {
                validateName();
                updateSubmitButton();
            });

            // Update submit button state
            function updateSubmitButton() {
                const isNameValid = validateName();
                submitBtn.disabled = !isNameValid;
            }

            // Form submission validation
            form.addEventListener('submit', function (e) {
                const isNameValid = validateName();

                if (!isNameValid) {
                    e.preventDefault();
                    nameInput.focus();
                    nameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return false;
                }

                // Disable button to prevent double submission
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating...';
            });

            // Initial validation
            updateSubmitButton();

            // ============================================
            // 🏢 SHOW/HIDE FIREWALL TYPES BASED ON VPN STATUS
            // ============================================
            const vpnSelect = document.getElementById('bc-vpn-select');
            const firewallSection = document.getElementById('bc-firewall-section');

            function toggleFirewallSection() {
                if (vpnSelect.value === 'true') {
                    firewallSection.style.display = '';
                } else {
                    firewallSection.style.display = 'none';
                    // Uncheck any selections so they don't get posted
                    // while the section is hidden/irrelevant.
                    firewallSection.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                }
            }

            vpnSelect.addEventListener('change', toggleFirewallSection);
            toggleFirewallSection();
        });
    </script>

</section>
