@model Sim_Card_Managment.Viewmodel.BranchCreateViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Branch</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>

<section class="bc-body">

    <main class="container px-3 p-100">

        <div class="bc-card">

            <!-- ========================================== -->
            <!-- 🏢 CARD HEADER                           -->
            <!-- ========================================== -->
            <div class="bc-card-header d-flex align-items-center gap-3">
                <div class="bc-icon-wrapper">
                    <i class="fa-solid fa-code-branch"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">Create New Branch</h3>
                    <p class="m-0 text-muted small">Add a new organization location</p>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- 🏢 FORM                                 -->
            <!-- ========================================== -->
            <form id="bc-create-form" asp-controller="Branch" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="px-4 pt-4">
                        <div class="bc-alert bc-alert-danger" role="alert">
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="p-4 p-md-5">
                    <div class="row g-4">

                        <!-- 🏢 BRANCH NAME -->
                        <div class="col-12">
                            <label for="bc-name-input" class="bc-label">
                                <i class="fa-regular fa-building me-1"></i> Branch Name <span class="text-danger">*</span>
                            </label>
                            <div class="bc-input-group">
                                <i class="fa-solid fa-building"></i>
                                <input id="bc-name-input" asp-for="Name" class="bc-input" placeholder="e.g., Cairo Main Branch" required maxlength="100">
                            </div>
                            <span id="bc-name-error" class="bc-error" style="display:none;">Branch name is required.</span>
                            <span asp-validation-for="Name" class="bc-error"></span>
                        </div>

                    </div>

                    <!-- 🏢 ACTION BUTTONS -->
                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-action="Index" class="bc-btn bc-btn-secondary">
                            <i class="fa-solid fa-times"></i> Cancel
                        </a>
                        <button type="submit" id="bc-submit-btn" class="bc-btn bc-btn-primary">
                            <i class="fa-solid fa-plus"></i> Create Branch
                        </button>
                    </div>

                </div>
            </form>

        </div>

    </main>

    <script>
        // ============================================
        // 🏢 FORM VALIDATION
        // ============================================
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('bc-create-form');
            const nameInput = document.getElementById('bc-name-input');
            const nameError = document.getElementById('bc-name-error');
            const submitBtn = document.getElementById('bc-submit-btn');

            // Validate branch name
            function validateName() {
                const value = nameInput.value.trim();

                if (!value) {
                    nameInput.classList.add('is-invalid');
                    nameError.textContent = 'Branch name is required.';
                    nameError.style.display = 'block';
                    return false;
                }

                if (value.length < 2) {
                    nameInput.classList.add('is-invalid');
                    nameError.textContent = 'Branch name must be at least 2 characters.';
                    nameError.style.display = 'block';
                    return false;
                }

                if (value.length > 100) {
                    nameInput.classList.add('is-invalid');
                    nameError.textContent = 'Branch name cannot exceed 100 characters.';
                    nameError.style.display = 'block';
                    return false;
                }

                nameInput.classList.remove('is-invalid');
                nameError.style.display = 'none';
                return true;
            }

            // Real-time validation on input
            nameInput.addEventListener('input', function () {
                validateName();
                updateSubmitButton();
            });

            nameInput.addEventListener('blur', function () {
                validateName();
                updateSubmitButton();
            });

            // Update submit button state
            function updateSubmitButton() {
                const isNameValid = validateName();
                submitBtn.disabled = !isNameValid;
            }

            // Form submission validation
            form.addEventListener('submit', function (e) {
                const isNameValid = validateName();

                if (!isNameValid) {
                    e.preventDefault();
                    nameInput.focus();
                    nameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return false;
                }

                // Disable button to prevent double submission
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating...';
            });

            // Initial validation
            updateSubmitButton();
        });
    </script>

</section>
