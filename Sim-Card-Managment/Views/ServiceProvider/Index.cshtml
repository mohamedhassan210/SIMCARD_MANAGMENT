@model IEnumerable<Sim_Card_Managment.Viewmodel.ServiceProviderViewModel>

@{
    ViewData["Title"] = "Service Providers";
    var spList = Model?.ToList() ?? new List<Sim_Card_Managment.Viewmodel.ServiceProviderViewModel>();
    var totalProviders = spList.Count;
    var activeProviders = spList.Count(sp => sp.IsActive);
    var inactiveProviders = totalProviders - activeProviders;
}

<style>
    /* Theme & Layout Variables */
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
        --bg-light: #f8f9fa;
    }

    /* Page Header */
    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    /* Action Buttons */
    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    .btn-view-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 8px;
        padding: 6px 16px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-view-action:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    /* Search Bar */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.92rem;
            color: #333333;
            padding: 4px 0;
        }

    /* Custom Dropdown Filter */
    .custom-select-filter {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 8px 36px 8px 14px;
        background-color: #ffffff;
        font-size: 0.9rem;
        color: #495057;
        transition: border-color 0.2s ease;
    }

        .custom-select-filter:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
            outline: none;
        }

    /* Status Badges */
    .badge-status-active {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
    }

    .badge-status-inactive {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
    }

    /* Pagination Styles */
    .pagination button {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        background: #fff;
        color: #6b6b6b;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .pagination button:hover:not(:disabled) {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
        }

        .pagination button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .pagination button.active {
            background: var(--primary-orange);
            border-color: var(--primary-orange);
            color: #fff;
        }
</style>

<div class="container-fluid px-4 p-100">

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">
                <span id="totalCountHeader">@totalProviders</span> Service Providers
            </h1>
            <p class="page-header-subtitle mb-0">Manage all assigned Service Providers in one central place.</p>
        </div>
        <div>
            <a asp-controller="ServiceProvider" asp-action="Create" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New Service Provider</span>
            </a>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total Providers</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalProviders</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #E24D17;">
                        <i class="fas fa-tower-cell fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Active Providers</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@activeProviders</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Inactive Providers</span>
                        <h3 class="fw-bold text-danger mb-0 mt-1">@inactiveProviders</h3>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                        <i class="fas fa-times-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <!-- Controls Row -->
        <div class="row g-3 justify-content-between align-items-center mb-4">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label text-muted small mb-1">Search</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="search-input" placeholder="Type name or display name to search...">
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-md-end align-items-end mt-3 mt-md-0">
                <div class="w-100 w-md-auto">
                    <label class="form-label text-muted small mb-1">Status Filter</label>
                    <select id="status-filter" class="form-select custom-select-filter">
                        <option value="all">All Statuses</option>
                        <option value="active">Active Only</option>
                        <option value="inactive">Inactive Only</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="directoryTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th scope="col">Name</th>
                        <th scope="col">Display Name</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="spTableBody">
                    @if (spList.Any())
                    {
                        foreach (var item in spList)
                        {
                            <tr class="sp-row @(item.IsActive ? "" : "table-light")"
                                data-name="@(item.Name ?? "")"
                                data-displayname="@(item.DisplayName ?? "")"
                                data-status="@(item.IsActive ? "active" : "inactive")">
                                <td class="fw-bold text-dark">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-orange bg-opacity-10 text-danger p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: #fffaf8;">
                                            <i class="fas fa-wifi fa-sm" style="color: var(--primary-orange);"></i>
                                        </div>
                                        <span>@item.Name</span>
                                    </div>
                                </td>
                                <td class="text-secondary">
                                    @(item.DisplayName ?? "N/A")
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-status-active">
                                            <i class="fas fa-circle me-1" style="font-size: 7px;"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-inactive">
                                            <i class="fas fa-circle me-1" style="font-size: 7px;"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="ServiceProvider" asp-action="Details" asp-route-id="@item.Id" class="btn-view-action">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    <tr id="emptyRow" style="display: none;">
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="fas fa-search me-1"></i> No service providers found matching your criteria.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer / Pagination -->
        <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 mt-4 pt-2 border-top">
            <div class="text-muted small" id="showingText">Showing 0 records</div>
            <div class="pagination d-flex align-items-center gap-1" id="paginationContainer"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rows = Array.from(document.querySelectorAll('.sp-row'));
            const emptyRow = document.getElementById('emptyRow');
            const searchInput = document.getElementById('search-input');
            const statusFilter = document.getElementById('status-filter');
            const totalCountHeader = document.getElementById('totalCountHeader');
            const showingText = document.getElementById('showingText');
            const paginationContainer = document.getElementById('paginationContainer');

            const pageSize = 7;
            let currentPage = 1;

            function updateTable() {
                const searchTerm = searchInput.value.trim().toLowerCase();
                const selectedStatus = statusFilter.value;

                const filteredRows = rows.filter(row => {
                    const name = (row.getAttribute('data-name') || '').toLowerCase();
                    const displayName = (row.getAttribute('data-displayname') || '').toLowerCase();
                    const status = row.getAttribute('data-status') || '';

                    const matchesSearch = name.includes(searchTerm) || displayName.includes(searchTerm);
                    const matchesStatus = (selectedStatus === 'all') || (status === selectedStatus);

                    return matchesSearch && matchesStatus;
                });

                const totalFiltered = filteredRows.length;
                totalCountHeader.textContent = totalFiltered;

                if (totalFiltered === 0) {
                    rows.forEach(r => r.style.display = 'none');
                    emptyRow.style.display = '';
                    showingText.textContent = 'Showing 0 records';
                    paginationContainer.innerHTML = '';
                    return;
                }

                emptyRow.style.display = 'none';

                const totalPages = Math.ceil(totalFiltered / pageSize);
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = startIndex + pageSize;

                rows.forEach(r => r.style.display = 'none');
                filteredRows.slice(startIndex, endIndex).forEach(r => r.style.display = '');

                const startShow = startIndex + 1;
                const endShow = Math.min(endIndex, totalFiltered);
                showingText.textContent = `Showing ${startShow} to ${endShow} of ${totalFiltered} records`;

                renderPagination(totalPages);
            }

            function renderPagination(totalPages) {
                paginationContainer.innerHTML = '';

                if (totalPages <= 1) return;

                const prevBtn = document.createElement('button');
                prevBtn.innerHTML = '&#8249;';
                prevBtn.disabled = currentPage === 1;
                prevBtn.addEventListener('click', () => {
                    if (currentPage > 1) {
                        currentPage--;
                        updateTable();
                    }
                });
                paginationContainer.appendChild(prevBtn);

                for (let i = 1; i <= totalPages; i++) {
                    const pageBtn = document.createElement('button');
                    pageBtn.className = `page-num ${i === currentPage ? 'active' : ''}`;
                    pageBtn.textContent = i;
                    pageBtn.addEventListener('click', () => {
                        currentPage = i;
                        updateTable();
                    });
                    paginationContainer.appendChild(pageBtn);
                }

                const nextBtn = document.createElement('button');
                nextBtn.innerHTML = '&#8250;';
                nextBtn.disabled = currentPage === totalPages;
                nextBtn.addEventListener('click', () => {
                    if (currentPage < totalPages) {
                        currentPage++;
                        updateTable();
                    }
                });
                paginationContainer.appendChild(nextBtn);
            }

            searchInput.addEventListener('input', () => {
                currentPage = 1;
                updateTable();
            });

            statusFilter.addEventListener('change', () => {
                currentPage = 1;
                updateTable();
            });

            updateTable();
        });
    </script>
}