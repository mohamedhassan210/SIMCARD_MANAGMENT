@model IEnumerable<Sim_Card_Managment.Viewmodel.ServiceProviderViewModel>

@{
    ViewData["Title"] = "Service Providers";
}

<style>
    /* ---------- Title ---------- */
    .title-section {
        margin-bottom: 24px;
    }

        .title-section h1 {
            font-size: 34px;
            font-weight: 800;
            color: #1a1a1a;
        }

            .title-section h1 .num {
                color: #e8552b;
            }

        .title-section p {
            margin-top: 10px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b6b6b;
            max-width: 560px;
        }

    /* ---------- Buttons ---------- */
    .create-btn-group {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .create-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #e8552b;
        color: #fff;
        border: none;
        padding: 11px 20px;
        border-radius: 24px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .create-btn:hover {
            background: #d64923;
            color: #fff;
            transform: translateY(-1px);
        }

    .create-btn-secondary {
        background: #ffffff;
        color: #1a1a1a;
        border: 1px solid #dcdcdc;
    }

        .create-btn-secondary:hover {
            background: #f7f7f7;
            color: #e8552b;
            border-color: #e8552b;
        }

    /* ---------- Filters ---------- */
    .filters {
        margin-top: 34px;
    }

        .filters label {
            display: block;
            font-size: 12px;
            color: #6b6b6b;
            margin-bottom: 8px;
        }

    .filters-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-select {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 13px;
        color: #1a1a1a;
        width: 150px;
        cursor: pointer;
        transition: border-color 0.2s ease;
    }

        .status-select:hover {
            border-color: #e8552b;
        }

    .search-box {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        transition: border-color 0.2s ease;
    }

        .search-box:focus-within {
            border-color: #e8552b;
        }

        .search-box svg {
            width: 15px;
            height: 15px;
            color: #a8a8a8;
            flex-shrink: 0;
        }

        .search-box input {
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
            width: 100%;
            color: #1a1a1a;
        }

            .search-box input::placeholder {
                color: #b3b3b3;
            }

    /* ---------- Table ---------- */
    .table-wrap {
        margin-top: 28px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #1a1a1a;
        padding-bottom: 12px;
        vertical-align: top;
    }

    thead tr {
        border-bottom: 2px solid #e8552b;
    }

    tbody td {
        font-size: 12.5px;
        color: #1a1a1a;
        padding: 16px 0;
        border-bottom: 1px solid #e2e2e2;
        vertical-align: middle;
    }

    .person-row.inactive-row {
        opacity: 0.65;
        background-color: #fcfcfc;
    }

    .badge-type {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 10px;
        text-transform: uppercase;
    }

    .badge-employee {
        background: #e6f4ea;
        color: #137333;
    }

    .badge-non-employee {
        background: #fce8e6;
        color: #c5221f;
    }

    .view-btn {
        display: inline-block;
        border: 1.5px solid #e8552b;
        color: #e8552b;
        background: transparent;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 18px;
        border-radius: 16px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .view-btn:hover {
            background: #e8552b;
            color: #fff;
        }

    th:nth-child(1), td:nth-child(1) {
        width: 30%;
    }

    th:nth-child(2), td:nth-child(2) {
        width: 35%;
    }

    th:nth-child(3), td:nth-child(3) {
        width: 20%;
    }

    th:nth-child(4), td:nth-child(4) {
        width: 15%;
        text-align: right;
    }

    /* ---------- Footer ---------- */
    .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 20px;
    }

        .footer .showing {
            font-size: 12px;
            color: #6b6b6b;
        }

    .pagination {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .pagination button {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid #dcdcdc;
            background: #fff;
            color: #6b6b6b;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .pagination button:hover:not(:disabled) {
                border-color: #e8552b;
                color: #e8552b;
            }

            .pagination button:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

            .pagination button.page-num {
                border: none;
                background: transparent;
                color: #1a1a1a;
            }

                .pagination button.page-num:hover {
                    background: #fbeae5;
                    color: #e8552b;
                }

            .pagination button.active {
                background: #e8552b;
                border-color: #e8552b;
                color: #fff;
            }
</style>

<div class="page p-100 container-fluid px-4">

    <div class="title-section">
        <h1><span class="num" id="totalCountHeader">0</span> ServiceProvider</h1>
        <p>Manage all assigned ServiceProvider in one central place.</p>

        <div class="create-btn-group">
            <a asp-controller="ServiceProvider" asp-action="Create" class="create-btn"><span>+</span> New ServiceProvider</a>
        </div>
    </div>

    <div class="filters">
        <div class="filters-row">
            <div class="filter-group">
                <label for="status-filter">Status</label>
                <select id="status-filter" class="status-select">
                    <option value="all">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="filter-group" style="flex: 1;">
                <label for="search-input">Search</label>
                <div class="search-box">
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5" />
                        <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <input id="search-input" type="text" placeholder="Type name or display name to search instantly..." autocomplete="off">
                </div>
            </div>
        </div>
    </div>

    <div class="table-wrap">
        <table id="directoryTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Display Name</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="spTableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="person-row sp-row @(item.IsActive ? "" : "inactive-row")"
                            data-name="@(item.Name ?? "")"
                            data-displayname="@(item.DisplayName ?? "")"
                            data-status="@(item.IsActive ? "active" : "inactive")">
                            <td><strong>@item.Name</strong></td>
                            <td>@(item.DisplayName ?? "N/A")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-type badge-employee">Active</span>
                                }
                                else
                                {
                                    <span class="badge-type badge-non-employee">Inactive</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <a asp-controller="ServiceProvider" asp-action="Details" asp-route-id="@item.Id" class="view-btn">VIEW</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyRow">
                        <td colspan="4" style="text-align: center; color: #888; padding: 24px 0;">No service providers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="footer">
        <div class="showing" id="showingText">Showing 0 records</div>
        <div class="pagination" id="paginationContainer"></div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rows = Array.from(document.querySelectorAll('.sp-row'));
            const searchInput = document.getElementById('search-input');
            const statusFilter = document.getElementById('status-filter');
            const totalCountHeader = document.getElementById('totalCountHeader');
            const showingText = document.getElementById('showingText');
            const paginationContainer = document.getElementById('paginationContainer');

            const pageSize = 7;
            let currentPage = 1;

            function updateTable() {
                const searchTerm = searchInput.value.trim().toLowerCase();
                const selectedStatus = statusFilter.value;

                const filteredRows = rows.filter(row => {
                    const name = (row.getAttribute('data-name') || '').toLowerCase();
                    const displayName = (row.getAttribute('data-displayname') || '').toLowerCase();
                    const status = row.getAttribute('data-status') || '';

                    const matchesSearch = name.includes(searchTerm) || displayName.includes(searchTerm);
                    const matchesStatus = (selectedStatus === 'all') || (status === selectedStatus);

                    return matchesSearch && matchesStatus;
                });

                const totalFiltered = filteredRows.length;
                totalCountHeader.textContent = totalFiltered;

                const totalPages = Math.ceil(totalFiltered / pageSize) || 1;
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = startIndex + pageSize;

                rows.forEach(r => r.style.display = 'none');
                filteredRows.slice(startIndex, endIndex).forEach(r => r.style.display = '');

                const startShow = totalFiltered === 0 ? 0 : startIndex + 1;
                const endShow = Math.min(endIndex, totalFiltered);
                showingText.textContent = `Showing ${startShow} to ${endShow} of ${totalFiltered} records`;

                renderPagination(totalPages);
            }

            function renderPagination(totalPages) {
                paginationContainer.innerHTML = '';

                if (totalPages <= 1) return;

                const prevBtn = document.createElement('button');
                prevBtn.innerHTML = '&#8249;';
                prevBtn.disabled = currentPage === 1;
                prevBtn.addEventListener('click', () => {
                    if (currentPage > 1) {
                        currentPage--;
                        updateTable();
                    }
                });
                paginationContainer.appendChild(prevBtn);

                for (let i = 1; i <= totalPages; i++) {
                    const pageBtn = document.createElement('button');
                    pageBtn.className = `page-num ${i === currentPage ? 'active' : ''}`;
                    pageBtn.textContent = i;
                    pageBtn.addEventListener('click', () => {
                        currentPage = i;
                        updateTable();
                    });
                    paginationContainer.appendChild(pageBtn);
                }

                const nextBtn = document.createElement('button');
                nextBtn.innerHTML = '&#8250;';
                nextBtn.disabled = currentPage === totalPages;
                nextBtn.addEventListener('click', () => {
                    if (currentPage < totalPages) {
                        currentPage++;
                        updateTable();
                    }
                });
                paginationContainer.appendChild(nextBtn);
            }

            searchInput.addEventListener('input', () => {
                currentPage = 1;
                updateTable();
            });

            statusFilter.addEventListener('change', () => {
                currentPage = 1;
                updateTable();
            });

            updateTable();
        });
    </script>
}