    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model Sim_Card_Managment.Models.Document

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document Details - @Model.DocumentNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-orange: #DF531B;
            --brand-orange-light: #FFF8F6;
            --brand-purple: #5B2D90;
            --bg-canvas: #F4F5F8;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --card-border: #E2E8F0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, sans-serif;
            padding-bottom: 3rem;
        }

        .page-header {
            background: #FFFFFF;
            border-bottom: 1px solid var(--card-border);
            padding: 2rem 0;
            margin-bottom: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .page-title {
            font-size: clamp(1.5rem, 3vw, 2rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--text-dark);
        }

        .details-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .info-card {
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .card-section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-section-title i {
                color: var(--brand-orange);
            }

        .info-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace, SFMono-Regular, Consolas;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #FFF;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 8px 14px;
            transition: border-color 0.2s ease;
        }

            .search-box:focus-within {
                border-color: var(--brand-orange);
            }

            .search-box i {
                color: var(--text-muted);
            }

            .search-box input {
                border: none;
                outline: none;
                background: transparent;
                font-size: 0.9rem;
                width: 100%;
                color: var(--text-dark);
            }

        .stat-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            background-color: var(--bg-canvas);
            border: 1px solid var(--card-border);
        }

        .btn-custom {
            height: 40px;
            padding: 0 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.875rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
        }

        .btn-secondary-outline {
            background-color: #FFFFFF;
            color: var(--text-dark);
            border: 1px solid var(--card-border);
        }

            .btn-secondary-outline:hover {
                background-color: var(--bg-canvas);
                color: var(--text-dark);
            }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }

            .custom-table thead th {
                text-align: left;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--text-muted);
                padding: 10px 12px;
                border-bottom: 2px solid var(--brand-orange);
                background: #FFFFFF;
            }

            .custom-table tbody td {
                font-size: 0.9rem;
                padding: 12px;
                border-bottom: 1px solid var(--card-border);
                vertical-align: middle;
            }

        .data-row:hover {
            background-color: var(--brand-orange-light);
        }
    </style>
</head>
<body>

    <header class="page-header">
        <div class="container-fluid px-lg-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="page-title m-0">Document Details</h1>
                    <p class="text-muted m-0 small mt-1">
                        Serial / Doc #: <strong class="font-mono text-dark">@(string.IsNullOrEmpty(Model.DocumentNumber) ? "N/A" : Model.DocumentNumber)</strong>
                    </p>
                </div>
                <div>
                    <a asp-action="Index" class="btn-custom btn-secondary-outline">
                        <i class="fa-solid fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="container-fluid px-lg-5 details-container">

        <!-- Top Overview Card -->
        <div class="info-card">
            <div class="card-section-title">
                <i class="fa-solid fa-file-contract"></i>
                <span>Document Information</span>
            </div>

            <div class="row g-4">
                <div class="col-6 col-md-3">
                    <div class="info-label">Serial / Doc #</div>
                    <div class="info-value font-mono">@(string.IsNullOrEmpty(Model.DocumentNumber) ? "N/A" : Model.DocumentNumber)</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="info-label">Document Type</div>
                    <div class="info-value">@(Model.DocumentType?.DisplayName ?? "N/A")</div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="info-label">Action Date</div>
                    <div class="info-value">@Model.ActionDate.ToString("yyyy-MM-dd")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="info-label">Creation Date</div>
                    <div class="info-value">@Model.CreatedAt.ToString("yyyy-MM-dd")</div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="info-label">Created By</div>
                    @* <div class="info-value">@(Model.CreatedBy ?? "System / Unknown")</div> *@
                </div>
                <div class="col-6 col-md-3">
                    <div class="info-label">Associated Items</div>
                    <div class="d-flex gap-2 mt-1">
                        <span class="stat-badge">
                            <i class="fa-solid fa-sim-card text-muted"></i>
                            <strong>@(ViewBag.SimCount ?? 0)</strong> SIMs
                        </span>
                        <span class="stat-badge">
                            <i class="fa-solid fa-usb text-muted"></i>
                            <strong>@(ViewBag.UsbCount ?? 0)</strong> USBs
                        </span>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="info-label">Notes</div>
                    <div class="info-value text-muted fw-normal">
                        @(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 1: Associated SIM Cards -->
        <div class="info-card">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <div class="card-section-title m-0">
                    <i class="fa-solid fa-sim-card"></i>
                    <span>Attached SIM Cards</span>
                    <span class="badge bg-light text-dark border ms-2">@(ViewBag.SimCount ?? 0)</span>
                </div>
                <div class="search-box col-12 col-md-4">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="simSearchInput" type="text" placeholder="Search SIM cards..." autocomplete="off">
                </div>
            </div>

            <div class="table-responsive">
                <table class="custom-table" id="simTable">
                    <thead>
                        <tr>
                            <th>Phone Number</th>
                            <th>Serial Number (ICCID)</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="simTableBody">
                        @if (ViewBag.Sims != null && ((IEnumerable<dynamic>)ViewBag.Sims).Any())
                        {
                            foreach (var sim in ViewBag.Sims)
                            {
                                <tr class="data-row">
                                    <td class="font-mono"><strong>@sim.PhoneNumber</strong></td>
                                    <td class="font-mono text-muted">@sim.SerialNumber</td>
                                    <td><span class="badge bg-secondary">@sim.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noSimsRow">
                                <td colspan="3" class="text-center text-muted py-4">
                                    No SIM cards attached to this document.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 2: Associated USB Modems -->
        <div class="info-card">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <div class="card-section-title m-0">
                    <i class="fa-solid fa-usb"></i>
                    <span>Attached USB Modems</span>
                    <span class="badge bg-light text-dark border ms-2">@(ViewBag.UsbCount ?? 0)</span>
                </div>
                <div class="search-box col-12 col-md-4">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="usbSearchInput" type="text" placeholder="Search USB modems..." autocomplete="off">
                </div>
            </div>

            <div class="table-responsive">
                <table class="custom-table" id="usbTable">
                    <thead>
                        <tr>
                            <th>Serial Number</th>
                            <th>Model / Type</th>
                            <th>IMEI</th>
                        </tr>
                    </thead>
                    <tbody id="usbTableBody">
                        @if (ViewBag.Usbs != null && ((IEnumerable<dynamic>)ViewBag.Usbs).Any())
                        {
                            foreach (var usb in ViewBag.Usbs)
                            {
                                <tr class="data-row">
                                    <td class="font-mono"><strong>@usb.SerialNumber</strong></td>
                                    <td>@usb.Model</td>
                                    <td class="font-mono text-muted">@usb.Imei</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noUsbRow">
                                <td colspan="3" class="text-center text-muted py-4">
                                    No USB modems attached to this document.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Live Search for SIMs
            setupSearch('simSearchInput', '#simTableBody tr.data-row', 'noSimsRow');

            // Live Search for USBs
            setupSearch('usbSearchInput', '#usbTableBody tr.data-row', 'noUsbRow');
        });

        function setupSearch(inputId, rowSelector, noResultId) {
            const input = document.getElementById(inputId);
            if (!input) return;

            input.addEventListener('input', () => {
                const query = input.value.toLowerCase().trim();
                const rows = document.querySelectorAll(rowSelector);
                let visible = 0;

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    if (text.includes(query)) {
                        row.style.display = '';
                        visible++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                const noRes = document.getElementById(noResultId);
                if (noRes && rows.length > 0) {
                    noRes.style.display = visible === 0 ? '' : 'none';
                }
            });
        }
    </script>

</body>
</html>