@model IEnumerable<Sim_Card_Managment.Models.Document>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet">
    <meta charset="utf-8">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f9fb;
            color: #191c1e;
            
        }

        .font-mono-data {
            font-family: 'JetBrains Mono', monospace;
        }

        .full {
            width: 1650px !important;
        }

        .hover-bg:hover {
            background-color: #f7f9fb;
            transition: background-color 0.2s ease-in-out;
        }
    </style>
</head>
<body class="vh-100 overflow-hidden  d-flex " >
    <main class="flex-grow-1 d-flex flex-column h-100 position-relative full min-w-0" style="margin-top: 80px">
        <div class="flex-grow-1 overflow-auto p-4 w-100 mw-100">
            <div class="d-flex justify-content-between align-items-center mb-4 w-100">
                <div>
                    <h2 class="h3 fw-bold text-dark mb-1" style="font-size: 32px; letter-spacing: -0.02em;">Document Management</h2>
                    <p class="text-secondary mb-0" style="font-size: 14px;">View, filter, and export document records.</p>
                </div>
                <div class="d-flex gap-3">
                    <a asp-action="InventoryReport" class="d-flex align-items-center gap-2 px-3 py-2 text-decoration-none rounded text-dark bg-secondary bg-opacity-10 border shadow-sm fw-semibold" style="font-size: 12px; border-color: #E2E8F0 !important;">
                        <span class="material-symbols-outlined" style="font-size: 18px;">devices</span>
                        Hardware Lifecycle Report
                    </a>
                    <a asp-action="ExportToExcel" asp-route-searchTerm="@Context.Request.Query["searchTerm"]" asp-route-documentTypeId="@Context.Request.Query["documentTypeId"]" class="d-flex align-items-center gap-2 px-3 py-2 text-decoration-none rounded text-dark bg-light border shadow-sm fw-semibold" style="font-size: 12px; border-color: #E2E8F0 !important;">
                        <span class="material-symbols-outlined" style="font-size: 18px;">download</span>
                        Export Summary
                    </a>
                    <a asp-action="Create" style="background-color: #e24d17;" class="d-flex align-items-center gap-2 px-3 py-2 text-decoration-none rounded text-white shadow-sm fw-semibold" style="font-size: 12px; background-color: #e24d17;">
                        <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                        New Document
                    </a>
                </div>
            </div>

            <div class="bg-white rounded border p-4 mb-4 shadow-sm w-100" style="border-color: #E2E8F0 !important;">
                <form asp-action="Index" method="get" class="row g-3 align-items-end w-100">
                    <div class="col-md">
                        <label class="form-label fw-semibold text-muted mb-1" style="font-size: 12px;">Search (Serial Number / Notes)</label>
                        <div class="position-relative w-100">
                            <span class="material-symbols-outlined position-absolute text-secondary" style="left: 12px; top: 10px; font-size: 20px;">search</span>
                            <input name="searchTerm" value="@Context.Request.Query["searchTerm"]" class="form-control ps-5 py-2 bg-light border" placeholder="Enter serial or partial notes..." type="text" style="font-size: 14px; border-color: #E2E8F0 !important;">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted mb-1" style="font-size: 12px;">Document Type</label>
                        <select name="documentTypeId" asp-items="ViewBag.DocumentTypes" class="form-select py-2 bg-light border" style="font-size: 14px; border-color: #E2E8F0 !important;">
                            <option value="">-- All Types --</option>
                        </select>
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-light border d-flex align-items-center justify-content-center gap-2 px-4 py-2 w-100 fw-semibold text-dark shadow-sm" style="font-size: 12px; border-color: #E2E8F0 !important;">
                            <span class="material-symbols-outlined" style="font-size: 18px;">filter_list</span>
                            Filter
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-white rounded border overflow-hidden shadow-sm d-flex flex-column min-vh-50 w-100" style="border-color: #E2E8F0 !important; min-height: 400px;">
                <div class="row g-0 p-3 bg-light border-bottom align-items-center fw-semibold text-muted" style="font-size: 12px; border-color: #E2E8F0 !important; background-color: #f2f4f6 !important;">
                    <div class="col-2">Serial / Doc #</div>
                    <div class="col-2">Document Type</div>
                    <div class="col-2">Action Date</div>
                    <div class="col-2">Creation Date</div>
                    <div class="col-2">Notes</div>
                    <div class="col-2 text-end">Options</div>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="w-100">
                        @foreach (var item in Model)
                        {
                            <div class="row g-0 p-3 align-items-center border-bottom w-100 m-0 hover-bg" style="border-color: #E2E8F0 !important;">
                                <div class="col-2 font-mono-data text-dark text-truncate" style="font-size: 14px;">
                                    @(string.IsNullOrEmpty(item.DocumentNumber) ? "N/A" : item.DocumentNumber)
                                </div>
                                <div class="col-2 text-dark" style="font-size: 14px;">
                                    @(item.DocumentType?.DisplayName ?? "N/A")
                                </div>
                                <div class="col-2 text-secondary" style="font-size: 14px;">
                                    @item.ActionDate.ToString("yyyy-MM-dd")
                                </div>
                                <div class="col-2 text-secondary" style="font-size: 14px;">
                                    @item.CreatedAt.ToString("yyyy-MM-dd")
                                </div>
                                <div class="col-2 text-secondary text-truncate" title="@item.Notes" style="font-size: 14px;">
                                    @(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)
                                </div>
                                <div class="col-2 text-end d-flex align-items-center justify-content-end gap-2">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this document?');" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-danger p-1 text-decoration-none" title="Delete">
                                            <span class="material-symbols-outlined" style="font-size: 20px;">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center p-5 text-center bg-light w-100 my-auto" style="min-height: 400px; background-color: #f7f9fb !important;">
                        <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                            <span class="material-symbols-outlined text-secondary fs-2">description</span>
                        </div>
                        <h3 class="h5 fw-bold text-dark mb-2" style="font-size: 20px;">No documents found</h3>
                        <p class="text-secondary text-muted" style="font-size: 14px; max-width: 400px;">
                            No documents match the current search criteria. Try adjusting your filters or search terms.
                        </p>
                    </div>
                }
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>