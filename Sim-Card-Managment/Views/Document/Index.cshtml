@model IEnumerable<Sim_Card_Managment.Models.Document>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-orange: #DF531B;
            --brand-orange-light: #FFF8F6;
            --brand-purple: #5B2D90;
            --bg-canvas: #F4F5F8;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --card-border: #E2E8F0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, sans-serif;
            padding-bottom: 3rem;
        }

        .page-header {
            background: #FFFFFF;
            border-bottom: 1px solid var(--card-border);
            padding: 2rem 0;
            margin-bottom: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .page-title {
            font-size: clamp(1.5rem, 3vw, 2.25rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--text-dark);
        }

        .table-card {
            max-width: 1200px;
            margin: 0 auto;
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            padding: 2rem;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #FFF;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 10px 16px;
            transition: border-color 0.2s ease;
        }

            .search-box:focus-within {
                border-color: var(--brand-orange);
            }

            .search-box i {
                color: var(--text-muted);
            }

            .search-box input {
                border: none;
                outline: none;
                background: transparent;
                font-size: 0.95rem;
                width: 100%;
                color: var(--text-dark);
            }

        .form-select-custom {
            height: 44px;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 0 16px;
            font-size: 0.95rem;
            color: var(--text-dark);
            outline: none;
            transition: border-color 0.2s ease;
        }

            .form-select-custom:focus {
                border-color: var(--brand-orange);
            }

        .btn-custom {
            height: 44px;
            padding: 0 24px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary-orange {
            background-color: var(--brand-orange);
            color: #FFFFFF;
        }

            .btn-primary-orange:hover {
                background-color: #c94614;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(223, 83, 27, 0.25);
            }

        .btn-secondary-outline {
            background-color: #FFFFFF;
            color: var(--text-dark);
            border: 1px solid var(--card-border);
        }

            .btn-secondary-outline:hover {
                background-color: var(--bg-canvas);
                color: var(--text-dark);
            }

        .btn-action-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--card-border);
            background: #FFFFFF;
            color: var(--text-muted);
            transition: all 0.2s ease;
            text-decoration: none;
        }

            .btn-action-icon:hover {
                background: var(--brand-orange-light);
                color: var(--brand-orange);
                border-color: rgba(223, 83, 27, 0.3);
            }

      

        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }

            .btn-view-action {
                background-color: #ffffff;
                border: 1px solid #e0e0e0;
                color: #333333;
                border-radius: 8px;
                padding: 6px 14px;
                font-size: 13px;
                font-weight: 600;
                transition: all 0.2s ease;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .btn-view-action:hover {
                    border-color: var(--brand-orange);
                    color: var(--brand-orange);
                    background-color: #fffaf8;
                }
            .custom-table thead th {
                text-align: left;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--text-muted);
                padding: 12px 16px;
                border-bottom: 2px solid var(--brand-orange);
                background: #FFFFFF;
            }

            .custom-table tbody td {
                font-size: 0.95rem;
                padding: 16px;
                border-bottom: 1px solid var(--card-border);
                vertical-align: middle;
            }

        .doc-row {
            transition: background-color 0.15s ease;
        }

            .doc-row:hover {
                background-color: var(--brand-orange-light);
            }

        .font-mono {
            font-family: 'JetBrains Mono', monospace, SFMono-Regular, Menlo, Monaco, Consolas;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <header class="page-header p-100">
        <div class="container-fluid px-lg-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="page-title m-0">Document Management</h1>
                    <p class="text-muted m-0 small mt-1">View, filter, and export document records</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="InventoryReport" class="btn-custom btn-secondary-outline">
                        <i class="fa-solid fa-laptop"></i> Hardware Report
                    </a>
                    <a asp-action="ExportToExcel" asp-route-searchTerm="@Context.Request.Query["searchTerm"]" asp-route-documentTypeId="@Context.Request.Query["documentTypeId"]" class="btn-custom btn-secondary-outline">
                        <i class="fa-solid fa-file-excel"></i> Export Summary
                    </a>
                    <a asp-action="Create" class="btn-custom btn-primary-orange">
                        <i class="fa-solid fa-plus"></i> New Document
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="container-fluid px-lg-5">

        <div class="table-card">

            <form asp-action="Index" method="get" class="row g-3 mb-4 align-items-center">
                <div class="col-md-6">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input id="docSearchInput" name="searchTerm" value="@Context.Request.Query["searchTerm"]" type="text" placeholder="Search serial, doc number, or notes..." autocomplete="off">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="documentTypeId" asp-items="ViewBag.DocumentTypes" class="form-select-custom w-100">
                        <option value="">-- All Document Types --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn-custom btn-secondary-outline w-100">
                        <i class="fa-solid fa-filter"></i> Filter
                    </button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="custom-table" id="documentTable">
                    <thead>
                        <tr>
                            <th>Serial / Doc #</th>
                            <th>Document Type</th>
                            <th>Action Date</th>
                            <th>Creation Date</th>
                            <th>Notes</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="documentTableBody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="doc-row">
                                    <td class="font-mono">
                                        <strong>@(string.IsNullOrEmpty(item.DocumentNumber) ? "N/A" : item.DocumentNumber)</strong>
                                    </td>
                                    <td>@(item.DocumentType?.DisplayName ?? "N/A")</td>
                                    <td class="text-muted">@item.ActionDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-muted">@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td class="text-muted text-truncate" style="max-width: 200px;" title="@item.Notes">
                                        @(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-view-action" title="View Details">
                                                <i class="fa-solid fa-eye"></i> View
                                            </a>
                                           
                                        </div>
                                    </td>
                                  
                                </tr>
                            }
                        }
                        <tr id="noResultsRow" style="display: @(Model == null || !Model.Any() ? "" : "none");">
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="fa-regular fa-folder-open fa-2x mb-3 d-block text-secondary"></i>
                                No matching documents found.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('docSearchInput');
            const noResultsRow = document.getElementById('noResultsRow');

            if (searchInput) {
                searchInput.addEventListener('input', () => {
                    const query = searchInput.value.toLowerCase().trim();
                    const rows = document.querySelectorAll('#documentTableBody tr.doc-row');
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const text = row.innerText.toLowerCase();
                        if (text.includes(query)) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    if (noResultsRow) {
                        noResultsRow.style.display = visibleCount === 0 ? '' : 'none';
                    }
                });
            }
        });

        function confirmDelete(btn) {
            Swal.fire({
                title: 'Delete Document?',
                text: 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#DC2626',
                cancelButtonColor: '#64748B',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel',
                customClass: { popup: 'rounded-4' }
            }).then((result) => {
                if (result.isConfirmed) {
                    btn.closest('form').submit();
                }
            });
        }
    </script>

</body>
</html>