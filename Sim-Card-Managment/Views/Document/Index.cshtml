@model IEnumerable<Sim_Card_Managment.Models.Document>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        try{
                tailwind.config = {
                    darkMode: "class",
                    theme: {
                        extend: {
                            "colors": {
                                "secondary-container": "#e5e2e1",
                                "background": "#f7f9fb",
                                "surface-bright": "#f7f9fb",
                                "surface-variant": "#e0e3e5",
                                "on-secondary": "#ffffff",
                                "surface-container": "#eceef0",
                                "on-secondary-fixed-variant": "#474646",
                                "surface-container-lowest": "#ffffff",
                                "tertiary": "#4d5d73",
                                "tertiary-fixed": "#d3e4fe",
                                "surface-container-highest": "#e0e3e5",
                                "inverse-primary": "#ffb59e",
                                "secondary": "#5f5e5e",
                                "on-error-container": "#93000a",
                                "error-container": "#ffdad6",
                                "primary-fixed-dim": "#ffb59e",
                                "primary-fixed": "#ffdbd0",
                                "secondary-fixed": "#e5e2e1",
                                "tertiary-container": "#66768d",
                                "surface-dim": "#d8dadc",
                                "surface-container-high": "#e6e8ea",
                                "on-tertiary-container": "#fdfcff",
                                "on-tertiary-fixed": "#0b1c30",
                                "surface-container-low": "#f2f4f6",
                                "secondary-fixed-dim": "#c8c6c5",
                                "on-surface-variant": "#5a4139",
                                "surface-tint": "#ae3200",
                                "on-surface": "#191c1e",
                                "inverse-surface": "#2d3133",
                                "primary-container": "#d24209",
                                "primary": "#a93100",
                                "surface": "#f7f9fb",
                                "outline": "#8e7067",
                                "on-tertiary-fixed-variant": "#38485d",
                                "on-primary-fixed-variant": "#852400",
                                "tertiary-fixed-dim": "#b7c8e1",
                                "on-error": "#ffffff",
                                "on-tertiary": "#ffffff",
                                "inverse-on-surface": "#eff1f3",
                                "on-primary": "#ffffff",
                                "on-primary-fixed": "#3a0b00",
                                "on-primary-container": "#fffbff",
                                "error": "#ba1a1a",
                                "outline-variant": "#e3bfb4",
                                "on-secondary-container": "#656464",
                                "on-background": "#191c1e",
                                "on-secondary-fixed": "#1c1b1b"
                            },
                            "borderRadius": {
                                "DEFAULT": "0.25rem",
                                "lg": "0.5rem",
                                "xl": "0.75rem",
                                "full": "9999px"
                            },
                            "spacing": {
                                "margin-page": "24px",
                                "base": "4px",
                                "panel-split": "280px",
                                "gutter": "16px"
                            },
                            "fontFamily": {
                                "body-md": ["Inter"],
                                "label-md": ["Inter"],
                                "headline-md": ["Inter"],
                                "body-lg": ["Inter"],
                                "headline-lg": ["Inter"],
                                "mono-data": ["JetBrains Mono"],
                                "headline-sm": ["Inter"]
                            },
                            "fontSize": {
                                "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                                "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                                "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                                "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                                "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                                "mono-data": ["14px", { "lineHeight": "20px", "fontWeight": "500" }],
                                "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }]
                            }
                        }
                    }
                }
            }catch(_e){}</script>
    <meta charset="utf-8">

    <style>
        .full {
            width: 1650px !important;
        }
    </style>
</head>
<body class="font-body-md text-on-surface bg-background antialiased flex h-screen overflow-hidden p-100">
    <main class="flex-1 flex flex-col h-full bg-background relative z-10 full min-w-0">
        <div class="flex-1 overflow-auto p-margin-page w-full max-w-none">
            <div class="flex justify-between items-center mb-6 w-full">
                <div>
                    <h2 class="font-headline-lg text-headline-lg text-on-surface">Document Management</h2>
                    <p class="font-body-md text-body-md text-secondary mt-1">View, filter, and export document records.</p>
                </div>
                <div class="flex gap-3">
                    <a asp-action="InventoryReport" class="flex items-center gap-2 px-4 py-2 bg-tertiary-container hover:opacity-90 text-on-tertiary-container rounded-md font-label-md text-label-md transition-all shadow-sm border border-[#E2E8F0]">
                        <span class="material-symbols-outlined text-[18px]">devices</span>
                        Hardware Lifecycle Report
                    </a>
                    <a asp-action="ExportToExcel" asp-route-searchTerm="@Context.Request.Query["searchTerm"]" asp-route-documentTypeId="@Context.Request.Query["documentTypeId"]" class="flex items-center gap-2 px-4 py-2 bg-secondary-container hover:bg-surface-variant text-on-surface rounded-md font-label-md text-label-md transition-all shadow-sm border border-[#E2E8F0]">
                        <span class="material-symbols-outlined text-[18px]">download</span>
                        Export Summary
                    </a>
                    <a asp-action="Create" style="background-color: #e24d17;" class="flex items-center gap-2 px-4 py-2 rounded-md font-label-md text-label-md text-white shadow-sm transition-all hover:opacity-95">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        New Document
                    </a>
                </div>
            </div>
            <div class="bg-white rounded-lg border border-[#E2E8F0] p-4 mb-6 shadow-sm w-full">
                <form asp-action="Index" method="get" class="flex flex-col md:flex-row gap-4 items-end w-full">
                    <div class="flex-1 w-full">
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1">Search (Serial Number / Notes)</label>
                        <div class="relative w-full">
                            <span class="material-symbols-outlined absolute left-3 top-2.5 text-secondary text-[20px]">search</span>
                            <input name="searchTerm" value="@Context.Request.Query["searchTerm"]" class="w-full pl-10 pr-3 py-2 border border-[#E2E8F0] rounded-md font-body-md text-body-md focus-ring text-on-surface bg-surface-bright" placeholder="Enter serial or partial notes..." type="text">
                        </div>
                    </div>
                    <div class="w-full md:w-64">
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1">Document Type</label>
                        <select name="documentTypeId" asp-items="ViewBag.DocumentTypes" class="w-full px-3 py-2 border border-[#E2E8F0] rounded-md font-body-md text-body-md focus-ring text-on-surface bg-surface-bright appearance-none">
                            <option value="">-- All Types --</option>
                        </select>
                    </div>
                    <button type="submit" class="w-full md:w-auto px-6 py-2 bg-secondary-container hover:bg-surface-variant text-on-surface rounded-md font-label-md text-label-md flex items-center justify-center gap-2 transition-colors border border-[#E2E8F0]">
                        <span class="material-symbols-outlined text-[18px]">filter_list</span>
                        Filter
                    </button>
                </form>
            </div>
            <div class="bg-white rounded-lg border border-[#E2E8F0] overflow-hidden shadow-sm flex flex-col min-h-[400px] w-full">
                <div class="grid grid-cols-6 gap-4 p-4 bg-surface-container-low border-b border-[#E2E8F0] w-full">
                    <div class="font-label-md text-label-md text-on-surface-variant col-span-1">Serial / Doc #</div>
                    <div class="font-label-md text-label-md text-on-surface-variant col-span-1">Document Type</div>
                    <div class="font-label-md text-label-md text-on-surface-variant col-span-1">Action Date</div>
                    <div class="font-label-md text-label-md text-on-surface-variant col-span-1">Creation Date</div>
                    <div class="font-label-md text-label-md text-on-surface-variant col-span-1">Notes</div>
                    <div class="font-label-md text-label-md text-on-surface-variant col-span-1 text-right">Options</div>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="divide-y divide-[#E2E8F0] w-full">
                        @foreach (var item in Model)
                        {
                            <div class="grid grid-cols-6 gap-4 p-4 items-center w-full hover:bg-surface-bright transition-colors">
                                <div class="font-mono-data text-mono-data text-on-surface col-span-1 truncate">
                                    @(string.IsNullOrEmpty(item.DocumentNumber) ? "N/A" : item.DocumentNumber)
                                </div>
                                <div class="font-body-md text-body-md text-on-surface col-span-1">
                                    @(item.DocumentType?.DisplayName ?? "N/A")
                                </div>
                                <div class="font-body-md text-body-md text-secondary col-span-1">
                                    @item.ActionDate.ToString("yyyy-MM-dd")
                                </div>
                                <div class="font-body-md text-body-md text-secondary col-span-1">
                                    @item.CreatedAt.ToString("yyyy-MM-dd")
                                </div>
                                <div class="font-body-md text-body-md text-secondary col-span-1 truncate" title="@item.Notes">
                                    @(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)
                                </div>
                                <div class="font-body-md text-body-md col-span-1 text-right flex items-center justify-end gap-2">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this document?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-error hover:opacity-80 transition-opacity p-1" title="Delete">
                                            <span class="material-symbols-outlined text-[20px]">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex-1 flex flex-col items-center justify-center p-12 text-center bg-surface-bright w-full">
                        <div class="w-16 h-16 bg-surface-container rounded-full flex items-center justify-center mb-4">
                            <span class="material-symbols-outlined text-4xl text-secondary">description</span>
                        </div>
                        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">No documents found</h3>
                        <p class="font-body-md text-body-md text-secondary max-w-md">
                            No documents match the current search criteria. Try adjusting your filters or search terms.
                        </p>
                    </div>
                }
            </div>
        </div>
    </main>

</body>
</html>