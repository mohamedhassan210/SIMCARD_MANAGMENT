@model DocumentCreateViewModel
@{
    ViewData["Title"] = "إنشاء مستند جديد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4" dir="rtl">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">@ViewData["Title"]</h2>

            <form id="documentForm" method="post" asp-action="Create" asp-controller="Document" novalidate>
                @Html.AntiForgeryToken()

                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">اختيار المستند ومزود الخدمة</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DocumentTypeId" class="form-label">نوع المستند</label>
                                <select asp-for="DocumentTypeId" asp-items="Model.DocumentTypes" class="form-select" required>
                                    <option value="">-- اختر نوع المستند --</option>
                                </select>
                                <span asp-validation-for="DocumentTypeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ServiceProviderId" class="form-label">مزود الخدمة</label>
                                <select asp-for="ServiceProviderId" asp-items="Model.ServiceProviders" class="form-select" required>
                                    <option value="">-- اختر مزود الخدمة --</option>
                                </select>
                                <span asp-validation-for="ServiceProviderId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ActionDate" class="form-label">تاريخ الإجراء</label>
                                <input asp-for="ActionDate" type="datetime-local" class="form-control" required>
                                <span asp-validation-for="ActionDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DocumentNumber" class="form-label">رقم المستند</label>
                                <input asp-for="DocumentNumber" type="text" class="form-control" required>
                                <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Notes" class="form-label">ملاحظات</label>
                                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SignatureType" class="form-label">نوع التوقيع</label>
                                <input asp-for="SignatureType" type="text" class="form-control" placeholder="مثل: توقيع رقمي">
                                <span asp-validation-for="SignatureType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SignatureData" class="form-label">بيانات التوقيع</label>
                                <input asp-for="SignatureData" type="text" class="form-control">
                                <span asp-validation-for="SignatureData" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">إضافة الأجهزة</h5>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-end">
                            <div class="col-md-4 mb-3">
                                <label for="deviceTypeSelect" class="form-label">نوع الجهاز</label>
                                <select id="deviceTypeSelect" class="form-select">
                                    <option value="">-- اختر نوع الجهاز --</option>
                                    <option value="SIM">شريحة SIM</option>
                                    <option value="USB">جهاز USB</option>
                                </select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="quantityInput" class="form-label">الكمية</label>
                                <input id="quantityInput" type="number" class="form-control" min="1" value="1">
                            </div>

                            <div class="col-md-4 mb-3">
                                <button type="button" id="addDeviceBtn" class="btn btn-success w-100">
                                    <i class="bi bi-plus"></i> إضافة
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">بيانات الأجهزة</h5>
                    </div>
                    <div class="card-body">
                        <div id="simSection" class="mb-5">
                            <h6 class="text-primary mb-3">بيانات شرائح SIM</h6>
                            <div id="simContainer" class="row">
                            </div>
                        </div>

                        <div id="usbSection" class="mb-5">
                            <h6 class="text-success mb-3">بيانات أجهزة USB</h6>
                            <div id="usbContainer" class="row">
                            </div>
                        </div>
                    </div>
                </div>

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-save"></i> حفظ المستند
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg w-100 mt-2">الرجوع</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Track row counts
        let simRowCount = 0;
        let usbRowCount = 0;

        // Add Device button handler
        document.getElementById('addDeviceBtn').addEventListener('click', function () {
            const deviceType = document.getElementById('deviceTypeSelect').value;
            const quantity = parseInt(document.getElementById('quantityInput').value) || 0;

            if (!deviceType) {
                alert('يرجى اختيار نوع الجهاز');
                return;
            }

            if (quantity < 1) {
                alert('يرجى إدخال كمية صحيحة');
                return;
            }

            if (deviceType === 'SIM') {
                addSimRows(quantity);
            } else if (deviceType === 'USB') {
                addUsbRows(quantity);
            }

            // Reset selection input
            document.getElementById('deviceTypeSelect').value = '';
            document.getElementById('quantityInput').value = '1';
        });

        // Add SIM Rows
        function addSimRows(quantity) {
            const container = document.getElementById('simContainer');

            for (let i = 0; i < quantity; i++) {
                const rowHtml = `
                    <div class="col-md-6 mb-4 sim-row" data-index="${simRowCount}">
                        <div class="card border-info">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>شريحة SIM #${simRowCount + 1}</span>
                                <button type="button" class="btn btn-sm btn-danger btn-close-row" onclick="removeRow('sim', ${simRowCount})">
                                    <i class="bi bi-trash"></i> إزالة
                                </button>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">السيريال (ICCID)</label>
                                    <input type="text" name="Sims[${simRowCount}].SerialNumber" class="form-control" required placeholder="أدخل رقم السيريال">
                                    <div class="invalid-feedback">السيريال مطلوب</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">رقم الهاتف</label>
                                    <input type="text" name="Sims[${simRowCount}].PhoneNumber" class="form-control" required placeholder="أدخل رقم الهاتف">
                                    <div class="invalid-feedback">رقم الهاتف مطلوب</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">نوع الشبكة</label>
                                    <select name="Sims[${simRowCount}].NetworkType" class="form-select" required>
                                        <option value="">-- اختر نوع الشبكة --</option>
                                        <option value="4G">4G</option>
                                        <option value="5G">5G</option>
                                    </select>
                                    <div class="invalid-feedback">نوع الشبكة مطلوب</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', rowHtml);
                simRowCount++;
            }
        }

        // Add USB Rows
        function addUsbRows(quantity) {
            const container = document.getElementById('usbContainer');

            for (let i = 0; i < quantity; i++) {
                const rowHtml = `
                    <div class="col-md-6 mb-4 usb-row" data-index="${usbRowCount}">
                        <div class="card border-success">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>جهاز USB #${usbRowCount + 1}</span>
                                <button type="button" class="btn btn-sm btn-danger btn-close-row" onclick="removeRow('usb', ${usbRowCount})">
                                    <i class="bi bi-trash"></i> إزالة
                                </button>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">السيريال</label>
                                    <input type="text" name="Usbs[${usbRowCount}].SerialNumber" class="form-control" required placeholder="أدخل رقم السيريال">
                                    <div class="invalid-feedback">السيريال مطلوب</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">الموديل</label>
                                    <input type="text" name="Usbs[${usbRowCount}].Model" class="form-control" required placeholder="أدخل موديل الجهاز">
                                    <div class="invalid-feedback">الموديل مطلوب</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', rowHtml);
                usbRowCount++;
            }
        }

        // Remove Row Functionality
        function removeRow(type, index) {
            const rowElement = document.querySelector(`.${type}-row[data-index="${index}"]`);
            if (rowElement) {
                rowElement.remove();
            }
            reindexRows();
        }

        // Re-index row input names for correct Model Binding post-deletion
        function reindexRows() {
            // Re-index SIM rows
            document.querySelectorAll('.sim-row').forEach((row, index) => {
                row.setAttribute('data-index', index);
                const titleSpan = row.querySelector('.card-header span');
                if (titleSpan) titleSpan.textContent = `شريحة SIM #${index + 1}`;

                const closeBtn = row.querySelector('.btn-close-row');
                if (closeBtn) closeBtn.setAttribute('onclick', `removeRow('sim', ${index})`);

                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.includes('.')) {
                        const fieldName = name.split('.')[1];
                        input.setAttribute('name', `Sims[${index}].${fieldName}`);
                    }
                });
            });
            simRowCount = document.querySelectorAll('.sim-row').length;

            // Re-index USB rows
            document.querySelectorAll('.usb-row').forEach((row, index) => {
                row.setAttribute('data-index', index);
                const titleSpan = row.querySelector('.card-header span');
                if (titleSpan) titleSpan.textContent = `جهاز USB #${index + 1}`;

                const closeBtn = row.querySelector('.btn-close-row');
                if (closeBtn) closeBtn.setAttribute('onclick', `removeRow('usb', ${index})`);

                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.includes('.')) {
                        const fieldName = name.split('.')[1];
                        input.setAttribute('name', `Usbs[${index}].${fieldName}`);
                    }
                });
            });
            usbRowCount = document.querySelectorAll('.usb-row').length;
        }

        // Form Submission & HTML5 Validation
        document.getElementById('documentForm').addEventListener('submit', function (event) {
            // Check HTML5 validity
            if (!this.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }

            // Ensure at least one device is added
            const simRows = document.querySelectorAll('.sim-row').length;
            const usbRows = document.querySelectorAll('.usb-row').length;

            if (simRows === 0 && usbRows === 0) {
                event.preventDefault();
                event.stopPropagation();
                alert('يجب إضافة جهاز واحد على الأقل (SIM أو USB)');
                return false;
            }

            this.classList.add('was-validated');
        });

        // Allow pressing Enter in quantity input to add devices
        document.getElementById('quantityInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('addDeviceBtn').click();
            }
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}