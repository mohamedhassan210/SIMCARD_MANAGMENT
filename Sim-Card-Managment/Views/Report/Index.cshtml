@model IEnumerable<Sim_Card_Managment.Models.Subscription>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-color: #f4f5f6;
            --brand-orange: #e55026;
            --brand-orange-hover: #d1421c;
            --text-dark: #111111;
            --text-muted: #6b7280;
            --excel-green: #157347;
            --border-color: #e5e7eb;
        }

        body {
            background-color: var(--bg-color);
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            padding: 2rem 0;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            color: #4b5563;
            max-width: 500px;
            font-size: 1rem;
            line-height: 1.5;
            margin-bottom: 2.5rem;
        }

        .report-card {
            background-color: #ffffff;
            border-radius: 16px;
            border: none;
            padding: 1.75rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .icon-box {
            width: 36px;
            height: 36px;
            background-color: #fbeae5;
            color: var(--brand-orange);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin-bottom: 1.25rem;
        }

        .report-card .card-title {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.4rem;
        }

        .report-card .card-text {
            color: var(--text-muted);
            font-size: 0.88rem;
            line-height: 1.45;
            margin-bottom: 1.25rem;
        }

        .card-filters {
            margin-bottom: 1.25rem;
            flex-grow: 1;
        }

        .card-filter-row {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.6rem;
            flex-wrap: wrap;
        }

        .card-filter-field {
            flex: 1;
            min-width: 100px;
        }

        .card-filter-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-bottom: 0.2rem;
            display: block;
        }

        .card-filter-input {
            width: 100%;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.4rem 0.6rem;
            font-size: 0.85rem;
            color: var(--text-dark);
            background-color: #fff;
        }

            .card-filter-input:focus {
                outline: none;
                border-color: var(--brand-orange);
            }

        .card-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-top: auto;
        }

        .btn-view-online {
            background-color: var(--brand-orange);
            color: white;
            border-radius: 50px;
            padding: 0.55rem 1.25rem;
            font-weight: 600;
            font-size: 0.88rem;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            white-space: nowrap;
        }

            .btn-view-online:hover {
                background-color: var(--brand-orange-hover);
                color: white;
            }

        .btn-icon-outline {
            border: 1px solid var(--excel-green);
            color: var(--excel-green);
            background: transparent;
            border-radius: 50%;
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transition: all 0.2s;
            text-decoration: none;
            flex-shrink: 0;
            cursor: pointer;
        }

            .btn-icon-outline:hover {
                background-color: #e7f3ec;
                color: var(--excel-green);
            }

        .btn-download-full {
            background-color: var(--excel-green);
            color: white;
            border-radius: 50px;
            padding: 0.55rem 1.25rem;
            font-weight: 600;
            font-size: 0.88rem;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            cursor: pointer;
            width: 100%;
            justify-content: center;
        }

            .btn-download-full:hover {
                background-color: #115e3a;
                color: white;
            }

        .card-note {
            font-size: 0.75rem;
            color: #9ca3af;
            margin-top: 0.5rem;
        }
    </style>
</head>
<body>

    <div class="container p-100">

        <div class="mb-5">
            <h1 class="page-title">Reports</h1>
            <p class="page-subtitle">Every exportable report in one place. Set the filters on a card and download — each report keeps its own filter set.</p>
        </div>

        <div class="row g-4">

            <!-- ============================================= -->
            <!-- SUBSCRIPTIONS -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-device-hdd-fill"></i></div>
                    <h3 class="card-title">Subscriptions</h3>
                    <p class="card-text">Every subscription with subscriber, device, quota, and fee details.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Status</label>
                                <select id="sub-status" class="card-filter-input">
                                    <option value="ALL">All</option>
                                    <option value="Active">Active</option>
                                    <option value="Expired">Expired</option>
                                </select>
                            </div>
                        </div>
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">From</label>
                                <input type="date" id="sub-from" class="card-filter-input">
                            </div>
                            <div class="card-filter-field">
                                <label class="card-filter-label">To</label>
                                <input type="date" id="sub-to" class="card-filter-input">
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="view-subscriptions" target="_blank" class="btn-view-online">View online <i class="bi bi-eye"></i></a>
                        <a href="#" id="export-subscriptions" class="btn-icon-outline" title="Download Excel"><i class="bi bi-file-earmark-spreadsheet-fill"></i></a>
                    </div>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- EMPLOYEES & NON-EMPLOYEES -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-person-fill"></i></div>
                    <h3 class="card-title">Employees &amp; Non-Employees</h3>
                    <p class="card-text">Full directory with assigned SIM/USB counts.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Status</label>
                                <select id="emp-status" class="card-filter-input">
                                    <option value="all">All</option>
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                            <div class="card-filter-field">
                                <label class="card-filter-label">Type</label>
                                <select id="emp-type" class="card-filter-input">
                                    <option value="all">All</option>
                                    <option value="employee">Employee</option>
                                    <option value="non-employee">Non-Employee</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-employees" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- DEVICE DIRECTORY -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-sim-fill"></i></div>
                    <h3 class="card-title">Device Directory (SIM + USB)</h3>
                    <p class="card-text">All SIM cards and USB modems, availability, and assignment.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Availability</label>
                                <select id="dev-status" class="card-filter-input">
                                    <option value="all">All</option>
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                            <div class="card-filter-field">
                                <label class="card-filter-label">Device Type</label>
                                <select id="dev-type" class="card-filter-input">
                                    <option value="all">All</option>
                                    <option value="sim">SIM</option>
                                    <option value="usb">USB</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-devices" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                    <p class="card-note">Status Type filter omitted — values aren't fixed/known at build time.</p>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- DEVICE STATUS LOG -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-clock-history"></i></div>
                    <h3 class="card-title">Device Status Log</h3>
                    <p class="card-text">Every status change recorded for SIMs and USBs.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Availability</label>
                                <select id="dsl-availability" class="card-filter-input">
                                    <option value="">All</option>
                                    <option value="Active">Active</option>
                                    <option value="Not Active">Not Active</option>
                                </select>
                            </div>
                            <div class="card-filter-field">
                                <label class="card-filter-label">Device Type</label>
                                <select id="dsl-type" class="card-filter-input">
                                    <option value="">All</option>
                                    <option value="SIM Card">SIM Card</option>
                                    <option value="USB Modem">USB Modem</option>
                                </select>
                            </div>
                        </div>
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">From</label>
                                <input type="date" id="dsl-from" class="card-filter-input">
                            </div>
                            <div class="card-filter-field">
                                <label class="card-filter-label">To</label>
                                <input type="date" id="dsl-to" class="card-filter-input">
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-device-status" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- BRANCHES -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-diagram-3-fill"></i></div>
                    <h3 class="card-title">Branches</h3>
                    <p class="card-text">Branch directory with VPN status and connection counts.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Status</label>
                                <select id="branch-status" class="card-filter-input">
                                    <option value="all">All</option>
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-branches" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- VPN CONNECTIONS -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-hdd-network-fill"></i></div>
                    <h3 class="card-title">VPN Connections</h3>
                    <p class="card-text">VPN leased-line status per branch, with firewall types.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Search</label>
                                <input type="text" id="vpn-search" class="card-filter-input" placeholder="Branch, provider, NID...">
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-vpn" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                    <p class="card-note">No status filter — the export action doesn't support one today.</p>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- INTERNET LINES -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-wifi"></i></div>
                    <h3 class="card-title">Internet Lines</h3>
                    <p class="card-text">Every internet line per branch — ISP, renewal date, quota, status.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Search</label>
                                <input type="text" id="internet-search" class="card-filter-input" placeholder="Branch, ISP, phone...">
                            </div>
                        </div>
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Status</label>
                                <select id="internet-status" class="card-filter-input">
                                    <option value="all">All</option>
                                    <option value="up">Up</option>
                                    <option value="down">Down</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-internet" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- QUOTAS -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-pie-chart-fill"></i></div>
                    <h3 class="card-title">Quotas</h3>
                    <p class="card-text">All data quota plans, base/extra amounts, and fees.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Status</label>
                                <select id="quota-status" class="card-filter-input">
                                    <option value="all">All</option>
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-quotas" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- GROUPS -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-people-fill"></i></div>
                    <h3 class="card-title">Groups</h3>
                    <p class="card-text">Permission groups and their active status.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Status</label>
                                <select id="group-status" class="card-filter-input">
                                    <option value="">All</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-groups" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- USERS -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-person-badge-fill"></i></div>
                    <h3 class="card-title">Users</h3>
                    <p class="card-text">System user accounts, groups, and active status.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Status</label>
                                <select id="user-status" class="card-filter-input">
                                    <option value="">All</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-users" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- DOCUMENTS SUMMARY -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-file-earmark-text-fill"></i></div>
                    <h3 class="card-title">Documents Summary</h3>
                    <p class="card-text">Document transactions with SIM/USB counts per document.</p>

                    <div class="card-filters">
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">Search</label>
                                <input type="text" id="doc-search" class="card-filter-input" placeholder="Doc number, notes...">
                            </div>
                        </div>
                        <div class="card-filter-row">
                            <div class="card-filter-field">
                                <label class="card-filter-label">From</label>
                                <input type="date" id="doc-from" class="card-filter-input">
                            </div>
                            <div class="card-filter-field">
                                <label class="card-filter-label">To</label>
                                <input type="date" id="doc-to" class="card-filter-input">
                            </div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="#" id="export-documents" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                    <p class="card-note">Document Type filter omitted — needs the type list wired in.</p>
                </div>
            </div>

            <!-- ============================================= -->
            <!-- HARDWARE LIFECYCLE -->
            <!-- ============================================= -->
            <div class="col-md-4">
                <div class="report-card">
                    <div class="icon-box"><i class="bi bi-box-seam-fill"></i></div>
                    <h3 class="card-title">Hardware Lifecycle</h3>
                    <p class="card-text">Full inventory lifecycle report — no filters currently.</p>

                    <div class="card-filters"></div>

                    <div class="card-actions">
                        <a asp-controller="Document" asp-action="ExportInventoryToExcel" class="btn-download-full"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Excel</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Reads each filter's current value only at click time (never
            // cached), skips anything empty/"all"/"ALL", and navigates —
            // same pattern as Subscription/Index.cshtml and DeviceStatus/Index.cshtml.
            function wireExport(btnId, actionUrl, filters, opts) {
                var btn = document.getElementById(btnId);
                if (!btn) return;

                btn.addEventListener('click', function (e) {
                    e.preventDefault();

                    var url = new URL(actionUrl, window.location.origin);

                    filters.forEach(function (f) {
                        var el = document.getElementById(f.id);
                        if (!el) return;

                        var val = el.value;
                        var skip = f.skipValues || ['all', 'ALL', ''];

                        if (val && skip.indexOf(val) === -1) {
                            url.searchParams.set(f.param, val);
                        }
                    });

                    if (opts && opts.newTab) {
                        window.open(url.toString(), '_blank');
                    } else {
                        window.location.href = url.toString();
                    }
                });
            }

            // ---- Subscriptions ----
            var subFilters = [
                { id: 'sub-status', param: 'status' },
                { id: 'sub-from', param: 'from' },
                { id: 'sub-to', param: 'to' }
            ];
            wireExport('export-subscriptions', '@Url.Action("ExportSubscriptionsExcel", "Report")', subFilters);
            wireExport('view-subscriptions', '@Url.Action("ViewSubscriptionsOnline", "Report")', subFilters, { newTab: true });

            // ---- Employees & Non-Employees ----
            wireExport('export-employees', '@Url.Action("ExportEmployeeExcel", "Employee")', [
                { id: 'emp-status', param: 'status' },
                { id: 'emp-type', param: 'type' }
            ]);

            // ---- Device Directory ----
            wireExport('export-devices', '@Url.Action("ExportDevicesExcel", "SIM")', [
                { id: 'dev-status', param: 'status' },
                { id: 'dev-type', param: 'type' }
            ]);

            // ---- Device Status Log ----
            wireExport('export-device-status', '@Url.Action("ExportDeviceStatusExcel", "DeviceStatus")', [
                { id: 'dsl-availability', param: 'isActive', skipValues: [''], },
                { id: 'dsl-type', param: 'deviceType' },
                { id: 'dsl-from', param: 'from' },
                { id: 'dsl-to', param: 'to' }
            ]);

            // ---- Branches ----
            wireExport('export-branches', '@Url.Action("ExportBranchesExcel", "Branch")', [
                { id: 'branch-status', param: 'status' }
            ]);

            // ---- VPN Connections ----
            wireExport('export-vpn', '@Url.Action("ExportToExcel", "VpnConnection")', [
                { id: 'vpn-search', param: 'searchTerm' }
            ]);

            // ---- Internet Lines ----
            wireExport('export-internet', '@Url.Action("ExportToExcel", "InternetLine")', [
                { id: 'internet-search', param: 'searchTerm' },
                { id: 'internet-status', param: 'status' }
            ]);

            // ---- Quotas ----
            wireExport('export-quotas', '@Url.Action("ExportQuotasExcel", "Quota")', [
                { id: 'quota-status', param: 'status' }
            ]);

            // ---- Groups ----
            wireExport('export-groups', '@Url.Action("ExportGroupsExcel", "Group")', [
                { id: 'group-status', param: 'isActive' }
            ]);

            // ---- Users ----
            wireExport('export-users', '@Url.Action("ExportUsersExcel", "Account")', [
                { id: 'user-status', param: 'isActive' }
            ]);

            // ---- Documents Summary ----
            wireExport('export-documents', '@Url.Action("ExportToExcel", "Document")', [
                { id: 'doc-search', param: 'searchTerm' },
                { id: 'doc-from', param: 'from' },
                { id: 'doc-to', param: 'to' }
            ]);

        });
    </script>
</body>
</html>
