                            <input type="date" id="doc-from" class="card-filter-input">
                        </div>
                        <div class="card-filter-field">
                            <label class="card-filter-label">To</label>
                            <input type="date" id="doc-to" class="card-filter-input">
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-documents" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

    </div>
</div>

@* Fix #7: removed duplicate bootstrap.bundle CDN script — _Layout.cshtml already loads it *@

<script>
    document.addEventListener('DOMContentLoaded', function () {

        // Reads each filter's current value only at click time (never
        // cached), skips anything empty/"all"/"ALL", and navigates.
        function wireExport(btnId, actionUrl, filters, opts) {
            var btn = document.getElementById(btnId);
            if (!btn) return;

            btn.addEventListener('click', function (e) {
                e.preventDefault();

                var url = new URL(actionUrl, window.location.origin);

                filters.forEach(function (f) {
                    var el = document.getElementById(f.id);
                    if (!el) return;

                    var val = el.value;
                    var skip = f.skipValues || ['all', 'ALL', ''];

                    if (val && skip.indexOf(val) === -1) {
                        url.searchParams.set(f.param, val);
                    }
                });

                if (opts && opts.newTab) {
                    window.open(url.toString(), '_blank');
                } else {
                    window.location.href = url.toString();
                }
            });
        }

        // ---- Subscriptions ----
        wireExport('export-subscriptions', '@Url.Action("ExportSubscriptionsExcel", "Report")', [
            { id: 'sub-status', param: 'status' },
            { id: 'sub-from',   param: 'from'   },
            { id: 'sub-to',     param: 'to'     }
        ]);

        // ---- Employees & Non-Employees ----
        wireExport('export-employees', '@Url.Action("ExportEmployeeExcel", "Employee")', [
            { id: 'emp-status', param: 'status' },
            { id: 'emp-type',   param: 'type'   }
        ]);

        // ---- Device Directory ----
        wireExport('export-devices', '@Url.Action("ExportDevicesExcel", "SIM")', [
            { id: 'dev-status',      param: 'status'     },
            { id: 'dev-type',        param: 'type'       },
            { id: 'dev-status-type', param: 'statusType' }
        ]);

        // ---- Device Status Log ----
        // isActive param is bool? — values "true"/"false" bind correctly; empty string ("All") is skipped.
        wireExport('export-device-status', '@Url.Action("ExportDeviceStatusExcel", "DeviceStatus")', [
            { id: 'dsl-availability', param: 'isActive',   skipValues: [''] },
            { id: 'dsl-type',         param: 'deviceType', skipValues: [''] },
            { id: 'dsl-from',         param: 'from' },
            { id: 'dsl-to',           param: 'to'   }
        ]);

        // ---- Branches ----
        wireExport('export-branches', '@Url.Action("ExportBranchesExcel", "Branch")', [
            { id: 'branch-status', param: 'status' }
        ]);

        // ---- VPN Connections ----
        // status values "up"/"down" match what VpnConnection/Index already sends to ExportToExcel
        wireExport('export-vpn', '@Url.Action("ExportToExcel", "VpnConnection")', [
            { id: 'vpn-search', param: 'searchTerm' },
            { id: 'vpn-status', param: 'status'     }
        ]);

        // ---- Internet Lines ----
        wireExport('export-internet', '@Url.Action("ExportToExcel", "InternetLine")', [
            { id: 'internet-search', param: 'searchTerm' },
            { id: 'internet-status', param: 'status'     }
        ]);

        // ---- Quotas ----
        wireExport('export-quotas', '@Url.Action("ExportQuotasExcel", "Quota")', [
            { id: 'quota-status', param: 'status' }
        ]);

        // ---- Groups ----
        wireExport('export-groups', '@Url.Action("ExportGroupsExcel", "Group")', [
            { id: 'group-status', param: 'isActive' }
        ]);

        // ---- Users ----
        wireExport('export-users', '@Url.Action("ExportUsersExcel", "Account")', [
            { id: 'user-status', param: 'isActive' }
        ]);

        // ---- Documents Summary ----
        wireExport('export-documents', '@Url.Action("ExportToExcel", "Document")', [
            { id: 'doc-search', param: 'searchTerm' },
            { id: 'doc-from',   param: 'from'       },
            { id: 'doc-to',     param: 'to'         }
        ]);

    });
</script>
