@* No @model — this is a hub page; no model data is used here *@

@{
    ViewData["Title"] = "Reports";
}

<style>
    :root {
        --bg-color: #f4f5f6;
        --brand-orange: #e55026;
        --brand-orange-hover: #d1421c;
        --text-dark: #111111;
        --text-muted: #6b7280;
        --excel-green: #157347;
        --border-color: #e5e7eb;
    }

    body {
        background-color: var(--bg-color);
        font-family: 'Inter', sans-serif;
        color: var(--text-dark);
        padding: 2rem 0;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #4b5563;
        max-width: 500px;
        font-size: 1rem;
        line-height: 1.5;
        /* Fix #6: was 2.5rem — too much whitespace before the first cards */
        margin-bottom: 1.75rem;
    }

    .report-card {
        background-color: #ffffff;
        border-radius: 16px;
        border: none;
        padding: 1.75rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .icon-box {
        width: 36px;
        height: 36px;
        background-color: #fbeae5;
        color: var(--brand-orange);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 1.25rem;
    }

    .report-card .card-title {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 0.4rem;
    }

    .report-card .card-text {
        color: var(--text-muted);
        font-size: 0.88rem;
        line-height: 1.45;
        margin-bottom: 1.25rem;
    }

    .card-filters {
        margin-bottom: 1.25rem;
        flex-grow: 1;
        /* Keeps Download Excel buttons level across cards with different filter counts */
        min-height: 7.5rem;
    }

    .card-filter-row {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.6rem;
        flex-wrap: wrap;
    }

    .card-filter-field {
        flex: 1;
        min-width: 100px;
    }

    .card-filter-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 0.2rem;
        display: block;
    }

    .card-filter-input {
        width: 100%;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.4rem 0.6rem;
        font-size: 0.85rem;
        color: var(--text-dark);
        background-color: #fff;
    }

        .card-filter-input:focus {
            outline: none;
            border-color: var(--brand-orange);
        }

    .card-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: auto;
    }

    .btn-view-online {
        background-color: var(--brand-orange);
        color: white;
        border-radius: 50px;
        padding: 0.55rem 1.25rem;
        font-weight: 600;
        font-size: 0.88rem;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        white-space: nowrap;
    }

        .btn-view-online:hover {
            background-color: var(--brand-orange-hover);
            color: white;
        }

    .btn-icon-outline {
        border: 1px solid var(--excel-green);
        color: var(--excel-green);
        background: transparent;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: all 0.2s;
        text-decoration: none;
        flex-shrink: 0;
        cursor: pointer;
    }

        .btn-icon-outline:hover {
            background-color: #e7f3ec;
            color: var(--excel-green);
        }

    .btn-download-full {
        background-color: var(--excel-green);
        color: white;
        border-radius: 50px;
        padding: 0.55rem 1.25rem;
        font-weight: 600;
        font-size: 0.88rem;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        width: 100%;
        justify-content: center;
    }

        .btn-download-full:hover {
            background-color: #115e3a;
            color: white;
        }


</style>

@* Fix #2/#3: removed <!DOCTYPE>, <html>, <head>, <body> — _Layout.cshtml provides these *@
@* Fix #7: removed duplicate Bootstrap + Bootstrap Icons CDN <link>/<script> tags *@

<div class="container py-4  p-100">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-5">
        <h1 class="page-title">Reports</h1>
        <p class="page-subtitle">Every exportable report in one place. Set the filters on a card and download — each report keeps its own filter set.</p>
    </div>

    <div class="row g-4">

        <!-- ============================================= -->
        <!-- SUBSCRIPTIONS -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-file-invoice"></i></div>
                <h3 class="card-title">Subscriptions</h3>
                <p class="card-text">Every subscription with subscriber, device, quota, and fee details.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Status</label>
                            <select id="sub-status" class="card-filter-input">
                                <option value="ALL">All</option>
                                <option value="Active">Active</option>
                                <option value="Expired">Expired</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">From</label>
                            <input type="date" id="sub-from" class="card-filter-input">
                        </div>
                        <div class="card-filter-field">
                            <label class="card-filter-label">To</label>
                            <input type="date" id="sub-to" class="card-filter-input">
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-subscriptions" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- EMPLOYEES & NON-EMPLOYEES -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-users"></i></div>
                <h3 class="card-title">Employees &amp; Non-Employees</h3>
                <p class="card-text">Full directory with assigned SIM/USB counts.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Status</label>
                            <select id="emp-status" class="card-filter-input">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="card-filter-field">
                            <label class="card-filter-label">Type</label>
                            <select id="emp-type" class="card-filter-input">
                                <option value="all">All</option>
                                <option value="employee">Employee</option>
                                <option value="non-employee">Non-Employee</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-employees" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- DEVICE DIRECTORY -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-sim-card"></i></div>
                <h3 class="card-title">Device Directory (SIM + USB)</h3>
                <p class="card-text">All SIM cards and USB modems, availability, and assignment.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Availability</label>
                            <select id="dev-status" class="card-filter-input">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="card-filter-field">
                            <label class="card-filter-label">Device Type</label>
                            <select id="dev-type" class="card-filter-input">
                                <option value="all">All</option>
                                <option value="sim">SIM</option>
                                <option value="usb">USB</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Device Status</label>
                            @* Values must match d.Status?.ToLower() in SIMController.ExportDevicesExcel *@
                            <select id="dev-status-type" class="card-filter-input">
                                <option value="all">All</option>
                                <option value="occupied">Occupied</option>
                                <option value="unassigned">Unassigned</option>
                                <option value="lost">Lost</option>
                                <option value="replaced">Replaced</option>
                                <option value="returned">Returned</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-devices" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- DEVICE STATUS LOG -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-tower-broadcast"></i></div>
                <h3 class="card-title">Device Status Log</h3>
                <p class="card-text">Every status change recorded for SIMs and USBs.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Availability</label>
                            @* Controller param is bool? isActive — values must be "true"/"false" to bind correctly *@
                            <select id="dsl-availability" class="card-filter-input">
                                <option value="">All</option>
                                <option value="true">Active</option>
                                <option value="false">Not Active</option>
                            </select>
                        </div>
                        <div class="card-filter-field">
                            <label class="card-filter-label">Device Type</label>
                            <select id="dsl-type" class="card-filter-input">
                                <option value="">All</option>
                                <option value="SIM Card">SIM Card</option>
                                <option value="USB Modem">USB Modem</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">From</label>
                            <input type="date" id="dsl-from" class="card-filter-input">
                        </div>
                        <div class="card-filter-field">
                            <label class="card-filter-label">To</label>
                            <input type="date" id="dsl-to" class="card-filter-input">
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-device-status" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- BRANCHES -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-code-branch"></i></div>
                <h3 class="card-title">Branches</h3>
                <p class="card-text">Branch directory with VPN status and connection counts.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Status</label>
                            <select id="branch-status" class="card-filter-input">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-branches" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- VPN CONNECTIONS -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-network-wired"></i></div>
                <h3 class="card-title">VPN Connections</h3>
                <p class="card-text">VPN leased-line status per branch, with firewall types.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Search</label>
                            <input type="text" id="vpn-search" class="card-filter-input" placeholder="Branch, provider, NID...">
                        </div>
                    </div>
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Status</label>
                            <select id="vpn-status" class="card-filter-input">
                                <option value="ALL">All</option>
                                <option value="up">Up</option>
                                <option value="down">Down</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-vpn" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- INTERNET LINES -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-globe"></i></div>
                <h3 class="card-title">Internet Lines</h3>
                <p class="card-text">Every internet line per branch — ISP, renewal date, quota, status.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Search</label>
                            <input type="text" id="internet-search" class="card-filter-input" placeholder="Branch, ISP, phone...">
                        </div>
                    </div>
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Status</label>
                            <select id="internet-status" class="card-filter-input">
                                <option value="all">All</option>
                                <option value="up">Up</option>
                                <option value="down">Down</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-internet" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- QUOTAS -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-database"></i></div>
                <h3 class="card-title">Quotas</h3>
                <p class="card-text">All data quota plans, base/extra amounts, and fees.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Status</label>
                            <select id="quota-status" class="card-filter-input">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-quotas" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- GROUPS -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-user-group"></i></div>
                <h3 class="card-title">Groups</h3>
                <p class="card-text">Permission groups and their active status.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Status</label>
                            <select id="group-status" class="card-filter-input">
                                <option value="">All</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-groups" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- USERS -->
        <!-- ============================================= -->
        <div class="col-md-4">
            <div class="report-card">
                <div class="icon-box"><i class="fa-solid fa-user"></i></div>
                <h3 class="card-title">Users</h3>
                <p class="card-text">System user accounts, groups, and active status.</p>

                <div class="card-filters">
                    <div class="card-filter-row">
                        <div class="card-filter-field">
                            <label class="card-filter-label">Status</label>
                            <select id="user-status" class="card-filter-input">
                                <option value="">All</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="#" id="export-users" class="btn-download-full"><i class="fa-solid fa-file-excel"></i> Download Excel</a>
                </div>
