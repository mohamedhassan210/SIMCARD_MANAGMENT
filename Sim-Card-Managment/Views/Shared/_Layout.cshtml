@{
    // Get the current controller and action from the route
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sim_Card_Managment</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Sim_Card_Managment.styles.css"  />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/all.min.css" />

</head>
<body>
    <div class="position-fixed top-50 start-0 bg-white z-3 d-flex justify-content-center align-items-center shadow "
         style="height: 40px; width: 40px; cursor: pointer; border-radius: 0 8px 8px 0; z-index:1000"
         data-bs-toggle="offcanvas" data-bs-target="#leftSidebar" aria-controls="leftSidebar">

        <svg class="animate-spin text-dark svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.991,10H19.42a1.039,1.039,0,0,1-.951-.674l-.005-.013a1.04,1.04,0,0,1,.2-1.146l1.11-1.11a1.01,1.01,0,0,0,0-1.428l-1.4-1.4a1.01,1.01,0,0,0-1.428,0l-1.11,1.11a1.04,1.04,0,0,1-1.146.2l-.013,0A1.04,1.04,0,0,1,14,4.579V3.009A1.009,1.009,0,0,0,12.991,2H11.009A1.009,1.009,0,0,0,10,3.009v1.57a1.04,1.04,0,0,1-.674.952l-.013,0a1.04,1.04,0,0,1-1.146-.2l-1.11-1.11a1.01,1.01,0,0,0-1.428,0l-1.4,1.4a1.01,1.01,0,0,0,0,1.428l1.11,1.11a1.04,1.04,0,0,1,.2,1.146l0,.013A1.039,1.039,0,0,1,4.58,10H3.009A1.009,1.009,0,0,0,2,11.009v1.982A1.009,1.009,0,0,0,3.009,14H4.58a1.039,1.039,0,0,1,.951.674l0,.013a1.04,1.04,0,0,1-.2,1.146l-1.11,1.11a1.01,1.01,0,0,0,0,1.428l1.4,1.4a1.01,1.01,0,0,0,1.428,0l1.11-1.11a1.04,1.04,0,0,1,1.146-.2l.013.005A1.039,1.039,0,0,1,10,19.42v1.571A1.009,1.009,0,0,0,11.009,22h1.982A1.009,1.009,0,0,0,14,20.991V19.42a1.039,1.039,0,0,1,.674-.951l.013-.005a1.04,1.04,0,0,1,1.146.2l1.11,1.11a1.01,1.01,0,0,0,1.428,0l1.4-1.4a1.01,1.01,0,0,0,0-1.428l-1.11-1.11a1.04,1.04,0,0,1-.2-1.146l.005-.013A1.039,1.039,0,0,1,19.42,14h1.571A1.009,1.009,0,0,0,22,12.991V11.009A1.009,1.009,0,0,0,20.991,10ZM12,15a3,3,0,1,1,3-3A3,3,0,0,1,12,15Z" />
        </svg>
    </div>
    <aside class="offcanvas offcanvas-start bg-black bg-opacity-25  border-end border-secondary glass-box d-flex flex-column" tabindex="-1" id="leftSidebar" aria-labelledby="leftSidebarLabel" data-bs-theme="dark" style="border-radius: 0px 30px 30px 0px">

        

        <div class="offcanvas-header ">

            <button type="button" class="btn-close bg-white d-flex justify-content-center align-items-center " data-bs-dismiss="offcanvas" aria-label="Close">

                <i class="fa-solid fa-x "></i>

            </button>
        </div>

        <div class="accordion sidebar-accordion mx-auto g-5 flex-grow-1 overflow-auto p-3" id="sidebarMenu" style="max-width: 400px ;width: 100%;">

            <div class="accordion-item mb-2">
                <div class="d-flex align-items-center gap-3 sidebar-toggle-btn" data-bs-toggle="collapse" data-bs-target="#collapseUser" aria-expanded="true" style="cursor: pointer;">
                    <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                        <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 6l-6 10h12z" />
                        </svg>
                    </div>
                    <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </svg>
                    </div>
                    <span class="text-white fs-6">User</span>
                </div>

                <div id="collapseUser" class="accordion-collapse collapse show" data-bs-parent="#sidebarMenu">
                    <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                        <a asp-controller="Account" asp-action="Register" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <i class="fa-solid fa-plus "></i>
                            </div>
                            <span class="sub-item-text">Create new user</span>
                        </a>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <img src="~/img/icon-park-outline_permissions.png" alt="Alternate Text" />
                            </div>
                            <span class="sub-item-text">Manage Permissions</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <i class="fa-solid fa-user-group"></i>
                            </div>
                            <span class="sub-item-text">Create new group</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item mb-2">
                <div class="d-flex align-items-center gap-3 sidebar-toggle-btn" data-bs-toggle="collapse"
                     data-bs-target="#collapseSim" aria-expanded="true" style="cursor: pointer;">
                    <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                        <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M12 6l-6 10h12z" />
                        </svg>
                    </div>
                    <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M18 2h-8L4 8v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM7 17h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2zM7 13h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z" />
                        </svg>
                    </div>
                    <span class="text-white fs-6">SIM cards</span>
                </div>

                <div id="collapseSim" class="accordion-collapse collapse show" data-bs-parent="#sidebarMenu">
                    <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                        <a asp-controller="SIM" asp-action="Create" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <img src="~/img/Vector.png" alt="Alternate Text" style="width: 20px" />
                            </div>
                            <span class="sub-item-text">Create new SIM</span>
                        </a>
                        <a asp-controller="SIM" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <img src="~/img/icon-park-outline_permissions.png" alt="Alternate Text" />
                            </div>
                            <span class="sub-item-text">View All Sims</span>
                        </a>

                    </div>
                </div>
            </div>

            <div class="accordion-item mb-2">
                <div class="d-flex align-items-center gap-3 sidebar-toggle-btn" data-bs-toggle="collapse"
                     data-bs-target="#collapseUsb" aria-expanded="true" style="cursor: pointer;">
                    <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                        <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M12 6l-6 10h12z" />
                        </svg>
                    </div>
                    <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                        <img src="~/img/boxicons_usb.png" alt="Alternate Text" style="width: 20px" />
                    </div>
                    <span class="text-white fs-6">USB</span>
                </div>

                <div id="collapseUsb" class="accordion-collapse collapse show" data-bs-parent="#sidebarMenu">
                    <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                        <a asp-controller="USB" asp-action="Create" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <img src="~/img/Vector.png" alt="Alternate Text" style="width: 20px" />
                            </div>
                            <span class="sub-item-text">Create new USB</span>
                        </a>
                        <a asp-controller="USB" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <img src="~/img/icon-park-outline_permissions.png" alt="Alternate Text" />
                            </div>
                            <span class="sub-item-text">View All USBs</span>
                        </a>

                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <div class="d-flex align-items-center gap-3 sidebar-toggle-btn" data-bs-toggle="collapse"
                     data-bs-target="#collapseReport" aria-expanded="true" style="cursor: pointer;">
                    <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                        <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M12 6l-6 10h12z" />
                        </svg>
                    </div>
                    <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                        <i class="fa-solid fa-chart-simple"></i>
                    </div>
                    <span class="text-white fs-6">Report</span>
                </div>

                <div id="collapseReport" class="accordion-collapse collapse show" data-bs-parent="#sidebarMenu">
                    <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                        <a asp-controller="Report" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <i class="fa-solid fa-file-lines"></i>
                            </div>
                            <span class="sub-item-text">View report</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="accordion-item mt-2">
                <div class="d-flex align-items-center gap-3 sidebar-toggle-btn" data-bs-toggle="collapse"
                     data-bs-target="#collapseSubscription" aria-expanded="true" style="cursor: pointer;">
                    <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                        <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M12 6l-6 10h12z" />
                        </svg>
                    </div>
                    <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                        <i class="fa-solid fa-file-invoice"></i>
                    </div>
                    <span class="text-white fs-6">Subscription</span>
                </div>

                <div id="collapseSubscription" class="accordion-collapse collapse show" data-bs-parent="#sidebarMenu">
                    <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                        <a asp-controller="Subscription" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <i class="fa-solid fa-file-lines"></i>
                            </div>
                            <span class="sub-item-text">View subscription</span>
                        </a>
                        <a asp-controller="Subscription" asp-action="Create" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                            <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                            <span class="sub-item-text">Add subscription</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <div class="sidebar-logout-wrapper">
            <button type="button" class="sidebar-logout-btn" id="sidebarLogoutBtn">
                <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </div>
                <span class="sub-item-text">Logout</span>
            </button>
        </div>

    </aside>
    <nav class="position-fixed top-0 navbar navbar-expand-lg w-100 ">
        <div class="container-fluid">
            <a class="navbar-brand text-white fw-bold" asp-controller="home" asp-action="home">
                <img src="~/images/Logo.svg" alt="LOGO" class="logo" />
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav border border-1 border-white rounded-pill p-2 text-white bg-blur">

                    <li class="nav-item">
                        <a class="nav-link fw-bold px-4 text-black @(currentController == "/" && currentAction == "home" ? "active" : "")"
                           asp-controller="/Home" asp-action="home">HOME</a>
                           
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-bold px-4 text-black @(currentController == "SIM" && currentAction == "Index" ? "active" : "")"
                           asp-controller="SIM" asp-action="Index">DEVICES</a>
                    </li>

                   
                    <li class="nav-item">
                        <a class="nav-link fw-bold px-4 text-black @(currentController == "Employee" ? "active" : "")"
                           asp-controller="Employee" asp-action="Index">USERS</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>
    <div class="">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/highcharts.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>