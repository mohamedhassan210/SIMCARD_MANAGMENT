@using Sim_Card_Managment.Services
@inject IUserPermissionService PermissionService
@{
    // Get the current controller and action from the route
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    var isManager = User.IsInRole("Manager");
    var permissionKeys = await PermissionService.GetPermissionKeysAsync();
    Func<string, string, bool> Has = (controller, action) =>
        isManager || permissionKeys.Contains($"{controller}|{action}");

    // Per-item visibility
    var canManageUsers = Has("Account", "ManageUsers");
    var canManagePermissions = Has("Permission", "Index");
    var canViewGroups = Has("Group", "Index");

    var canCreateSim = Has("SIM", "Create");
    var canViewSims = Has("SIM", "Index");

    var canCreateUsb = Has("USB", "Create");
    var canViewUsbs = Has("USB", "Index");

    var canViewDocuments = Has("Document", "Index");
    var canCreateDocument = Has("Document", "Create");

    var canViewServiceProviders = Has("ServiceProvider", "Index");
    var canCreateServiceProvider = Has("ServiceProvider", "Create");

    var canViewReport = Has("Report", "Index");

    var canViewSubscription = Has("Subscription", "Index");
    var canCreateSubscription = Has("Subscription", "Create");


    // Branch
    var canViewBranches = Has("Branch", "Index");
    var canCreateBranch = Has("Branch", "Create");

    // VPN Connection
    var canViewVpnConnections = Has("VpnConnection", "Index");
    var canCreateVpnConnection = Has("VpnConnection", "Create");

    // Internet Line
    var canViewInternetLines = Has("InternetLine", "Index");
    var canCreateInternetLine = Has("InternetLine", "Create");
    var canViewInternetLineDashboard = Has("InternetLine", "Dashboard");
    var canViewServiceTypes = Has("ServiceType", "Index");
    var canViewPaymentTypes = Has("PaymentType", "Index");

    // Device Status
    var canViewDeviceStatuses = Has("DeviceStatus", "Index");

    // Quota
    var canViewQuotas = Has("Quota", "Index");

    // Mail Configuration
    var canViewMailConfigurations = Has("MailConfiguration", "Index");

    // Per-section visibility (header only shows if at least one child is visible)
    var showUserSection = canManageUsers || canManagePermissions || canViewGroups || canViewMailConfigurations;
    var showSimSection = canCreateSim || canViewSims || canViewDeviceStatuses;
    var showUsbSection = canCreateUsb || canViewUsbs;
    var showDocumentSection = canViewDocuments || canCreateDocument;
    var showServiceProviderSection = canViewServiceProviders || canCreateServiceProvider || canViewQuotas;
    var showReportSection = canViewReport;
    var showSubscriptionSection = canViewSubscription || canCreateSubscription;
    var showBranchSection = canViewBranches || canCreateBranch;
    var showVpnConnectionSection = canViewVpnConnections || canCreateVpnConnection;
    var showInternetLineSection = canViewInternetLines || canCreateInternetLine || canViewServiceTypes || canViewPaymentTypes;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SimCard Managment</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/all.min.css" />
    <link href="~/favicon.ico" rel="icon" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />
       
</head>
<body>
    <div id="sidebarToggleHandle" class="rotate position-fixed top-50 start-0 bg-transparent z-3 d-flex justify-content-center align-items-center shadow "
         style="height: 40px; width: 40px; cursor: pointer; border-radius: 0 8px 8px 0; z-index:1000; touch-action: none;"
         aria-controls="leftSidebar">

        <svg class="animate-spin text-dark svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.991,10H19.42a1.039,1.039,0,0,1-.951-.674l-.005-.013a1.04,1.04,0,0,1,.2-1.146l1.11-1.11a1.01,1.01,0,0,0,0-1.428l-1.4-1.4a1.01,1.01,0,0,0-1.428,0l-1.11,1.11a1.04,1.04,0,0,1-1.146.2l-.013,0A1.04,1.04,0,0,1,14,4.579V3.009A1.009,1.009,0,0,0,12.991,2H11.009A1.009,1.009,0,0,0,10,3.009v1.57a1.04,1.04,0,0,1-.674.952l-.013,0a1.04,1.04,0,0,1-1.146-.2l-1.11-1.11a1.01,1.01,0,0,0-1.428,0l-1.4,1.4a1.01,1.01,0,0,0,0,1.428l1.11,1.11a1.04,1.04,0,0,1,.2,1.146l0,.013A1.039,1.039,0,0,1,4.58,10H3.009A1.009,1.009,0,0,0,2,11.009v1.982A1.009,1.009,0,0,0,3.009,14H4.58a1.039,1.039,0,0,1,.951.674l0,.013a1.04,1.04,0,0,1-.2,1.146l-1.11,1.11a1.01,1.01,0,0,0,0,1.428l1.4,1.4a1.01,1.01,0,0,0,1.428,0l1.11-1.11a1.04,1.04,0,0,1,1.146-.2l.013.005A1.039,1.039,0,0,1,10,19.42v1.571A1.009,1.009,0,0,0,11.009,22h1.982A1.009,1.009,0,0,0,14,20.991V19.42a1.039,1.039,0,0,1,.674-.951l.013-.005a1.04,1.04,0,0,1,1.146.2l1.11,1.11a1.01,1.01,0,0,0,1.428,0l1.4-1.4a1.01,1.01,0,0,0,0-1.428l-1.11-1.11a1.04,1.04,0,0,1-.2-1.146l.005-.013A1.039,1.039,0,0,1,19.42,14h1.571A1.009,1.009,0,0,0,22,12.991V11.009A1.009,1.009,0,0,0,20.991,10ZM12,15a3,3,0,1,1,3-3A3,3,0,0,1,12,15Z" />
        </svg>
    </div>
    <aside class="offcanvas offcanvas-start bg-black  border-end border-secondary glass-box d-flex flex-column" tabindex="-1" id="leftSidebar" aria-labelledby="leftSidebarLabel" data-bs-theme="dark" style="border-radius: 0px 30px 30px 0px">

        <div class="offcanvas-header">
            <button type="button" class="btn-close bg-white d-flex justify-content-center align-items-center" data-bs-dismiss="offcanvas" aria-label="Close">
                <i class="fa-solid fa-x"></i>
            </button>
        </div>

        <div class="accordion sidebar-accordion mx-auto g-5 flex-grow-1 overflow-auto p-3" id="sidebarMenu" style="max-width: 400px; width: 100%;">

            @if (showUserSection)
            {
                <div class="accordion-item mb-2">
                    <div class="d-flex align-items-center gap-3 sidebar-toggle-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseUser" aria-expanded="false" style="cursor: pointer;">
                        <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                            <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 6l-6 10h12z" />
                            </svg>
                        </div>
                        <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </svg>
                        </div>
                        <span class="text-white fs-6">User</span>
                    </div>

                    <div id="collapseUser" class="accordion-collapse collapse" data-bs-parent="#sidebarMenu">
                        <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                            @if (canManageUsers)
                            {
                                <a asp-controller="Account" asp-action="ManageUsers" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                        </svg>
                                    </div>
                                    <span class="sub-item-text">View Users</span>
                                </a>
                            }
                            @if (canManagePermissions)
                            {
                                <a asp-controller="Permission" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <img src="~/img/icon-park-outline_permissions.png" alt="Alternate Text" />
                                    </div>
                                    <span class="sub-item-text">Manage Permissions</span>
                                </a>
                            }
                            @if (canViewGroups)
                            {
                                <a class="d-flex align-items-center gap-3 mb-3 text-decoration-none" asp-controller="Group" asp-action="Index">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-user-group"></i>
                                    </div>
                                    <span class="sub-item-text">View Groups</span>
                                </a>
                            }
                            @if (canViewMailConfigurations)
                            {
                                <a class="d-flex align-items-center gap-3 mb-3 text-decoration-none" asp-controller="MailConfiguration" asp-action="Index">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-envelope"></i>
                                    </div>
                                    <span class="sub-item-text">Mail Configuration</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (showSimSection)
            {
                <div class="accordion-item mb-2">
                    <div class="d-flex align-items-center gap-3 sidebar-toggle-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseSim" aria-expanded="false" style="cursor: pointer;">
                        <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                            <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 6l-6 10h12z" />
                            </svg>
                        </div>
                        <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18 2h-8L4 8v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM7 17h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2zM7 13h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z" />
                            </svg>
                        </div>
                        <span class="text-white fs-6">Devices</span>
                    </div>

                    <div id="collapseSim" class="accordion-collapse collapse" data-bs-parent="#sidebarMenu">
                        <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                            @if (canViewSims)
                            {
                                <a asp-controller="SIM" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <img src="~/img/icon-park-outline_permissions.png" alt="Alternate Text" />
                                    </div>
                                    <span class="sub-item-text">Manage Devices</span>
                                </a>
                            }
                            @if (canCreateSim)
                            {
                                <a asp-controller="SIM" asp-action="Create" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <img src="~/img/Vector.png" alt="Alternate Text" style="width: 20px" />
                                    </div>
                                    <span class="sub-item-text">Create new SIM</span>
                                </a>
                            }
                            @if (canCreateUsb)
                            {
                                <a asp-controller="USB" asp-action="Create" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <img src="~/img/Vector.png" alt="Alternate Text" style="width: 20px" />
                                    </div>
                                    <span class="sub-item-text">Create new USB</span>
                                </a>
                            }
                            @if (canViewDeviceStatuses)
                            {
                                <a asp-controller="DeviceStatus" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-tower-broadcast"></i>
                                    </div>
                                    <span class="sub-item-text">Device Status</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

           

            @if (showDocumentSection)
            {
                <div class="accordion-item mb-2">
                    <div class="d-flex align-items-center gap-3 sidebar-toggle-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseDocument" aria-expanded="false" style="cursor: pointer;">
                        <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                            <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 6l-6 10h12z" />
                            </svg>
                        </div>
                        <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                            <i class="fa-solid fa-folder-open"></i>
                        </div>
                        <span class="text-white fs-6">Document</span>
                    </div>

                    <div id="collapseDocument" class="accordion-collapse collapse" data-bs-parent="#sidebarMenu">
                        <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                            @if (canViewDocuments)
                            {
                                <a asp-controller="Document" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-file-lines"></i>
                                    </div>
                                    <span class="sub-item-text">View Documents</span>
                                </a>
                            }
                            @if (canCreateDocument)
                            {
                                <a asp-controller="Document" asp-action="Create" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-plus"></i>
                                    </div>
                                    <span class="sub-item-text">Create new Document</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (showServiceProviderSection)
            {
                <div class="accordion-item mb-2">
                    <div class="d-flex align-items-center gap-3 sidebar-toggle-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseServiceProvider" aria-expanded="false" style="cursor: pointer;">
                        <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                            <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 6l-6 10h12z" />
                            </svg>
                        </div>
                        <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                            <i class="fa-solid fa-tower-cell"></i>
                        </div>
                        <span class="text-white fs-6">ServiceProvider</span>
                    </div>

                    <div id="collapseServiceProvider" class="accordion-collapse collapse" data-bs-parent="#sidebarMenu">
                        <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                            @if (canViewServiceProviders)
                            {
                                <a asp-controller="ServiceProvider" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-list-check"></i>
                                    </div>
                                    <span class="sub-item-text">View ServiceProviders</span>
                                </a>
                            }
                            @if (canCreateServiceProvider)
                            {
                                <a asp-controller="ServiceProvider" asp-action="Create" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-plus"></i>
                                    </div>
                                    <span class="sub-item-text">Create new ServiceProvider</span>
                                </a>
                            }
                            @if (canViewQuotas)
                            {
                                <a asp-controller="Quota" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-database"></i>
                                    </div>
                                    <span class="sub-item-text">Manage Quotas</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (showReportSection)
            {
                <div class="accordion-item mb-2">
                    <div class="d-flex align-items-center gap-3 sidebar-toggle-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseReport" aria-expanded="false" style="cursor: pointer;">
                        <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                            <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 6l-6 10h12z" />
                            </svg>
                        </div>
                        <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                            <i class="fa-solid fa-chart-simple"></i>
                        </div>
                        <span class="text-white fs-6">Report</span>
                    </div>

                    <div id="collapseReport" class="accordion-collapse collapse" data-bs-parent="#sidebarMenu">
                        <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                            @if (canViewReport)
                            {
                                <a asp-controller="Report" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-file-lines"></i>
                                    </div>
                                    <span class="sub-item-text">View report</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (showSubscriptionSection)
            {
                <div class="accordion-item mb-2">
                    <div class="d-flex align-items-center gap-3 sidebar-toggle-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseSubscription" aria-expanded="false" style="cursor: pointer;">
                        <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                            <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 6l-6 10h12z" />
                            </svg>
                        </div>
                        <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                            <i class="fa-solid fa-file-invoice"></i>
                        </div>
                        <span class="text-white fs-6">Subscription</span>
                    </div>

                    <div id="collapseSubscription" class="accordion-collapse collapse" data-bs-parent="#sidebarMenu">
                        <div class="accordion-body p-0 pt-3 pb-3 ms-2">
                            @if (canViewSubscription)
                            {
                                <a asp-controller="Subscription" asp-action="Index" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-file-lines"></i>
                                    </div>
                                    <span class="sub-item-text">View subscription</span>
                                </a>
                            }
                            @if (canCreateSubscription)
                            {
                                <a asp-controller="Subscription" asp-action="Create" class="d-flex align-items-center gap-3 mb-3 text-decoration-none">
                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-plus"></i>
                                    </div>
                                    <span class="sub-item-text">Add subscription</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (showBranchSection)
            {
                <div class="accordion-item mb-2">
                    <div class="d-flex align-items-center gap-3 sidebar-toggle-btn collapsed"
                         data-bs-toggle="collapse"
                         data-bs-target="#collapseBranch"
                         aria-expanded="false"
                         style="cursor: pointer;">

                        <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                            <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 6l-6 10h12z" />
                            </svg>
                        </div>

                        <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                            <i class="fa-solid fa-code-branch"></i>
                        </div>

                        <span class="text-white fs-6">Branch</span>
                    </div>

                    <div id="collapseBranch"
                         class="accordion-collapse collapse"
                         data-bs-parent="#sidebarMenu">

                        <div class="accordion-body p-0 pt-3 pb-3 ms-2">

                            @if (canViewBranches)
                            {
                                <a asp-controller="Branch"
                                   asp-action="Index"
                                   class="d-flex align-items-center gap-3 mb-3 text-decoration-none">

                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-list"></i>
                                    </div>

                                    <span class="sub-item-text">View Branches</span>
                                </a>
                            }

                            @if (canCreateBranch)
                            {
                                <a asp-controller="Branch"
                                   asp-action="Create"
                                   class="d-flex align-items-center gap-3 mb-3 text-decoration-none">

                                    <div class="icon-box-sub rounded-3 d-flex justify-content-center align-items-center text-white">
                                        <i class="fa-solid fa-plus"></i>
                                    </div>

                                    <span class="sub-item-text">Create new Branch</span>
                                </a>
                            }

                        </div>
                    </div>
                </div>
            }

            @if (showVpnConnectionSection)
            {
                <div class="accordion-item mb-2">
                    <div class="d-flex align-items-center gap-3 sidebar-toggle-btn collapsed"
                         data-bs-toggle="collapse"
                         data-bs-target="#collapseVpnConnection"
                         aria-expanded="false"
                         style="cursor: pointer;">

                        <div class="triangle-box rounded-3 d-flex justify-content-center align-items-center text-secondary">
                            <svg class="toggle-triangle" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 6l-6 10h12z" />
                            </svg>
                        </div>

                        <div class="icon-box-main rounded-3 d-flex justify-content-center align-items-center text-white">
                            <i class="fa-solid fa-network-wired"></i>
                        </div>

                        <span class="text-white fs-6">Vpn Connection</span>
                    </div>

                    <div id="collapseVpnConnection"
                         class="accordion-collapse collapse"
                         data-bs-parent="#sidebarMenu">

