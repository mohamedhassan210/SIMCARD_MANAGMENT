    <div class="">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/highcharts.js"></script>
    <script>
        // Draggable sidebar-toggle handle: vertical dragging only, pinned to the
        // left edge of the screen. Last vertical position is remembered per browser.
        // The offcanvas is opened manually (not via data-bs-toggle) so a press that
        // turns into a drag never also pops the sidebar open.
        (function () {
            var handle = document.getElementById('sidebarToggleHandle');
            if (!handle) return;

            var offcanvasEl = document.getElementById('leftSidebar');

            var STORAGE_KEY = 'sidebarToggleHandleTop';
            var DRAG_THRESHOLD = 6; // px of movement before a press counts as a drag

            var isPointerDown = false;
            var isDragging = false;
            var startClientY = 0;
            var startTop = 0;

            function clampTop(top) {
                var maxTop = Math.max(window.innerHeight - handle.offsetHeight, 0);
                return Math.min(Math.max(top, 0), maxTop);
            }

            function applyTop(top) {
                handle.style.top = top + 'px';
                handle.classList.remove('top-50');
            }

            // Restore the last saved position, if any.
            var savedTop = localStorage.getItem(STORAGE_KEY);
            if (savedTop !== null && !isNaN(parseFloat(savedTop))) {
                applyTop(clampTop(parseFloat(savedTop)));
            }

            handle.addEventListener('pointerdown', function (e) {
                // Only respond to primary button / touch / pen.
                if (e.button !== undefined && e.button !== 0) return;

                isPointerDown = true;
                isDragging = false;
                startClientY = e.clientY;
                startTop = handle.getBoundingClientRect().top;

                try { handle.setPointerCapture(e.pointerId); } catch (err) { /* no-op */ }
            });

            handle.addEventListener('pointermove', function (e) {
                if (!isPointerDown) return;

                var deltaY = e.clientY - startClientY;

                if (!isDragging && Math.abs(deltaY) > DRAG_THRESHOLD) {
                    isDragging = true;
                    handle.style.cursor = 'grabbing';
                }

                if (isDragging) {
                    e.preventDefault();
                    applyTop(clampTop(startTop + deltaY));
                }
            });

            function endDrag(e) {
                if (!isPointerDown) return;
                isPointerDown = false;
                handle.style.cursor = 'pointer';

                if (isDragging) {
                    // This press was a drag: save the new spot, don't open the sidebar.
                    isDragging = false;

                    var finalTop = parseFloat(handle.style.top);
                    if (!isNaN(finalTop)) {
                        localStorage.setItem(STORAGE_KEY, finalTop);
                    }
                } else if (offcanvasEl && window.bootstrap && window.bootstrap.Offcanvas) {
                    // This press was a plain click (no meaningful movement): open it.
                    window.bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl).show();
                }
            }

            handle.addEventListener('pointerup', endDrag);
            handle.addEventListener('pointercancel', function () {
                isPointerDown = false;
                isDragging = false;
                handle.style.cursor = 'pointer';
            });

            // Keep the handle on-screen if the window gets resized/rotated.
            window.addEventListener('resize', function () {
                var currentTop = parseFloat(handle.style.top);
                if (!isNaN(currentTop)) {
                    applyTop(clampTop(currentTop));
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
