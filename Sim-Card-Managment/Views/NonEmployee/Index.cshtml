@model IEnumerable<Sim_Card_Managment.ViewModels.NonEmployeeIndexViewModel>

<style>
    /* =========================================
           Employee / NonEmployee Dashboard Styles
           ========================================= */

    :root {
        --brand-orange: #E24D17;
        --bg-light: #F0F0F0;
        --border-gray: #D1D1D1;
    }

    .main-bg {
        background-color: var(--bg-light);
    }

    .text-brand-orange {
        color: var(--brand-orange) !important;
    }

    .bg-brand-orange {
        background-color: var(--brand-orange) !important;
    }

    .btn-brand-orange {
        background-color: var(--brand-orange) !important;
        border-color: var(--brand-orange) !important;
        transition: all 0.2s ease-in-out;
    }

        .btn-brand-orange:hover {
            background-color: #c74213 !important;
            border-color: #c74213 !important;
            color: white !important;
        }

    .custom-search-wrapper {
        background-color: transparent;
        border: 1px solid var(--border-gray);
        max-width: 400px;
        width: 100%;
    }

        .custom-search-wrapper:focus-within {
            border-color: var(--brand-orange);
            background-color: white;
        }

    .table-container {
        border: 1px solid var(--brand-orange);
        height: 500px;
    }

    .custom-table th,
    .custom-table td {
        border-bottom: none !important;
        border-right: none !important;
        border-left: none !important;
        vertical-align: middle;
    }

    .custom-table tbody tr {
        border-bottom: none !important;
    }

    .badge {
        font-size: 0.65rem;
        letter-spacing: 0.5px;
    }

    .custom-scrollbar {
        max-height: 420px;
        overflow-y: auto;
    }

        .custom-scrollbar::-webkit-scrollbar {
            width: 25px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #E5E5E5;
            border-radius: 10px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background-color: var(--brand-orange);
            border-radius: 10px;
            border: 3px solid #E5E5E5;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background-color: #c74213;
            }
</style>

<div class="container-fluid py-5 px-md-5 main-bg p-100" style="min-height: 100dvh;">

    <div class="mb-4">
        <h1 class="fw-bolder mb-3" style="font-size: 2.5rem;">
            <span class="text-brand-orange">@Model.Count()</span> <span class="text-black">Non employees</span>
        </h1>
        <p class="text-muted fw-medium mb-4" style="max-width: 800px; font-size: 0.95rem;">
            Manage and view non-employee contractors and visitors assigned SIM cards and USB devices across your system.
        </p>
        <a asp-action="Create" class="btn btn-brand-orange text-white rounded-pill px-4 py-2 fw-bold shadow-sm text-decoration-none">
            <i class="fa-solid fa-plus me-1"></i>Create new non employee
        </a>
    </div>

    <div class="d-flex align-items-center gap-3 mb-4 w-100">
        <div class="d-flex align-items-center px-3 py-2 rounded-pill custom-search-wrapper">
            <i class="fa-solid fa-magnifying-glass text-dark fw-bold me-2"></i>
            <input type="text" class="form-control bg-transparent border-0 text-dark shadow-none px-0"
                   placeholder="Search by id or name">
        </div>

        <button class="btn btn-brand-orange text-white rounded-3 px-3 py-2 shadow-sm d-flex align-items-center justify-content-center" style="height: 46px; width: 46px;">
            <i class="fa-solid fa-bars-staggered fs-4"></i>
        </button>
    </div>

    <div class="bg-white table-container position-relative pt-4 ps-2 pe-1 pb-2" style="border-radius: 30px">

        <div class="table-responsive custom-scrollbar pe-3">
            <table class="table custom-table align-middle text-start mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="border-0 ps-4 text-dark fw-medium">#</th>
                        <th scope="col" class="border-0 text-dark fw-medium">Name</th>
                        <th scope="col" class="border-0 text-dark fw-medium">Phone / Contact</th>
                        <th scope="col" class="border-0 text-dark fw-medium">Used</th>
                        <th scope="col" class="border-0"></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 0;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-dark ps-4">@index</td>
                            <td class="text-dark fw-bold">@item.Name</td>
                            <td class="text-dark">@(item.ContactInfo ?? "N/A")</td>
                            <td class="py-3">
                                @if (item.ActiveSimOnlyCount > 0)
                                {
                                    <span class="badge bg-brand-orange rounded-pill me-1 px-3 py-2 fw-bold">@item.ActiveSimOnlyCount SIM</span>
                                }
                                @if (item.ActiveUsbCount > 0)
                                {
                                    <span class="badge bg-brand-orange rounded-pill px-3 py-2 fw-bold">@item.ActiveUsbCount USB</span>
                                }
                                @if (item.ActiveSimOnlyCount == 0 && item.ActiveUsbCount == 0)
                                {
                                    <span class="text-muted fs-7">None</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-brand-orange text-white rounded-2 px-2 py-1">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>