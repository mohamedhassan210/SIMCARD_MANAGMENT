@model Sim_Card_Managment.Viewmodel.VpnConnectionDetailsViewModel

@{
    ViewData["Title"] = "VPN Connection Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connection Details</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .vd-btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #E2E8F0;
            background-color: #DF531B;
            color: #FFFFFF;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

            .vd-btn-action:hover {
                background: #FFF8F6;
                color: #DF531B;
                border-color: rgba(223, 83, 27, 0.3);
            }</style>
</head>
<body>
    <section class="bd-body">
        <main class="container-fluid px-lg-5 p-100">

            <!-- Connection Details Header Card -->
            <div class="bd-card mb-4">
                <div class="bd-card-header d-flex align-items-center justify-content-between p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bd-icon-wrapper">
                            <i class="fa-solid fa-network-wired"></i>
                        </div>
                        <div>
                            <h3 class="m-0 fs-5 fw-bold text-dark">Connection Details</h3>
                            <p class="m-0 text-muted small">Comprehensive view of network line configuration</p>
                        </div>
                    </div>
                    <div>
                        @if (Model.Status == true)
                        {
                            <span class="bd-badge-up">
                                <i class="fa-solid fa-circle"></i> Active / Up
                            </span>
                        }
                        else if (Model.Status == false)
                        {
                            <span class="bd-badge-down">
                                <i class="fa-solid fa-circle"></i> Down / Inactive
                            </span>
                        }
                        else
                        {
                            <span class="bd-badge-unknown">
                                <i class="fa-solid fa-circle"></i> Unknown
                            </span>
                        }
                    </div>
                </div>

                <div class="p-4 p-md-5 border-top">
                    <div class="row g-4">

                        <!-- Branch Name -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Branch Name</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-building text-muted me-2"></i>
                                @Model.BranchName
                            </div>
                        </div>

                        <!-- Connection Type -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Connection Type Name</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-diagram-project text-muted me-2"></i>
                                @Model.ConnectionTypeName
                            </div>
                        </div>

                        <!-- Service Provider -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Service Provider Name</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-tower-cell text-muted me-2"></i>
                                @Model.ServiceProviderName
                            </div>
                        </div>

                        <!-- NID -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">NID</div>
                            <div class="bd-info-value">
                                <code class="bd-code">@(string.IsNullOrEmpty(Model.NID) ? "N/A" : Model.NID)</code>
                            </div>
                        </div>

                        <!-- Line Speed -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Line Speed</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-gauge-high text-muted me-2"></i>
                                @(string.IsNullOrEmpty(Model.LineSpeed) ? "N/A" : Model.LineSpeed)
                            </div>
                        </div>

                        <!-- Created By -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Created By Username</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-user text-muted me-2"></i>
                                @(string.IsNullOrEmpty(Model.CreatedByUsername) ? "System" : Model.CreatedByUsername)
                            </div>
                        </div>

                        <!-- Notes & Remarks -->
                        <div class="col-12">
                            <div class="bd-info-label">Notes & Remarks</div>
                            <div class="bd-info-value">
                                @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes available." : Model.Notes)
                            </div>
                        </div>

                    </div>

                    <!-- Actions Footer -->
                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-controller="VpnConnection" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back
                        </a>

                        <a asp-controller="VpnConnection" asp-action="Edit" asp-route-id="@Model.Id" class="btn vd-btn-action rounded-pill px-4">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Connection
                        </a>
                    </div>
                </div>
            </div>

        </main>
    </section>
</body>
</html>