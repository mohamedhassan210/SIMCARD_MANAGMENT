            }

            .custom-table tbody td {
                font-size: 0.95rem;
                padding: 16px;
                border-bottom: 1px solid var(--card-border);
                vertical-align: middle;
            }
    </style>
</head>
<body>

    <header class="page-header">
        <div class="container-fluid px-lg-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="page-title m-0">Types Directory</h1>
                    <p class="text-muted m-0 small mt-1">Manage system connection and service types</p>
                </div>
                <div>
                    <a href="/Types/Create" class="btn-custom btn-primary-orange">
                        <i class="fa-solid fa-plus"></i> New Type
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="container-fluid px-lg-5">

        <div class="table-card">

            <div class="mb-4">
                <div class="search-box col-12">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="typeSearchInput" type="text" placeholder="Search types..." autocomplete="off">
                </div>
            </div>

            <div class="table-responsive">
                <table class="custom-table" id="typeTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="typeTableBody">

                        <tr class="type-row">
                            <td><strong>Fiber Optic</strong></td>
                            <td style="text-align: right;">
                                <a href="/Types/Edit/1" class="btn-action-icon" title="Edit Type">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </td>
                        </tr>

                        <tr class="type-row">
                            <td><strong>IPsec VPN</strong></td>
                            <td style="text-align: right;">
                                <a href="/Types/Edit/2" class="btn-action-icon" title="Edit Type">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </td>
                        </tr>

                        <tr class="type-row">
                            <td><strong>4G LTE Backup</strong></td>
                            <td style="text-align: right;">
                                <a href="/Types/Edit/3" class="btn-action-icon" title="Edit Type">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </td>
                        </tr>

                        <tr class="type-row">
                            <td><strong>MPLS Circuit</strong></td>
                            <td style="text-align: right;">
                                <a href="/Types/Edit/4" class="btn-action-icon" title="Edit Type">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </td>
                        </tr>

                        <tr id="noResultsRow" style="display: none;">
                            <td colspan="2" class="text-center text-muted py-4">
                                No matching types found.
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>

        </div>

    </main>

    <script>
        // Real-time Search Logic
        const searchInput = document.getElementById('typeSearchInput');

        searchInput.addEventListener('input', () => {
            const query = searchInput.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#typeTableBody tr.type-row');
            let hasVisibleRow = false;

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(query)) {
                    row.style.display = '';
                    hasVisibleRow = true;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('noResultsRow').style.display = hasVisibleRow ? 'none' : '';
        });
    </script>
</body>
</html> *@