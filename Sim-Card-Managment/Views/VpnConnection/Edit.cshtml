@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit VPN</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-orange: #DF531B;
            --brand-orange-light: #FFF8F6;
            --brand-purple: #5B2D90;
            --bg-canvas: #F4F5F8;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --card-border: #E2E8F0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, sans-serif;
            padding-bottom: 3rem;
        }

        /* Form Card Layout */
        .form-card {
            max-width: 760px;
            margin: 3rem auto 0 auto;
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            overflow: hidden;
        }

        .card-header-styled {
            border-bottom: 1px solid var(--card-border);
            padding: 1.5rem 2rem;
            background: linear-gradient(180deg, var(--brand-orange-light) 0%, #FFFFFF 100%);
        }

        .section-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background-color: rgba(223, 83, 27, 0.12);
            color: var(--brand-orange);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        /* Form Controls */
        .form-label-custom {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 6px;
            display: block;
        }

        .input-group-custom {
            display: flex;
            align-items: center;
            background: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 0 14px;
            transition: all 0.2s ease;
        }

            .input-group-custom:focus-within {
                border-color: var(--brand-orange);
                box-shadow: 0 0 0 3px rgba(223, 83, 27, 0.1);
            }

            .input-group-custom i {
                color: var(--text-muted);
                font-size: 1rem;
                margin-right: 10px;
            }

        .form-control-custom, .form-select-custom {
            border: none;
            outline: none;
            background: transparent;
            font-size: 0.95rem;
            width: 100%;
            height: 48px;
            color: var(--text-dark);
            font-weight: 500;
        }

        textarea.form-control-custom {
            height: auto;
            padding: 12px 0;
            resize: vertical;
            min-height: 90px;
        }

        .form-select-custom {
            cursor: pointer;
        }

        /* Action Buttons */
        .btn-custom {
            height: 48px;
            padding: 0 28px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary-orange {
            background-color: var(--brand-orange);
            color: #FFFFFF;
        }

            .btn-primary-orange:hover {
                background-color: #c94614;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(223, 83, 27, 0.25);
            }

        .btn-secondary-soft {
            background-color: #F1F5F9;
            color: var(--text-muted);
            border: 1px solid var(--card-border);
        }

            .btn-secondary-soft:hover {
                background-color: #E2E8F0;
                color: var(--text-dark);
            }
    </style>
</head>
<body>

    <main class="container px-3 p-100">

        <div class="form-card">

            <div class="card-header-styled d-flex align-items-center gap-3">
                <div class="section-icon-wrapper">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">Edit VPN Connection</h3>
                    <p class="m-0 text-muted small">Update network link details and status for this branch</p>
                </div>
            </div>

            <form id="editVpnForm" onsubmit="handleFormSubmit(event)">
                <div class="p-4 p-md-5">
                    <div class="row g-4">

                        <div class="col-12 col-md-6">
                            <label for="branch" class="form-label-custom">Branch</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-building"></i>
                                <input type="text" id="branch" class="form-control-custom" value="Cairo Main Branch" placeholder="e.g., Cairo Main Branch" required>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="connectionType" class="form-label-custom">Connection Type</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-diagram-project"></i>
                                <input type="text" id="connectionType" class="form-control-custom" value="MPLS Link" placeholder="e.g., MPLS / Site-to-Site" required>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="serviceProvider" class="form-label-custom">Service Provider</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-tower-cell"></i>
                                <input type="text" id="serviceProvider" class="form-control-custom" value="Vodafone" placeholder="e.g., Vodafone / Orange / WE" required>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="nid" class="form-label-custom">NID (Network ID)</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-fingerprint"></i>
                                <input type="text" id="nid" class="form-control-custom" value="NID-99201" placeholder="Enter NID" required>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="lineSpeed" class="form-label-custom">Line Speed</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-gauge-high"></i>
                                <input type="text" id="lineSpeed" class="form-control-custom" value="100 Mbps" placeholder="e.g., 50 Mbps" required>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="status" class="form-label-custom">Status</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-circle-dot"></i>
                                <select id="status" class="form-select-custom" required>
                                    <option value="" disabled>Select connection status</option>
                                    <option value="Up" selected>Up (Active)</option>
                                    <option value="Down">Down (Inactive)</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="notes" class="form-label-custom">Notes</label>
                            <div class="input-group-custom align-items-start pt-2">
                                <i class="fa-regular fa-comment-dots mt-2"></i>
                                <textarea id="notes" class="form-control-custom" placeholder="Additional details or configuration notes...">Primary backup line connected to fiber switch port #4.</textarea>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a href="#" class="btn-custom btn-secondary-soft">Cancel</a>
                        <button type="submit" class="btn-custom btn-primary-orange">
                            <i class="fa-solid fa-floppy-disk"></i> Save Changes
                        </button>
                    </div>

                </div>
            </form>

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function handleFormSubmit(event) {
            event.preventDefault();

            const branch = document.getElementById('branch').value;
            const status = document.getElementById('status').value;

            Swal.fire({
                title: 'VPN Updated!',
                text: `VPN settings for ${branch} have been updated successfully. Current status: ${status}.`,
                icon: 'success',
                confirmButtonColor: '#DF531B',
                customClass: { popup: 'rounded-4' }
            });
        }
    </script>
</body>
</html>