<style>
    /* ---------- Title ---------- */
    .title-section {
        margin-bottom: 24px;
    }

        .title-section h1 {
            font-size: 34px;
            font-weight: 800;
            color: #1a1a1a;
        }

            .title-section h1 .num {
                color: #e8552b;
            }

        .title-section p {
            margin-top: 10px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b6b6b;
            max-width: 560px;
        }

    /* ---------- Create button ---------- */
    .create-btn {
        margin-top: 20px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #e8552b;
        color: #fff;
        border: none;
        padding: 13px 22px;
        border-radius: 24px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .create-btn:hover {
            background: #d64923;
            transform: translateY(-1px);
        }

        .create-btn .plus {
            font-size: 16px;
            font-weight: 700;
        }

    /* ---------- Filters ---------- */
    .filters {
        margin-top: 34px;
    }

        .filters label {
            display: block;
            font-size: 12px;
            color: #6b6b6b;
            margin-bottom: 8px;
        }

    .filters-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-select {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 13px;
        color: #1a1a1a;
        width: 150px;
        cursor: pointer;
        transition: border-color 0.2s ease;
    }

        .status-select:hover {
            border-color: #e8552b;
        }

        .status-select svg {
            width: 12px;
            height: 12px;
        }

    .search-box {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        transition: border-color 0.2s ease;
    }

        .search-box:focus-within {
            border-color: #e8552b;
        }

        .search-box svg {
            width: 15px;
            height: 15px;
            color: #a8a8a8;
            flex-shrink: 0;
        }

        .search-box input {
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
            width: 100%;
            color: #1a1a1a;
        }

            .search-box input::placeholder {
                color: #b3b3b3;
            }

    .filter-icon-btn {
        background: #e8552b;
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .filter-icon-btn:hover {
            background: #d64923;
        }

        .filter-icon-btn svg {
            width: 18px;
            height: 18px;
        }

    /* ---------- Table ---------- */
    .table-wrap {
        margin-top: 28px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #1a1a1a;
        padding-bottom: 12px;
        vertical-align: top;
    }

    thead tr {
        border-bottom: 2px solid #e8552b;
    }

    tbody td {
        font-size: 12.5px;
        color: #1a1a1a;
        padding: 16px 0;
        border-bottom: 1px solid #e2e2e2;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: 1px solid #e2e2e2;
    }

    .asset-cell {
        display: flex;
        align-items: center;
        gap: 6px;
        line-height: 1.3;
    }

        .asset-cell svg {
            width: 14px;
            height: 14px;
            color: #1a1a1a;
            flex-shrink: 0;
        }

    .view-btn {
        display: inline-block;
        border: 1.5px solid #e8552b;
        color: #e8552b;
        background: transparent;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 18px;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .view-btn:hover {
            background: #e8552b;
            color: #fff;
        }

    th:nth-child(1), td:nth-child(1) {
        width: 19%;
    }

    th:nth-child(2), td:nth-child(2) {
        width: 18%;
    }

    th:nth-child(3), td:nth-child(3) {
        width: 17%;
    }

    th:nth-child(4), td:nth-child(4) {
        width: 18%;
    }

    th:nth-child(5), td:nth-child(5) {
        width: 15%;
    }

    th:nth-child(6), td:nth-child(6) {
        width: 13%;
        text-align: right;
    }

    td:nth-child(6) {
        text-align: right;
    }

    /* ---------- Footer ---------- */
    .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 20px;
    }

        .footer .showing {
            font-size: 12px;
            color: #6b6b6b;
        }

    .pagination {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .pagination button {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid #dcdcdc;
            background: #fff;
            color: #6b6b6b;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .pagination button:hover {
                border-color: #e8552b;
                color: #e8552b;
            }

            .pagination button:active {
                transform: scale(0.92);
            }

            .pagination button.page-num {
                border: none;
                background: transparent;
                color: #1a1a1a;
            }

                .pagination button.page-num:hover {
                    background: #fbeae5;
                    color: #e8552b;
                    border-color: transparent;
                }

            .pagination button.active {
                background: #e8552b;
                border-color: #e8552b;
                color: #fff;
            }

                .pagination button.active:hover {
                    background: #d64923;
                    color: #fff;
                }

            .pagination button.arrow {
                color: #888888;
            }
</style>

