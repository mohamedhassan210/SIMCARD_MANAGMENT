@model IEnumerable<Sim_Card_Managment.ViewModels.PersonListItemViewModel>

@{
    ViewData["Title"] = "Directory";
    var personList = Model?.ToList() ?? new List<Sim_Card_Managment.ViewModels.PersonListItemViewModel>();
    int totalCount = personList.Count;
    int employeeCount = personList.Count(x => x.PersonType == "Employee");
    int nonEmployeeCount = personList.Count(x => x.PersonType != "Employee");

    string currentStatus = (ViewBag.CurrentStatus as string)?.ToLower() ?? "active";
    string currentType = (ViewBag.CurrentType as string)?.ToLower() ?? "all";
}

<style>
    /* Theme & Layout Variables */
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
        --bg-light: #f8f9fa;
    }

    /* Page Header */
    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    /* Primary & Secondary Action Buttons */
    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    .btn-orange-outline {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-outline:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    .btn-view-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-view-action:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    /* Seamless Search Bar Wrapper */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.92rem;
            color: #333333;
            padding: 4px 0;
        }

    /* Custom Form Selects */
    .custom-select-control {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 8px 14px;
        font-size: 0.92rem;
        color: #333333;
        background-color: #ffffff;
        transition: border-color 0.2s ease;
    }

        .custom-select-control:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
            outline: none;
        }

    /* Badges */
    .badge-type-employee {
        background-color: #e6f4ea;
        color: #137333;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .badge-type-non-employee {
        background-color: #feefc3;
        color: #b06000;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .asset-pill {
        background-color: #f1f3f5;
        color: #495057;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* Inactive row visual treatment */
    .person-row.inactive-row {
        opacity: 0.65;
        background-color: #fafafa;
    }

    /* Pagination Styles */
    .pagination-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid #e0e0e0;
        background: #ffffff;
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .pagination-btn:hover:not([disabled]) {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

        .pagination-btn.active {
            background: var(--primary-orange);
            border-color: var(--primary-orange);
            color: #ffffff;
        }

        .pagination-btn[disabled] {
            opacity: 0.4;
            cursor: not-allowed;
        }
</style>

<div class="container-fluid px-4 p-100">

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">Directory Entries</h1>
            <p class="page-header-subtitle mb-0">Manage all assigned personnel, contractors, and external device holders in one central directory.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Employee" asp-action="Create" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New Employee</span>
            </a>
            <a asp-controller="NonEmployee" asp-action="Create" class="btn-orange-outline shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New Non-Employee</span>
            </a>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total Directory Records</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #E24D17;">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Employees</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@employeeCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #198754;">
                        <i class="fas fa-user-tie fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Non-Employees / Contractors</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@nonEmployeeCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #fd7e14;">
                        <i class="fas fa-user-tag fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Container -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <!-- Controls / Filters Header -->
        <div class="row g-3 align-items-end mb-4">
            <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                <label for="status-filter" class="form-label text-muted small fw-medium mb-1">Status</label>
                <select id="status-filter" class="form-select custom-select-control">
                    <option value="active" selected="@(currentStatus == "active")">Active</option>
                    <option value="inactive" selected="@(currentStatus == "inactive")">Inactive</option>
                    <option value="all" selected="@(currentStatus == "all")">All</option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                <label for="employee-type-filter" class="form-label text-muted small fw-medium mb-1">Type</label>
                <select id="employee-type-filter" class="form-select custom-select-control">
                    <option value="all" selected="@(currentType == "all")">All Types</option>
                    <option value="employee" selected="@(currentType == "employee")">Employee</option>
                    <option value="non-employee" selected="@(currentType == "non-employee")">Non-Employee</option>
                </select>
            </div>

            <div class="col-12 col-md-6 col-xl-8">
                <label for="search-input" class="form-label text-muted small fw-medium mb-1">Search Directory</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="search-input" placeholder="Search by name, ID, or contact info..." autocomplete="off">
                </div>
            </div>
        </div>

        <!-- Directory Table View -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="directoryTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th scope="col" style="width: 25%;">Name</th>
                        <th scope="col" style="width: 15%;">Type</th>
                        <th scope="col" style="width: 18%;">ID / Contact</th>
                        <th scope="col" style="width: 22%;">Assigned Assets</th>
                        <th scope="col" style="width: 12%;">Start Date</th>
                        <th scope="col" class="text-end" style="width: 8%;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (personList.Any())
                    {
                        foreach (var item in personList)
                        {
                            bool isRowActive = item.PersonType == "Employee" ? item.IsActive : true;
                            var statusValue = isRowActive ? "active" : "inactive";
                            var rawType = (item.PersonType ?? "").ToLower().Replace(" ", "-");
                            var rowClass = !isRowActive ? "person-row inactive-row" : "person-row";

                            <tr class="@rowClass" data-status="@statusValue" data-type="@rawType">
                                <td>
                                    <div>
                                        <span class="fw-bold text-dark fs-6 d-block">@item.Name</span>
                                        @if (!string.IsNullOrEmpty(item.ExtraInfo))
                                        {
                                            <span class="text-muted small">@item.ExtraInfo</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="@(item.PersonType == "Employee" ? "badge-type-employee" : "badge-type-non-employee")">
                                        @item.PersonType
                                    </span>
                                </td>
                                <td>
                                    <span class="text-dark font-monospace small">@item.Identifier</span>
                                </td>
                                <td>
                                    <div class="asset-pill">
                                        <i class="fas fa-sim-card text-muted"></i>
                                        <span>SIMs: <strong>@item.ActiveSimOnlyCount</strong></span>
                                        <span class="text-muted mx-1">|</span>
                                        <i class="fas fa-usb text-muted"></i>
                                        <span>USBs: <strong>@item.ActiveUsbCount</strong></span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.StartDate.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="text-end">
                                    @if (item.PersonType == "Employee")
                                    {
                                        <a asp-controller="Employee" asp-action="Details" asp-route-id="@item.Id" class="btn-view-action" title="View Details">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="NonEmployee" asp-action="Details" asp-route-id="@item.Id" class="btn-view-action" title="View Details">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="6" class="text-center text-muted py-4">
                            No matching personnel found.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer / Pagination -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 mt-4 pt-3 border-top">
            <span class="text-muted small" id="showingText">Showing 0 records</span>
            <div class="d-flex align-items-center gap-1" id="paginationContainer"></div>
        </div>

    </div>
</div>

<!-- Dynamic Search & Pagination Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("search-input");
        const typeFilter = document.getElementById("employee-type-filter");
        const statusFilter = document.getElementById("status-filter");

        const allRows = Array.from(document.querySelectorAll("#tableBody tr.person-row"));
        const noResultsRow = document.getElementById("noResultsRow");
        const showingText = document.getElementById("showingText");
        const paginationContainer = document.getElementById("paginationContainer");

        const itemsPerPage = 7;
        let visibleRows = [...allRows];
        let currentPage = 1;

        function renderTable() {
            const totalVisible = visibleRows.length;
            const totalPages = Math.max(1, Math.ceil(totalVisible / itemsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx = startIdx + itemsPerPage;

            // Hide all rows initially
            allRows.forEach(row => row.style.display = "none");

            // Display current page slice
            visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

            // Handle empty search / filter state
            if (totalVisible === 0) {
                if (noResultsRow) noResultsRow.style.display = "";
                showingText.textContent = "Showing 0 records";
                paginationContainer.innerHTML = "";
                return;
            } else {
                if (noResultsRow) noResultsRow.style.display = "none";
            }

            // Update stats counter text
            const actualEnd = Math.min(endIdx, totalVisible);
            showingText.textContent = `Showing ${startIdx + 1}-${actualEnd} of ${totalVisible} records`;

            // Build pagination HTML
            let html = `<button type="button" class="pagination-btn" id="prevBtn" ${currentPage === 1 ? 'disabled' : ''}>&lsaquo;</button>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<button type="button" class="pagination-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
            }

            html += `<button type="button" class="pagination-btn" id="nextBtn" ${currentPage === totalPages ? 'disabled' : ''}>&rsaquo;</button>`;

            paginationContainer.innerHTML = html;
        }

        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            const selectedType = typeFilter.value.toLowerCase();
            const selectedStatus = statusFilter.value.toLowerCase();

            visibleRows = allRows.filter(row => {
                // 1. Text Search matching
                const text = row.innerText.toLowerCase();
                const matchesSearch = text.includes(query);

                // 2. Type Filter matching
                const rowType = (row.getAttribute("data-type") || "").toLowerCase();
                const matchesType = (selectedType === "all" || rowType === selectedType);

                // 3. Status Filter matching
                const rowStatus = (row.getAttribute("data-status") || "active").toLowerCase();
                const matchesStatus = (selectedStatus === "all" || rowStatus === selectedStatus);

                return matchesSearch && matchesType && matchesStatus;
            });

            currentPage = 1; // Reset to page 1 on filter change
            renderTable();
        }

        // Attach event listeners
        searchInput.addEventListener("input", applyFilters);
        typeFilter.addEventListener("change", applyFilters);
        statusFilter.addEventListener("change", applyFilters);

        // Pagination button click delegation
        paginationContainer.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn || btn.disabled) return;

            if (btn.id === "prevBtn") {
                if (currentPage > 1) currentPage--;
            } else if (btn.id === "nextBtn") {
                const totalPages = Math.ceil(visibleRows.length / itemsPerPage);
                if (currentPage < totalPages) currentPage++;
            } else if (btn.dataset.page) {
                currentPage = parseInt(btn.dataset.page, 10);
            }

            renderTable();
        });

        // Initialize display
        applyFilters();
    });
</script>