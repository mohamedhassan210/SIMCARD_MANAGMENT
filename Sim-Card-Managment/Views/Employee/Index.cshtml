<script>
    document.addEventListener("DOMContentLoaded", function () {
        const totalItems = 1284;
        const itemsPerPage = 10;
        const totalPages = Math.ceil(totalItems / itemsPerPage);
        let currentPage = 1;

        const showingText = document.getElementById("showingText");
        const paginationContainer = document.getElementById("paginationContainer");

        function updatePagination() {
            // Calculate start and end item counts
            const startItem = (currentPage - 1) * itemsPerPage + 1;
            const endItem = Math.min(currentPage * itemsPerPage, totalItems);

            // Update footer text dynamically
            showingText.textContent = `Showing ${startItem}-${endItem} of ${totalItems.toLocaleString()} subscriptions`;

            // Rebuild pagination buttons layout
            let buttonsHTML = `<button class="arrow" type="button" id="prevBtn" title="Previous Page" ${currentPage === 1 ? 'style="opacity: 0.5; cursor: not-allowed;"' : ''}>&#8249;</button>`;

            // Show a clean sliding window of page numbers
            let startPage = Math.max(1, currentPage - 1);
            let endPage = Math.min(totalPages, startPage + 2);
            if (endPage - startPage < 2) {
                startPage = Math.max(1, endPage - 2);
            }

            for (let i = startPage; i <= endPage; i++) {
                if (i === currentPage) {
                    buttonsHTML += `<button class="active" type="button" data-page="${i}">${i}</button>`;
                } else {
                    buttonsHTML += `<button class="page-num" type="button" data-page="${i}">${i}</button>`;
                }
            }

            buttonsHTML += `<button class="arrow" type="button" id="nextBtn" title="Next Page" ${currentPage === totalPages ? 'style="opacity: 0.5; cursor: not-allowed;"' : ''}>&#8250;</button>`;

            paginationContainer.innerHTML = buttonsHTML;
        }

        // Event listener for pagination clicks
        paginationContainer.addEventListener("click", function (e) {
            const target = e.target.closest("button");
            if (!target) return;

            if (target.classList.contains("page-num") || target.classList.contains("active")) {
                const selectedPage = parseInt(target.getAttribute("data-page"));
                if (selectedPage && selectedPage !== currentPage) {
                    currentPage = selectedPage;
                    updatePagination();
                }
            } else if (target.id === "prevBtn") {
                if (currentPage > 1) {
                    currentPage--;
                    updatePagination();
                }
            } else if (target.id === "nextBtn") {
                if (currentPage < totalPages) {
                    currentPage++;
                    updatePagination();
                }
            }
        });

        // Initialize state on load
        updatePagination();
    });
</script>