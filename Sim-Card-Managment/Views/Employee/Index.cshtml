@model IEnumerable<Sim_Card_Managment.ViewModels.PersonListItemViewModel>

@{
    string currentStatus = ViewBag.CurrentStatus ?? "active";
    string currentType = ViewBag.CurrentType ?? "all";
}

<style>
    /* ---------- Title ---------- */
    .title-section {
        margin-bottom: 24px;
    }

        .title-section h1 {
            font-size: 34px;
            font-weight: 800;
            color: #1a1a1a;
        }

            .title-section h1 .num {
                color: #e8552b;
            }

        .title-section p {
            margin-top: 10px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b6b6b;
            max-width: 560px;
        }

    /* ---------- Buttons ---------- */
    .create-btn-group {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .create-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #e8552b;
        color: #fff;
        border: none;
        padding: 11px 20px;
        border-radius: 24px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .create-btn:hover {
            background: #d64923;
            color: #fff;
            transform: translateY(-1px);
        }

    .create-btn-secondary {
        background: #ffffff;
        color: #1a1a1a;
        border: 1px solid #dcdcdc;
    }

        .create-btn-secondary:hover {
            background: #f7f7f7;
            color: #e8552b;
            border-color: #e8552b;
        }

    /* ---------- Filters ---------- */
    .filters {
        margin-top: 34px;
    }

        .filters label {
            display: block;
            font-size: 12px;
            color: #6b6b6b;
            margin-bottom: 8px;
        }

    .filters-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-select {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 13px;
        color: #1a1a1a;
        width: 150px;
        cursor: pointer;
        transition: border-color 0.2s ease;
    }

        .status-select:hover {
            border-color: #e8552b;
        }

    .search-box {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        transition: border-color 0.2s ease;
    }

        .search-box:focus-within {
            border-color: #e8552b;
        }

        .search-box svg {
            width: 15px;
            height: 15px;
            color: #a8a8a8;
            flex-shrink: 0;
        }

        .search-box input {
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
            width: 100%;
            color: #1a1a1a;
        }

            .search-box input::placeholder {
                color: #b3b3b3;
            }

    /* ---------- Table ---------- */
    .table-wrap {
        margin-top: 28px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #1a1a1a;
        padding-bottom: 12px;
        vertical-align: top;
    }

    thead tr {
        border-bottom: 2px solid #e8552b;
    }

    tbody td {
        font-size: 12.5px;
        color: #1a1a1a;
        padding: 16px 0;
        border-bottom: 1px solid #e2e2e2;
        vertical-align: middle;
    }

    /* Inactive visual distinction */
    tr.person-row.row-inactive {
        opacity: 0.65;
        background-color: #fcfcfc;
    }

    .asset-cell {
        display: flex;
        align-items: center;
        gap: 6px;
        line-height: 1.3;
    }

        .asset-cell svg {
            width: 14px;
            height: 14px;
            color: #1a1a1a;
            flex-shrink: 0;
        }

    .badge-type {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 10px;
        text-transform: uppercase;
    }

    .badge-employee {
        background: #e6f4ea;
        color: #137333;
    }

    .badge-non-employee {
        background: #feefc3;
        color: #b06000;
    }

    .view-btn {
        display: inline-block;
        border: 1.5px solid #e8552b;
        color: #e8552b;
        background: transparent;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 18px;
        border-radius: 16px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .view-btn:hover {
            background: #e8552b;
            color: #fff;
        }

    th:nth-child(1), td:nth-child(1) {
        width: 22%;
    }

    th:nth-child(2), td:nth-child(2) {
        width: 14%;
    }

    th:nth-child(3), td:nth-child(3) {
        width: 18%;
    }

    th:nth-child(4), td:nth-child(4) {
        width: 20%;
    }

    th:nth-child(5), td:nth-child(5) {
        width: 14%;
    }

    th:nth-child(6), td:nth-child(6) {
        width: 12%;
        text-align: right;
    }

    /* ---------- Footer ---------- */
    .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 20px;
    }

        .footer .showing {
            font-size: 12px;
            color: #6b6b6b;
        }

    .pagination {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .pagination button {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid #dcdcdc;
            background: #fff;
            color: #6b6b6b;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .pagination button:hover {
                border-color: #e8552b;
                color: #e8552b;
            }

            .pagination button.page-num {
                border: none;
                background: transparent;
                color: #1a1a1a;
            }

                .pagination button.page-num:hover {
                    background: #fbeae5;
                    color: #e8552b;
                }

            .pagination button.active {
                background: #e8552b;
                border-color: #e8552b;
                color: #fff;
            }
</style>

<div class="page p-100 container-fluid px-4">

    <div class="title-section">
        <h1><span class="num" id="totalCountDisplay">@Model?.Count()</span> Directory Entries</h1>
        <p>Manage all assigned personnel, contractors, and external device holders in one central place.</p>

        <div class="create-btn-group">
            <a asp-controller="Employee" asp-action="Create" class="create-btn"><span>+</span> New Employee</a>
            <a asp-controller="NonEmployee" asp-action="Create" class="create-btn create-btn-secondary"><span>+</span> New Non-Employee</a>
        </div>
    </div>

    <div class="filters">
        <div class="filters-row">
            <div class="filter-group">
                <label for="status-filter">Status</label>
                <select id="status-filter" class="status-select">
                    <option value="active" selected="@(currentStatus.ToLower() == "active" ? "selected" : null)">Active</option>
                    <option value="inactive" selected="@(currentStatus.ToLower() == "inactive" ? "selected" : null)">Inactive</option>
                    <option value="all" selected="@(currentStatus.ToLower() == "all" ? "selected" : null)">All</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="employee-type-filter">Type</label>
                <select id="employee-type-filter" class="status-select">
                    <option value="all" selected="@(currentType.ToLower() == "all" ? "selected" : null)">All Types</option>
                    <option value="employee" selected="@(currentType.ToLower() == "employee" ? "selected" : null)">Employee</option>
                    <option value="non-employee" selected="@(currentType.ToLower() == "non-employee" ? "selected" : null)">Non-Employee</option>
                </select>
            </div>

            <div class="filter-group" style="flex: 1;">
                <label for="search-input">Search (Client-Side)</label>
                <div class="search-box">
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5" />
                        <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <input id="search-input" type="text" placeholder="Type name, ID, or contact to search instantly..." autocomplete="off">
                </div>
            </div>
        </div>
    </div>

    <div class="table-wrap">
        <table id="directoryTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>ID / Contact</th>
                    <th>Assigned Assets</th>
                    <th>Start Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var statusAttr = item.IsActive ? "active" : "inactive";
                        var rowClass = !item.IsActive ? "person-row row-inactive" : "person-row";

                        <tr class="@rowClass" data-status="@statusAttr">
                            <td class="col-name">
                                <strong>@item.Name</strong>
                                @if (!string.IsNullOrEmpty(item.ExtraInfo))
                                {
                                    <div style="font-size: 11px; color: #888;">@item.ExtraInfo</div>
                                }
                            </td>
                            <td>
                                <span class="badge-type @(item.PersonType == "Employee" ? "badge-employee" : "badge-non-employee")">
                                    @item.PersonType
                                </span>
                            </td>
                            <td class="col-identifier">@item.Identifier</td>
                            <td>
                                <div class="asset-cell">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="3" y="2" width="14" height="20" rx="2" stroke="currentColor" stroke-width="1.5" />
                                        <path d="M17 6H21V18H17" stroke="currentColor" stroke-width="1.5" />
                                    </svg>
                                    <div>
                                        SIMs: @item.ActiveSimOnlyCount | USBs: @item.ActiveUsbCount
                                    </div>
                                </div>
                            </td>
                            <td>@item.StartDate.ToString("MMM dd, yyyy")</td>
                            <td style="text-align: right;">
                                @if (item.PersonType == "Employee")
                                {
                                    <a asp-controller="Employee" asp-action="Details" asp-route-id="@item.Id" class="view-btn">VIEW</a>
                                }
                                else
                                {
                                    <a asp-controller="NonEmployee" asp-action="Details" asp-route-id="@item.Id" class="view-btn">VIEW</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tr id="noResultsRow" style="display: none;">
                <td colspan="6" style="text-align: center; padding: 32px; color: #888;">
                    No matching personnel found.
                </td>
            </tr>
        </table>
    </div>

    <div class="footer">
        <div class="showing" id="showingText">Showing 0 records</div>
        <div class="pagination" id="paginationContainer"></div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("search-input");
        const typeFilter = document.getElementById("employee-type-filter");
        const statusFilter = document.getElementById("status-filter");

        const allRows = Array.from(document.querySelectorAll("#tableBody tr.person-row"));
        const noResultsRow = document.getElementById("noResultsRow");
        const showingText = document.getElementById("showingText");
        const paginationContainer = document.getElementById("paginationContainer");

        const itemsPerPage = 7;
        let visibleRows = [...allRows];
        let currentPage = 1;

        function renderTable() {
            const totalVisible = visibleRows.length;
            const totalPages = Math.max(1, Math.ceil(totalVisible / itemsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx = startIdx + itemsPerPage;

            // Hide all rows initial state
            allRows.forEach(row => row.style.display = "none");

            // Display current page slice
            visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

            // Empty state check
            if (totalVisible === 0) {
                noResultsRow.style.display = "";
                showingText.textContent = "Showing 0 records";
                paginationContainer.innerHTML = "";
                return;
            } else {
                noResultsRow.style.display = "none";
            }

            // Stats info update
            const actualEnd = Math.min(endIdx, totalVisible);
            showingText.textContent = `Showing ${startIdx + 1}-${actualEnd} of ${totalVisible} records`;

            // Render pagination buttons
            let html = `<button type="button" class="arrow" id="prevBtn" ${currentPage === 1 ? 'disabled style="opacity:0.4;cursor:default;"' : ''}>&#8249;</button>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<button type="button" class="${i === currentPage ? 'active' : 'page-num'}" data-page="${i}">${i}</button>`;
            }

            html += `<button type="button" class="arrow" id="nextBtn" ${currentPage === totalPages ? 'disabled style="opacity:0.4;cursor:default;"' : ''}>&#8250;</button>`;

            paginationContainer.innerHTML = html;
        }

        // Unified filtration function
        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            const selectedType = typeFilter.value.toLowerCase();
            const selectedStatus = statusFilter.value.toLowerCase();

            visibleRows = allRows.filter(row => {
                // 1. Text Search Evaluation
                const text = row.innerText.toLowerCase();
                const matchesSearch = text.includes(query);

                // 2. Type Evaluation
                const typeText = row.querySelector(".badge-type") ? row.querySelector(".badge-type").innerText.trim().toLowerCase() : "";
                const matchesType = (selectedType === "all" || typeText === selectedType);

                // 3. Inactive/Active Status Evaluation
                const rowStatus = (row.getAttribute("data-status") || "active").toLowerCase();
                const matchesStatus = (selectedStatus === "all" || rowStatus === selectedStatus);

                return matchesSearch && matchesType && matchesStatus;
            });

            currentPage = 1; // Reset to page 1 on filter trigger
            renderTable();
        }

        // Event listeners
        searchInput.addEventListener("input", applyFilters);
        typeFilter.addEventListener("change", applyFilters);
        statusFilter.addEventListener("change", applyFilters);

        // Pagination Click Listener
        paginationContainer.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn || btn.disabled) return;

            if (btn.id === "prevBtn") {
                if (currentPage > 1) currentPage--;
            } else if (btn.id === "nextBtn") {
                const totalPages = Math.ceil(visibleRows.length / itemsPerPage);
                if (currentPage < totalPages) currentPage++;
            } else if (btn.dataset.page) {
                currentPage = parseInt(btn.dataset.page, 10);
            }

            renderTable();
        });

        // Trigger initial filtering based on defaults
        applyFilters();
    });
</script>