@model Sim_Card_Managment.ViewModels.EmployeeUserCreateViewModel

@{
    ViewData["Title"] = "Create New Employee";
}

<style>
    .page-center-wrapper {
        background-color: #E24D17;
        min-height: 100vh;
        margin-bottom: -1rem; /* cancels out <main class="pb-3">'s padding */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .create-card {
        background-color: #ffffff;
        border-radius: 30px;
        max-width: 750px;
        width: 100%;
        padding: 3rem 4rem;
    }

    .title-header {
        font-weight: 700;
        font-size: 32px;
        color: #000;
        margin-bottom: 2rem;
    }

    .custom-label {
        font-weight: 500;
        color: #000;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .custom-input {
        background-color: #d8d8d8;
        border: none;
        border-radius: 12px;
        padding: 12px 18px;
        color: #333;
        width: 100%;
        font-size: 14px;
        transition: box-shadow 0.2s ease-in-out, background-color 0.2s ease-in-out;
    }

        .custom-input:focus {
            outline: none;
            box-shadow: 0 0 0 2px #E24D17;
            background-color: #e2e2e2;
        }

    select.custom-input {
        appearance: auto;
    }

    .btn-cancel {
        border: 1px solid #E24D17;
        background-color: #ffffff;
        color: #000;
        border-radius: 30px;
        padding: 10px 45px;
        font-weight: 700;
        font-size: 15px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

        .btn-cancel:hover {
            background-color: #fffaf8;
            color: #E24D17;
        }

    .btn-create {
        background-color: #E24D17;
        border: 1px solid #E24D17;
        color: #fff;
        border-radius: 30px;
        padding: 10px 45px;
        font-weight: 700;
        font-size: 15px;
        transition: all 0.3s ease;
    }

        .btn-create:hover {
            background-color: #c84111;
            border-color: #c84111;
            color: #fff;
        }

    .custom-input.is-invalid {
        box-shadow: 0 0 0 2px #D41212;
        background-color: #ffe6e6;
    }

    .error-msg {
        color: #D41212;
        font-size: 12px;
        margin-top: 5px;
        margin-left: 10px;
        display: block;
    }

    /* Account Toggle Section Styles */
    .account-toggle-btn {
        background-color: transparent;
        border: 2px dashed #E24D17;
        color: #E24D17;
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 600;
        font-size: 14px;
        width: 50%;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
    }

        .account-toggle-btn:hover,
        .account-toggle-btn.active {
            background-color: #E24D17;
            color: #ffffff;
            border-style: solid;
        }

    .account-fields-container {
        display: none;
        background-color: #f8f9fa;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #e0e0e0;
        margin-top: 1rem;
        animation: fadeIn 0.3s ease-in-out;
    }
</style>

<div class="page-center-wrapper">
    <div class="create-card shadow">
        <h2 class="title-header">Create new employee</h2>

        <form id="employeeForm" asp-controller="Employee" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label class="custom-label" asp-for="Name">Full Name</label>
                    <input type="text" asp-for="Name" id="empName" class="custom-input" placeholder="Adham Amr Mohamed">
                    <span asp-validation-for="Name" class="error-msg"></span>
                </div>

                <div class="col-md-6">
                    <label class="custom-label" asp-for="NationalID">National ID</label>
                    <input type="text" asp-for="NationalID" id="empNid" class="custom-input" placeholder="30906070123456" maxlength="14" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                    <span asp-validation-for="NationalID" class="error-msg"></span>
                </div>

                <div class="col-md-6">
                    <label class="custom-label" asp-for="EmpCode">Employee Code</label>
                    <input type="text" asp-for="EmpCode" id="empCode" class="custom-input" placeholder="EMP001">
                    <span asp-validation-for="EmpCode" class="error-msg"></span>
                </div>

                <div class="col-md-6">
                    <label class="custom-label" asp-for="Position">Position</label>
                    <input type="text" asp-for="Position" id="empPosition" class="custom-input" placeholder="Software Engineer">
                    <span asp-validation-for="Position" class="error-msg"></span>
                </div>
            </div>

            <div class="mb-5">
                <input type="hidden" asp-for="HasAccount" id="hasAccountInput" value="false" />

                <button type="button" id="toggleAccountBtn" class="account-toggle-btn">
                    <i class="fa-solid fa-user-plus"></i>  User Account
                </button>

                <div id="accountFields" class="account-fields-container">
                    <h6 class="fw-bold mb-3 text-dark">User Account Credentials</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="custom-label" asp-for="Username">Username</label>
                            <input type="text" asp-for="Username" id="username" class="custom-input" placeholder="adham.amr">
                            <span asp-validation-for="Username" class="error-msg" id="usernameError"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="custom-label" asp-for="Password">Password</label>
                            <input type="password" asp-for="Password" id="password" class="custom-input" placeholder="••••••••">
                            <span asp-validation-for="Password" class="error-msg" id="passwordError"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="custom-label" asp-for="Email">Email</label>
                            <input type="email" asp-for="Email" id="email" class="custom-input" placeholder="adham.amr@company.com">
                            <span asp-validation-for="Email" class="error-msg" id="emailError"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="custom-label" asp-for="GroupId">Group</label>
                            <select asp-for="GroupId" asp-items="Model.Groups" id="groupId" class="custom-input">
                                <option value="">Select Group</option>
                            </select>
                            <span asp-validation-for="GroupId" class="error-msg" id="groupIdError"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3">
                <a class="btn btn-cancel" asp-controller="Employee" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-create">Create</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('toggleAccountBtn');
            const accountFields = document.getElementById('accountFields');
            const hasAccountInput = document.getElementById('hasAccountInput');
            const usernameInput = document.getElementById('username');
            const passwordInput = document.getElementById('password');
            const emailInput = document.getElementById('email');
            const groupIdInput = document.getElementById('groupId');
            let hasAccount = false;

            // Toggle logic for User Account section
            toggleBtn.addEventListener('click', function () {
                hasAccount = !hasAccount;
                hasAccountInput.value = hasAccount ? 'true' : 'false';

                if (hasAccount) {
                    accountFields.style.display = 'block';
                    toggleBtn.classList.add('active');
                    toggleBtn.innerHTML = '<i class="fa-solid fa-user-check"></i> User Account Included (Click to remove)';
                } else {
                    accountFields.style.display = 'none';
                    toggleBtn.classList.remove('active');
                    toggleBtn.innerHTML = '<i class="fa-solid fa-user-plus"></i> Create User Account for Employee';

                    // Clear values and errors if toggled off
                    usernameInput.value = '';
                    passwordInput.value = '';
                    emailInput.value = '';
                    groupIdInput.value = '';
                    usernameInput.classList.remove('is-invalid');
                    passwordInput.classList.remove('is-invalid');
                    emailInput.classList.remove('is-invalid');
                    groupIdInput.classList.remove('is-invalid');
                }
            });

            // Form Submit Validation
            document.getElementById('employeeForm').addEventListener('submit', function (event) {
                let isValid = true;

                // Clear previous errors
                document.querySelectorAll('.is-invalid').forEach(function(el) {
                    el.classList.remove('is-invalid');
                });

                // Validate Name
                const name = document.getElementById('empName');
                if (!name.value || name.value.trim() === '') {
                    name.classList.add('is-invalid');
                    isValid = false;
                }

                // Validate National ID (14 digits)
                const nid = document.getElementById('empNid');
                if (!nid.value || nid.value.trim().length !== 14) {
                    nid.classList.add('is-invalid');
                    isValid = false;
                }

                // Validate Account inputs if user enabled the account section
                if (hasAccount) {
                    if (!usernameInput.value || usernameInput.value.trim() === '') {
                        usernameInput.classList.add('is-invalid');
                        isValid = false;
                    }

                    if (!passwordInput.value || passwordInput.value.trim() === '') {
                        passwordInput.classList.add('is-invalid');
                        isValid = false;
                    }

                    if (!emailInput.value || emailInput.value.trim() === '') {
                        emailInput.classList.add('is-invalid');
                        isValid = false;
                    }

                    if (!groupIdInput.value) {
                        groupIdInput.classList.add('is-invalid');
                        isValid = false;
                    }
                }

                if (!isValid) {
                    event.preventDefault();
                }
            });
        });
    </script>
}