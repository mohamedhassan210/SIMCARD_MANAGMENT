@model Sim_Card_Managment.Viewmodel.InternetLineEditViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Internet Line</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-orange: #DF531B;
            --brand-orange-light: #FFF8F6;
            --brand-purple: #5B2D90;
            --bg-canvas: #F4F5F8;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --card-border: #E2E8F0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, sans-serif;
            padding-bottom: 3rem;
        }

        .form-card {
            max-width: 760px;
            margin: 3rem auto 0 auto;
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            overflow: hidden;
        }

        .card-header-styled {
            border-bottom: 1px solid var(--card-border);
            padding: 1.5rem 2rem;
            background: linear-gradient(180deg, var(--brand-orange-light) 0%, #FFFFFF 100%);
        }

        .section-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background-color: rgba(223, 83, 27, 0.12);
            color: var(--brand-orange);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .form-label-custom {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 6px;
            display: block;
        }

        .input-group-custom {
            display: flex;
            align-items: center;
            background: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 0 14px;
            transition: all 0.2s ease;
        }

            .input-group-custom:focus-within {
                border-color: var(--brand-orange);
                box-shadow: 0 0 0 3px rgba(223, 83, 27, 0.1);
            }

            .input-group-custom i {
                color: var(--text-muted);
                font-size: 1rem;
                margin-right: 10px;
            }

        .form-control-custom, .form-select-custom {
            border: none;
            outline: none;
            background: transparent;
            font-size: 0.95rem;
            width: 100%;
            height: 48px;
            color: var(--text-dark);
            font-weight: 500;
        }

        textarea.form-control-custom {
            height: auto;
            padding: 12px 0;
            resize: vertical;
            min-height: 90px;
        }

        .form-select-custom {
            cursor: pointer;
        }

        .btn-custom {
            height: 48px;
            padding: 0 28px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary-orange {
            background-color: var(--brand-orange);
            color: #FFFFFF;
        }

            .btn-primary-orange:hover {
                background-color: #c94614;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(223, 83, 27, 0.25);
            }

        .btn-secondary-soft {
            background-color: #F1F5F9;
            color: var(--text-muted);
            border: 1px solid var(--card-border);
        }

            .btn-secondary-soft:hover {
                background-color: #E2E8F0;
                color: var(--text-dark);
            }

        /* SIM Card selection styles */
        .selection-card {
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 18px;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            height: 100%;
            background-color: #FFFFFF;
        }

            .selection-card:hover {
                border-color: #C9CED8;
            }

            .selection-card.active {
                border: 1.5px solid var(--brand-orange);
                background-color: var(--brand-orange-light);
            }

        .sim-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .sp-logo-img {
            height: 22px;
            max-width: 70px;
            object-fit: contain;
        }

        .badge-available {
            font-size: 0.65rem;
            font-weight: 700;
            color: #198754;
            border: 1px solid #198754;
            border-radius: 12px;
            padding: 3px 8px;
        }

        .badge-current {
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--brand-orange);
            border: 1px solid var(--brand-orange);
            border-radius: 12px;
            padding: 3px 8px;
        }

        .card-title-text {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 4px;
            color: var(--text-dark);
        }

        .card-subtitle-text {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin: 0;
        }

        .check-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--brand-orange);
            font-size: 1.4rem;
            display: none;
        }

        .selection-card.active .check-icon {
            display: block;
        }

        .sim-status-text {
            font-size: 0.8rem;
            color: var(--brand-orange);
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
    </style>
</head>
<body>

    <main class="container px-3 p-100">

        <div class="form-card">

            <div class="card-header-styled d-flex align-items-center gap-3">
                <div class="section-icon-wrapper">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">Edit Internet Line</h3>
                    <p class="m-0 text-muted small">Update internet line details and status for this branch</p>
                </div>
            </div>

            <form asp-controller="InternetLine" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="p-4 p-md-5">
                    <div class="row g-4">

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Branch</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-building"></i>
                                <select asp-for="BranchId" asp-items="Model.Branches" class="form-select-custom">
                                    <option value="">Select branch</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Service Provider</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-tower-cell"></i>
                                <select asp-for="ServiceProviderId" asp-items="Model.ServiceProviders" class="form-select-custom">
                                    <option value="">Select provider</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Service Type</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-diagram-project"></i>
                                <select asp-for="ServiceTypeId" asp-items="Model.ServiceTypes" class="form-select-custom">
                                    <option value="">Select service type</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Payment Type</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-credit-card"></i>
                                <select asp-for="PaymentTypeId" asp-items="Model.PaymentTypes" class="form-select-custom">
                                    <option value="">Select payment type</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">
                                <i class="fa-solid fa-sim-card"></i> SIM Card
                            </label>
                            <input asp-for="PhoneNumber" type="hidden" id="PhoneNumber" />
                            <input asp-for="SimId" type="hidden" id="SimId" />

                            <div class="row g-3 mb-3" id="selectedSimContainer"></div>

                            <div class="input-group-custom mb-3">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input type="text" id="simSearchInput" class="form-control-custom" placeholder="Search by phone number or serial...">
                            </div>

                            <div class="row g-3" id="simCardsContainer">
                                <div class="col-12 text-muted small fst-italic">
                                    Search above to change the assigned SIM card.
                                </div>
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Bandwidth</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-gauge-high"></i>
                                <input asp-for="Bandwidth" class="form-control-custom" placeholder="e.g., 100 Mbps">
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Renewal Type</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-rotate"></i>
                                <select asp-for="RenewaltypeId" asp-items="Model.RenewalTypes" id="renewalTypeSelect" class="form-select-custom">
                                    <option value="">Select renewal type</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Last Renewal Date</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-calendar-day"></i>
                                <input asp-for="LastRenewalDate" type="date" id="lastRenewalInput" class="form-control-custom">
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Next Renewal Date</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-calendar-check"></i>
                                <input asp-for="NextRenewalDate" type="date" id="nextRenewalInput" class="form-control-custom">
                            </div>
                            <span class="text-muted small">Auto-fills from Last Renewal Date + Renewal Type — edit it directly to correct a mistake.</span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Quota (GB)</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-database"></i>
                                <input asp-for="QuotaGB" type="number" class="form-control-custom" placeholder="e.g., 500">
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label-custom">Status</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-circle-dot"></i>
                                <select asp-for="Status" class="form-select-custom">
                                    <option value="">Select line status</option>
                                    <option value="true">Up (Active)</option>
                                    <option value="false">Down (Inactive)</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">Notes</label>
                            <div class="input-group-custom align-items-start pt-2">
                                <i class="fa-regular fa-comment-dots mt-2"></i>
                                <textarea asp-for="Notes" class="form-control-custom" placeholder="Additional details or configuration notes..."></textarea>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-controller="InternetLine" asp-action="Index" class="btn-custom btn-secondary-soft">Cancel</a>
                        <button type="submit" class="btn-custom btn-primary-orange">
                            <i class="fa-solid fa-floppy-disk"></i> Save Changes
                        </button>
                    </div>

                </div>
            </form>

        </div>

    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Auto-calculate Next Renewal Date from Last Renewal Date + Renewal Type -->
    <script>
        (function () {
            var durations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RenewalTypeDurations));

            var renewalTypeSelect = document.getElementById('renewalTypeSelect');
            var lastRenewalInput = document.getElementById('lastRenewalInput');
            var nextRenewalInput = document.getElementById('nextRenewalInput');

            function addMonthsToDateString(dateStr, months) {
                var parts = dateStr.split('-');
                var year = parseInt(parts[0], 10);
                var month = parseInt(parts[1], 10) - 1;
                var day = parseInt(parts[2], 10);

                var d = new Date(year, month, day);
                d.setMonth(d.getMonth() + months);

                var yyyy = d.getFullYear();
                var mm = String(d.getMonth() + 1).padStart(2, '0');
                var dd = String(d.getDate()).padStart(2, '0');
                return yyyy + '-' + mm + '-' + dd;
            }

            function recalcNextRenewal() {
                var typeId = renewalTypeSelect.value;
                var lastDateVal = lastRenewalInput.value;

                if (!typeId || !lastDateVal || !(typeId in durations)) return;

                nextRenewalInput.value = addMonthsToDateString(lastDateVal, durations[typeId]);
            }

            if (renewalTypeSelect) renewalTypeSelect.addEventListener('change', recalcNextRenewal);
            if (lastRenewalInput) lastRenewalInput.addEventListener('change', recalcNextRenewal);
        })();
    </script>

    <!-- SIM Card Picker -->
    <script>
        var currentLineId = @Model.Id;

        var selectedSim = {
            id: @Html.Raw(Model.SimId.HasValue ? Model.SimId.Value.ToString() : "null"),
            phoneNumber: @Html.Raw(string.IsNullOrEmpty(Model.PhoneNumber) ? "null" : System.Text.Json.JsonSerializer.Serialize(Model.PhoneNumber)),
            serialNumber: @Html.Raw(string.IsNullOrEmpty(Model.SimSerialNumber) ? "null" : System.Text.Json.JsonSerializer.Serialize(Model.SimSerialNumber)),
            providerName: @Html.Raw(string.IsNullOrEmpty(Model.SimProviderName) ? "null" : System.Text.Json.JsonSerializer.Serialize(Model.SimProviderName))
        };

        function getProviderLogo(providerName) {
            var name = (providerName || '').toLowerCase();
            if (name.includes('orange')) return '/img/orange.png';
            if (name.includes('vodafone') || name.includes('fodafone')) return '/img/fodafone.png';
            if (name.includes('we')) return '/img/we.png';
            if (name.includes('etisalat')) return '/img/etisalat-logo.png';
            return '';
        }

        function renderSelectedCard() {
            if (!selectedSim.id) {
                $('#selectedSimContainer').empty();
                return;
            }
            var logoSrc = getProviderLogo(selectedSim.providerName);
            var logoHtml = logoSrc
                ? '<img src="' + logoSrc + '" alt="' + (selectedSim.providerName || '') + '" class="sp-logo-img" />'
                : '<span class="fw-bold text-dark" style="font-size:0.85rem">' + (selectedSim.providerName || 'Unknown') + '</span>';

            var html = '<div class="col-md-6">' +
                '<div class="selection-card active" onclick="deselectSim()" title="Click to remove this SIM">' +
                '<div class="sim-card-header">' + logoHtml + '<span class="badge-current">Current</span></div>' +
                '<div class="card-title-text">' + selectedSim.phoneNumber + '</div>' +
                '<p class="card-subtitle-text">Provider : ' + (selectedSim.providerName || 'Unknown') + '</p>' +
                '<p class="card-subtitle-text">Serial : ' + (selectedSim.serialNumber || '—') + '</p>' +
                '<i class="fas fa-check-circle check-icon"></i>' +
                '</div></div>';
            $('#selectedSimContainer').html(html);
        }

        function deselectSim() {
            selectedSim = { id: null, phoneNumber: null, serialNumber: null, providerName: null };
            $('#PhoneNumber').val('');
            $('#SimId').val('');
            renderSelectedCard();
            loadSims($('#simSearchInput').val());
        }

        function selectSim(simId, phoneNumber, serialNumber, providerName) {
            selectedSim = { id: simId, phoneNumber: phoneNumber, serialNumber: serialNumber, providerName: providerName };
            $('#PhoneNumber').val(phoneNumber);
            $('#SimId').val(simId);
            renderSelectedCard();
            loadSims($('#simSearchInput').val());
        }

        $('#simSearchInput').on('input', function () {
            loadSims($(this).val());
        });

        function loadSims(query) {
            if (!query || !query.trim()) {
                $('#simCardsContainer').html('<div class="col-12 text-muted small fst-italic">Search above to change the assigned SIM card.</div>');
                return;
            }
            $.get('/InternetLine/SearchSims', { query: query, currentLineId: currentLineId })
                .done(function (data) {
                    var html = '';
                    var results = (data || []).filter(function (sim) {
                        return String(sim.id) !== String(selectedSim.id);
                    });
                    if (results.length === 0) {
                        html = '<div class="col-12 text-muted small">No available SIM cards found.</div>';
                    } else {
                        results.forEach(function (sim) {
                            var logoSrc = getProviderLogo(sim.providerName);
                            var logoHtml = logoSrc
                                ? '<img src="' + logoSrc + '" alt="' + sim.providerName + '" class="sp-logo-img" />'
                                : '<span class="fw-bold text-dark" style="font-size:0.85rem">' + sim.providerName + '</span>';

                            html += '<div class="col-md-6">' +
                                '<div class="selection-card" onclick="selectSim(\'' + sim.id + '\', \'' + sim.phoneNumber + '\', \'' + sim.serialNumber + '\', \'' + sim.providerName + '\')">' +
                                '<div class="sim-card-header">' + logoHtml + '<span class="badge-available">Active</span></div>' +
                                '<div class="card-title-text">' + sim.phoneNumber + '</div>' +
                                '<p class="card-subtitle-text">Provider : ' + sim.providerName + '</p>' +
                                '<p class="card-subtitle-text">Serial : ' + sim.serialNumber + '</p>' +
                                '<i class="fas fa-check-circle check-icon"></i>' +
                                '</div></div>';
                        });
                    }
                    $('#simCardsContainer').html(html);
                })
                .fail(function (xhr) {
                    console.error('SearchSims failed:', xhr.status, xhr.responseText);
                    $('#simCardsContainer').html(
                        '<div class="col-12 text-danger small">Search failed (HTTP ' + xhr.status + '). Check the console/network tab.</div>'
                    );
                });
        }

        $(document).ready(function () {
            renderSelectedCard();
        });
    </script>
</body>
</html>
