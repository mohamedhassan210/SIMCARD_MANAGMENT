@model IEnumerable<Sim_Card_Managment.Viewmodel.InternetLineListItemViewModel>

@{
    ViewData["Title"] = "Internet Lines Directory";
    var lineList = Model?.ToList() ?? new List<Sim_Card_Managment.Viewmodel.InternetLineListItemViewModel>();
    int totalCount = lineList.Count;
    int activeCount = lineList.Count(x => x.Status);
    int inactiveCount = lineList.Count(x => !x.Status);
}

<style>
    /* Theme & Layout Variables */
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
        --bg-light: #f8f9fa;
    }

    /* Page Header */
    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    /* Primary & Secondary Action Buttons */
    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    .btn-secondary-soft {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 12px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-soft:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    .btn-action-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        background: #ffffff;
        color: #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .btn-action-icon:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    .btn-action-text {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        background-color: #ffffff;
        color: #495057;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-action-text:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

            .btn-action-text:hover i {
                color: var(--primary-orange) !important;
            }

    /* Search Bar Wrapper */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.92rem;
            color: #333333;
            padding: 4px 0;
        }

    /* Custom Form Selects */
    .custom-select-control {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 8px 14px;
        font-size: 0.92rem;
        color: #333333;
        background-color: #ffffff;
        transition: border-color 0.2s ease;
    }

        .custom-select-control:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
            outline: none;
        }

    /* Badges */
    .badge-status-active {
        background-color: #e6f4ea;
        color: #137333;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-status-inactive {
        background-color: #fce8e6;
        color: #c5221f;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-renewal-due {
        background-color: #fce8e6;
        color: #c5221f;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-renewal-ok {
        color: #333333;
        font-size: 0.85rem;
    }

    /* Table Interactive Rows */
    .clickable-row {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .clickable-row.inactive-row {
            opacity: 0.7;
            background-color: #fafafa;
        }

    /* Pagination Styles */
    .pagination-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid #e0e0e0;
        background: #ffffff;
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .pagination-btn:hover:not([disabled]) {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

        .pagination-btn.active {
            background: var(--primary-orange);
            border-color: var(--primary-orange);
            color: #ffffff;
        }

        .pagination-btn[disabled] {
            opacity: 0.4;
            cursor: not-allowed;
        }
</style>

<div class="container-fluid px-4 p-100">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">Internet Lines</h1>
            <p class="page-header-subtitle mb-0">Manage internet connections, bandwidth, and operational status across all branches.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="#" id="exportLineExcelBtn" class="btn-secondary-soft">
                <i class="fas fa-file-excel text-success"></i>
                <span>Excel</span>
            </a>

            <a asp-controller="PaymentType" asp-action="Index" class="btn-secondary-soft">
                <i class="fas fa-credit-card"></i>
                <span>Payment Types</span>
            </a>

            <a asp-controller="ServiceType" asp-action="Index" class="btn-secondary-soft">
                <i class="fas fa-diagram-project"></i>
                <span>Service Types</span>
            </a>

            <a asp-controller="InternetLine" asp-action="Dashboard" class="btn-secondary-soft">
                <i class="fas fa-chart-line"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="InternetLine" asp-action="Create" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New Line</span>
            </a>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total Lines</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #E24D17;">
                        <i class="fas fa-globe fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Active (Up)</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@activeCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #198754;">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Offline (Down)</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@inactiveCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #dc3545;">
                        <i class="fas fa-times-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Container -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <!-- Controls / Filters Header -->
        <div class="row g-3 align-items-end mb-4">
            <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                <label for="statusFilter" class="form-label text-muted small fw-medium mb-1">Status</label>
                <select id="statusFilter" class="form-select custom-select-control">
                    <option value="ALL">All Statuses</option>
                    <option value="UP">Up (Active)</option>
                    <option value="DOWN">Down (Inactive)</option>
                </select>
            </div>

            <div class="col-12 col-md-9 col-xl-10">
                <label for="lineSearchInput" class="form-label text-muted small fw-medium mb-1">Search Lines</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="lineSearchInput" placeholder="Search by branch, provider, service, or phone number..." autocomplete="off">
                </div>
            </div>
        </div>

        <!-- Table View -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="lineTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th scope="col" style="width: 14%;">Branch</th>
                        <th scope="col" style="width: 12%;">ISP</th>
                        <th scope="col" style="width: 12%;">Service Type</th>
                        <th scope="col" style="width: 12%;">Payment Type</th>
                        <th scope="col" style="width: 12%;">Phone Number</th>
                        <th scope="col" style="width: 9%;">Bandwidth</th>
                        <th scope="col" style="width: 7%;">Status</th>
                        <th scope="col" style="width: 12%;">Next Renewal</th>
                        <th scope="col" style="width: 5%;">Created By</th>
                        <th scope="col" class="text-end" style="width: 5%;">Actions</th>
                    </tr>
                </thead>
                <tbody id="lineTableBody">
                    @if (lineList.Any())
                    {
                        foreach (var item in lineList)
                        {
                            var statusAttr = item.Status ? "UP" : "DOWN";
                            var rowClass = !item.Status ? "clickable-row inactive-row" : "clickable-row";

                            <tr class="@rowClass" data-status="@statusAttr" data-href="@Url.Action("Details", "InternetLine", new { id = item.Id })">
                                <td>
                                    <span class="fw-bold text-dark fs-6">@item.BranchName</span>
                                </td>
                                <td>
                                    <span class="text-dark small fw-medium">@item.ServiceProviderName</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.ServiceTypeName</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.PaymentTypeName</span>
                                </td>
                                <td>
                                    <code class="text-dark fw-semibold">@(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)</code>
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(item.Bandwidth) ? "N/A" : item.Bandwidth)</span>
                                </td>
                                <td>
                                    @if (item.Status)
                                    {
                                        <span class="badge-status-active">
                                            <i class="fas fa-circle" style="font-size: 6px;"></i> Up
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-inactive">
                                            <i class="fas fa-circle" style="font-size: 6px;"></i> Down
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.NextRenewalDate.HasValue)
                                    {
                                        if (item.IsDueForRenewal)
                                        {
                                            <span class="badge-renewal-due" title="@item.RenewalTypeName">
                                                <i class="fas fa-triangle-exclamation"></i>
                                                @item.NextRenewalDate.Value.ToString("dd MMM yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-renewal-ok" title="@item.RenewalTypeName">
                                                @item.NextRenewalDate.Value.ToString("dd MMM yyyy")
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">@item.CreatedByUsername</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-controller="InternetLine" asp-action="Details" asp-route-id="@item.Id" class="btn-action-text" title="View Details">
                                            <i class="fa-solid fa-eye text-muted"></i>
                                            <span>Details</span>
                                        </a>
                                        <a asp-controller="InternetLine" asp-action="Edit" asp-route-id="@item.Id" class="btn-action-icon" title="Edit Line">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="10" class="text-center text-muted py-4">
                            No matching internet lines found.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer / Pagination -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 mt-4 pt-3 border-top">
            <span class="text-muted small" id="showingText">Showing 0 records</span>
            <div class="d-flex align-items-center gap-1" id="paginationContainer"></div>
        </div>

    </div>
</div>

<!-- Dynamic Search, Filter & Pagination Script -->
<script>
        const exportLineExcelBtn = document.getElementById('exportLineExcelBtn');
    if (exportLineExcelBtn) {
        exportLineExcelBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const url = new URL('@Url.Action("ExportToExcel", "InternetLine")', window.location.origin);
            const statusVal = document.getElementById('statusFilter').value; // "ALL", "UP", or "DOWN" — read at click time
            if (statusVal && statusVal !== 'ALL') {
                url.searchParams.set('status', statusVal.toLowerCase());
            }
            window.location.href = url.toString();
        });
    }
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("lineSearchInput");
        const statusFilter = document.getElementById("statusFilter");
        const allRows = Array.from(document.querySelectorAll("#lineTableBody tr.clickable-row"));
        const noResultsRow = document.getElementById("noResultsRow");
        const showingText = document.getElementById("showingText");
        const paginationContainer = document.getElementById("paginationContainer");

        const itemsPerPage = 7;
        let visibleRows = [...allRows];
        let currentPage = 1;

        function renderTable() {
            const totalVisible = visibleRows.length;
            const totalPages = Math.max(1, Math.ceil(totalVisible / itemsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx = startIdx + itemsPerPage;

            // Hide all rows initially
            allRows.forEach(row => row.style.display = "none");

            // Display current page slice
            visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

            // Handle empty search / filter state
            if (totalVisible === 0) {
                if (noResultsRow) noResultsRow.style.display = "";
                showingText.textContent = "Showing 0 records";
                paginationContainer.innerHTML = "";
                return;
            } else {
                if (noResultsRow) noResultsRow.style.display = "none";
            }

            // Update stats counter text
            const actualEnd = Math.min(endIdx, totalVisible);
            showingText.textContent = `Showing ${startIdx + 1}-${actualEnd} of ${totalVisible} records`;

            // Build pagination HTML
            let html = `<button type="button" class="pagination-btn" id="prevBtn" ${currentPage === 1 ? 'disabled' : ''}>&lsaquo;</button>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<button type="button" class="pagination-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
            }

            html += `<button type="button" class="pagination-btn" id="nextBtn" ${currentPage === totalPages ? 'disabled' : ''}>&rsaquo;</button>`;

            paginationContainer.innerHTML = html;
        }

        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value.toUpperCase();

            visibleRows = allRows.filter(row => {
                const text = row.innerText.toLowerCase();
                const matchesSearch = text.includes(query);

                const rowStatus = (row.getAttribute("data-status") || "UP").toUpperCase();
                const matchesStatus = (selectedStatus === "ALL" || rowStatus === selectedStatus);

                return matchesSearch && matchesStatus;
            });

            currentPage = 1;
            renderTable();
        }

        // Attach event listeners
        if (searchInput) searchInput.addEventListener("input", applyFilters);
        if (statusFilter) statusFilter.addEventListener("change", applyFilters);

        // Pagination delegation
        paginationContainer.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn || btn.disabled) return;

            if (btn.id === "prevBtn") {
                if (currentPage > 1) currentPage--;
            } else if (btn.id === "nextBtn") {
                const totalPages = Math.ceil(visibleRows.length / itemsPerPage);
                if (currentPage < totalPages) currentPage++;
            } else if (btn.dataset.page) {
                currentPage = parseInt(btn.dataset.page, 10);
            }

            renderTable();
        });

        // Initial render
        applyFilters();
    });
</script>