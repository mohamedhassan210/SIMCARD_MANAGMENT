@model Sim_Card_Managment.Viewmodel.InternetLineDetailsViewModel

@{
    ViewData["Title"] = "Internet Line Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Internet Line Details</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .id-btn-action {
          
            
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #E2E8F0;
            background-color: #DF531B;
            color: #FFFFFF;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

            .id-btn-action:hover {
                background: #FFF8F6;
                color: #DF531B;
                border-color: rgba(223, 83, 27, 0.3);
            }

       
    </style>
</head>
<body>
    <section class="bd-body">
        <main class="container-fluid px-lg-5 p-100">

            <!-- Internet Line Details Header Card -->
            <div class="bd-card mb-4">
                <div class="bd-card-header d-flex align-items-center justify-content-between p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bd-icon-wrapper">
                            <i class="fa-solid fa-globe"></i>
                        </div>
                        <div>
                            <h3 class="m-0 fs-5 fw-bold text-dark">Internet Line Details</h3>
                            <p class="m-0 text-muted small">Comprehensive view of internet line configuration and state</p>
                        </div>
                    </div>
                    <div>
                        @if (Model.Status)
                        {
                            <span class="bd-badge-up"><i class="fa-solid fa-circle"></i> Active / Up</span>
                        }
                        else
                        {
                            <span class="bd-badge-down"><i class="fa-solid fa-circle"></i> Down / Inactive</span>
                        }
                    </div>
                </div>

                <div class="p-4 p-md-5 border-top">
                    <div class="row g-4">

                        <!-- Branch -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Branch Name</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-building text-muted me-2"></i>
                                @Model.BranchName
                            </div>
                        </div>

                        <!-- Service Provider -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Service Provider Name</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-tower-cell text-muted me-2"></i>
                                @Model.ServiceProviderName
                            </div>
                        </div>

                        <!-- Service Type -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Service Type</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-diagram-project text-muted me-2"></i>
                                @Model.ServiceTypeName
                            </div>
                        </div>

                        <!-- Payment Type -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Payment Type</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-credit-card text-muted me-2"></i>
                                @Model.PaymentTypeName
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Phone Number</div>
                            <div class="bd-info-value">
                                <code class="bd-code">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</code>
                            </div>
                        </div>

                        <!-- Bandwidth -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Bandwidth</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-gauge-high text-muted me-2"></i>
                                @(string.IsNullOrEmpty(Model.Bandwidth) ? "N/A" : Model.Bandwidth)
                            </div>
                        </div>

                        <!-- Renewal Type -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Renewal Type</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-rotate text-muted me-2"></i>
                                @Model.RenewalTypeName
                            </div>
                        </div>

                        <!-- Last Renewal Date -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Last Renewal Date</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-calendar-day text-muted me-2"></i>
                                @(Model.LastRenewalDate?.ToString("MMM dd, yyyy") ?? "N/A")
                            </div>
                        </div>

                        <!-- Next Renewal Date -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Next Renewal Date</div>
                            <div class="bd-info-value">
                                @{
                                    bool isDue = Model.NextRenewalDate.HasValue && Model.NextRenewalDate.Value <= DateOnly.FromDateTime(DateTime.Now);
                                }
                                <i class="fa-solid fa-calendar-check @(isDue ? "text-danger" : "text-muted") me-2"></i>
                                @if (Model.NextRenewalDate.HasValue)
                                {
                                    <span class="@(isDue ? "text-danger fw-bold" : "")">
                                        @Model.NextRenewalDate.Value.ToString("MMM dd, yyyy")
                                        @(isDue ? " (Due)" : "")
                                    </span>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </div>
                        </div>

                        <!-- Quota GB -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Quota</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-database text-muted me-2"></i>
                                @(Model.QuotaGB.HasValue ? $"{Model.QuotaGB} GB" : "N/A")
                            </div>
                        </div>

                        <!-- SIM Serial Number -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">SIM Serial</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-sim-card text-muted me-2"></i>
                                @(string.IsNullOrEmpty(Model.SimSerial) ? "N/A" : Model.SimSerial)
                            </div>
                        </div>

                        <!-- Created By -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Created By</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-user text-muted me-2"></i>
                                @(string.IsNullOrEmpty(Model.CreatedByUsername) ? "System" : Model.CreatedByUsername)
                            </div>
                        </div>

                        <!-- Notes & Remarks -->
                        <div class="col-12">
                            <div class="bd-info-label">Notes & Remarks</div>
                            <div class="bd-info-value">
                                @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded." : Model.Notes)
                            </div>
                        </div>

                    </div>

                    <!-- Actions Footer -->
                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-controller="InternetLine" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back
                        </a>

                        <form asp-controller="InternetLine" asp-action="Renew" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Renew this line now? This will extend the next renewal date by one cycle.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-primary rounded-pill px-4">
                                <i class="fa-solid fa-rotate me-1"></i> Renew Now
                            </button>
                        </form>

                        <a asp-controller="InternetLine" asp-action="Edit" asp-route-id="@Model.Id" class="btn id-btn-action px-3 rounded-pill ">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Line
                        </a>
                    </div>
                </div>
            </div>

        </main>
    </section>
</body>
</html>