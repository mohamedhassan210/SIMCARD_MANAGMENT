@model Sim_Card_Managment.Models.Sim

@{
    Layout = null;
}

<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit SIM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>

<section class="es-body">

    <div class="es-card shadow">
        <h2 class="es-title">Edit SIM Card</h2>

        <div id="es-form-errors" class="alert alert-danger" style="display:none;">
            <i class="fas fa-exclamation-circle me-2"></i>
            <span id="es-form-error-text">Please fix the errors below.</span>
        </div>

        <form id="es-edit-form" asp-controller="SIM" asp-action="Edit" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RegisteredAt" />

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="es-label" asp-for="SerialNumber">
                        <i class="fas fa-hashtag"></i> Serial Number <span class="text-danger">*</span>
                    </label>
                    <div class="es-input-wrapper">
                        <input type="text"
                               class="es-input"
                               id="es-serial-input"
                               asp-for="SerialNumber"
                               placeholder="Enter serial number"
                               maxlength="30"
                               required />
                        <i class="fas fa-check-circle es-success-icon" id="es-serial-success"></i>
                    </div>
                    <span asp-validation-for="SerialNumber" class="es-error" id="es-serial-error"></span>
                    <small class="es-helper" id="es-serial-helper">
                        <i class="fas fa-info-circle"></i> Serial number must be at least 5 characters
                    </small>
                </div>

                <div class="col-md-6">
                    <label class="es-label" asp-for="PhoneNumber">
                        <i class="fas fa-phone"></i> Phone Number <span class="text-danger">*</span>
                    </label>
                    <div class="es-input-wrapper">
                        <input type="text"
                               class="es-input"
                               id="es-phone-input"
                               asp-for="PhoneNumber"
                               placeholder="e.g. 01012345678"
                               maxlength="15"
                               required />
                        <i class="fas fa-check-circle es-success-icon" id="es-phone-success"></i>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="es-error" id="es-phone-error"></span>
                    <small class="es-helper" id="es-phone-helper">
                        <i class="fas fa-info-circle"></i> Enter a valid Egyptian phone number (010, 011, 012, 015)
                    </small>
                </div>

                <div class="col-md-6">
                    <label class="es-label" asp-for="NetworkType">
                        <i class="fas fa-wifi"></i> Network Type <span class="text-danger">*</span>
                    </label>
                    <select class="es-select" id="es-network-select" asp-for="NetworkType" required>
                        <option value="">-- Select Network --</option>
                        <option value="4G">4G</option>
                        <option value="5G">5G</option>
                        <option value="3G">3G</option>
                    </select>
                    <span asp-validation-for="NetworkType" class="es-error" id="es-network-error"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">
                <a class="es-btn-cancel" asp-controller="SIM" asp-action="Index">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
                <button type="submit" class="es-btn-save" id="es-save-btn">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
            </div>

        </form>
    </div>

 
</section>
<script>


    const phoneRegex = /^(010|011|012|015)\d{8}$/;

    const MIN_SERIAL_LENGTH = 5;
    const MAX_SERIAL_LENGTH = 30;

    function validateSerial(value) {
        const trimmed = value.trim();
        if (!trimmed) {
            return { valid: false, message: 'Serial number is required.' };
        }
        if (trimmed.length < MIN_SERIAL_LENGTH) {
            return { valid: false, message: `Serial number must be at least ${MIN_SERIAL_LENGTH} characters.` };
        }
        if (trimmed.length > MAX_SERIAL_LENGTH) {
            return { valid: false, message: `Serial number cannot exceed ${MAX_SERIAL_LENGTH} characters.` };
        }
        if (/[^a-zA-Z0-9\-_]/.test(trimmed)) {
            return { valid: false, message: 'Serial number contains invalid characters. Use letters, numbers, hyphens, or underscores.' };
        }
        return { valid: true, message: '' };
    }

    function validatePhone(value) {
        const trimmed = value.trim();
        if (!trimmed) {
            return { valid: false, message: 'Phone number is required.' };
        }
        if (!phoneRegex.test(trimmed)) {
            return { valid: false, message: 'Invalid phone number. Format: 010, 011, 012, or 015 + 8 digits (e.g., 01012345678).' };
        }
        return { valid: true, message: '' };
    }

    function validateNetwork(value) {
        if (!value) {
            return { valid: false, message: 'Please select a network type.' };
        }
        return { valid: true, message: '' };
    }


    function validateSerialField() {
        const input = document.getElementById('es-serial-input');
        const error = document.getElementById('es-serial-error');
        const helper = document.getElementById('es-serial-helper');
        const successIcon = document.getElementById('es-serial-success');
        const value = input.value;

        const result = validateSerial(value);

        input.classList.remove('is-valid', 'is-invalid');
        error.classList.remove('show');
        successIcon.classList.remove('show');

        if (value.trim() === '') {
            helper.classList.remove('hidden');
            return false;
        }

        helper.classList.add('hidden');

        if (result.valid) {
            input.classList.add('is-valid');
            successIcon.classList.add('show');
            return true;
        } else {
            input.classList.add('is-invalid');
            error.textContent = result.message;
            error.classList.add('show');
            return false;
        }
    }

    function validatePhoneField() {
        const input = document.getElementById('es-phone-input');
        const error = document.getElementById('es-phone-error');
        const helper = document.getElementById('es-phone-helper');
        const successIcon = document.getElementById('es-phone-success');
        const value = input.value;

        const result = validatePhone(value);

        input.classList.remove('is-valid', 'is-invalid');
        error.classList.remove('show');
        successIcon.classList.remove('show');

        if (value.trim() === '') {
            helper.classList.remove('hidden');
            return false;
        }

        helper.classList.add('hidden');

        if (result.valid) {
            input.classList.add('is-valid');
            successIcon.classList.add('show');
            return true;
        } else {
            input.classList.add('is-invalid');
            error.textContent = result.message;
            error.classList.add('show');
            return false;
        }
    }

    function validateNetworkField() {
        const select = document.getElementById('es-network-select');
        const error = document.getElementById('es-network-error');
        const value = select.value;

        const result = validateNetwork(value);

        select.classList.remove('is-valid', 'is-invalid');
        error.classList.remove('show');

        if (result.valid) {
            select.classList.add('is-valid');
            return true;
        } else {
            select.classList.add('is-invalid');
            error.textContent = result.message;
            error.classList.add('show');
            return false;
        }
    }



    document.getElementById('es-serial-input').addEventListener('input', function () {
        validateSerialField();
        updateSaveButton();
    });

    document.getElementById('es-serial-input').addEventListener('blur', function () {
        validateSerialField();
        updateSaveButton();
    });

    document.getElementById('es-phone-input').addEventListener('input', function () {
        validatePhoneField();
        updateSaveButton();
    });

    document.getElementById('es-phone-input').addEventListener('blur', function () {
        validatePhoneField();
        updateSaveButton();
    });

    document.getElementById('es-network-select').addEventListener('change', function () {
        validateNetworkField();
        updateSaveButton();
    });



    function updateSaveButton() {
        const serialValid = validateSerialField();
        const phoneValid = validatePhoneField();
        const networkValid = validateNetworkField();

        const saveBtn = document.getElementById('es-save-btn');
        const formErrors = document.getElementById('es-form-errors');

        const allValid = serialValid && phoneValid && networkValid;

        saveBtn.disabled = !allValid;

        if (!allValid) {
            formErrors.style.display = 'block';
            document.getElementById('es-form-error-text').textContent = 'Please fix all errors before saving.';
        } else {
            formErrors.style.display = 'none';
        }
    }



    document.getElementById('es-edit-form').addEventListener('submit', function (e) {
        const serialValid = validateSerialField();
        const phoneValid = validatePhoneField();
        const networkValid = validateNetworkField();

        if (!serialValid || !phoneValid || !networkValid) {
            e.preventDefault();

            const formErrors = document.getElementById('es-form-errors');
            formErrors.style.display = 'block';

            let errorMessages = [];
            if (!serialValid) {
                errorMessages.push('Serial Number: ' + document.getElementById('es-serial-error').textContent);
            }
            if (!phoneValid) {
                errorMessages.push('Phone Number: ' + document.getElementById('es-phone-error').textContent);
            }
            if (!networkValid) {
                errorMessages.push('Network Type: ' + document.getElementById('es-network-error').textContent);
            }

            document.getElementById('es-form-error-text').textContent = errorMessages.join(' | ');

            const firstInvalid = document.querySelector('.es-input.is-invalid, .es-select.is-invalid');
            if (firstInvalid) {
                firstInvalid.focus();
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            return false;
        }

        const saveBtn = document.getElementById('es-save-btn');
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
    });



    document.addEventListener('DOMContentLoaded', function () {
        validateSerialField();
        validatePhoneField();
        validateNetworkField();
        updateSaveButton();
    });


    document.getElementById('es-phone-input').addEventListener('input', function () {
        let value = this.value.replace(/\D/g, '');

        if (value.length > 11) {
            value = value.slice(0, 11);
        }

        this.value = value;
    });



    document.getElementById('es-serial-input').addEventListener('input', function () {
        let value = this.value.replace(/[^a-zA-Z0-9\-_]/g, '');
        this.value = value;
    });
</script>