@model Sim_Card_Managment.Models.Sim

@{
}

<!DOCTYPE html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New SIM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />

</head>




<section class="cs-body">

    <div class="cs-card shadow">
        <h2 class="cs-title">Create New SIM</h2>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form id="cs-sim-form" asp-controller="SIM" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="cs-label" asp-for="SerialNumber">Serial Number</label>
                    <input type="text" class="cs-input" asp-for="SerialNumber" placeholder="Enter serial number" required />
                    <span asp-validation-for="SerialNumber" class="cs-error"></span>
                </div>

                <div class="col-md-6">
                    <label class="cs-label" asp-for="PhoneNumber">Phone Number</label>
                    <input type="text" maxlength="11" id="cs-phone-input" class="cs-input" asp-for="PhoneNumber" placeholder="e.g. 010..., 012..., 015..." required />
                    <div id="cs-provider-detected" class="cs-provider-badge" style="display:none;"></div>
                    <span asp-validation-for="PhoneNumber" class="cs-error"></span>
                </div>

                <div class="col-md-6">
                    <label class="cs-label" asp-for="NetworkType">Network Type</label>
                    <select class="cs-select" asp-for="NetworkType">
                        <option value="4G">4G</option>
                        <option value="5G">5G</option>
                        <option value="3G">3G</option>
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">
                <a class="cs-btn-cancel" asp-controller="SIM" asp-action="Index">Cancel</a>
                <button type="submit" class="cs-btn-create">Create SIM</button>
            </div>
        </form>
    </div>

    </section>

    <script>
           // ============================================
    // 📱 PHONE NUMBER PROVIDER DETECTION (dynamic, from DB-configured prefixes)
    // ============================================
    var providerPrefixMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ProviderPrefixMap ?? new Dictionary<string, int>()));
    var providerNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ProviderNames ?? new Dictionary<int, string>()));

    function detectProviderIdFromPrefixMap(phoneValue) {
        // Longest matching prefix wins
        var bestPrefix = null;
        for (var prefix in providerPrefixMap) {
            if (phoneValue.startsWith(prefix)) {
                if (bestPrefix === null || prefix.length > bestPrefix.length) {
                    bestPrefix = prefix;
                }
            }
        }
        return bestPrefix !== null ? providerPrefixMap[bestPrefix] : null;
    }

    document.getElementById('cs-phone-input').addEventListener('input', function () {
        const val = this.value.trim();
        const badge = document.getElementById('cs-provider-detected');

        badge.className = 'cs-provider-badge';

        const providerId = detectProviderIdFromPrefixMap(val);
        if (providerId !== null && providerNames[providerId]) {
            badge.style.display = 'inline-block';
            badge.innerText = 'Detected Provider: ' + providerNames[providerId];
        } else {
            badge.style.display = 'none';
        }
    });

        // ============================================
        // 📱 FORM VALIDATION
        // ============================================
        document.getElementById('cs-sim-form').addEventListener('submit', function (e) {
            const serial = document.querySelector('[asp-for="SerialNumber"]');
            const phone = document.querySelector('[asp-for="PhoneNumber"]');

            let isValid = true;

            if (!serial.value.trim()) {
                serial.classList.add('is-invalid');
                isValid = false;
            } else {
                serial.classList.remove('is-invalid');
            }

            if (!phone.value.trim()) {
                phone.classList.add('is-invalid');
                isValid = false;
            } else {
                phone.classList.remove('is-invalid');
            }

            if (!isValid) {
                e.preventDefault();
                alert('Please fill in all required fields.');
            }
        });

        // Remove invalid class on typing
        document.querySelectorAll('.cs-input').forEach(input => {
            input.addEventListener('input', function () {
                this.classList.remove('is-invalid');
            });
        });
    </script>

<script src="~/js/bootstrap.bundle.min.js"></script>