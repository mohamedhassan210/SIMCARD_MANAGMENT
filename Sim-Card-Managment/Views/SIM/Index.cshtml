@model IEnumerable<Sim_Card_Managment.Viewmodel.DeviceDirectoryViewModel>

<style>
    /* ---------- Title ---------- */
    .title-section {
        margin-bottom: 24px;
    }

        .title-section h1 {
            font-size: 34px;
            font-weight: 800;
            color: #1a1a1a;
        }

            .title-section h1 .num {
                color: #e8552b;
            }

        .title-section p {
            margin-top: 10px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b6b6b;
            max-width: 560px;
        }

    /* ---------- Buttons ---------- */
    .create-btn-group {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .create-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #e8552b;
        color: #fff;
        border: none;
        padding: 11px 20px;
        border-radius: 24px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .create-btn:hover {
            background: #d64923;
            color: #fff;
            transform: translateY(-1px);
        }

    .create-btn-secondary {
        background: #ffffff;
        color: #1a1a1a;
        border: 1px solid #dcdcdc;
    }

        .create-btn-secondary:hover {
            background: #f7f7f7;
            color: #e8552b;
            border-color: #e8552b;
        }

    /* ---------- Filters ---------- */
    .filters {
        margin-top: 34px;
    }

        .filters label {
            display: block;
            font-size: 12px;
            color: #6b6b6b;
            margin-bottom: 8px;
        }

    .filters-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .status-select {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 13px;
        color: #1a1a1a;
        width: 150px;
        cursor: pointer;
        transition: border-color 0.2s ease;
    }

        .status-select:hover {
            border-color: #e8552b;
        }

    .search-box {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        transition: border-color 0.2s ease;
        min-width: 250px;
    }

        .search-box:focus-within {
            border-color: #e8552b;
        }

        .search-box svg {
            width: 15px;
            height: 15px;
            color: #a8a8a8;
            flex-shrink: 0;
        }

        .search-box input {
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
            width: 100%;
            color: #1a1a1a;
        }

            .search-box input::placeholder {
                color: #b3b3b3;
            }

    /* ---------- Table ---------- */
    .table-wrap {
        margin-top: 28px;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #1a1a1a;
        padding-bottom: 12px;
        vertical-align: top;
    }

    thead tr {
        border-bottom: 2px solid #e8552b;
    }

    tbody td {
        font-size: 12.5px;
        color: #1a1a1a;
        padding: 16px 0;
        border-bottom: 1px solid #e2e2e2;
        vertical-align: middle;
    }

    .badge-type {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 10px;
        text-transform: uppercase;
    }

    .badge-sim {
        background: #e6f4ea;
        color: #137333;
    }

    .badge-usb {
        background: #feefc3;
        color: #b06000;
    }

    .view-btn {
        display: inline-block;
        border: 1.5px solid #e8552b;
        color: #e8552b;
        background: transparent;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 18px;
        border-radius: 16px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .view-btn:hover {
            background: #e8552b;
            color: #fff;
        }

    th:nth-child(1), td:nth-child(1) {
        width: 20%;
    }

    th:nth-child(2), td:nth-child(2) {
        width: 10%;
    }

    th:nth-child(3), td:nth-child(3) {
        width: 16%;
    }

    th:nth-child(4), td:nth-child(4) {
        width: 12%;
    }

    th:nth-child(5), td:nth-child(5) {
        width: 14%;
    }

    th:nth-child(6), td:nth-child(6) {
        width: 16%;
    }

    th:nth-child(7), td:nth-child(7) {
        width: 12%;
        text-align: right;
    }

    /* ---------- Footer ---------- */
    .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 20px;
    }

        .footer .showing {
            font-size: 12px;
            color: #6b6b6b;
        }

    .pagination {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .pagination button {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid #dcdcdc;
            background: #fff;
            color: #6b6b6b;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .pagination button:hover {
                border-color: #e8552b;
                color: #e8552b;
            }

            .pagination button.page-num {
                border: none;
                background: transparent;
                color: #1a1a1a;
            }

                .pagination button.page-num:hover {
                    background: #fbeae5;
                    color: #e8552b;
                }

            .pagination button.active {
                background: #e8552b;
                border-color: #e8552b;
                color: #fff;
            }
</style>

<div class="page p-100 container-fluid px-4">

    <div class="title-section">
        <h1><span class="num">@(Model?.Count() ?? 0)</span> Devices Directory</h1>
        <p>Manage all active, available, and assigned SIM cards and USB modems in one place.</p>

        <div class="create-btn-group">
            <a asp-controller="SIM" asp-action="Create" class="create-btn"><span>+</span> New SIM Card</a>
            <a asp-controller="USB" asp-action="Create" class="create-btn create-btn-secondary"><span>+</span> New USB Modem</a>
            <a asp-controller="DeviceStatusType" asp-action="Index" class="create-btn create-btn-secondary">Status Types</a>
        </div>
    </div>

    <form id="filterForm" class="filters" onsubmit="event.preventDefault();">
        <div class="filters-row">
            <div class="filter-group">
                <label for="status-filter">Availability</label>
                <select id="status-filter" class="status-select">
                    <option value="all">All</option>
                    <option value="active">Active</option>
                    <option value="inactive">Not Active</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="device-type-filter">Type</label>
                <select id="device-type-filter" class="status-select">
                    <option value="all">All Types</option>
                    <option value="sim">SIM Card</option>
                    <option value="usb">USB Modem</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="status-type-filter">Status Type</label>
                <select id="status-type-filter" class="status-select">
                    <option value="all">All Status Types</option>
                    @if (ViewBag.StatusTypes != null)
                    {
                        foreach (var st in ViewBag.StatusTypes as List<string>)
                        {
                            <option value="@st.ToLower()">@st</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-group" style="flex: 1;">
                <label for="search-input">Search</label>
                <div class="search-box">
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5" />
                        <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <input id="search-input" type="text" placeholder="Search by Serial, Phone, Model, Provider, or Assignee..." autocomplete="off">
                </div>
            </div>
        </div>
    </form>

    <div class="table-wrap">
        <table id="deviceTable">
            <thead>
                <tr>
                    <th>Serial Number</th>
                    <th>Type</th>
                    <th>Details</th>
                    <th>Availability</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        @* FIX: normalize data-type to exactly "sim" or "usb" so it always
                           matches the dropdown's option values, regardless of whether
                           item.DeviceType is "SIM", "USB", or "USB Modem" etc. *@
                        var normalizedType = (item.DeviceType != null && item.DeviceType.Contains("SIM", StringComparison.OrdinalIgnoreCase))
                        ? "sim"
                        : (item.DeviceType != null && item.DeviceType.Contains("USB", StringComparison.OrdinalIgnoreCase))
                        ? "usb"
                        : "";

                        <tr class="device-row"
                            data-status="@(item.IsActive ? "active" : "inactive")"
                            data-type="@normalizedType"
                            data-status-type="@(item.Status?.ToLower() ?? "unassigned")">
                            <td>
                                <strong>@item.SerialNumber</strong>
                                @if (!string.IsNullOrEmpty(item.ProviderName))
                                {
                                    <div style="font-size: 11px; color: #888;">@item.ProviderName</div>
                                }
                            </td>
                            <td>
                                <span class="badge-type @(item.DeviceType == "SIM" ? "badge-sim" : "badge-usb")">
                                    @item.DeviceType
                                </span>
                            </td>
                            <td>
                                <div>@(string.IsNullOrEmpty(item.Identifier) ? "-" : item.Identifier)</div>
                                @if (!string.IsNullOrEmpty(item.Detail))
                                {
                                    <div style="font-size: 11px; color: #888;">@item.Detail</div>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span style="color:#137333; font-weight:700;">Active</span>
                                }
                                else
                                {
                                    <span style="color:#c5221f; font-weight:700;">Not Active</span>
                                }
                            </td>
                            <td>
                                @{
                                    var statusColor = item.Status switch
                                    {
                                        "Occupied" => "#137333",
                                        "Unassigned" => "#6b6b6b",
                                        "Lost" => "#c5221f",
                                        "Replaced" => "#b06000",
                                        "Returned" => "#1a73e8",
                                        _ => "#1a1a1a"
                                    };
                                }
                                <span style="color:@statusColor; font-weight:700;">@item.Status</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.AssignedToName))
                                {
                                    <div>
                                        @item.AssignedToName
                                        @if (!string.IsNullOrEmpty(item.AssignedToType))
                                        {
                                            <span style="font-size: 10px; color: #888;">(@item.AssignedToType)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="color: #a8a8a8;">Unassigned</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                @if (item.DeviceType.Contains("SIM"))
                                {
                                    <a asp-controller="SIM" asp-action="Details" asp-route-id="@item.Id" class="view-btn">VIEW</a>
                                }
                                else
                                {
                                    <a asp-controller="USB" asp-action="Details" asp-route-id="@item.Id" class="view-btn">VIEW</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tr id="noResultsRow" style="display: none;">
                <td colspan="7" style="text-align: center; padding: 32px; color: #888;">
                    No matching devices found.
                </td>
            </tr>
        </table>
    </div>

    <div class="footer">
        <div class="showing" id="showingText">Showing 0 records</div>
        <div class="pagination" id="paginationContainer"></div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("search-input");
        const statusFilter = document.getElementById("status-filter");
        const typeFilter = document.getElementById("device-type-filter");
        const statusTypeFilter = document.getElementById("status-type-filter");

        const allRows = Array.from(document.querySelectorAll("#tableBody tr.device-row"));
        const noResultsRow = document.getElementById("noResultsRow");
        const showingText = document.getElementById("showingText");
        const paginationContainer = document.getElementById("paginationContainer");

        const itemsPerPage = 7;
        let visibleRows = [...allRows];
        let currentPage = 1;

        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            const statusVal = statusFilter.value.toLowerCase();
            const typeVal = typeFilter.value.toLowerCase();
            const statusTypeVal = statusTypeFilter.value.toLowerCase();

            visibleRows = allRows.filter(row => {
                const text = row.innerText.toLowerCase();
                const matchesSearch = text.includes(query);

                const rowStatus = row.getAttribute("data-status");
                const matchesStatus = (statusVal === "all") || (rowStatus === statusVal);

                const rowType = row.getAttribute("data-type");
                const matchesType = (typeVal === "all") || (rowType === typeVal);

                const rowStatusType = row.getAttribute("data-status-type") ?? "";
                const matchesStatusType = (statusTypeVal === "all") || (rowStatusType === statusTypeVal);

                return matchesSearch && matchesStatus && matchesType && matchesStatusType;
            });

            currentPage = 1;
            renderTable();
        }

        function renderTable() {
            const totalVisible = visibleRows.length;
            const totalPages = Math.max(1, Math.ceil(totalVisible / itemsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx = startIdx + itemsPerPage;

            allRows.forEach(row => row.style.display = "none");
            visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

            if (totalVisible === 0) {
                noResultsRow.style.display = "";
                showingText.textContent = "Showing 0 records";
                paginationContainer.innerHTML = "";
                return;
            } else {
                noResultsRow.style.display = "none";
            }

            const actualEnd = Math.min(endIdx, totalVisible);
            showingText.textContent = `Showing ${startIdx + 1}-${actualEnd} of ${totalVisible} records`;

            let html = `<button type="button" class="arrow" id="prevBtn" ${currentPage === 1 ? 'disabled style="opacity:0.4;cursor:default;"' : ''}>&#8249;</button>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<button type="button" class="${i === currentPage ? 'active' : 'page-num'}" data-page="${i}">${i}</button>`;
            }

            html += `<button type="button" class="arrow" id="nextBtn" ${currentPage === totalPages ? 'disabled style="opacity:0.4;cursor:default;"' : ''}>&#8250;</button>`;

            paginationContainer.innerHTML = html;
        }

        searchInput.addEventListener("input", applyFilters);
        statusFilter.addEventListener("change", applyFilters);
        typeFilter.addEventListener("change", applyFilters);
        statusTypeFilter.addEventListener("change", applyFilters);

        paginationContainer.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn || btn.disabled) return;

            if (btn.id === "prevBtn") {
                if (currentPage > 1) currentPage--;
            } else if (btn.id === "nextBtn") {
                const totalPages = Math.ceil(visibleRows.length / itemsPerPage);
                if (currentPage < totalPages) currentPage++;
            } else if (btn.dataset.page) {
                currentPage = parseInt(btn.dataset.page);
            }

            renderTable();
        });

        applyFilters();
    });
</script>
