@model IEnumerable<Sim_Card_Managment.Viewmodel.DeviceDirectoryViewModel>

@{
    ViewData["Title"] = "Devices Directory";
    var deviceList = Model?.ToList() ?? new List<Sim_Card_Managment.Viewmodel.DeviceDirectoryViewModel>();
    var totalDevices = deviceList.Count;
    var activeDevices = deviceList.Count(d => d.IsActive);
    var simCount = deviceList.Count(d => d.DeviceType != null && d.DeviceType.Contains("SIM", StringComparison.OrdinalIgnoreCase));
    var usbCount = deviceList.Count(d => d.DeviceType != null && d.DeviceType.Contains("USB", StringComparison.OrdinalIgnoreCase));
}

<style>
    /* Theme & Layout Variables */
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
        --bg-light: #f8f9fa;
    }

    /* Page Header */
    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    /* Action Buttons */
    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    .btn-outline-custom {
        background-color: #ffffff;
        border: 1px solid #dcdcdc;
        color: #1a1a1a;
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-outline-custom:hover {
            background-color: #fffaf8;
            border-color: var(--primary-orange);
            color: var(--primary-orange);
        }

    .btn-view-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 8px;
        padding: 6px 16px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-view-action:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    /* Search Bar & Dropdowns */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.92rem;
            color: #333333;
            padding: 4px 0;
        }

    .custom-select-filter {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 8px 14px;
        background-color: #ffffff;
        font-size: 0.9rem;
        color: #495057;
        transition: border-color 0.2s ease;
    }

        .custom-select-filter:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
            outline: none;
        }

    /* Type Badges */
    .badge-type-sim {
        background-color: #e6f4ea;
        color: #137333;
        border: 1px solid #ceebd6;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 11px;
        text-transform: uppercase;
    }

    .badge-type-usb {
        background-color: #feefc3;
        color: #b06000;
        border: 1px solid #fce8b2;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 11px;
        text-transform: uppercase;
    }

    /* Status Badges */
    .badge-status-active {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
    }

    .badge-status-inactive {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
    }

    /* Pagination Styles */
    .pagination button {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        background: #fff;
        color: #6b6b6b;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .pagination button:hover:not(:disabled) {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
        }

        .pagination button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .pagination button.active {
            background: var(--primary-orange);
            border-color: var(--primary-orange);
            color: #fff;
        }
</style>

<div class="container-fluid px-4 p-100">

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">
                <span id="totalCountHeader">@totalDevices</span> Devices Directory
            </h1>
            <p class="page-header-subtitle mb-0">Manage all active, available, and assigned SIM cards and USB modems in one place.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="SIM" asp-action="Create" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New SIM Card</span>
            </a>
            <a asp-controller="USB" asp-action="Create" class="btn-outline-custom shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New USB Modem</span>
            </a>
            <a asp-controller="DeviceStatusType" asp-action="Index" class="btn-outline-custom shadow-sm">
                <i class="fas fa-tags"></i>
                <span>Status Types</span>
            </a>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total Devices</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalDevices</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: var(--primary-orange);">
                        <i class="fas fa-microchip fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Active Devices</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@activeDevices</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">SIM Cards</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@simCount</h3>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
                        <i class="fas fa-sim-card fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">USB Modems</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@usbCount</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="fas fa-dongle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <!-- Filters Row -->
        <div class="row g-3 align-items-end mb-4">
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label text-muted small mb-1">Availability</label>
                <select id="status-filter" class="form-select custom-select-filter">
                    <option value="all">All Statuses</option>
                    <option value="active">Active Only</option>
                    <option value="inactive">Inactive Only</option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label text-muted small mb-1">Device Type</label>
                <select id="device-type-filter" class="form-select custom-select-filter">
                    <option value="all">All Types</option>
                    <option value="sim">SIM Card</option>
                    <option value="usb">USB Modem</option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label text-muted small mb-1">Status Type</label>
                <select id="status-type-filter" class="form-select custom-select-filter">
                    <option value="all">All Status Types</option>
                    @if (ViewBag.StatusTypes != null)
                    {
                        foreach (var st in ViewBag.StatusTypes as List<string>)
                        {
                            <option value="@st.ToLower()">@st</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label text-muted small mb-1">Search</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="search-input" placeholder="Serial, phone, provider..." autocomplete="off">
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="deviceTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th scope="col">Serial Number</th>
                        <th scope="col">Type</th>
                        <th scope="col">Details</th>
                        <th scope="col">Availability</th>
                        <th scope="col">Status</th>
                        <th scope="col">Assigned To</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (deviceList.Any())
                    {
                        foreach (var item in deviceList)
                        {
                            var normalizedType = (item.DeviceType != null && item.DeviceType.Contains("SIM", StringComparison.OrdinalIgnoreCase))
                            ? "sim"
                            : (item.DeviceType != null && item.DeviceType.Contains("USB", StringComparison.OrdinalIgnoreCase))
                            ? "usb"
                            : "";

                            <tr class="device-row @(item.IsActive ? "" : "table-light")"
                                data-status="@(item.IsActive ? "active" : "inactive")"
                                data-type="@normalizedType"
                                data-status-type="@(item.Status?.ToLower() ?? "unassigned")">

                                <td class="fw-bold text-dark">
                                    <div>@item.SerialNumber</div>
                                    @if (!string.IsNullOrEmpty(item.ProviderName))
                                    {
                                        <div class="text-muted small fw-normal">@item.ProviderName</div>
                                    }
                                </td>

                                <td>
                                    <span class="@(normalizedType == "sim" ? "badge-type-sim" : "badge-type-usb")">
                                        @item.DeviceType
                                    </span>
                                </td>

                                <td>
                                    <div class="text-dark">@(string.IsNullOrEmpty(item.Identifier) ? "-" : item.Identifier)</div>
                                    @if (!string.IsNullOrEmpty(item.Detail))
                                    {
                                        <div class="text-muted small">@item.Detail</div>
                                    }
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-status-active">
                                            <i class="fas fa-circle me-1" style="font-size: 7px;"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-inactive">
                                            <i class="fas fa-circle me-1" style="font-size: 7px;"></i> Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @{
                                        var statusColor = item.Status switch
                                        {
                                            "Occupied" => "#137333",
                                            "Unassigned" => "#6b6b6b",
                                            "Lost" => "#c5221f",
                                            "Replaced" => "#b06000",
                                            "Returned" => "#1a73e8",
                                            _ => "#1a1a1a"
                                        };
                                    }
                                    <span class="fw-bold" style="color: @statusColor;">
                                        @item.Status
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.AssignedToName))
                                    {
                                        <div>
                                            <span class="fw-medium text-dark">@item.AssignedToName</span>
                                            @if (!string.IsNullOrEmpty(item.AssignedToType))
                                            {
                                                <span class="text-muted small">(@item.AssignedToType)</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Unassigned</span>
                                    }
                                </td>

                                <td class="text-end">
                                    @if (item.DeviceType != null && item.DeviceType.Contains("SIM", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a asp-controller="SIM" asp-action="Details" asp-route-id="@item.Id" class="btn-view-action">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="USB" asp-action="Details" asp-route-id="@item.Id" class="btn-view-action">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="fas fa-search me-1"></i> No matching devices found.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer / Pagination -->
        <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 mt-4 pt-2 border-top">
            <div class="text-muted small" id="showingText">Showing 0 records</div>
            <div class="pagination d-flex align-items-center gap-1" id="paginationContainer"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("search-input");
            const statusFilter = document.getElementById("status-filter");
            const typeFilter = document.getElementById("device-type-filter");
            const statusTypeFilter = document.getElementById("status-type-filter");

            const allRows = Array.from(document.querySelectorAll("#tableBody tr.device-row"));
            const noResultsRow = document.getElementById("noResultsRow");
            const totalCountHeader = document.getElementById("totalCountHeader");
            const showingText = document.getElementById("showingText");
            const paginationContainer = document.getElementById("paginationContainer");

            const itemsPerPage = 7;
            let visibleRows = [...allRows];
            let currentPage = 1;

            function applyFilters() {
                const query = searchInput.value.trim().toLowerCase();
                const statusVal = statusFilter.value.toLowerCase();
                const typeVal = typeFilter.value.toLowerCase();
                const statusTypeVal = statusTypeFilter.value.toLowerCase();

                visibleRows = allRows.filter(row => {
                    const text = row.innerText.toLowerCase();
                    const matchesSearch = text.includes(query);

                    const rowStatus = row.getAttribute("data-status");
                    const matchesStatus = (statusVal === "all") || (rowStatus === statusVal);

                    const rowType = row.getAttribute("data-type");
                    const matchesType = (typeVal === "all") || (rowType === typeVal);

                    const rowStatusType = row.getAttribute("data-status-type") ?? "";
                    const matchesStatusType = (statusTypeVal === "all") || (rowStatusType === statusTypeVal);

                    return matchesSearch && matchesStatus && matchesType && matchesStatusType;
                });

                currentPage = 1;
                renderTable();
            }

            function renderTable() {
                const totalVisible = visibleRows.length;
                totalCountHeader.textContent = totalVisible;

                if (totalVisible === 0) {
                    allRows.forEach(row => row.style.display = "none");
                    noResultsRow.style.display = "";
                    showingText.textContent = "Showing 0 records";
                    paginationContainer.innerHTML = "";
                    return;
                }

                noResultsRow.style.display = "none";

                const totalPages = Math.ceil(totalVisible / itemsPerPage);
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const startIdx = (currentPage - 1) * itemsPerPage;
                const endIdx = startIdx + itemsPerPage;

                allRows.forEach(row => row.style.display = "none");
                visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

                const actualEnd = Math.min(endIdx, totalVisible);
                showingText.textContent = `Showing ${startIdx + 1} to ${actualEnd} of ${totalVisible} records`;

                renderPagination(totalPages);
            }

            function renderPagination(totalPages) {
                paginationContainer.innerHTML = '';

                if (totalPages <= 1) return;

                const prevBtn = document.createElement('button');
                prevBtn.innerHTML = '&#8249;';
                prevBtn.disabled = currentPage === 1;
                prevBtn.addEventListener('click', () => {
                    if (currentPage > 1) {
                        currentPage--;
                        renderTable();
                    }
                });
                paginationContainer.appendChild(prevBtn);

                for (let i = 1; i <= totalPages; i++) {
                    const pageBtn = document.createElement('button');
                    pageBtn.className = `page-num ${i === currentPage ? 'active' : ''}`;
                    pageBtn.textContent = i;
                    pageBtn.addEventListener('click', () => {
                        currentPage = i;
                        renderTable();
                    });
                    paginationContainer.appendChild(pageBtn);
                }

                const nextBtn = document.createElement('button');
                nextBtn.innerHTML = '&#8250;';
                nextBtn.disabled = currentPage === totalPages;
                nextBtn.addEventListener('click', () => {
                    if (currentPage < totalPages) {
                        currentPage++;
                        renderTable();
                    }
                });
                paginationContainer.appendChild(nextBtn);
            }

            searchInput.addEventListener("input", applyFilters);
            statusFilter.addEventListener("change", applyFilters);
            typeFilter.addEventListener("change", applyFilters);
            statusTypeFilter.addEventListener("change", applyFilters);

            applyFilters();
        });
    </script>
}