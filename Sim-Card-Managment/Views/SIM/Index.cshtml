

@model IEnumerable<Sim_Card_Managment.ViewModels.PersonListItemViewModel>

@{
    string currentStatus = ViewBag.CurrentStatus ?? "active";
    string currentType = ViewBag.CurrentType ?? "all";
}

<style>
    /* ---------- Title ---------- */
    .title-section {
        margin-bottom: 24px;
    }

        .title-section h1 {
            font-size: 34px;
            font-weight: 800;
            color: #1a1a1a;
        }

            .title-section h1 .num {
                color: #e8552b;
            }

        .title-section p {
            margin-top: 10px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b6b6b;
            max-width: 560px;
        }

    /* ---------- Buttons ---------- */
    .create-btn-group {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .create-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #e8552b;
        color: #fff;
        border: none;
        padding: 11px 20px;
        border-radius: 24px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .create-btn:hover {
            background: #d64923;
            color: #fff;
            transform: translateY(-1px);
        }

    .create-btn-secondary {
        background: #ffffff;
        color: #1a1a1a;
        border: 1px solid #dcdcdc;
    }

        .create-btn-secondary:hover {
            background: #f7f7f7;
            color: #e8552b;
            border-color: #e8552b;
        }

    /* ---------- Filters ---------- */
    .filters {
        margin-top: 34px;
    }

        .filters label {
            display: block;
            font-size: 12px;
            color: #6b6b6b;
            margin-bottom: 8px;
        }

    .filters-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-select {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 13px;
        color: #1a1a1a;
        width: 150px;
        cursor: pointer;
        transition: border-color 0.2s ease;
    }

        .status-select:hover {
            border-color: #e8552b;
        }

    .search-box {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        transition: border-color 0.2s ease;
    }

        .search-box:focus-within {
            border-color: #e8552b;
        }

        .search-box svg {
            width: 15px;
            height: 15px;
            color: #a8a8a8;
            flex-shrink: 0;
        }

        .search-box input {
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
            width: 100%;
            color: #1a1a1a;
        }

            .search-box input::placeholder {
                color: #b3b3b3;
            }

    /* ---------- Table ---------- */
    .table-wrap {
        margin-top: 28px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #1a1a1a;
        padding-bottom: 12px;
        vertical-align: top;
    }

    thead tr {
        border-bottom: 2px solid #e8552b;
    }

    tbody td {
        font-size: 12.5px;
        color: #1a1a1a;
        padding: 16px 0;
        border-bottom: 1px solid #e2e2e2;
        vertical-align: middle;
    }

    .asset-cell {
        display: flex;
        align-items: center;
        gap: 6px;
        line-height: 1.3;
    }

        .asset-cell svg {
            width: 14px;
            height: 14px;
            color: #1a1a1a;
            flex-shrink: 0;
        }

    .badge-type {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 10px;
        text-transform: uppercase;
    }

    .badge-sim {
        background: #e6f4ea;
        color: #137333;
    }

    .badge-usb {
        background: #feefc3;
        color: #b06000;
    }

    .view-btn {
        display: inline-block;
        border: 1.5px solid #e8552b;
        color: #e8552b;
        background: transparent;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 18px;
        border-radius: 16px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .view-btn:hover {
            background: #e8552b;
            color: #fff;
        }

    th:nth-child(1), td:nth-child(1) {
        width: 22%;
    }

    th:nth-child(2), td:nth-child(2) {
    }

    th:nth-child(3), td:nth-child(3) {
    }

    th:nth-child(4), td:nth-child(4) {
    }

    th:nth-child(5), td:nth-child(5) {
        width: 12%;
    }

    th:nth-child(6), td:nth-child(6) {
        width: 14%;
    }

        text-align: right;
    }

    /* ---------- Footer ---------- */
    .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 20px;
    }

        .footer .showing {
            font-size: 12px;
            color: #6b6b6b;
        }

    .pagination {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .pagination button {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid #dcdcdc;
            background: #fff;
            color: #6b6b6b;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .pagination button:hover {
                border-color: #e8552b;
                color: #e8552b;
            }

            .pagination button.page-num {
                border: none;
                background: transparent;
                color: #1a1a1a;
            }

                .pagination button.page-num:hover {
                    background: #fbeae5;
                    color: #e8552b;
                }

            .pagination button.active {
                background: #e8552b;
                border-color: #e8552b;
                color: #fff;
            }
</style>

<div class="page p-100 container-fluid px-4">

    <div class="title-section">
        <h1><span class="num">@Model.Count()</span> Devices</h1>

        <div class="create-btn-group">
            <a asp-controller="SIM" asp-action="Create" class="create-btn"><span>+</span> New SIM</a>
        </div>
    </div>

        <div class="filters-row">
            <div class="filter-group">
                <label for="status-filter">Status</label>
                <select id="status-filter" name="status" class="status-select" onchange="this.form.submit()">
                </select>
            </div>

            <div class="filter-group">
                </select>
            </div>

            <div class="filter-group" style="flex: 1;">
                <div class="search-box">
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5" />
                        <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </div>
            </div>
        </div>
    </form>

    <div class="table-wrap">
        <table id="directoryTable">
            <thead>
                <tr>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                            <td class="col-name">
                                @if (!string.IsNullOrEmpty(item.ExtraInfo))
                                {
                                    <div style="font-size: 11px; color: #888;">@item.ExtraInfo</div>
                                }
                            </td>
                            <td>
                                </span>
                            </td>
                            <td style="text-align: right;">
                                {
                                }
                                else
                                {
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tr id="noResultsRow" style="display: none;">
                </td>
            </tr>
        </table>
    </div>

    <div class="footer">
        <div class="showing" id="showingText">Showing 0 records</div>
        <div class="pagination" id="paginationContainer"></div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const paginationContainer = document.getElementById("paginationContainer");

        let visibleRows = [...allRows];
        let currentPage = 1;

        function renderTable() {
            const totalVisible = visibleRows.length;

            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;

            // Hide all rows first
            allRows.forEach(row => row.style.display = "none");

            // Show page slice
            visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

            // Handle empty search result display
            if (totalVisible === 0) {
                paginationContainer.innerHTML = "";
                return;
            } else {
                noResultsRow.style.display = "none";
            }


            // Render pagination controls
            let html = `<button type="button" class="arrow" id="prevBtn" ${currentPage === 1 ? 'disabled style="opacity:0.4;cursor:default;"' : ''}>&#8249;</button>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<button type="button" class="${i === currentPage ? 'active' : 'page-num'}" data-page="${i}">${i}</button>`;
            }

            html += `<button type="button" class="arrow" id="nextBtn" ${currentPage === totalPages ? 'disabled style="opacity:0.4;cursor:default;"' : ''}>&#8250;</button>`;

            paginationContainer.innerHTML = html;
        }

        // Live JavaScript Search Filter
        searchInput.addEventListener("input", function () {
            const query = this.value.trim().toLowerCase();
            currentPage = 1;
            renderTable();
        });

        // Pagination Click Handler
        paginationContainer.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn || btn.disabled) return;

            if (btn.id === "prevBtn") {
                if (currentPage > 1) currentPage--;
            } else if (btn.id === "nextBtn") {
                const totalPages = Math.ceil(visibleRows.length / itemsPerPage);
                if (currentPage < totalPages) currentPage++;
            } else if (btn.dataset.page) {
                currentPage = parseInt(btn.dataset.page);
            }

            renderTable();
        });

        // Initial render
        renderTable();
    });
</script>