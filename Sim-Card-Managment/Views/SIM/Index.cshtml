@model IEnumerable<Sim_Card_Managment.Viewmodel.DeviceDirectoryViewModel>

@{
    string currentStatus = ViewBag.CurrentStatus ?? "active";
    string currentType = ViewBag.CurrentType ?? "all";
}

<style>
    .title-section {
        margin-bottom: 24px;
    }

        .title-section h1 {
            font-size: 34px;
            font-weight: 800;
            color: #1a1a1a;
        }

            .title-section h1 .num {
                color: #e8552b;
            }

        .title-section p {
            margin-top: 10px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b6b6b;
            max-width: 560px;
        }

    .create-btn-group {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .create-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #e8552b;
        color: #fff;
        border: none;
        padding: 11px 20px;
        border-radius: 24px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .create-btn:hover {
            background: #d64923;
            color: #fff;
            transform: translateY(-1px);
        }

    .create-btn-secondary {
        background: #ffffff;
        color: #1a1a1a;
        border: 1px solid #dcdcdc;
    }

        .create-btn-secondary:hover {
            background: #f7f7f7;
            color: #e8552b;
            border-color: #e8552b;
        }

    .filters {
        margin-top: 34px;
    }

        .filters label {
            display: block;
            font-size: 12px;
            color: #6b6b6b;
            margin-bottom: 8px;
        }

    .filters-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-select {
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 13px;
        color: #1a1a1a;
        width: 150px;
        cursor: pointer;
        transition: border-color 0.2s ease;
    }

        .status-select:hover {
            border-color: #e8552b;
        }

    .search-box {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 11px 14px;
        transition: border-color 0.2s ease;
    }

        .search-box:focus-within {
            border-color: #e8552b;
        }

        .search-box svg {
            width: 15px;
            height: 15px;
            color: #a8a8a8;
            flex-shrink: 0;
        }

        .search-box input {
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
            width: 100%;
            color: #1a1a1a;
        }

            .search-box input::placeholder {
                color: #b3b3b3;
            }

    .table-wrap {
        margin-top: 28px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #1a1a1a;
        padding-bottom: 12px;
        vertical-align: top;
    }

    thead tr {
        border-bottom: 2px solid #e8552b;
    }

    tbody td {
        font-size: 12.5px;
        color: #1a1a1a;
        padding: 16px 0;
        border-bottom: 1px solid #e2e2e2;
        vertical-align: middle;
    }

    .badge-type {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 10px;
        text-transform: uppercase;
    }

    .badge-sim {
        background: #e6f4ea;
        color: #137333;
    }

    .badge-usb {
        background: #feefc3;
        color: #b06000;
    }

    .view-btn {
        display: inline-block;
        border: 1.5px solid #e8552b;
        color: #e8552b;
        background: transparent;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 18px;
        border-radius: 16px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .view-btn:hover {
            background: #e8552b;
            color: #fff;
        }

    th:nth-child(1), td:nth-child(1) {
        width: 22%;
    }

    th:nth-child(2), td:nth-child(2) {
        width: 10%;
    }

    th:nth-child(3), td:nth-child(3) {
        width: 16%;
    }

    th:nth-child(4), td:nth-child(4) {
        width: 18%;
    }

    th:nth-child(5), td:nth-child(5) {
        width: 12%;
    }

    th:nth-child(6), td:nth-child(6) {
        width: 14%;
    }

    th:nth-child(7), td:nth-child(7) {
        width: 8%;
        text-align: right;
    }

    .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 20px;
    }

        .footer .showing {
            font-size: 12px;
            color: #6b6b6b;
        }

    .pagination {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .pagination button {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid #dcdcdc;
            background: #fff;
            color: #6b6b6b;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .pagination button:hover {
                border-color: #e8552b;
                color: #e8552b;
            }

            .pagination button.page-num {
                border: none;
                background: transparent;
                color: #1a1a1a;
            }

                .pagination button.page-num:hover {
                    background: #fbeae5;
                    color: #e8552b;
                }

            .pagination button.active {
                background: #e8552b;
                border-color: #e8552b;
                color: #fff;
            }
</style>

<div class="page p-100 container-fluid px-4">

    <div class="title-section">
        <h1><span class="num">@Model.Count()</span> Devices</h1>
        <p>Manage all registered SIM cards and USB modems, track their status and current assignments.</p>

        <div class="create-btn-group">
            <a asp-controller="SIM" asp-action="Create" class="create-btn"><span>+</span> New SIM</a>
            <a asp-controller="USB" asp-action="Create" class="create-btn create-btn-secondary"><span>+</span> New USB</a>
        </div>
    </div>

    <form id="filterForm" method="get" asp-controller="SIM" asp-action="Index" class="filters">
        <div class="filters-row">
            <div class="filter-group">
                <label for="status-filter">Status</label>
                <select id="status-filter" name="status" class="status-select" onchange="this.form.submit()">
                    <option value="active">Active</option>
                    <option value="lost">Lost</option>
                    <option value="replaced">Replaced</option>
                    <option value="returned">Returned</option>
                    <option value="all">All</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="device-type-filter">Type</label>
                <select id="device-type-filter" name="type" class="status-select" onchange="this.form.submit()">
                    <option value="all">All Types</option>
                    <option value="sim">SIM</option>
                    <option value="usb">USB</option>
                </select>
            </div>

            <div class="filter-group" style="flex: 1;">
                <label for="search-input">Search</label>
                <div class="search-box">
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5" />
                        <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <input id="search-input" type="text" placeholder="Search by serial number, phone number, or assignee..." autocomplete="off">
                </div>
            </div>
        </div>
    </form>

    <div class="table-wrap">
        <table id="directoryTable">
            <thead>
                <tr>
                    <th>Serial Number</th>
                    <th>Type</th>
                    <th>Phone Number</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th>Registered At</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="device-row">
                            <td class="col-name">
                                <strong>@item.SerialNumber</strong>
                                @if (!string.IsNullOrEmpty(item.ExtraInfo))
                                {
                                    <div style="font-size: 11px; color: #888;">@item.ExtraInfo</div>
                                }
                            </td>
                            <td>
                                <span class="badge-type @(item.DeviceType == "SIM" ? "badge-sim" : "badge-usb")">
                                    @item.DeviceType
                                </span>
                            </td>
                            <td>@(item.Identifier ?? "—")</td>
                            <td>@(item.AssignedTo ?? "Unassigned")</td>
                            <td>@item.Status</td>
                            <td>@item.RegisteredAt.ToString("MMM dd, yyyy")</td>
                            <td style="text-align: right;">
                                @if (item.DeviceType == "SIM")
                                {
                                    <a asp-controller="SIM" asp-action="Details" asp-route-id="@item.Id" class="view-btn">VIEW</a>
                                }
                                else
                                {
                                    <a asp-controller="USB" asp-action="Details" asp-route-id="@item.Id" class="view-btn">VIEW</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tr id="noResultsRow" style="display: none;">
                <td colspan="7" style="text-align: center; padding: 32px; color: #888;">
                    No devices found.
                </td>
            </tr>
        </table>
    </div>

    <div class="footer">
        <div class="showing" id="showingText">Showing 0 records</div>
        <div class="pagination" id="paginationContainer"></div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Restore filter state
        document.getElementById("status-filter").value = "@currentStatus";
        document.getElementById("device-type-filter").value = "@currentType";

        const searchInput         = document.getElementById("search-input");
        const allRows             = Array.from(document.querySelectorAll("#tableBody tr.device-row"));
        const noResultsRow        = document.getElementById("noResultsRow");
        const showingText         = document.getElementById("showingText");
        const paginationContainer = document.getElementById("paginationContainer");

        const itemsPerPage = 7;
        let visibleRows = [...allRows];
        let currentPage = 1;

        function renderTable() {
            const totalVisible = visibleRows.length;
            const totalPages   = Math.max(1, Math.ceil(totalVisible / itemsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx   = startIdx + itemsPerPage;

            allRows.forEach(row => row.style.display = "none");
            visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

            if (totalVisible === 0) {
                noResultsRow.style.display    = "";
                showingText.textContent       = "Showing 0 records";
                paginationContainer.innerHTML = "";
                return;
            } else {
                noResultsRow.style.display = "none";
            }

            const actualEnd         = Math.min(endIdx, totalVisible);
            showingText.textContent = `Showing ${startIdx + 1}–${actualEnd} of ${totalVisible} records`;

            let html = `<button type="button" class="arrow" id="prevBtn" ${currentPage === 1 ? 'disabled style="opacity:0.4;cursor:default;"' : ''}>&#8249;</button>`;
            for (let i = 1; i <= totalPages; i++) {
                html += `<button type="button" class="${i === currentPage ? 'active' : 'page-num'}" data-page="${i}">${i}</button>`;
            }
            html += `<button type="button" class="arrow" id="nextBtn" ${currentPage === totalPages ? 'disabled style="opacity:0.4;cursor:default;"' : ''}>&#8250;</button>`;
            paginationContainer.innerHTML = html;
        }

        searchInput.addEventListener("input", function () {
            const query = this.value.trim().toLowerCase();
            visibleRows = allRows.filter(row => row.innerText.toLowerCase().includes(query));
            currentPage = 1;
            renderTable();
        });

        paginationContainer.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn || btn.disabled) return;

            if (btn.id === "prevBtn") {
                if (currentPage > 1) currentPage--;
            } else if (btn.id === "nextBtn") {
                const totalPages = Math.ceil(visibleRows.length / itemsPerPage);
                if (currentPage < totalPages) currentPage++;
            } else if (btn.dataset.page) {
                currentPage = parseInt(btn.dataset.page);
            }

            renderTable();
        });

        renderTable();
    });
</script>