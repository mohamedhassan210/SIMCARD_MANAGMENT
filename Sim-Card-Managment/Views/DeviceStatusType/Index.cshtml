@model IEnumerable<Sim_Card_Management.Models.DeviceStatusType>

@{
    ViewData["Title"] = "Device Status Types";
    var typeList = Model?.ToList() ?? new List<Sim_Card_Management.Models.DeviceStatusType>();
    int totalTypes = typeList.Count;
}

<style>
    /* Theme & Layout Variables */
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
        --bg-light: #f8f9fa;
    }

    /* Page Header */
    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    /* Action Buttons */
    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    .btn-view-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-view-action:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    .btn-icon-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #6c757d;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 13px;
        transition: all 0.2s ease;
    }

        .btn-icon-action:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    .btn-action-delete {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #dc3545;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 13px;
        transition: all 0.2s ease;
    }

        .btn-action-delete:hover {
            border-color: #dc3545;
            color: #ffffff;
            background-color: #dc3545;
        }

    /* Seamless Search Bar */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.92rem;
            color: #333333;
            padding: 4px 0;
        }

    /* Type Icon Badge */
    .type-icon-wrapper {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background-color: rgba(226, 77, 23, 0.1);
        color: var(--primary-orange);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }
</style>

<div class="container-fluid px-4 p-100">



    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">Device Status Types</h1>
            <p class="page-header-subtitle mb-0">Manage and configure status classifications available for device lifecycle tracking.</p>
        </div>
        <div>
            <a asp-controller="DeviceStatusType" asp-action="Create" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New Status Type</span>
            </a>
        </div>
    </div>

    <!-- KPI Summary Card -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total Status Types</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1" id="totalTypesCount">@totalTypes</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #E24D17;">
                        <i class="fas fa-tags fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Container -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <!-- Controls Header -->
        <div class="row g-3 justify-content-between align-items-center mb-4">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label text-muted small mb-1">Search</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="typeSearchInput" placeholder="Search status types..." autocomplete="off">
                </div>
            </div>
        </div>

        <!-- Table View -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="typeTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th scope="col">Status Name</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="typeTableBody">
                    @if (typeList.Any())
                    {
                        foreach (var item in typeList)
                        {
                            <tr class="type-row">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="type-icon-wrapper">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <span class="fw-bold text-dark fs-6">@item.Name</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-controller="DeviceStatusType" asp-action="Edit" asp-route-id="@item.Id" class="btn-view-action" title="Edit Status Type">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>

                                        <form asp-controller="DeviceStatusType" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn-action-delete" title="Delete Status Type" onclick="confirmDelete(this)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="noDataRow">
                            <td colspan="2" class="text-center text-muted py-4">No status types configured.</td>
                        </tr>
                    }
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="2" class="text-center text-muted py-4">No matching status types found.</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

<!-- SweetAlert2 & Filtering Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById('typeSearchInput');
        const rows = document.querySelectorAll('#typeTableBody tr.type-row');
        const noResultsRow = document.getElementById('noResultsRow');

        searchInput.addEventListener('input', function () {
            const query = searchInput.value.toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(query)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noResultsRow) {
                noResultsRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
            }
        });
    });

    function confirmDelete(btn) {
        Swal.fire({
            title: 'Delete Status Type?',
            text: 'This action cannot be undone and may affect related devices.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel',
            customClass: {
                popup: 'rounded-4'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                btn.closest('form').submit();
            }
        });
    }
</script>