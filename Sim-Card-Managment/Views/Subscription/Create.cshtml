                    <label class="form-check-label terms-text" for="termsCheck">
                        I agree to the <a href="#">Terms & Conditions</a> and privacy policy. I acknowledge that the selected employee is solely responsible for the use of the assigned asset.
                    </label>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <button type="button" class="btn btn-action btn-outline-back">Back</button>
                    <div class="d-flex gap-3">
                        <button type="button" class="btn btn-action btn-draft">Save Draft</button>
                        <button type="button" class="btn btn-action btn-activate">Activate Subscription</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>