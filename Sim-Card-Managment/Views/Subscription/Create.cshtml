                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="selection-card">
                                <div class="sim-card-header">
                                    <i class="fas fa-sim-card sim-icon"></i>
                                    <span class="badge-available">Available</span>
                                </div>
                                <div class="card-title-text">5G SIM</div>
                                <p class="card-subtitle-text">Provider : We</p>
                                <p class="card-subtitle-text">Serial : 250154541.013100</p>
                            </div>
                        </div>
                    </div>

                    <div class="status-text">
                        <i class="fas fa-info-circle"></i> 250154541.013100 selected
                    </div>
                </div>

                <div class="mb-5">
                    <h2 class="section-title">
                        <i class="far fa-clock"></i> Schedule
                    </h2>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="custom-form-label">Activation date</label>
                            <input type="text" class="form-control custom-form-control" placeholder="8/7/2026" value="8/7/2026">
