@model Sim_Card_Managment.ViewModels.Subscription.SubscriptionDetailsVM

@{
    ViewData["Title"] = "Subscription Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscription Details</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link href="~/css/all.min.css" rel="stylesheet" asp-append-version="true" />

    <style>
        /* Preserved custom button shape */
        .btn-custom {
            height: 44px;
            padding: 0 24px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary-orange {
            background-color: var(--brand-orange, #DF531B);
            color: #FFFFFF;
        }

            .btn-primary-orange:hover {
                background-color: #c94614;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(223, 83, 27, 0.25);
            }

        .btn-secondary-soft {
            background-color: #F1F5F9;
            color: #64748B;
            border: 1px solid #E2E8F0;
        }

            .btn-secondary-soft:hover {
                background-color: #E2E8F0;
                color: #1E293B;
            }

        /* Interactive Sub-device cards */
        .device-card-link {
            display: block;
            text-decoration: none;
            height: 100%;
        }

        .sub-device-card {
            border: 1.5px solid var(--brand-orange, #DF531B);
            border-radius: 12px;
            padding: 20px;
            height: 100%;
            background-color: #ffffff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
        }

            .sub-device-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 24px rgba(223, 83, 27, 0.18);
            }

        .sub-device-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .sp-logo-img {
            height: 24px;
            max-width: 70px;
            object-fit: contain;
        }

        .usb-icon-wrap {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand-orange, #DF531B);
            font-size: 1.1rem;
        }

        .badge-available {
            font-size: 0.65rem;
            font-weight: 700;
            color: #198754;
            border: 1px solid #198754;
            border-radius: 12px;
            padding: 3px 8px;
        }

        .badge-inactive-mini {
            font-size: 0.65rem;
            font-weight: 700;
            color: #6c757d;
            border: 1px solid #6c757d;
            border-radius: 12px;
            padding: 3px 8px;
        }

        .card-title-text {
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 4px;
            color: #1E293B;
        }

        .card-subtitle-text {
            font-size: 0.8rem;
            color: #64748B;
            margin: 0;
        }
    </style>
</head>
<body>
    <section class="bd-body">
        <main class="container-fluid px-lg-5 p-100">

            <div class="bd-card mb-4">
                <div class="bd-card-header d-flex align-items-center justify-content-between p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bd-icon-wrapper">
                            <i class="fa-solid fa-file-contract"></i>
                        </div>
                        <div>
                            <h3 class="m-0 fs-5 fw-bold text-dark">Subscription Details</h3>
                            <p class="m-0 text-muted small">Recipient, device, and quota information</p>
                        </div>
                    </div>

                    <div>
                        @if (Model.Status == "Active")
                        {
                            <span class="bd-badge-up">
                                <i class="fa-solid fa-circle"></i> Active
                            </span>
                        }
                        else if (Model.Status == "Expired")
                        {
                            <span class="bd-badge-down">
                                <i class="fa-solid fa-circle"></i> Expired
                            </span>
                        }
                        else
                        {
                            <span class="bd-badge-unknown">
                                <i class="fa-solid fa-circle"></i> Scheduled End
                            </span>
                        }
                    </div>
                </div>

                <div class="p-4 p-md-5 border-top">
                    <div class="row g-4 mb-4">

                        <!-- Subscriber -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Subscriber</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-user text-muted me-2"></i>
                                @Model.SubscriberName
                            </div>
                        </div>

                        <!-- Type -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Type</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-id-card text-muted me-2"></i>
                                @Model.SubscriberType
                            </div>
                        </div>

                        <!-- Quota -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Quota</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-chart-pie text-muted me-2"></i>
                                @Model.QuotaName
                            </div>
                        </div>

                        <!-- Monthly Fees -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Monthly Fees</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-dollar-sign text-muted me-2"></i>
                                @Model.Fees
                            </div>
                        </div>

                        <!-- Start Date -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Start Date</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-calendar-day text-muted me-2"></i>
                                @Model.StartDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>

                        <!-- End Date -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">End Date</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-calendar-xmark text-muted me-2"></i>
                                @(Model.EndDate?.ToString("MMM dd, yyyy") ?? "Open ended")
                            </div>
                        </div>

                        <!-- Created By -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Created By</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-user-pen text-muted me-2"></i>
                                @Model.CreatedByUserName
                            </div>
                        </div>

                        <!-- Created Date -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="bd-info-label">Created Date</div>
                            <div class="bd-info-value">
                                <i class="fa-solid fa-clock text-muted me-2"></i>
                                @Model.CreatedDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>

                    </div>

                    <!-- Assigned Devices -->
                    <div class="bd-info-label mb-2">Assigned Devices</div>
                    <div class="row g-3 mb-4">
                        @if (Model.SimId.HasValue)
                        {
                            <div class="col-md-6">
                                <a asp-controller="SIM" asp-action="Details" asp-route-id="@Model.SimId" class="device-card-link">
                                    <div class="sub-device-card">
                                        <div class="sub-device-card-header">
                                            @{
                                                var simProvider = (Model.SimProviderName ?? "").ToLower();
                                                string simLogo = simProvider switch
                                                {
                                                    var p when p.Contains("we") => "/img/we.png",
                                                    var p when p.Contains("vodafone") || p.Contains("fodafone") => "/img/fodafone.png",
                                                    var p when p.Contains("orange") => "/img/orange.png",
                                                    var p when p.Contains("etisalat") => "/img/etisalat-logo.png",
                                                    _ => ""
                                                };
                                            }
                                            @if (!string.IsNullOrEmpty(simLogo))
                                            {
                                                <img src="@simLogo" alt="@Model.SimProviderName" class="sp-logo-img" />
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-dark" style="font-size:0.85rem">@(Model.SimProviderName ?? "Unknown")</span>
                                            }
                                            <span class="@(Model.SimIsActive ? "badge-available" : "badge-inactive-mini")">
                                                @(Model.SimIsActive ? "Active" : "Inactive")
                                            </span>
                                        </div>
                                        <div class="card-title-text">@(Model.SimNetworkType ?? "4G") SIM (@(Model.SimPhoneNumber ?? "N/A"))</div>
                                        <p class="card-subtitle-text">Provider : @(Model.SimProviderName ?? "Unknown")</p>
                                        <p class="card-subtitle-text">Serial : @(Model.SimNumber ?? "N/A")</p>
                                    </div>
                                </a>
                            </div>
                        }

                        @if (Model.UsbId.HasValue)
                        {
                            <div class="col-md-6">
                                <a asp-controller="USB" asp-action="Details" asp-route-id="@Model.UsbId" class="device-card-link">
                                    <div class="sub-device-card">
                                        <div class="sub-device-card-header">
                                            <div class="usb-icon-wrap">
                                                <i class="fa-solid fa-usb"></i>
                                            </div>
                                            <span class="@(Model.UsbIsActive ? "badge-available" : "badge-inactive-mini")">
                                                @(Model.UsbIsActive ? "Active" : "Inactive")
                                            </span>
                                        </div>
                                        <div class="card-title-text">@(Model.UsbModel ?? "USB Modem")</div>
                                        <p class="card-subtitle-text">Provider : @(Model.UsbProviderName ?? "Unknown")</p>
                                        <p class="card-subtitle-text">Serial : @(Model.UsbSerialNumber ?? "N/A")</p>
                                    </div>
                                </a>
                            </div>
                        }

                        @if (!Model.SimId.HasValue && !Model.UsbId.HasValue)
                        {
                            <div class="col-12 text-muted small">No devices assigned.</div>
                        }
                    </div>

                    <!-- Notes -->
                    <div class="bd-info-label">Notes</div>
                    <div class="bd-info-value border rounded-3 p-3 bg-light">
                        @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes available." : Model.Notes)
                    </div>

                    <!-- Action Footer with Preserved Button Shape -->
                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-controller="Subscription" asp-action="Index" class="btn-custom btn-secondary-soft">
                            <i class="fa-solid fa-arrow-left"></i> Back
                        </a>
                        <a asp-controller="Subscription" asp-action="Edit" asp-route-id="@Model.Id" class="btn-custom btn-primary-orange">
                            <i class="fa-solid fa-pen-to-square"></i> Edit Subscription
                        </a>
                    </div>

                </div>
            </div>

        </main>
    </section>
</body>
</html>