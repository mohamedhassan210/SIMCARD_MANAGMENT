    <style>
        :root {
            --brand-orange: #EE4623;
            --brand-orange-dark: #D63A1B;
            --ink: #1F2430;
            --muted: #8A94A6;
            --line: #E7E9EF;
            --bg: #F4F5F8;
            --card: #FFFFFF;
            --success-bg: #EAF7EE;
            --success-text: #1E9E4C;
        }

     
       

        .breadcrumb-row {
            font-size: .8rem;
            color: var(--muted);
        }

            .breadcrumb-row a {
                color: var(--muted);
                text-decoration: none;
            }

            .breadcrumb-row .current {
                color: var(--ink);
                font-weight: 600;
            }

        .page-title {
            font-weight: 700;
            font-size: 1.5rem;
            margin-bottom: .15rem;
        }

        .page-sub {
            color: var(--muted);
            font-size: .85rem;
        }

        /* Step sidebar */
        .step-list {
            list-style: none;
            padding: 0;
            margin: 0;
            position: relative;
        }

            .step-list::before {
                content: "";
                position: absolute;
                left: 13px;
                top: 14px;
                bottom: 14px;
                width: 2px;
                background: var(--line);
                z-index: 0;
            }

        .step-item {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .6rem 0;
            position: relative;
            z-index: 1;
        }

        .step-dot {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .85rem;
            flex-shrink: 0;
            background: #fff;
            border: 2px solid var(--line);
            color: var(--muted);
        }

        .step-item.done .step-dot {
            background: var(--brand-orange);
            border-color: var(--brand-orange);
            color: #fff;
        }

        .step-item.active .step-label {
            color: var(--brand-orange);
            font-weight: 700;
        }

        .step-item.done .step-label {
            color: var(--ink);
            font-weight: 600;
        }

        .step-label {
            color: var(--muted);
            font-size: .9rem;
        }

        /* Card panel */
        .panel {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 1.5rem;
        }

        .section-heading {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 1rem;
        }

            .section-heading i {
                color: var(--brand-orange);
            }

        .field-label {
            font-size: .8rem;
            color: var(--muted);
            margin-bottom: .35rem;
            display: block;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid var(--line);
            padding: .55rem .8rem;
            font-size: .88rem;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--brand-orange);
                box-shadow: 0 0 0 .15rem rgba(238,70,35,.15);
            }

        .search-input {
            position: relative;
        }

            .search-input i {
                position: absolute;
                left: .8rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--muted);
            }

            .search-input input {
                padding-left: 2.2rem;
            }

        /* Selectable cards (employee / sim) */
        .pick-card {
            border: 1.5px solid var(--line);
            border-radius: 12px;
            padding: .8rem .9rem;
            display: flex;
            align-items: center;
            gap: .7rem;
            cursor: pointer;
            position: relative;
            background: #fff;
            transition: border-color .15s ease;
        }

            .pick-card:hover {
                border-color: #F3B9AB;
            }

            .pick-card.selected {
                border-color: var(--brand-orange);
                background: #FFF7F5;
            }

            .pick-card .avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: #E9ECF2;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--muted);
                font-size: 1.1rem;
                flex-shrink: 0;
            }

            .pick-card .title {
                font-weight: 600;
                font-size: .88rem;
            }

            .pick-card .subtitle {
                font-size: .75rem;
                color: var(--muted);
            }

            .pick-card .check-badge {
                margin-left: auto;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: var(--brand-orange);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .7rem;
            }

        .change-link {
            font-size: .78rem;
            color: var(--brand-orange);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .3rem;
        }

        /* Device type toggle */
        .toggle-group {
            display: inline-flex;
            background: #EFF1F5;
            border-radius: 10px;
            padding: .25rem;
            gap: .25rem;
        }

            .toggle-group .btn {
                border-radius: 8px;
                font-size: .85rem;
                font-weight: 600;
                padding: .45rem 1.3rem;
                border: none;
                color: var(--muted);
                background: transparent;
            }

                .toggle-group .btn.active {
                    background: var(--brand-orange);
                    color: #fff;
                }

        /* Sim device cards */
        .device-card {
            border: 1.5px solid var(--line);
            border-radius: 12px;
            padding: .9rem;
            position: relative;
            cursor: pointer;
            background: #fff;
        }

            .device-card.selected {
                border-color: var(--brand-orange);
                background: #FFF7F5;
            }

            .device-card .badge-avail {
                position: absolute;
                top: .7rem;
                right: .7rem;
                background: var(--success-bg);
                color: var(--success-text);
                font-size: .65rem;
                font-weight: 700;
                padding: .2rem .55rem;
                border-radius: 999px;
            }

            .device-card .icon-wrap {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                background: #F2F3F6;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--brand-orange);
                margin-bottom: .6rem;
                font-size: 1rem;
            }

            .device-card .d-title {
                font-weight: 700;
                font-size: .88rem;
                margin-bottom: .1rem;
            }

            .device-card .d-sub {
                font-size: .75rem;
                color: var(--muted);
                margin-bottom: .05rem;
            }

        hr.section-divider {
            border-color: var(--line);
            margin: 1.75rem 0;
        }

        .terms-check label {
            font-size: .8rem;
            color: var(--muted);
        }

        .terms-check a {
            color: var(--brand-orange);
            text-decoration: none;
            font-weight: 600;
        }

        .actions-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1.5rem;
        }

        .btn-outline-secondary-soft {
            border-radius: 10px;
            border: 1px solid var(--line);
            background: #fff;
            color: var(--ink);
            font-weight: 600;
            padding: .55rem 1.5rem;
            font-size: .85rem;
        }

        .btn-draft {
            border-radius: 10px;
            border: 1px solid var(--line);
            background: #F2F3F6;
            color: var(--muted);
            font-weight: 600;
            padding: .55rem 1.5rem;
            font-size: .85rem;
        }

        .btn-primary-brand {
            border-radius: 10px;
            background: var(--brand-orange);
            border: none;
            color: #fff;
            font-weight: 700;
            padding: .55rem 1.8rem;
            font-size: .85rem;
        }

            .btn-primary-brand:hover {
                background: var(--brand-orange-dark);
                color: #fff;
            }

        .edit-flag {
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--brand-orange);
            background: #FFF1EE;
            padding: .25rem .6rem;
            border-radius: 6px;
        }
    </style>

<body>

   

    <div class="container-fluid p-100 py-4" style="max-width:1200px;">

        <!-- Breadcrumb -->
        <div class="breadcrumb-row mb-2">
            <a href="#">Subscription</a> &nbsp;&gt;&nbsp; <span class="current">Edit subscription</span>
        </div>

        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="page-title mb-0">Edit Subscription</h1>
            <span class="edit-flag">Editing</span>
        </div>
        <p class="page-sub mb-4">Update the details below to modify this employee's assigned system asset.</p>

        <div class="row g-4">
            <!-- Left step nav -->
            <div class="col-12 col-md-3">
                <ul class="step-list">
                    <li class="step-item done">
                        <span class="step-dot"><i class="bi bi-check-lg"></i></span>
                        <span class="step-label">Employee</span>
                    </li>
                    <li class="step-item done">
                        <span class="step-dot"><i class="bi bi-check-lg"></i></span>
                        <span class="step-label">Device</span>
                    </li>
                    <li class="step-item active">
                        <span class="step-dot">3</span>
                        <span class="step-label">Quota</span>
                    </li>
                    <li class="step-item">
                        <span class="step-dot">4</span>
                        <span class="step-label">Schedule</span>
                    </li>
                </ul>
            </div>

            <!-- Right form panel -->
            <div class="col-12 col-md-9">
                <div class="panel">

                    <!-- Select Employee -->
                    <div class="section-heading">
                        <i class="bi bi-person-circle"></i> Select Employee
                    </div>
                    <label class="field-label">Employee Search</label>
                    <div class="search-input mb-3">
                        <i class="bi bi-search"></i>
                        <input type="text" class="form-control" placeholder="Search by name or id" value="Mohamed Hussien">
                    </div>

                    <div class="row g-3 mb-1">
                        <div class="col-12 col-sm-6">
                            <div class="pick-card selected">
                                <div class="avatar"><i class="bi bi-person-fill"></i></div>
                                <div>
                                    <div class="title">Mohamed Hussien</div>
                                    <div class="subtitle">HR manager · ID 2334</div>
                                </div>
                                <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="pick-card">
                                <div class="avatar"><i class="bi bi-person-fill"></i></div>
                                <div>
                                    <div class="title">Mohamed Hussien</div>
                                    <div class="subtitle">HR manager · ID 2334</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <a href="#" class="change-link"><i class="bi bi-pencil"></i> Change selected employee</a>

                    <hr class="section-divider">

                    <!-- Device type -->
                    <div class="section-heading">
                        <i class="bi bi-sim"></i> Device type
                    </div>
                    <div class="toggle-group mb-3">
                        <button type="button" class="btn active">SIM Card</button>
                        <button type="button" class="btn">Usb</button>
                    </div>

                    <div class="row g-3 mb-2">
                        <div class="col-12 col-md-6">
                            <label class="field-label">SIM cards</label>
                            <div class="search-input">
                                <i class="bi bi-search"></i>
                                <input type="text" class="form-control" placeholder="Search by name or id">
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="field-label">Select sim</label>
                            <select class="form-select">
                                <option selected>0755245787110</option>
                                <option>0755245787111</option>
                                <option>0755245787112</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-1">
                        <div class="col-12 col-sm-6">
                            <div class="device-card selected">
                                <span class="badge-avail">Available</span>
                                <div class="icon-wrap"><i class="bi bi-sim"></i></div>
                                <div class="d-title">5G SIM</div>
                                <div class="d-sub">Provider : We</div>
                                <div class="d-sub">Serial : 2805649703500</div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="device-card">
                                <span class="badge-avail">Available</span>
                                <div class="icon-wrap"><i class="bi bi-sim"></i></div>
                                <div class="d-title">5G SIM</div>
                                <div class="d-sub">Provider : We</div>
                                <div class="d-sub">Serial : 2925645103900</div>
                            </div>
                        </div>
                    </div>
                    <a href="#" class="change-link"><i class="bi bi-pencil"></i> Change selected device</a>

                    <hr class="section-divider">

                    <!-- Quota -->
                    <div class="section-heading">
                        <i class="bi bi-clock-history"></i> Quota
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="field-label">Select quota</label>
                            <select class="form-select">
                                <option>2GB</option>
                                <option selected>5GB</option>
                                <option>10GB</option>
                                <option>20GB</option>
                            </select>
                        </div>
                    </div>

                    <hr class="section-divider">

                    <!-- Schedule -->
                    <div class="section-heading">
                        <i class="bi bi-clock-history"></i> Schedule
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="field-label">Activation date</label>
                            <input type="date" class="form-control" value="2026-08-07">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="field-label">Contract duration</label>
                            <select class="form-select">
                                <option>6 months</option>
                                <option selected>1 year</option>
                                <option>2 years</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-check terms-check mb-1">
                        <input class="form-check-input" type="checkbox" id="termsCheck" checked>
                        <label class="form-check-label" for="termsCheck">
                            I agree to the <a href="#">Terms &amp; Conditions</a> and privacy policy. I acknowledge that the selected employee is solely responsible for the use of the assigned asset.
                        </label>
                    </div>

                    <!-- Actions -->
                    <div class="actions-bar">
                        <button type="button" class="btn-outline-secondary-soft">Back</button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn-draft">Save Draft</button>
                            <button type="button" class="btn-primary-brand">Update Subscription</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</body>
