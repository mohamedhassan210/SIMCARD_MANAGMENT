@model Sim_Card_Managment.Models.Quota

@{
    ViewData["Title"] = "Quota Details";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quota Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #E24D17;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 2rem 1rem;
        }

        .details-card {
            background-color: #ffffff;
            border-radius: 30px;
            max-width: 750px;
            width: 100%;
            padding: 3rem 4rem;
        }

        .title-header {
            font-weight: 700;
            font-size: 32px;
            color: #000;
            margin-bottom: 0.25rem;
        }

        .subtitle-text {
            font-size: 14px;
            color: #6c757d;
            margin-bottom: 2.5rem;
        }

        .detail-item {
            background-color: #f8f9fa;
            border-radius: 16px;
            padding: 1.25rem 1.5rem;
            border: 1px solid #e0e0e0;
            height: 100%;
        }

        .detail-label {
            font-weight: 600;
            color: #6c757d;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .detail-value {
            font-weight: 700;
            color: #1a1a1a;
            font-size: 20px;
            margin-bottom: 0;
        }

        /* Status Badges */
        .badge-status-active {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-status-inactive {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* Action Buttons */
        .btn-cancel {
            border: 1px solid #E24D17;
            background-color: #ffffff;
            color: #000;
            border-radius: 30px;
            padding: 10px 35px;
            font-weight: 700;
            font-size: 15px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

            .btn-cancel:hover {
                background-color: #fffaf8;
                color: #E24D17;
            }

        .btn-edit {
            background-color: #E24D17;
            border: 1px solid #E24D17;
            color: #fff;
            border-radius: 30px;
            padding: 10px 35px;
            font-weight: 700;
            font-size: 15px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

            .btn-edit:hover {
                background-color: #c84111;
                border-color: #c84111;
                color: #fff;
            }
    </style>
</head>

<body>

    <div class="details-card shadow">
        <h2 class="title-header">Quota Details</h2>
        <p class="subtitle-text">Detailed view of provider quota allocations, extra units, and active pricing.</p>

        <div class="row g-4 mb-5">

            <div class="col-12">
                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fas fa-building text-secondary"></i> Service Provider
                    </span>
                    <p class="detail-value text-primary-emphasis">Vodafone Egypt</p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fas fa-database text-secondary"></i> Base Amount
                    </span>
                    <p class="detail-value">100 GB</p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fas fa-plus-circle text-secondary"></i> Extra Amount
                    </span>
                    <p class="detail-value text-success">+20 GB</p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fas fa-receipt text-secondary"></i> Total Fees
                    </span>
                    <p class="detail-value text-danger">$150.00</p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item d-flex flex-column justify-content-center">
                    <span class="detail-label">
                        <i class="fas fa-toggle-on text-secondary"></i> Status
                    </span>
                    <div>
                        <span class="badge-status-active">
                            <i class="fas fa-circle" style="font-size: 8px;"></i> Active
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <div class="d-flex justify-content-end gap-3">
            <a class="btn btn-cancel" href="/Quota/Index">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
            <a class="btn btn-edit" href="/Quota/Edit/1">
                <i class="fas fa-pen"></i> Edit Quota
            </a>
        </div>

    </div>

</body>

</html> 