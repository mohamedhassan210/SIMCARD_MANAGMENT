@model Sim_Card_Managment.Models.Quota

@{
    ViewData["Title"] = "Create Quota";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Quota</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #E24D17;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 2rem 1rem;
        }

        .create-card {
            background-color: #ffffff;
            border-radius: 30px;
            max-width: 750px;
            width: 100%;
            padding: 3rem 4rem;
        }

        .title-header {
            font-weight: 700;
            font-size: 32px;
            color: #000;
            margin-bottom: 2.5rem;
        }

        .custom-label {
            font-weight: 500;
            color: #000;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .custom-input {
            background-color: #d8d8d8;
            border: none;
            border-radius: 12px;
            padding: 12px 18px;
            color: #333;
            width: 100%;
            font-size: 14px;
            transition: box-shadow 0.2s ease-in-out, background-color 0.2s ease-in-out;
        }

            .custom-input:focus {
                outline: none;
                box-shadow: 0 0 0 2px #E24D17;
                background-color: #e2e2e2;
            }

        .btn-cancel {
            border: 1px solid #E24D17;
            background-color: #ffffff;
            color: #000;
            border-radius: 30px;
            padding: 10px 45px;
            font-weight: 700;
            font-size: 15px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
        }

            .btn-cancel:hover {
                background-color: #fffaf8;
                color: #E24D17;
            }

        .btn-create {
            background-color: #E24D17;
            border: 1px solid #E24D17;
            color: #fff;
            border-radius: 30px;
            padding: 10px 45px;
            font-weight: 700;
            font-size: 15px;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                background-color: #c84111;
                border-color: #c84111;
                color: #fff;
            }

        .custom-input.is-invalid {
            box-shadow: 0 0 0 2px #D41212;
            background-color: #ffe6e6;
        }

        .error-msg {
            color: #D41212;
            font-size: 12px;
            margin-top: 5px;
            margin-left: 10px;
            display: block;
        }

        /* Custom Toggle Switch */
        .form-check-input:checked {
            background-color: #E24D17;
            border-color: #E24D17;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(226, 77, 23, 0.25);
            border-color: #E24D17;
        }

        .toggle-container {
            background-color: #f8f9fa;
            border-radius: 16px;
            padding: 1rem 1.5rem;
            border: 1px solid #e0e0e0;
        }
    </style>
</head>

<body>

    <div class="create-card shadow">
        <h2 class="title-header">Create New Quota</h2>

        <form id="quotaForm" method="post">

            <div class="row g-4 mb-4">
                <div class="col-md-12">
                    <label class="custom-label" for="ServiceProviderId">Service Provider</label>
                    <select name="ServiceProviderId" id="serviceProvider" class="custom-input">
                        <option value="" disabled selected>Select Service Provider</option>
                        <option value="1">Vodafone Egypt</option>
                        <option value="2">Orange Business</option>
                        <option value="3">Etisalat Misr</option>
                        <option value="4">WE (Telecom Egypt)</option>
                    </select>
                    <span class="error-msg" id="providerError"></span>
                </div>

                <div class="col-md-6">
                    <label class="custom-label" for="BaseAmount">Base Amount (GB / Units)</label>
                    <input type="number" step="0.01" name="BaseAmount" id="baseAmount" class="custom-input" placeholder="e.g. 100">
                    <span class="error-msg" id="baseAmountError"></span>
                </div>

                <div class="col-md-6">
                    <label class="custom-label" for="ExtraAmount">Extra Amount (GB / Units)</label>
                    <input type="number" step="0.01" name="ExtraAmount" id="extraAmount" class="custom-input" placeholder="e.g. 20">
                    <span class="error-msg" id="extraAmountError"></span>
                </div>

                <div class="col-md-12">
                    <label class="custom-label" for="Fees">Fees ($ / EGP)</label>
                    <input type="number" step="0.01" name="Fees" id="fees" class="custom-input" placeholder="e.g. 150.00">
                    <span class="error-msg" id="feesError"></span>
                </div>

                <div class="col-md-12">
                    <div class="toggle-container d-flex align-items-center justify-content-between">
                        <div>
                            <label class="custom-label mb-0" for="isActiveToggle">Active Status</label>
                            <small class="text-muted d-block" style="font-size: 12px;">Set whether this quota is currently active for allocations.</small>
                        </div>
                        <div class="form-check form-switch fs-4 mb-0">
                            <input class="form-check-input" type="checkbox" id="isActiveToggle" name="IsActive" value="true" checked style="cursor: pointer;">
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-5">
                <a class="btn btn-cancel" href="/Quota/Index">Cancel</a>
                <button type="submit" class="btn btn-create">Create</button>
            </div>

        </form>
    </div>

    <script>
        document.getElementById('quotaForm').addEventListener('submit', function (event) {
            let isValid = true;

            // Clear previous error states
            document.querySelectorAll('.is-invalid').forEach(function(el) {
                el.classList.remove('is-invalid');
            });

            // Validate Service Provider
            const provider = document.getElementById('serviceProvider');
            if (!provider.value || provider.value === '') {
                provider.classList.add('is-invalid');
                isValid = false;
            }

            // Validate Base Amount
            const baseAmount = document.getElementById('baseAmount');
            if (!baseAmount.value || baseAmount.value < 0) {
                baseAmount.classList.add('is-invalid');
                isValid = false;
            }

            // Validate Fees
            const fees = document.getElementById('fees');
            if (!fees.value || fees.value < 0) {
                fees.classList.add('is-invalid');
                isValid = false;
            }

            if (!isValid) {
                event.preventDefault();
            }
        });
    </script>
</body>

</html>
@section Scripts {
    @{
        @Html.AntiForgeryToken();
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}