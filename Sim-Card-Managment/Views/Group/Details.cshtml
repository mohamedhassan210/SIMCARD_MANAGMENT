@model Sim_Card_Managment.Models.Group
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Details</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-orange: #DF531B;
            --brand-orange-light: #FFF8F6;
            --brand-purple: #5B2D90;
            --bg-canvas: #F4F5F8;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --card-border: #E2E8F0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, sans-serif;
            padding-bottom: 3rem;
        }

        /* Group Details Card */
        .details-card {
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            overflow: hidden;
            margin-top: 2.5rem;
            margin-bottom: 2rem;
        }

        .card-header-styled {
            border-bottom: 1px solid var(--card-border);
            padding: 1.5rem 2rem;
            background: linear-gradient(180deg, var(--brand-orange-light) 0%, #FFFFFF 100%);
        }

        .section-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background-color: rgba(223, 83, 27, 0.12);
            color: var(--brand-orange);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .info-grid-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 4px;
        }

        .info-grid-value {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .badge-status-active {
            display: inline-block;
            font-size: 0.75rem;
            background-color: rgba(34, 197, 94, 0.1);
            color: #15803D;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 50px;
            border: 1px solid rgba(34, 197, 94, 0.2);
            text-transform: uppercase;
        }

        .emp-count-badge {
            background: #E8F0FE;
            color: #1A73E8;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.9rem;
            display: inline-block;
        }

        /* Users Section */
        .users-card {
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            padding: 2rem;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #FFF;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 10px 16px;
            transition: border-color 0.2s ease;
        }

            .search-box:focus-within {
                border-color: var(--brand-orange);
            }

            .search-box i {
                color: var(--text-muted);
            }

            .search-box input {
                border: none;
                outline: none;
                background: transparent;
                font-size: 0.95rem;
                width: 100%;
                color: var(--text-dark);
            }

        /* Fixed Table Container with Hidden Scrollbar */
        .table-scroll-container {
            max-height: 260px; /* Fixed height for scrolling */
            overflow-y: auto;
            border-bottom: 1px solid var(--card-border);
            /* Hide scrollbar for Chrome, Safari and Opera */
            -webkit-overflow-scrolling: touch;
        }

            .table-scroll-container::-webkit-scrollbar {
                display: none;
            }

        /* Hide scrollbar for IE, Edge and Firefox */
        .table-scroll-container {
            -ms-overflow-style: none; /* IE and Edge */
            scrollbar-width: none; /* Firefox */
        }

        /* Table Styling */
        .users-table {
            width: 100%;
            border-collapse: collapse;
        }

            .users-table thead th {
                position: sticky;
                top: 0;
                background-color: #FFFFFF;
                z-index: 10;
                text-align: left;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--text-muted);
                padding-bottom: 12px;
                border-bottom: 2px solid var(--brand-orange);
            }

            .users-table tbody td {
                font-size: 0.95rem;
                padding: 16px 0;
                border-bottom: 1px solid var(--card-border);
                vertical-align: middle;
            }

        .btn-change-group {
            border: 1.5px solid var(--brand-purple);
            color: var(--brand-purple);
            background: transparent;
            font-size: 0.8rem;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .btn-change-group:hover {
                background: var(--brand-purple);
                color: #FFFFFF;
            }

        /* Action Buttons Container under Table */
        .group-actions-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 1.75rem;
            flex-wrap: wrap;
        }

        .btn-action {
            height: 44px;
            padding: 0 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .btn-action-edit {
            background-color: var(--brand-orange);
            color: #FFFFFF;
        }

            .btn-action-edit:hover {
                background-color: #c94614;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(223, 83, 27, 0.25);
            }

        .btn-action-delete {
            background-color: #FEF2F2;
            color: #DC2626;
            border: 1px solid #FCA5A5;
        }

            .btn-action-delete:hover {
                background-color: #DC2626;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
            }

        .btn-action-permissions {
            background-color: rgba(91, 45, 144, 0.1);
            color: var(--brand-purple);
            border: 1px solid rgba(91, 45, 144, 0.2);
        }

            .btn-action-permissions:hover {
                background-color: var(--brand-purple);
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(91, 45, 144, 0.25);
            }

        .btn-action-activate-group {
            background-color: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #93C5FD;
        }

            .btn-action-activate-group:hover {
                background-color: #1D4ED8;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(29, 78, 216, 0.2);
            }

    </style>
</head>
<body>

    @Html.AntiForgeryToken()

    <main class="container-fluid px-lg-5 p-100">

        <div class="details-card">
            <div class="card-header-styled d-flex align-items-center gap-3">
                <div class="section-icon-wrapper">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">Group Details</h3>
                    <p class="m-0 text-muted small">System permissions and member count</p>
                </div>
            </div>

            <div class="p-4 p-md-5">
                <div class="row g-4">
                    <div class="col-12 col-md-3">
                        <div class="info-grid-label">Group Name</div>
                        <div class="info-grid-value">@Model.Name</div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="info-grid-label">Description</div>
                        <div class="info-grid-value">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</div>
                    </div>

                    <div class="col-12 col-sm-4 col-md-2">
                        <div class="info-grid-label">Status</div>
                        <div class="info-grid-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge-status-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-status-active" style="background-color: rgba(220,38,38,0.1); color:#DC2626; border-color: rgba(220,38,38,0.2);">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="col-12 col-sm-4 col-md-2">
                        <div class="info-grid-label">Created At</div>
                        <div class="info-grid-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                    </div>

                    <div class="col-12 col-sm-4 col-md-1">
                        <div class="info-grid-label">Employees</div>
                        <div class="info-grid-value">
                            <span class="emp-count-badge">@Model.Users.Count</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="users-card">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <h4 class="fw-bold fs-5 m-0 text-dark">Assigned Users</h4>

                <div class="search-box col-12 col-md-4">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="userSearchInput" type="text" placeholder="Search users by name..." autocomplete="off">
                </div>
            </div>

            <div class="table-scroll-container">
                <table class="users-table" id="usersTable">
                    <thead>
                        <tr>
                            <th>User Name</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        @if (Model.Users.Any())
                        {
                            @foreach (var user in Model.Users)
                            {
                                <tr class="user-row">
                                    <td>
                                        <strong>@user.Username</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn-change-group" onclick="changeGroup(@user.Id, '@user.Username')">
                                            <i class="fa-solid fa-arrows-rotate me-1"></i> Change Group
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        <tr id="noResultsRow" style="display: @(Model.Users.Any() ? "none" : "");">
                            <td colspan="2" class="text-center text-muted py-4">
                                No matching users found.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="group-actions-bar">
                <a asp-controller="Group" asp-action="Edit" asp-route-id="@Model.Id" class="btn-action btn-action-edit">
                    <i class="fa-solid fa-pen-to-square"></i> Edit
                </a>

                @if (Model.IsActive)
                {
                    <button type="button" class="btn-action btn-action-delete" onclick="onDeleteGroup(@Model.Id)">
                        <i class="fa-solid fa-trash-can"></i> Delete
                    </button>
                }
                else
                {
                    <button type="button" class="btn-action btn-action-activate-group" onclick="onActivateGroup(@Model.Id)">
                        <i class="fa-solid fa-circle-check"></i> Activate
                    </button>
                }

                <a asp-action="mangePermission" asp-controller="Permission" asp-route-groupId="@Model.Id" class="btn-action btn-action-permissions">
                    <i class="fa-solid fa-user-shield"></i> Manage Permissions
                </a>
            </div>

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        // Client-side search for the scrollable table
        document.getElementById('userSearchInput').addEventListener('input', function () {
            const query = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#usersTableBody tr.user-row');
            let hasVisibleRow = false;

            rows.forEach(row => {
                const name = row.querySelector('td').innerText.toLowerCase();
                if (name.includes(query)) {
                    row.style.display = '';
                    hasVisibleRow = true;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('noResultsRow').style.display = hasVisibleRow ? 'none' : '';
        });

        // Change Group Action — pulls real groups, posts real change
        async function changeGroup(userId, userName) {
            let groupOptions = {};
            try {
                const res = await fetch('/Group/GetAllGroups');
                const groups = await res.json();
                groups.forEach(g => groupOptions[g.id] = g.name);
            } catch {
                Swal.fire('Error', 'Could not load groups.', 'error');
                return;
            }

            const result = await Swal.fire({
                title: 'Change Group',
                text: `Reassign group for ${userName}`,
                input: 'select',
                inputOptions: groupOptions,
                inputPlaceholder: 'Select a new group',
                showCancelButton: true,
                confirmButtonColor: '#5B2D90',
                cancelButtonColor: '#64748B',
                confirmButtonText: 'Save Change',
                customClass: { popup: 'rounded-4' }
            });

            if (result.isConfirmed && result.value) {
                const formData = new FormData();
                formData.append('userId', userId);
                formData.append('newGroupId', result.value);
                formData.append('__RequestVerificationToken', getAntiForgeryToken());

                const res = await fetch('/Group/ChangeUserGroup', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success) {
                    Swal.fire({
                        title: 'Updated!',
                        text: `${userName} was moved to a new group.`,
                        icon: 'success',
                        customClass: { popup: 'rounded-4' }
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Error', data.message || 'Failed to change group.', 'error');
                }
            }
        }

               function onDeleteGroup(groupId) {
            Swal.fire({
                title: 'Delete Group?',
                text: 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#DC2626',
                cancelButtonColor: '#64748B',
                confirmButtonText: 'Yes, Delete',
                customClass: { popup: 'rounded-4' }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', getAntiForgeryToken());

                    const res = await fetch(`/Group/Delete/${groupId}`, {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok || res.redirected) {
                        window.location.href = '/Group/Index';
                    } else {
                        Swal.fire('Error', 'Failed to delete group.', 'error');
                    }
                }
            });
        }

        function onActivateGroup(groupId) {
            Swal.fire({
                title: 'Activate Group?',
                text: 'This will reactivate the group.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#1D4ED8',
                cancelButtonColor: '#64748B',
                confirmButtonText: 'Yes, Activate',
                customClass: { popup: 'rounded-4' }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', getAntiForgeryToken());

                    const res = await fetch(`/Group/Activate/${groupId}`, {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok || res.redirected) {
                        window.location.reload();
                    } else {
                        Swal.fire('Error', 'Failed to activate group.', 'error');
                    }
                }
            });
        }


        
    </script>
</body>
</html>