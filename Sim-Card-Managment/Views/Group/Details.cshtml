<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Details</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-orange: #DF531B;
            --brand-orange-light: #FFF8F6;
            --brand-purple: #5B2D90;
            --bg-canvas: #F4F5F8;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --card-border: #E2E8F0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, sans-serif;
            padding-bottom: 3rem;
        }

        /* Group Details Card */
        .details-card {
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            overflow: hidden;
            margin-top: 2.5rem;
            margin-bottom: 2rem;
        }

        .card-header-styled {
            border-bottom: 1px solid var(--card-border);
            padding: 1.5rem 2rem;
            background: linear-gradient(180deg, var(--brand-orange-light) 0%, #FFFFFF 100%);
        }

        .section-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background-color: rgba(223, 83, 27, 0.12);
            color: var(--brand-orange);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .info-grid-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 4px;
        }

        .info-grid-value {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .badge-status-active {
            display: inline-block;
            font-size: 0.75rem;
            background-color: rgba(34, 197, 94, 0.1);
            color: #15803D;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 50px;
            border: 1px solid rgba(34, 197, 94, 0.2);
            text-transform: uppercase;
        }

        .emp-count-badge {
            background: #E8F0FE;
            color: #1A73E8;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.9rem;
            display: inline-block;
        }

        /* Users Section */
        .users-card {
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            padding: 2rem;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #FFF;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 10px 16px;
            transition: border-color 0.2s ease;
        }

            .search-box:focus-within {
                border-color: var(--brand-orange);
            }

            .search-box i {
                color: var(--text-muted);
            }

            .search-box input {
                border: none;
                outline: none;
                background: transparent;
                font-size: 0.95rem;
                width: 100%;
                color: var(--text-dark);
            }

        /* Table Styling */
        .users-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1.5rem;
        }

            .users-table thead th {
                text-align: left;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--text-muted);
                padding-bottom: 12px;
                border-bottom: 2px solid var(--brand-orange);
            }

            .users-table tbody td {
                font-size: 0.95rem;
                padding: 16px 0;
                border-bottom: 1px solid var(--card-border);
                vertical-align: middle;
            }

        .btn-change-group {
            border: 1.5px solid var(--brand-purple);
            color: var(--brand-purple);
            background: transparent;
            font-size: 0.8rem;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .btn-change-group:hover {
                background: var(--brand-purple);
                color: #FFFFFF;
            }
    </style>
</head>
<body>

    <main class="container-fluid px-lg-5 p-100">

        <div class="details-card">
            <div class="card-header-styled d-flex align-items-center gap-3">
                <div class="section-icon-wrapper">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">Group Details</h3>
                    <p class="m-0 text-muted small">System permissions and member count</p>
                </div>
            </div>

            <div class="p-4 p-md-5">
                <div class="row g-4">
                    <div class="col-12 col-md-3">
                        <div class="info-grid-label">Group Name</div>
                        <div class="info-grid-value">Administrators</div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="info-grid-label">Description</div>
                        <div class="info-grid-value">Full access privileges across all modules and system settings.</div>
                    </div>

                    <div class="col-12 col-sm-4 col-md-2">
                        <div class="info-grid-label">Status</div>
                        <div class="info-grid-value">
                            <span class="badge-status-active">Active</span>
                        </div>
                    </div>

                    <div class="col-12 col-sm-4 col-md-2">
                        <div class="info-grid-label">Created At</div>
                        <div class="info-grid-value">Jan 15, 2026</div>
                    </div>

                    <div class="col-12 col-sm-4 col-md-1">
                        <div class="info-grid-label">Employees</div>
                        <div class="info-grid-value">
                            <span class="emp-count-badge">3</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="users-card">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <h4 class="fw-bold fs-5 m-0 text-dark">Assigned Users</h4>

                <div class="search-box col-12 col-md-4">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="userSearchInput" type="text" placeholder="Search users by name..." autocomplete="off">
                </div>
            </div>

            <div class="table-responsive">
                <table class="users-table" id="usersTable">
                    <thead>
                        <tr>
                            <th>User Name</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        <tr class="user-row">
                            <td>
                                <strong>John Doe</strong>
                            </td>
                            <td style="text-align: right;">
                                <button type="button" class="btn-change-group" onclick="changeGroup('John Doe')">
                                    <i class="fa-solid fa-arrows-rotate me-1"></i> Change Group
                                </button>
                            </td>
                        </tr>
                        <tr class="user-row">
                            <td>
                                <strong>Sarah Smith</strong>
                            </td>
                            <td style="text-align: right;">
                                <button type="button" class="btn-change-group" onclick="changeGroup('Sarah Smith')">
                                    <i class="fa-solid fa-arrows-rotate me-1"></i> Change Group
                                </button>
                            </td>
                        </tr>
                        <tr class="user-row">
                            <td>
                                <strong>Michael Brown</strong>
                            </td>
                            <td style="text-align: right;">
                                <button type="button" class="btn-change-group" onclick="changeGroup('Michael Brown')">
                                    <i class="fa-solid fa-arrows-rotate me-1"></i> Change Group
                                </button>
                            </td>
                        </tr>
                        <tr id="noResultsRow" style="display: none;">
                            <td colspan="2" class="text-center text-muted py-4">
                                No matching users found.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Search functionality
        document.getElementById('userSearchInput').addEventListener('input', function () {
            const query = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#usersTableBody tr.user-row');
            let hasVisibleRow = false;

            rows.forEach(row => {
                const name = row.querySelector('td').innerText.toLowerCase();
                if (name.includes(query)) {
                    row.style.display = '';
                    hasVisibleRow = true;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('noResultsRow').style.display = hasVisibleRow ? 'none' : '';
        });

        // Change Group Action
        function changeGroup(userName) {
            Swal.fire({
                title: 'Change Group',
                text: `Reassign group for ${userName}`,
                input: 'select',
                inputOptions: {
                    'Administrators': 'Administrators',
                    'HR Managers': 'HR Managers',
                    'Support Team': 'Support Team'
                },
                inputPlaceholder: 'Select a new group',
                showCancelButton: true,
                confirmButtonColor: '#5B2D90',
                cancelButtonColor: '#64748B',
                confirmButtonText: 'Save Change',
                customClass: { popup: 'rounded-4' }
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    Swal.fire({
                        title: 'Updated!',
                        text: `${userName} was moved to ${result.value}.`,
                        icon: 'success',
                        customClass: { popup: 'rounded-4' }
                    });
                }
            });
        }
    </script>
</body>
</html>