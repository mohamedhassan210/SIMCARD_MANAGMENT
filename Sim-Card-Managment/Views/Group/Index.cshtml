@model IEnumerable<Sim_Card_Managment.Viewmodel.GroupListItemViewModel>

@{
    ViewData["Title"] = "Groups Directory";
    var groupList = Model?.ToList() ?? new List<Sim_Card_Managment.Viewmodel.GroupListItemViewModel>();
    int totalCount = groupList.Count;
    int activeCount = groupList.Count(x => x.IsActive);
    int inactiveCount = groupList.Count(x => !x.IsActive);

    string currentStatus = (ViewBag.CurrentStatus as string)?.ToLower() ?? "all";
}

<style>
    /* Theme & Layout Variables */
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
        --bg-light: #f8f9fa;
    }

    /* Page Header */
    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    /* Primary & Secondary Action Buttons */
    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    .btn-secondary-soft {
        background-color: #F1F5F9;
        color: #64748B;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        cursor: pointer;
    }

        .btn-secondary-soft:hover {
            background-color: #E2E8F0;
            color: #1a1a1a;
        }

    .btn-view-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-view-action:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    /* Search Bar Wrapper */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.92rem;
            color: #333333;
            padding: 4px 0;
        }

    /* Custom Form Selects */
    .custom-select-control {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 8px 14px;
        font-size: 0.92rem;
        color: #333333;
        background-color: #ffffff;
        transition: border-color 0.2s ease;
    }

        .custom-select-control:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
            outline: none;
        }

    /* Badges */
    .badge-status-active {
        background-color: #e6f4ea;
        color: #137333;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .badge-status-inactive {
        background-color: #fce8e6;
        color: #c5221f;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .count-pill {
        background-color: #e8f0fe;
        color: #1a73e8;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* Inactive row visual treatment */
    .group-row.inactive-row {
        opacity: 0.65;
        background-color: #fafafa;
    }

    /* Pagination Styles */
    .pagination-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid #e0e0e0;
        background: #ffffff;
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .pagination-btn:hover:not([disabled]) {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

        .pagination-btn.active {
            background: var(--primary-orange);
            border-color: var(--primary-orange);
            color: #ffffff;
        }

        .pagination-btn[disabled] {
            opacity: 0.4;
            cursor: not-allowed;
        }
</style>

<div class="container-fluid px-4 p-100">



    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">System Groups</h1>
            <p class="page-header-subtitle mb-0">Manage user permission groups, role descriptions, and track employee assignments.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="#" id="exportExcelBtn" class="btn-secondary-soft shadow-sm">
                <i class="fas fa-file-excel"></i>
                <span>Excel</span>
            </a>
            <a asp-controller="Group" asp-action="Create" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New Group</span>
            </a>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total System Groups</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #E24D17;">
                        <i class="fas fa-layer-group fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Active Groups</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@activeCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #198754;">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Inactive Groups</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@inactiveCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #dc3545;">
                        <i class="fas fa-ban fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Container -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <!-- Controls / Filters Header -->
        <div class="row g-3 align-items-end mb-4">
            <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                <label for="status-filter" class="form-label text-muted small fw-medium mb-1">Status</label>
                <select id="status-filter" class="form-select custom-select-control">
                    <option value="all" selected="@(currentStatus == "all")">All Statuses</option>
                    <option value="active" selected="@(currentStatus == "active")">Active</option>
                    <option value="inactive" selected="@(currentStatus == "inactive")">Inactive</option>
                </select>
            </div>

            <div class="col-12 col-md-9 col-xl-10">
                <label for="search-input" class="form-label text-muted small fw-medium mb-1">Search Groups</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="search-input" placeholder="Search by group name or description..." autocomplete="off">
                </div>
            </div>
        </div>

        <!-- Groups Table View -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="groupsTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th scope="col" style="width: 25%;">Group Name</th>
                        <th scope="col" style="width: 33%;">Description</th>
                        <th scope="col" style="width: 15%;">Created At</th>
                        <th scope="col" style="width: 12%;">Status</th>
                        <th scope="col" class="text-center" style="width: 10%;">Employees</th>
                        <th scope="col" class="text-end" style="width: 5%;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (groupList.Any())
                    {
                        foreach (var group in groupList)
                        {
                            var statusValue = group.IsActive ? "active" : "inactive";
                            var rowClass = !group.IsActive ? "group-row inactive-row" : "group-row";

                            <tr class="@rowClass" data-status="@statusValue">
                                <td>
                                    <span class="fw-bold text-dark fs-6">@group.Name</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(group.Description) ? "No description provided." : group.Description)</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@group.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td>
                                    <span class="@(group.IsActive ? "badge-status-active" : "badge-status-inactive")">
                                        @(group.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="count-pill">
                                        <i class="fas fa-user text-muted"></i>
                                        <span>@group.EmployeeCount</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Group" asp-action="Details" asp-route-id="@group.Id" class="btn-view-action" title="View Details">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="6" class="text-center text-muted py-4">
                            No matching groups found.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer / Pagination -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 mt-4 pt-3 border-top">
            <span class="text-muted small" id="showingText">Showing 0 records</span>
            <div class="d-flex align-items-center gap-1" id="paginationContainer"></div>
        </div>

    </div>
</div>

<!-- Dynamic Search & Pagination Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("search-input");
        const statusFilter = document.getElementById("status-filter");
        const exportExcelBtn = document.getElementById("exportExcelBtn");

        const allRows = Array.from(document.querySelectorAll("#tableBody tr.group-row"));
        const noResultsRow = document.getElementById("noResultsRow");
        const showingText = document.getElementById("showingText");
        const paginationContainer = document.getElementById("paginationContainer");

        const itemsPerPage = 7;
        let visibleRows = [...allRows];
        let currentPage = 1;

        function renderTable() {
            const totalVisible = visibleRows.length;
            const totalPages = Math.max(1, Math.ceil(totalVisible / itemsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx = startIdx + itemsPerPage;

            // Hide all rows initially
            allRows.forEach(row => row.style.display = "none");

            // Display current page slice
            visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

            // Handle empty search / filter state
            if (totalVisible === 0) {
                if (noResultsRow) noResultsRow.style.display = "";
                showingText.textContent = "Showing 0 records";
                paginationContainer.innerHTML = "";
                return;
            } else {
                if (noResultsRow) noResultsRow.style.display = "none";
            }

            // Update stats counter text
            const actualEnd = Math.min(endIdx, totalVisible);
            showingText.textContent = `Showing ${startIdx + 1}-${actualEnd} of ${totalVisible} records`;

            // Build pagination HTML
            let html = `<button type="button" class="pagination-btn" id="prevBtn" ${currentPage === 1 ? 'disabled' : ''}>&lsaquo;</button>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<button type="button" class="pagination-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
            }

            html += `<button type="button" class="pagination-btn" id="nextBtn" ${currentPage === totalPages ? 'disabled' : ''}>&rsaquo;</button>`;

            paginationContainer.innerHTML = html;
        }

        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value.toLowerCase();

            visibleRows = allRows.filter(row => {
                // 1. Text Search matching
                const text = row.innerText.toLowerCase();
                const matchesSearch = text.includes(query);

                // 2. Status Filter matching
                const rowStatus = (row.getAttribute("data-status") || "active").toLowerCase();
                const matchesStatus = (selectedStatus === "all" || rowStatus === selectedStatus);

                return matchesSearch && matchesStatus;
            });

            currentPage = 1; // Reset to page 1 on filter change
            renderTable();
        }

        // Attach event listeners
        searchInput.addEventListener("input", applyFilters);
        statusFilter.addEventListener("change", applyFilters);

        // Pagination button click delegation
        paginationContainer.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn || btn.disabled) return;

            if (btn.id === "prevBtn") {
                if (currentPage > 1) currentPage--;
            } else if (btn.id === "nextBtn") {
                const totalPages = Math.ceil(visibleRows.length / itemsPerPage);
                if (currentPage < totalPages) currentPage++;
            } else if (btn.dataset.page) {
                currentPage = parseInt(btn.dataset.page, 10);
            }

            renderTable();
        });

        // Excel export: read the Status filter's value only at the moment of
        // the click, not on every change, then build the export URL with it.
        if (exportExcelBtn) {
            exportExcelBtn.addEventListener("click", function (e) {
                e.preventDefault();

                const status = statusFilter.value;
                const url = new URL('@Url.Action("ExportGroupsExcel", "Group")', window.location.origin);

                if (status === "active") {
                    url.searchParams.set("isActive", "true");
                } else if (status === "inactive") {
                    url.searchParams.set("isActive", "false");
                }
                // "all" -> no isActive param, export everything

                window.location.href = url.toString();
            });
        }

        // Initialize display
        applyFilters();
    });
</script>
