@model Sim_Card_Managment.Models.Group

@{
    ViewData["Title"] = "Create New Group";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Group</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #E24D17;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .create-card {
            background-color: #ffffff;
            border-radius: 30px;
            max-width: 750px;
            width: 100%;
            padding: 3rem 4rem;
        }

        .title-header {
            font-weight: 700;
            font-size: 32px;
            color: #000;
            margin-bottom: 2.5rem;
        }

        .custom-label {
            font-weight: 500;
            color: #000;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .custom-input, .custom-textarea {
            background-color: #d8d8d8;
            border: none;
            border-radius: 12px;
            padding: 12px 18px;
            color: #333;
            width: 100%;
            font-size: 14px;
            transition: box-shadow 0.2s ease-in-out;
        }

            .custom-input:focus, .custom-textarea:focus {
                outline: none;
                box-shadow: 0 0 0 2px #E24D17;
            }

        .btn-cancel {
            border: 1px solid #E24D17;
            background-color: #ffffff;
            color: #000;
            border-radius: 30px;
            padding: 10px 45px;
            font-weight: 700;
            font-size: 15px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
        }

            .btn-cancel:hover {
                background-color: #fffaf8;
                color: #E24D17;
            }

        .btn-create {
            background-color: #E24D17;
            border: 1px solid #E24D17;
            color: #fff;
            border-radius: 30px;
            padding: 10px 45px;
            font-weight: 700;
            font-size: 15px;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                background-color: #c84111;
                border-color: #c84111;
                color: #fff;
            }

        .custom-input.is-invalid, .custom-textarea.is-invalid {
            box-shadow: 0 0 0 2px #D41212;
            background-color: #ffe6e6;
        }

        .error-msg {
            color: #D41212;
            font-size: 12px;
            margin-top: 5px;
            margin-left: 10px;
            display: block;
        }
    </style>
</head>

<body>

    <div class="create-card shadow">
        <h2 class="title-header">Create new group</h2>

        <form id="groupForm" asp-controller="Group" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-4 mb-5">
                <div class="col-12">
                    <label class="custom-label" asp-for="Name">Group Name</label>
                    <input type="text" asp-for="Name" id="groupName" class="custom-input" placeholder="e.g., Sales Department">
                    <span asp-validation-for="Name" class="error-msg"></span>
                </div>

                <div class="col-12">
                    <label class="custom-label" asp-for="Description">Description (Optional)</label>
                    <textarea asp-for="Description" id="groupDescription" class="custom-textarea" rows="4" placeholder="Enter group details or purpose..."></textarea>
                    <span asp-validation-for="Description" class="error-msg"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">
                <a class="btn btn-cancel" asp-controller="Group" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-create">Create</button>
            </div>

        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.getElementById('groupForm').addEventListener('submit', function (event) {
            let isValid = true;

            // Clear previous error styles
            document.querySelectorAll('.is-invalid').forEach(function(el) {
                el.classList.remove('is-invalid');
            });

            // Validate Name (Required)
            const name = document.getElementById('groupName');
            if (!name.value || name.value.trim() === '') {
                name.classList.add('is-invalid');
                isValid = false;
            }

            if (!isValid) {
                event.preventDefault();
            }
        });
    </script>
</body>

</html>