@model Sim_Card_Managment.Viewmodel.UserProfileViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-orange: #DF531B;
            --brand-orange-light: #FFF8F6;
            --brand-purple: #5B2D90;
            --bg-canvas: #F4F5F8;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --card-border: #E2E8F0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, sans-serif;
        }

        .page-header {
            background: #FFFFFF;
            border-bottom: 1px solid var(--card-border);
            padding: 2.5rem 0;
            margin-bottom: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .user-title {
            font-size: clamp(1.75rem, 4vw, 2.75rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--text-dark);
        }

        .user-badge-active {
            font-size: 0.875rem;
            background-color: rgba(34, 197, 94, 0.1);
            color: #15803D;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 50px;
            vertical-align: middle;
            border: 1px solid rgba(34, 197, 94, 0.2);
        }

        .user-badge-inactive {
            font-size: 0.875rem;
            background-color: rgba(220, 38, 38, 0.1);
            color: #DC2626;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 50px;
            vertical-align: middle;
            border: 1px solid rgba(220, 38, 38, 0.2);
        }

        .user-id-chip {
            display: inline-flex;
            align-items: center;
            background: #F1F5F9;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 0.03em;
        }

        .btn-custom {
            height: 48px;
            padding: 0 24px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            text-decoration: none;
        }

        .btn-primary-orange {
            background-color: var(--brand-orange);
            color: #FFFFFF;
            border: none;
        }

            .btn-primary-orange:hover {
                background-color: #c94614;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(223, 83, 27, 0.25);
            }

        .btn-danger-soft {
            background-color: #FEF2F2;
            color: #DC2626;
            border: 1px solid #FCA5A5;
        }

        .btn-activate {
            background-color: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #93C5FD;
        }

            .btn-activate:hover {
                background-color: #1D4ED8;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(29, 78, 216, 0.2);
            }

            .btn-danger-soft:hover {
                background-color: #DC2626;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(220, 38, 38, 0.2);
            }

        .main-info-card {
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            overflow: hidden;
        }

        .card-header-styled {
            border-bottom: 1px solid var(--card-border);
            padding: 1.5rem 2rem;
            background: linear-gradient(180deg, var(--brand-orange-light) 0%, #FFFFFF 100%);
        }

        .section-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background-color: rgba(223, 83, 27, 0.12);
            color: var(--brand-orange);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .info-grid-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 4px;
        }

        .info-grid-value {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .group-chip {
            display: inline-block;
            background-color: rgba(91, 45, 144, 0.1);
            color: var(--brand-purple);
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 0.95rem;
        }
    </style>
</head>
<body class="p-100">

    <header class="page-header">
        <div class="container-fluid px-lg-5">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">

                <div>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <h1 class="user-title m-0">@Model.FullName</h1>
                        @if (Model.IsActive)
                        {
                            <span class="user-badge-active">
                                <i class="fa-solid fa-circle-check me-1"></i> Active User
                            </span>
                        }
                        else
                        {
                            <span class="user-badge-inactive">
                                <i class="fa-solid fa-circle-xmark me-1"></i> Inactive User
                            </span>
                        }
                    </div>
                    <div class="mt-2">
                        <span class="user-id-chip">
                            <i class="fa-regular fa-envelope me-2"></i> @Model.Email
                        </span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Account" asp-action="ChangePassword" asp-route-id="@Model.Id"
                       class="btn btn-custom btn-primary-orange">
                        <i class="fa-solid fa-pen-to-square"></i> Change Password
                    </a>
                    <a asp-controller="Account" asp-action="EditUser" asp-route-id="@Model.Id"
                       class="btn btn-custom btn-primary-orange">
                        <i class="fa-solid fa-pen-to-square"></i> Edit User
                    </a>

                    @if (Model.IsActive)
                    {
                        <form asp-controller="Account" asp-action="SoftDelete" asp-route-id="@Model.Id"
                              method="post" id="deleteForm" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-custom btn-danger-soft" onclick="confirmDelete()">
                                <i class="fa-solid fa-trash-can"></i> Delete
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Account" asp-action="ActivateUser" asp-route-id="@Model.Id"
                              method="post" id="activateForm" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-custom btn-activate" onclick="confirmActivate()">
                                <i class="fa-solid fa-circle-check"></i> Activate
                            </button>
                        </form>
                    }
                </div>

            </div>
        </div>
    </header>

    <main class="container-fluid px-lg-5 pb-5">
        <div class="main-info-card">

            <div class="card-header-styled d-flex align-items-center gap-3">
                <div class="section-icon-wrapper">
                    <i class="fa-solid fa-user-gear"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">User Information</h3>
                    <p class="m-0 text-muted small">Account identity, role, and system access status</p>
                </div>
            </div>

            <div class="p-4 p-md-5">
                <div class="row g-4">
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="info-grid-label">Full Name</div>
                        <div class="info-grid-value">@Model.FullName</div>
                    </div>

                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="info-grid-label">Email Address</div>
                        <div class="info-grid-value">@Model.Email</div>
                    </div>

                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="info-grid-label">Group Name</div>
                        <div class="info-grid-value">
                            <span class="group-chip">@Model.GroupName</span>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="info-grid-label">Account Status</div>
                        <div class="info-grid-value">
                            @if (Model.IsActive)
                            {
                                <span class="text-success fw-bold">Active</span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">Inactive</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Delete User Profile?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#DC2626',
                cancelButtonColor: '#64748B',
                confirmButtonText: 'Yes, Delete',
                customClass: { popup: 'rounded-4' }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();  // ← actually submits
                }
            });
        }

                function confirmActivate() {
            Swal.fire({
                title: 'Activate User?',
                text: "This will reactivate the user account.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#1D4ED8',
                cancelButtonColor: '#64748B',
                confirmButtonText: 'Yes, Activate',
                customClass: { popup: 'rounded-4' }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('activateForm').submit();
                }
            });
        }

    </script>
</body>
</html>