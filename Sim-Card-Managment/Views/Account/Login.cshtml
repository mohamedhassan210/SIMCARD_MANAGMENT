@model Sim_Card_Managment.Viewmodel.LoginViewmodel


<style>
    /* =========================================
           Login Page Styles
           ========================================= */
    .login-section {
        background-color: #E24D17;
    }

    .login-card {
        border-radius: 24px;
        width: 100%;
        max-width: 500px;
        min-height: 500px;
    }

    .login-title {
        font-size: 32px;
    }

    .login-input {
        font-size: 0.9rem;
        box-shadow: none;
    }

    .login-btn {
        background-color: #E24D17;
        color: white;
        font-size: 1rem;
        border: 2px solid #E24D17;
        transition: all 0.2s ease-in-out;
    }

        .login-btn:hover {
            background-color: #c74213;
            border-color: #c74213;
            color: #ffffff;
        }

    .forgot-password-link {
        font-size: 0.85rem;
        color: #555555;
    }

    .reset-text {
        color: #E24D17;
        font-weight: bold;
    }

    .form-control {
        border: 2px solid transparent !important;
    }

        .form-control:focus {
            box-shadow: none !important;
            border: 2px solid #E24D17 !important;
        }
</style>

<section class="login-section position-relative vh-100 vw-100 overflow-hidden d-flex align-items-center justify-content-center">

    <div class="login-card bg-white d-flex flex-column align-items-center px-4 py-5 shadow-lg position-relative z-2">

        <h2 class="login-title text-center fw-bolder text-dark mb-4">Login</h2>

        <form asp-controller="Account" asp-action="Login" method="post" class="d-flex flex-column align-items-center w-100 px-2">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <div class="w-100 mb-3">
                <input asp-for="Username" type="text" placeholder="Username"
                       class="login-input form-control bg-light rounded-pill px-4 py-3 text-dark w-100">
                <span asp-validation-for="Username" class="text-danger small d-block mt-1 ms-3"></span>
            </div>

            <div class="w-100 mb-3">
                <input asp-for="Password" type="password" placeholder="Password"
                       class="login-input form-control bg-light rounded-pill px-4 py-3 text-dark w-100">
                <span asp-validation-for="Password" class="text-danger small d-block mt-1 ms-3"></span>
            </div>

            <div class="form-check mb-4 align-self-start ms-3">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="RememberMe" />
                <label asp-for="RememberMe" class="form-check-label text-dark small" for="RememberMe">Remember Me</label>
            </div>

            <a asp-action="ForgotPassword" class="forgot-password-link text-decoration-none mb-4 text-center">
                Forgot your password? <span class="reset-text">Reset it</span>
            </a>

            <button type="submit" class="btn login-btn rounded-pill px-5 py-2 w-100fw-bold">Login</button>
        </form>
    </div>

    <div class="bg-shape shape-solid z-1"></div>
    <div class="bg-shape shape-outline z-1"></div>
</section>

<script src="~/js/bootstrap.bundle.min.js"></script>