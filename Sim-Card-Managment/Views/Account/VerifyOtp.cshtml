@model Sim_Card_Managment.Viewmodel.VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify Access Code";
}

<style>
    /* =========================================
           Unified Brand Identity Styles
           ========================================= */
    .login-section {
        background-color: #E24D17;
    }

    .login-card {
        border-radius: 24px;
        width: 100%;
        max-width: 500px;
        min-height: 500px;
    }

    .login-title {
        font-size: 32px;
    }

    .login-input {
        font-size: 1.1rem;
        letter-spacing: 4px;
        font-weight: bold;
        box-shadow: none;
    }

    .login-btn {
        background-color: #E24D17;
        color: white;
        font-size: 1rem;
        border: 2px solid #E24D17;
        transition: all 0.2s ease-in-out;
    }

        .login-btn:hover {
            background-color: #c74213;
            border-color: #c74213;
            color: #ffffff;
        }

    .form-control {
        border: 2px solid transparent !important;
    }

        .form-control:focus {
            box-shadow: none !important;
            border: 2px solid #E24D17 !important;
        }
</style>

<section class="login-section position-relative vh-100 vw-100 overflow-hidden d-flex align-items-center justify-content-center">

    <div class="login-card bg-white d-flex flex-column align-items-center px-4 py-5 shadow-lg position-relative z-2">

        <h2 class="login-title text-center fw-bolder text-dark mb-3">Enter OTP Code</h2>

        <p class="text-muted text-center small mb-4 px-2" style="line-height: 1.4rem;">
            A one-time security entry code has been sent to <strong class="text-dark">@Model.Email</strong>. Paste the 6-digit numeric payload below to access the session context.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success small w-100 text-center rounded-pill py-2 border-0 mb-3 bg-light text-success fw-bold">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger small w-100 text-center rounded-pill py-2 border-0 mb-3 bg-light text-danger fw-bold">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="VerifyOtp" method="post" class="d-flex flex-column align-items-center w-100 px-2">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <div class="w-100 mb-4">
                <input asp-for="OtpCode" type="text" placeholder="******" maxlength="6" required autocomplete="off"
                       class="login-input form-control bg-light rounded-pill px-4 py-3 text-center text-dark w-100">
                <span asp-validation-for="OtpCode" class="text-danger small d-block mt-1 text-center"></span>
            </div>

            <button type="submit" class="btn login-btn rounded-pill px-5 py-2 w-100 fw-bold mb-3">Verify & Sign In</button>
        </form>

        <form asp-action="ResendOtp" method="post" class="w-100 text-center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@Model.Email" />
            <button type="submit" class="btn btn-link text-decoration-none text-muted small py-1" style="font-size: 0.85rem;">
                Didn't get a code? <span style="color: #E24D17; font-weight: bold;">Resend Request</span>
            </button>
        </form>
    </div>

    <div class="bg-shape shape-solid z-1"></div>
    <div class="bg-shape shape-outline z-1"></div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}