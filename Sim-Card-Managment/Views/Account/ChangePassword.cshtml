@model Sim_Card_Managment.Viewmodel.ChangePasswordViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --brand-orange: #DF531B;
            --brand-orange-light: #FFF8F6;
            --brand-purple: #5B2D90;
            --bg-canvas: #F4F5F8;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --card-border: #E2E8F0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-dark);
            font-family: system-ui, -apple-system, sans-serif;
            padding-bottom: 3rem;
        }

        .form-card {
            max-width: 580px;
            margin: 3rem auto 0 auto;
            background-color: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            overflow: hidden;
        }

        .card-header-styled {
            border-bottom: 1px solid var(--card-border);
            padding: 1.5rem 2rem;
            background: linear-gradient(180deg, var(--brand-orange-light) 0%, #FFFFFF 100%);
        }

        .section-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background-color: rgba(223, 83, 27, 0.12);
            color: var(--brand-orange);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .form-label-custom {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 6px;
            display: block;
        }

        .input-group-custom {
            display: flex;
            align-items: center;
            background: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 0 14px;
            transition: all 0.2s ease;
        }

            .input-group-custom:focus-within {
                border-color: var(--brand-orange);
                box-shadow: 0 0 0 3px rgba(223, 83, 27, 0.1);
            }

            .input-group-custom i {
                color: var(--text-muted);
                font-size: 1rem;
                margin-right: 10px;
            }

        .toggle-password {
            cursor: pointer;
            margin-right: 0 !important;
            margin-left: 10px;
            padding: 4px;
        }

            .toggle-password:hover {
                color: var(--brand-orange) !important;
            }

        .form-control-custom {
            border: none;
            outline: none;
            background: transparent;
            font-size: 0.95rem;
            width: 100%;
            height: 48px;
            color: var(--text-dark);
            font-weight: 500;
        }

        .password-hint {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 6px;
        }

        .btn-custom {
            height: 48px;
            padding: 0 28px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }

        .btn-primary-orange {
            background-color: var(--brand-orange);
            color: #FFFFFF;
        }

            .btn-primary-orange:hover {
                background-color: #c94614;
                color: #FFFFFF;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(223, 83, 27, 0.25);
            }

        .btn-secondary-soft {
            background-color: #F1F5F9;
            color: var(--text-muted);
            border: 1px solid var(--card-border);
        }

            .btn-secondary-soft:hover {
                background-color: #E2E8F0;
                color: var(--text-dark);
            }
    </style>
</head>
<body>

    <main class="container px-3 p-100">

        <div class="form-card">

            <div class="card-header-styled d-flex align-items-center gap-3">
                <div class="section-icon-wrapper">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div>
                    <h3 class="m-0 fs-5 fw-bold text-dark">Change Password</h3>
                    <p class="m-0 text-muted small">Update your account credentials to keep it secure</p>
                </div>
            </div>

            <form asp-action="ChangePassword" asp-controller="Account" method="post" id="changePasswordForm">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="px-4 pt-4">
                        <div class="alert alert-danger" role="alert">
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="p-4 p-md-5">
                    <div class="row g-4">
                     

                        <div class="col-12">
                            <label for="NewPassword" class="form-label-custom">New Password</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-shield-halved"></i>
                                <input asp-for="NewPassword" class="form-control-custom" placeholder="Enter new password" required>
                                <i class="fa-regular fa-eye toggle-password" onclick="toggleVisibility('NewPassword', this)"></i>
                            </div>
                            <div class="password-hint">Must be at least 8 characters long.</div>
                        </div>

                        <div class="col-12">
                            <label for="ConfirmPassword" class="form-label-custom">Confirm New Password</label>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-check-double"></i>
                                <input asp-for="ConfirmPassword" class="form-control-custom" placeholder="Re-enter new password" required>
                                <i class="fa-regular fa-eye toggle-password" onclick="toggleVisibility('ConfirmPassword', this)"></i>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a href="javascript:history.back()" class="btn-custom btn-secondary-soft">Cancel</a>
                        <button type="submit" class="btn-custom btn-primary-orange">
                            <i class="fa-solid fa-floppy-disk"></i> Update Password
                        </button>
                    </div>

                </div>
            </form>

        </div>

    </main>

    <script>
        // Toggle password visibility (show/hide text)
        function toggleVisibility(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>