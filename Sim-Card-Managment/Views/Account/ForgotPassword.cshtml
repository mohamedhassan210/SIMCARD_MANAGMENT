@model Sim_Card_Managment.Viewmodel.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    /* =========================================
       Unified Brand Identity Styles
       ========================================= */
    .login-section {
        background-color: #E24D17;
    }

    .login-card {
        border-radius: 24px;
        width: 100%;
        max-width: 500px;
        min-height: 500px;
    }

    .login-title {
        font-size: 32px;
    }

    .login-input {
        font-size: 0.9rem;
        box-shadow: none;
    }

    .login-btn {
        background-color: #E24D17;
        color: white;
        font-size: 1rem;
        border: 2px solid #E24D17;
        transition: all 0.2s ease-in-out;
    }

    .login-btn:hover {
        background-color: #c74213;
        border-color: #c74213;
        color: #ffffff;
    }

    .form-control {
        border: 2px solid transparent !important;
    }

    .form-control:focus {
        box-shadow: none !important;
        border: 2px solid #E24D17 !important;
    }
</style>

<section class="login-section position-relative vh-100 vw-100 overflow-hidden d-flex align-items-center justify-content-center">

    <div class="login-card bg-white d-flex flex-column align-items-center px-4 py-5 shadow-lg position-relative z-2">

        <h2 class="login-title text-center fw-bolder text-dark mb-3">Reset Access</h2>

        <p class="text-muted text-center small mb-4 px-2" style="line-height: 1.4rem;">
            Enter your registered corporate email profile. If an account matches our active database, we will immediately route an access verification code to your inbox.
        </p>

        <form asp-action="ForgotPassword" method="post" class="d-flex flex-column align-items-center w-100 px-2">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <div class="w-100 mb-4">
                <input asp-for="Email" type="email" placeholder="name@company.com" autocomplete="email" required
                       class="login-input form-control bg-light rounded-pill px-4 py-3 text-dark w-100">
                <span asp-validation-for="Email" class="text-danger small d-block mt-1 ms-3"></span>
            </div>

            <button type="submit" class="btn login-btn rounded-pill px-5 py-2 w-100 fw-bold mb-3">Send Recovery Email</button>

            <a asp-action="Login" class="text-secondary small text-decoration-none py-1">
                Back to Sign In
            </a>
        </form>
    </div>

    <div class="bg-shape shape-solid z-1"></div>
    <div class="bg-shape shape-outline z-1"></div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}