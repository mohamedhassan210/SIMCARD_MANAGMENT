@model Sim_Card_Managment.Viewmodel.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";

    Layout = null;
}
<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>



<section class="fp-page-section position-relative vh-100 vw-100 overflow-hidden d-flex align-items-center justify-content-center">

    <!-- 🔑 FORGOT PASSWORD CARD -->
    <div class="fp-card bg-white d-flex flex-column align-items-center px-4 py-5 shadow-lg position-relative z-2">

        <h2 class="fp-title text-center fw-bolder text-dark mb-3">Reset Access</h2>

        <p class="text-muted text-center small mb-4 px-2" style="line-height: 1.4rem;">
            Enter your registered corporate email profile. If an account matches our active database, we will immediately route an access verification code to your inbox.
        </p>

        <form asp-action="ForgotPassword" method="post" class="d-flex flex-column align-items-center w-100 px-2">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <div class="w-100 mb-4">
                <input asp-for="Email" type="email" placeholder="name@company.com" autocomplete="email" required
                       class="fp-input form-control bg-light rounded-pill px-4 py-3 text-dark w-100">
                <span asp-validation-for="Email" class="text-danger small d-block mt-1 ms-3"></span>
            </div>

            <button type="submit" class="btn fp-btn-submit rounded-pill px-5 py-2 w-100 fw-bold mb-3">Send Recovery Email</button>

            <a asp-action="Login" class="text-secondary small text-decoration-none py-1">
                Back to Sign In
            </a>
        </form>
    </div>


</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>