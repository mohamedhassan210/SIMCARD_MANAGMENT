@model Sim_Card_Managment.Viewmodel.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter Email</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        /* Orange background matching the image */
        body {
            background-color: #DF4C18; /* Matched to the exact orange in the image */
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        /* Main Card Container */
        .auth-card {
            background-color: #ffffff;
            border-radius: 20px;
            max-width: 480px;
            width: 90%; /* Responsive width */
            padding: 4rem 3rem;
            text-align: center;
        }

        /* Title Styling */
        .title-header {
            font-weight: 800;
            font-size: 36px;
            color: #000;
            margin-bottom: 2.5rem;
        }

        /* Input Styling */
        .custom-input {
            background-color: #D9D9D9; /* Light gray background */
            border: none;
            border-radius: 12px;
            padding: 14px 20px;
            color: #333;
            width: 100%;
            font-size: 14px;
            margin-bottom: 1.5rem;
            transition: box-shadow 0.2s ease-in-out;
        }

            .custom-input:focus {
                outline: none;
                box-shadow: 0 0 0 2px #DF4C18; /* Orange focus ring */
            }

            .custom-input::placeholder {
                color: #777;
            }

        /* Button Styling */
        .btn-submit {
            background-color: #DF4C18;
            border: none;
            color: #fff;
            border-radius: 12px;
            padding: 12px;
            font-weight: 700;
            font-size: 18px;
            width: 100%;
            transition: opacity 0.3s ease;
        }

            .btn-submit:hover {
                opacity: 0.9;
                color: #fff;
            }

        /* Optional Back Link Styling */
        .back-link {
            display: inline-block;
            margin-top: 1.5rem;
            color: #000;
            text-decoration: none;
            font-size: 14px;
        }

            .back-link span {
                color: #DF4C18;
                font-weight: bold;
            }

        /* Mobile responsiveness adjustments */

    </style>
</head>

<body>

    <div class="auth-card shadow-lg">
        <h2 class="title-header">Enter your email</h2>

        <form asp-action="ForgotPassword" method="post">

            <input asp-for="Email" type="email" class="custom-input" placeholder="Email address" required>
            @Html.AntiForgeryToken() <span asp-validation-for="Email" class="text-danger mb-3 d-block text-start"></span>

            <button type="submit" class="btn-submit">send otp</button>
        </form>

        <a asp-action="Login" class="back-link">Remembered your password? <span>login</span></a>
    </div>

</body>

</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}