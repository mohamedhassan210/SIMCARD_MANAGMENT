@model Sim_Card_Managment.Viewmodel.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>


<section class="rpw-page-section position-relative vh-100 vw-100 overflow-hidden d-flex align-items-center justify-content-center">

    <div class="rpw-card bg-white d-flex flex-column align-items-center px-4 py-5 shadow-lg position-relative z-2">

        <h2 class="rpw-title text-center fw-bolder text-dark mb-3">New Password</h2>

        <p class="text-muted text-center small mb-4 px-2" style="line-height: 1.4rem;">
            Your account authentication code has been verified. Establish a secure new login credential password below.
        </p>

        <form asp-action="ResetPassword" method="post" class="d-flex flex-column align-items-center w-100 px-2">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <div class="w-100 mb-3">
                <label class="small fw-bold text-muted ms-3 mb-1">Account Username</label>
                <input asp-for="Username" type="text" readonly
                       class="rpw-input form-control rpw-input-readonly rounded-pill px-4 py-3 text-dark w-100">
            </div>

            <div class="w-100 mb-3">
                <input asp-for="NewPassword" type="password" placeholder="New Password" required
                       class="rpw-input form-control bg-light rounded-pill px-4 py-3 text-dark w-100">
                <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1 ms-3"></span>
            </div>

            <div class="w-100 mb-4">
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" required
                       class="rpw-input form-control bg-light rounded-pill px-4 py-3 text-dark w-100">
                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1 ms-3"></span>
            </div>

            <button type="submit" class="btn rpw-btn-submit rounded-pill px-5 py-2 w-100 fw-bold mb-2">Update Password</button>
        </form>
    </div>

    <div class="bg-shape shape-solid z-1"></div>
    <div class="bg-shape shape-outline z-1"></div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>