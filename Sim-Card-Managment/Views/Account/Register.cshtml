@model Sim_Card_Managment.Viewmodel.RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New User</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />

</head>

<section class="rp-page-section">

    <div class="rp-card shadow">

        <h2 class="rp-title">Create new account</h2>

        <form id="registerForm" asp-controller="Account" asp-action="Register" method="post">

            <div asp-validation-summary="ModelOnly" class="rp-text-danger mb-3"></div>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label class="rp-label" asp-for="Username">Username</label>
                    <input type="text" asp-for="Username" class="rp-input" placeholder="e.g. adham_amr">
                    <span asp-validation-for="Username" class="rp-text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="rp-label" asp-for="Email">Email Address</label>
                    <input type="email" asp-for="Email" class="rp-input" placeholder="example@company.com">
                    <span asp-validation-for="Email" class="rp-text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="rp-label" asp-for="PasswordHash">Temporary Password</label>
                    <input type="password" asp-for="PasswordHash" class="rp-input" placeholder="••••••••">
                    <span asp-validation-for="PasswordHash" class="rp-text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="rp-label" asp-for="GroupId">User Group</label>
                    <select asp-for="GroupId" asp-items="ViewBag.Groups" class="rp-select">
                        <option value="">-- Select Group --</option>
                    </select>
                    <span asp-validation-for="GroupId" class="rp-text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">
                <a class="rp-btn-cancel" asp-controller="Account" asp-action="ManageUsers">Cancel</a>
                <button type="submit" class="rp-btn-create">Create Account</button>
            </div>

        </form>
    </div>
</section>