@model IEnumerable<Sim_Card_Managment.Viewmodel.UserListItemViewModel>

@{
    ViewData["Title"] = "Users Directory";
    var userList = Model?.ToList() ?? new List<Sim_Card_Managment.Viewmodel.UserListItemViewModel>();
    int totalCount = userList.Count;
    int activeCount = userList.Count(x => x.IsActive);
    int inactiveCount = totalCount - activeCount;
}

<style>
    /* Theme & Layout Variables */
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
        --bg-light: #f8f9fa;
    }

    /* Page Header */
    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    /* Primary Action Button */
    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    .btn-view-action {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        color: #333333;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-view-action:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    /* Seamless Search Bar Wrapper */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.92rem;
            color: #333333;
            padding: 4px 0;
        }

    /* Custom Form Selects */
    .custom-select-control {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 8px 14px;
        font-size: 0.92rem;
        color: #333333;
        background-color: #ffffff;
        transition: border-color 0.2s ease;
    }

        .custom-select-control:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 3px rgba(226, 77, 23, 0.1);
            outline: none;
        }

    /* Badges */
    .badge-group-pill {
        background-color: #f1f3f5;
        color: #495057;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .badge-status-active {
        background-color: #e6f4ea;
        color: #137333;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .badge-status-inactive {
        background-color: #fce8e6;
        color: #c5221f;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    /* Inactive row visual treatment */
    .user-row.inactive-row {
        opacity: 0.65;
        background-color: #fafafa;
    }

    /* Pagination Styles */
    .pagination-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid #e0e0e0;
        background: #ffffff;
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .pagination-btn:hover:not([disabled]) {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

        .pagination-btn.active {
            background: var(--primary-orange);
            border-color: var(--primary-orange);
            color: #ffffff;
        }

        .pagination-btn[disabled] {
            opacity: 0.4;
            cursor: not-allowed;
        }
</style>

<div class="container-fluid px-4 p-100">

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">Users Directory</h1>
            <p class="page-header-subtitle mb-0">Manage registered user accounts, assigned permission groups, and active statuses.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Account" asp-action="Register" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New User</span>
            </a>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total Users</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #E24D17;">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Active Users</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@activeCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #198754;">
                        <i class="fas fa-user-check fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Inactive Users</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@inactiveCount</h3>
                    </div>
                    <div class="rounded-circle p-3 text-white" style="background-color: #c5221f;">
                        <i class="fas fa-user-slash fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Container -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <!-- Controls / Filters Header -->
        <div class="row g-3 align-items-end mb-4">
            <div class="col-12 col-sm-4 col-md-3 col-xl-2">
                <label for="status-filter" class="form-label text-muted small fw-medium mb-1">Status</label>
                <select id="status-filter" class="form-select custom-select-control">
                    <option value="all" selected>All Statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="col-12 col-sm-8 col-md-9 col-xl-10">
                <label for="search-input" class="form-label text-muted small fw-medium mb-1">Search Users</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="search-input" placeholder="Search by name, email, or group name..." autocomplete="off">
                </div>
            </div>
        </div>

        <!-- Users Table View -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="usersTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th scope="col" style="width: 28%;">Name</th>
                        <th scope="col" style="width: 30%;">Email</th>
                        <th scope="col" style="width: 18%;">Group</th>
                        <th scope="col" style="width: 14%;">Status</th>
                        <th scope="col" class="text-end" style="width: 10%;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (userList.Any())
                    {
                        foreach (var item in userList)
                        {
                            var statusValue = item.IsActive ? "active" : "inactive";
                            var rowClass = item.IsActive ? "user-row" : "user-row inactive-row";

                            <tr class="@rowClass" data-status="@statusValue">
                                <td>
                                    <span class="fw-bold text-dark fs-6">@item.Username</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.Email</span>
                                </td>
                                <td>
                                    <span class="badge-group-pill">@item.GroupName</span>
                                </td>
                                <td>
                                    <span class="@(item.IsActive ? "badge-status-active" : "badge-status-inactive")">
                                        @(item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Account" asp-action="Details" asp-route-id="@item.Id" class="btn-view-action" title="View Details">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="5" class="text-center text-muted py-4">
                            No matching users found.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer / Pagination -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 mt-4 pt-3 border-top">
            <span class="text-muted small" id="showingText">Showing 0 records</span>
            <div class="d-flex align-items-center gap-1" id="paginationContainer"></div>
        </div>

    </div>
</div>

<!-- Dynamic Search & Pagination Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("search-input");
        const statusFilter = document.getElementById("status-filter");

        const allRows = Array.from(document.querySelectorAll("#tableBody tr.user-row"));
        const noResultsRow = document.getElementById("noResultsRow");
        const showingText = document.getElementById("showingText");
        const paginationContainer = document.getElementById("paginationContainer");

        const itemsPerPage = 7;
        let visibleRows = [...allRows];
        let currentPage = 1;

        function renderTable() {
            const totalVisible = visibleRows.length;
            const totalPages = Math.max(1, Math.ceil(totalVisible / itemsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx = startIdx + itemsPerPage;

            allRows.forEach(row => row.style.display = "none");
            visibleRows.slice(startIdx, endIdx).forEach(row => row.style.display = "");

            if (totalVisible === 0) {
                if (noResultsRow) noResultsRow.style.display = "";
                showingText.textContent = "Showing 0 records";
                paginationContainer.innerHTML = "";
                return;
            } else {
                if (noResultsRow) noResultsRow.style.display = "none";
            }

            const actualEnd = Math.min(endIdx, totalVisible);
            showingText.textContent = `Showing ${startIdx + 1}-${actualEnd} of ${totalVisible} records`;

            let html = `<button type="button" class="pagination-btn" id="prevBtn" ${currentPage === 1 ? 'disabled' : ''}>&lsaquo;</button>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<button type="button" class="pagination-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
            }

            html += `<button type="button" class="pagination-btn" id="nextBtn" ${currentPage === totalPages ? 'disabled' : ''}>&rsaquo;</button>`;

            paginationContainer.innerHTML = html;
        }

        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value.toLowerCase();

            visibleRows = allRows.filter(row => {
                const text = row.innerText.toLowerCase();
                const matchesSearch = text.includes(query);
                const rowStatus = (row.getAttribute("data-status") || "active").toLowerCase();
                const matchesStatus = (selectedStatus === "all" || rowStatus === selectedStatus);
                return matchesSearch && matchesStatus;
            });

            currentPage = 1;
            renderTable();
        }

        searchInput.addEventListener("input", applyFilters);
        statusFilter.addEventListener("change", applyFilters);

        paginationContainer.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn || btn.disabled) return;

            if (btn.id === "prevBtn") {
                if (currentPage > 1) currentPage--;
            } else if (btn.id === "nextBtn") {
                const totalPages = Math.ceil(visibleRows.length / itemsPerPage);
                if (currentPage < totalPages) currentPage++;
            } else if (btn.dataset.page) {
                currentPage = parseInt(btn.dataset.page, 10);
            }

            renderTable();
        });

        applyFilters();
    });
</script>
