@{
    ViewData["Title"] = "Success";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Created</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: system-ui, -apple-system, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .success-card {
            background: #fff;
            padding: 3rem;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            text-align: center;
            max-width: 500px;
            width: 100%;
        }

        .success-icon {
            font-size: 4rem;
            color: #28a745;
            margin-bottom: 1rem;
        }

        .btn-home {
            background-color: #E24D17;
            color: white;
            border-radius: 25px;
            padding: 10px 30px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            margin-top: 1.5rem;
            transition: background 0.2s;
        }

            .btn-home:hover {
                background-color: #c84111;
                color: white;
            }
    </style>
</head>
<body>

    <div class="success-card">
        <div class="success-icon">✓</div>
        <h2>Welcome!</h2>
        <p class="text-muted mt-2">The new user account has been created and saved to the database successfully.</p>

        <a asp-controller="Home" asp-action="Index" class="btn-home">Go to Dashboard</a>
    </div>

</body>
</html>