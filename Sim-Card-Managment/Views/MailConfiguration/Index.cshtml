@model IEnumerable<Sim_Card_Managment.Models.MailConfiguration>

@{
    ViewData["Title"] = "Mail Configurations";
    var configs = Model?.ToList() ?? new List<Sim_Card_Managment.Models.MailConfiguration>();
}

<style>
    :root {
        --primary-orange: #E24D17;
        --primary-orange-hover: #c84111;
    }

    .page-header-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .page-header-subtitle {
        font-size: 14px;
        color: #6c757d;
    }

    .btn-orange-primary {
        background-color: var(--primary-orange);
        border: 1px solid var(--primary-orange);
        color: #ffffff;
        border-radius: 12px;
        padding: 8px 16px;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-orange-primary:hover {
            background-color: var(--primary-orange-hover);
            border-color: var(--primary-orange-hover);
            color: #ffffff;
        }

    .btn-action-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        background: #ffffff;
        color: #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .btn-action-icon:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background-color: #fffaf8;
        }

    .badge-active-config {
        background: linear-gradient(135deg, #34d399 0%, #059669 100%);
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-inactive-config {
        background-color: #f1f3f4;
        color: #5f6368;
        font-size: 11px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
</style>

<div class="container-fluid px-4 p-100">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="page-header-title mb-1">Mail Configurations</h1>
            <p class="page-header-subtitle mb-0">SMTP settings used to send system emails. Only one can be active at a time.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="MailConfiguration" asp-action="Create" class="btn-orange-primary shadow-sm">
                <i class="fas fa-plus"></i>
                <span>New Configuration</span>
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small fw-bold">
                        <th>Name</th>
                        <th>SMTP Host</th>
                        <th>Port</th>
                        <th>Sender Email</th>
                        <th>Display Name</th>
                        <th>SSL</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (configs.Any())
                    {
                        foreach (var item in configs)
                        {
                            <tr>
                                <td><span class="fw-bold text-dark">@item.Name</span></td>
                                <td><span class="text-muted small">@item.SmtpHost</span></td>
                                <td><span class="text-muted small">@item.SmtpPort</span></td>
                                <td><code class="text-dark">@item.SenderEmail</code></td>
                                <td><span class="text-muted small">@item.SenderDisplayName</span></td>
                                <td>
                                    @if (item.EnableSsl)
                                    {
                                        <i class="fas fa-lock text-success" title="SSL enabled"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-lock-open text-muted" title="SSL disabled"></i>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-active-config"><i class="fas fa-check-circle"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive-config">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        @if (!item.IsActive)
                                        {
                                            <form asp-controller="MailConfiguration" asp-action="SetActive" asp-route-id="@item.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Make this the active mail configuration?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action-icon" title="Set as active">
                                                    <i class="fas fa-toggle-on"></i>
                                                </button>
                                            </form>
                                        }
                                        <a asp-controller="MailConfiguration" asp-action="Edit" asp-route-id="@item.Id" class="btn-action-icon" title="Edit">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form asp-controller="MailConfiguration" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this mail configuration? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-action-icon" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No mail configurations yet. Create one to start sending system emails from the database instead of appsettings.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
