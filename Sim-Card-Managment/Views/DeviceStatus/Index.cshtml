@model IEnumerable<Sim_Card_Managment.Viewmodel.DeviceStatusViewModel>

<style>
    /* Custom Page Layout */
    .breadcrumb-custom {
        --bs-breadcrumb-divider: '>';
        font-size: 0.8rem;
        font-weight: 500;
    }

    .page-title {
        font-size: 32px;
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        font-size: 15px;
        line-height: 1.5;
        max-width: 520px;
    }

    .table-header-row {
        letter-spacing: 0.5px;
    }

    .avatar-initials {
        width: 28px;
        height: 28px;
        font-size: 12px;
    }

    .status-dot-icon {
        font-size: 8px;
    }

    .transition-arrow {
        font-size: 10px;
    }

    /* Seamless Unified Search Bar */
    .search-bar-wrapper {
        display: flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 6px 16px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .search-bar-wrapper:focus-within {
            border-color: #a0a0a0;
            box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.03);
        }

        .search-bar-wrapper .search-icon {
            color: #8c8c8c;
            font-size: 15px;
            margin-right: 10px;
        }

        .search-bar-wrapper input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.95rem;
            color: #333333;
            padding: 4px 0;
        }

            .search-bar-wrapper input::placeholder {
                color: #a0a0a0;
            }

    /* Custom Dropdown Filters */
    .custom-select-filter {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 8px 36px 8px 14px;
        background-color: #ffffff;
        font-size: 0.9rem;
        color: #495057;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-select-filter:focus {
            border-color: #a0a0a0;
            box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.03);
            outline: none;
        }
</style>

@{
    var statusList = Model?.ToList() ?? new List<Sim_Card_Managment.Viewmodel.DeviceStatusViewModel>();
    int totalCount = statusList.Count;
    int activeCount = statusList.Count(s => s.IsActive);
    int simCount = statusList.Count(s => s.DeviceType == "SIM Card");
    int usbCount = statusList.Count(s => s.DeviceType == "USB Modem");
}

<header>
    <div class="p-100 w-100 mx-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom mb-4">
                <li class="breadcrumb-item">
                    <a href="#" class="text-decoration-none text-muted">Management</a>
                </li>
                <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">
                    Device Status History
                </li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1 class="fw-bold text-dark page-title mb-3">
                    Device Status Overview
                </h1>

                <p class="mb-0 text-muted page-subtitle">
                    Monitor device lifecycle transitions, active assignments, and status change records across all registered hardware.
                </p>
            </div>

            <a asp-controller="DeviceStatus" asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold align-self-start">
                <i class="fas fa-plus me-1"></i> Log New Status
            </a>
        </div>
    </div>
</header>

<section class="container-fluid px-4 mt-4">

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Total Log Records</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1" id="totalRecordsCount">@totalCount</h3>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="fas fa-list-alt fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">Active Items</span>
                        <h3 class="fw-bold text-success mb-0 mt-1" id="activeRecordsCount">@activeCount</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">SIM Cards</span>
                        <h3 class="fw-bold text-danger mb-0 mt-1" id="simCount">@simCount</h3>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                        <i class="fas fa-sim-card fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium">USB Modems</span>
                        <h3 class="fw-bold text-secondary mb-0 mt-1" id="usbCount">@usbCount</h3>
                    </div>
                    <div class="rounded-circle bg-secondary bg-opacity-10 p-3 text-secondary">
                        <i class="fas fa-usb fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-4">

        <div class="row g-3 justify-content-between align-items-center mb-4">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label text-muted small mb-1">Search</label>
                <div class="search-bar-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="tableSearchInput" placeholder="Search by Serial, Status, Assignee, or Reporter...">
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-5 d-flex gap-2 justify-content-md-end align-items-end mt-3 mt-md-0">
                <div>
                    <label class="form-label text-muted small mb-1">Device Type</label>
                    <select id="typeFilter" class="form-select custom-select-filter">
                        <option value="">All Types</option>
                        <option value="SIM Card">SIM Card</option>
                        <option value="USB Modem">USB Modem</option>
                    </select>
                </div>

                <div>
                    <label class="form-label text-muted small mb-1">Status</label>
                    <select id="availabilityFilter" class="form-select custom-select-filter">
                        <option value="">All Availability</option>
                        <option value="Active">Active</option>
                        <option value="Not Active">Not Active</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="deviceStatusTable">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small table-header-row">
                        <th scope="col">Serial Number</th>
                        <th scope="col">Device Type</th>
                        <th scope="col">Status Transition</th>
                        <th scope="col">Availability</th>
                        <th scope="col">Assigned To</th>
                        <th scope="col">Reported By</th>
                        <th scope="col">Status Date</th>
                        <th scope="col" class="text-end">Notes</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (statusList.Any())
                    {
                        foreach (var item in statusList)
                        {
                            bool isSim = item.DeviceType == "SIM Card";
                            string typeBadgeClass = isSim ? "bg-danger-subtle text-danger border-danger-subtle" : "bg-secondary-subtle text-secondary border-secondary-subtle";
                            string typeIcon = isSim ? "fa-sim-card" : "fa-usb";
                            string availBadgeClass = item.IsActive ? "bg-success" : "bg-secondary";
                            string assignedInitial = (!string.IsNullOrEmpty(item.AssignedTo) && item.AssignedTo != "Unassigned")
                                ? item.AssignedTo.Substring(0, 1).ToUpper()
                                : "";

                            <tr>
                                <td class="fw-bold text-dark">
                                    <code>@item.SerialNumber</code>
                                </td>
                                <td>
                                    <span class="badge @typeBadgeClass border px-2 py-1 rounded-pill device-type-cell">
                                        <i class="fas @typeIcon me-1"></i> @item.DeviceType
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2 small">
                                        <span class="badge bg-light text-dark border">@item.OldStatus</span>
                                        <i class="fas fa-arrow-right text-muted transition-arrow"></i>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@item.NewStatus</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @availBadgeClass text-white px-2 py-1 rounded-pill availability-cell" data-active="@item.IsActive.ToString().ToLower()">
                                        <i class="fas fa-circle me-1 status-dot-icon"></i> @item.Availability
                                    </span>
                                </td>
                                <td>
                                    @if (assignedInitial != "")
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex justify-content-center align-items-center avatar-initials fw-bold">
                                                @assignedInitial
                                            </div>
                                            <span class="fw-medium text-dark">@item.AssignedTo</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Unassigned</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    <i class="fas fa-user-edit me-1"></i> @item.ReportedByUserName
                                </td>
                                <td class="text-muted small">
                                    @item.StatusDate.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="tooltip" title="@item.Notes">
                                            <i class="fas fa-sticky-note"></i>
                                        </button>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="DeviceStatus" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary border-0">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No status records yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Initialize Tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Filter Controls
        const searchInput = document.getElementById('tableSearchInput');
        const typeFilter = document.getElementById('typeFilter');
        const availFilter = document.getElementById('availabilityFilter');
        const rows = document.querySelectorAll('#deviceStatusTable tbody tr');

        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const selectedType = typeFilter.value.toLowerCase();
            const selectedAvail = availFilter.value; // "Active" or "Not Active"

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();

                const typeCell = row.querySelector('.device-type-cell');
                const availCell = row.querySelector('.availability-cell');

                const rowType = typeCell ? typeCell.textContent.toLowerCase() : '';
                const isRowActive = availCell ? availCell.getAttribute('data-active') === 'true' : false;

                const matchesSearch = !searchTerm || text.includes(searchTerm);
                const matchesType = !selectedType || rowType.includes(selectedType);

                let matchesAvail = true;
                if (selectedAvail === 'Active') {
                    matchesAvail = isRowActive === true;
                } else if (selectedAvail === 'Not Active') {
                    matchesAvail = isRowActive === false;
                }

                if (matchesSearch && matchesType && matchesAvail) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        searchInput.addEventListener('input', filterTable);
        typeFilter.addEventListener('change', filterTable);
        availFilter.addEventListener('change', filterTable);
    });
</script>
