                        </td>
                        <td class="text-muted small">
                            <i class="fas fa-user-edit me-1"></i> Admin.User
                        </td>
                        <td class="text-muted small">
                            Aug 11, 2026 14:30
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="tooltip" title="Reassigned after card replacement">
                                <i class="fas fa-sticky-note"></i>
                            </button>
