                </tbody>
            </table>
        </div>

    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Initialize Tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Filter Controls
        const searchInput = document.getElementById('tableSearchInput');
        const typeFilter = document.getElementById('typeFilter');
        const availFilter = document.getElementById('availabilityFilter');
        const rows = document.querySelectorAll('#deviceStatusTable tbody tr');

        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const selectedType = typeFilter.value.toLowerCase();
            const selectedAvail = availFilter.value; // "Active" or "Not Active"

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();

                const typeCell = row.querySelector('.device-type-cell');
                const availCell = row.querySelector('.availability-cell');

                const rowType = typeCell ? typeCell.textContent.toLowerCase() : '';
                const isRowActive = availCell ? availCell.getAttribute('data-active') === 'true' : false;

                // Search term matching
                const matchesSearch = !searchTerm || text.includes(searchTerm);

                // Device Type matching
                const matchesType = !selectedType || rowType.includes(selectedType);

                // Strict Active / Not Active matching using data attribute
                let matchesAvail = true;
                if (selectedAvail === 'Active') {
                    matchesAvail = isRowActive === true;
                } else if (selectedAvail === 'Not Active') {
                    matchesAvail = isRowActive === false;
                }

                // Apply visibility
                if (matchesSearch && matchesType && matchesAvail) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Event listeners
        searchInput.addEventListener('input', filterTable);
        typeFilter.addEventListener('change', filterTable);
        availFilter.addEventListener('change', filterTable);
    });
</script>