<style>
    /* Custom Page Layout */
    .breadcrumb-custom {
        --bs-breadcrumb-divider: '>';
        font-size: 0.8rem;
        font-weight: 500;
    }

    .page-title {
        font-size: 32px;
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        font-size: 15px;
        line-height: 1.5;
