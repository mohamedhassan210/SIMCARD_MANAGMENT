@model Sim_Card_Managment.Viewmodel.DeviceStatusCreateViewModel

@{
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Device Status</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            body {
                background-color: #E24D17;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
                padding: 2rem 1rem;
            }

            .create-card {
                background-color: #ffffff;
                border-radius: 30px;
                max-width: 750px;
                width: 100%;
                padding: 3rem 4rem;
            }

            .title-header {
                font-weight: 700;
                font-size: 32px;
                color: #000;
                margin-bottom: 0.25rem;
            }

            .subtitle-text {
                font-size: 14px;
                color: #6c757d;
                margin-bottom: 2.5rem;
            }

            .custom-label {
                font-weight: 500;
                color: #000;
                margin-bottom: 8px;
                font-size: 14px;
            }

            .required-asterisk {
                color: #D41212;
            }

            .custom-input {
                background-color: #d8d8d8;
                border: none;
                border-radius: 12px;
                padding: 12px 18px;
                color: #333;
                width: 100%;
                font-size: 14px;
                transition: box-shadow 0.2s ease-in-out, background-color 0.2s ease-in-out;
            }

                .custom-input:focus {
                    outline: none;
                    box-shadow: 0 0 0 2px #E24D17;
                    background-color: #e2e2e2;
                }

                .custom-input.is-invalid,
                .custom-input.input-validation-error {
                    box-shadow: 0 0 0 2px #D41212;
                    background-color: #ffe6e6;
                }

            .error-msg {
                color: #D41212;
                font-size: 12px;
                margin-top: 5px;
                margin-left: 10px;
                display: block;
            }

            .btn-cancel {
                border: 1px solid #E24D17;
                background-color: #ffffff;
                color: #000;
                border-radius: 30px;
                padding: 10px 45px;
                font-weight: 700;
                font-size: 15px;
                text-decoration: none;
                display: inline-block;
                transition: all 0.3s ease;
            }

                .btn-cancel:hover {
                    background-color: #fffaf8;
                    color: #E24D17;
                }

            .btn-create {
                background-color: #E24D17;
                border: 1px solid #E24D17;
                color: #fff;
                border-radius: 30px;
                padding: 10px 45px;
                font-weight: 700;
                font-size: 15px;
                transition: all 0.3s ease;
            }

                .btn-create:hover {
                    background-color: #c84111;
                    border-color: #c84111;
                    color: #fff;
                }

            /* Dynamic Conditional Fields Container */
            .conditional-field {
                display: none;
                animation: fadeIn 0.3s ease-in-out;
            }

            /* Search + Card Selection (matches Subscription/Create) */
            .selection-card {
                border: 1px solid #dee2e6;
                border-radius: 12px;
                padding: 16px;
                cursor: pointer;
                transition: all 0.2s ease;
                position: relative;
                height: 100%;
                background-color: #ffffff;
            }

                .selection-card:hover {
                    border-color: #babbbc;
                }

                .selection-card.active {
                    border: 1.5px solid #E24D17;
                }

            .card-title-text {
                font-weight: 600;
                font-size: 0.9rem;
                margin-bottom: 4px;
                color: #212529;
            }

            .card-subtitle-text {
                font-size: 0.78rem;
                color: #6c757d;
                margin: 0;
            }

            .check-icon {
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #E24D17;
                font-size: 1.4rem;
                display: none;
            }

            .selection-card.active .check-icon {
                display: block;
            }

            .device-card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 10px;
            }

            .badge-status-mini {
                font-size: 0.65rem;
                font-weight: 700;
                color: #E24D17;
                border: 1px solid #E24D17;
                border-radius: 12px;
                padding: 3px 8px;
                text-transform: uppercase;
            }
    </style>
</head>

<body class="p-100">

    <div class="create-card shadow p-100">
        <h2 class="title-header">Create Device Status</h2>
        <p class="subtitle-text">Log status updates, replacements, and notes for devices.</p>

        <div asp-validation-summary="ModelOnly" class="error-msg mb-3"></div>

        <form id="createDeviceStatusForm" asp-controller="DeviceStatus" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-4 mb-4">

                <!-- Device Category -->
                <div class="col-12">
                    <label for="deviceCategory" class="custom-label">
                        Device Category <span class="required-asterisk">*</span>
                    </label>
                    <select id="deviceCategory" class="custom-input">
                        <option value="" disabled selected>-- Select Device Category --</option>
                        <option value="SIM">SIM Card</option>
                        <option value="USB">USB Modem</option>
                    </select>
                </div>

                <input type="hidden" asp-for="SimId" id="SimId" />
                <input type="hidden" asp-for="UsbId" id="UsbId" />

                <!-- Conditional SIM Selection -->
                <div id="simIdGroup" class="col-12 conditional-field">
                    <label class="custom-label">
                        SIM Card <span class="required-asterisk">*</span>
                    </label>
                    <input type="text" id="simSearchInput" class="custom-input mb-3" placeholder="Search by phone number or serial...">
                    <div class="row g-3" id="simCardsContainer">
                        <div class="col-12 text-muted small fst-italic">Search above to display selection cards.</div>
                    </div>
                    <span asp-validation-for="SimId" class="error-msg"></span>
                </div>

                <!-- Conditional USB Selection -->
                <div id="usbIdGroup" class="col-12 conditional-field">
                    <label class="custom-label">
                        USB Modem <span class="required-asterisk">*</span>
                    </label>
                    <input type="text" id="usbSearchInput" class="custom-input mb-3" placeholder="Search by model or serial...">
                    <div class="row g-3" id="usbCardsContainer">
                        <div class="col-12 text-muted small fst-italic">Search above to display selection cards.</div>
                    </div>
                    <span asp-validation-for="UsbId" class="error-msg"></span>
                </div>

                <!-- Current (Old) Status - read only -->
                <div class="col-12">
                    <label for="oldStatusDisplay" class="custom-label">Current Status</label>
                    <input type="text" id="oldStatusDisplay" class="custom-input" value="Select a device first" readonly>
                </div>

                <!-- Status Type -->
                <div class="col-12">
                    <label asp-for="StatusTypeId" class="custom-label">
                        New Status <span class="required-asterisk">*</span>
                    </label>
                    <select asp-for="StatusTypeId" asp-items="Model.StatusTypes" class="custom-input" required>
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="StatusTypeId" class="error-msg"></span>
                </div>

                <!-- Replacement SIM -->
                <div id="replacedBySimGroup" class="col-12 conditional-field">
                    <label asp-for="ReplacedBySimId" class="custom-label">Replaced By SIM Card</label>
                    <select asp-for="ReplacedBySimId" asp-items="Model.ReplacementSims" class="custom-input">
                        <option value="">-- Select Replacement SIM --</option>
                    </select>
                </div>

                <!-- Replacement USB -->
                <div id="replacedByUsbGroup" class="col-12 conditional-field">
                    <label asp-for="ReplacedByUsbId" class="custom-label">Replaced By USB Modem</label>
                    <select asp-for="ReplacedByUsbId" asp-items="Model.ReplacementUsbs" class="custom-input">
                        <option value="">-- Select Replacement USB --</option>
                    </select>
                </div>

                <!-- Notes / Details -->
                <div class="col-12">
                    <label asp-for="Notes" class="custom-label">Notes / Details</label>
                    <textarea asp-for="Notes" class="custom-input" rows="3" placeholder="Add optional details regarding status change..."></textarea>
                    <span asp-validation-for="Notes" class="error-msg"></span>
                </div>

            </div>

            <!-- BUTTON ACTIONS -->
            <div class="d-flex justify-content-end gap-3 mt-4">
                <a class="btn btn-cancel" asp-controller="DeviceStatus" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-create">Save Status</button>
            </div>

        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const deviceCategorySelect = document.getElementById("deviceCategory");

                const simIdGroup = document.getElementById("simIdGroup");
                const usbIdGroup = document.getElementById("usbIdGroup");
                const replacedBySimGroup = document.getElementById("replacedBySimGroup");
                const replacedByUsbGroup = document.getElementById("replacedByUsbGroup");

                const simIdInput = document.getElementById("SimId");
                const usbIdInput = document.getElementById("UsbId");
                const oldStatusDisplay = document.getElementById("oldStatusDisplay");

                function showCategory(category) {
                    simIdGroup.style.display = "none";
                    usbIdGroup.style.display = "none";
                    replacedBySimGroup.style.display = "none";
                    replacedByUsbGroup.style.display = "none";

                    oldStatusDisplay.value = "Select a device first";

                    if (category === "SIM") {
                        simIdGroup.style.display = "block";
                        replacedBySimGroup.style.display = "block";

                        usbIdInput.value = "";
                        $('#usbCardsContainer .selection-card').removeClass('active');
                    } else if (category === "USB") {
                        usbIdGroup.style.display = "block";
                        replacedByUsbGroup.style.display = "block";

                        simIdInput.value = "";
                        $('#simCardsContainer .selection-card').removeClass('active');
                    }
                }

                deviceCategorySelect.addEventListener("change", function() {
                    showCategory(this.value);
                });

                // --- SIM Search ---
                $('#simSearchInput').on('input', function() {
                    loadSims($(this).val());
                });

                function loadSims(query) {
                    if (!query || !query.trim()) {
                        $('#simCardsContainer').html('<div class="col-12 text-muted small fst-italic">Search above to display selection cards.</div>');
                        return;
                    }
                    $.get('/DeviceStatus/SearchSims', { query: query }, function(data) {
                        let html = '';
                        if (!data || data.length === 0) {
                            html = '<div class="col-12 text-muted small">No SIM cards found.</div>';
                        } else {
                            data.forEach(sim => {
                                const isSelected = simIdInput.value == sim.id;
                                html += `
                                            <div class="col-md-6">
                                                <div class="selection-card ${isSelected ? 'active' : ''}" onclick="selectSim(${sim.id}, '${sim.phoneNumber}', '${sim.status}', this)">
                                                    <div class="device-card-header">
                                                        <span class="fw-bold text-dark" style="font-size:0.85rem">${sim.providerName}</span>
                                                        <span class="badge-status-mini">${sim.status}</span>
                                                    </div>
                                                    <div class="card-title-text">${sim.phoneNumber}</div>
                                                    <p class="card-subtitle-text">Serial: ${sim.serialNumber}</p>
                                                    <i class="fas fa-check-circle check-icon"></i>
                                                </div>
                                            </div>`;
                            });
                        }
                        $('#simCardsContainer').html(html);
                    });
                }

                window.selectSim = function(simId, phoneNumber, status, cardEl) {
                    if ($(cardEl).hasClass('active')) {
                        $(cardEl).removeClass('active');
                        simIdInput.value = "";
                        oldStatusDisplay.value = "Select a device first";
                    } else {
                        $('#simCardsContainer .selection-card').removeClass('active');
                        $(cardEl).addClass('active');
                        simIdInput.value = simId;
                        oldStatusDisplay.value = status;
                    }
                };

                // --- USB Search ---
                $('#usbSearchInput').on('input', function() {
                    loadUsbs($(this).val());
                });

                function loadUsbs(query) {
                    if (!query || !query.trim()) {
                        $('#usbCardsContainer').html('<div class="col-12 text-muted small fst-italic">Search above to display selection cards.</div>');
                        return;
                    }
                    $.get('/DeviceStatus/SearchUsbs', { query: query }, function(data) {
                        let html = '';
                        if (!data || data.length === 0) {
                            html = '<div class="col-12 text-muted small">No USB modems found.</div>';
                        } else {
                            data.forEach(usb => {
                                const isSelected = usbIdInput.value == usb.id;
                                html += `
                                            <div class="col-md-6">
                                                <div class="selection-card ${isSelected ? 'active' : ''}" onclick="selectUsb(${usb.id}, '${usb.serialNumber}', '${usb.status}', this)">
                                                    <div class="device-card-header">
                                                        <span class="fw-bold text-dark" style="font-size:0.85rem">${usb.providerName}</span>
                                                        <span class="badge-status-mini">${usb.status}</span>
                                                    </div>
                                                    <div class="card-title-text">${usb.model ?? 'USB Modem'}</div>
                                                    <p class="card-subtitle-text">Serial: ${usb.serialNumber}</p>
                                                    <i class="fas fa-check-circle check-icon"></i>
                                                </div>
                                            </div>`;
                            });
                        }
                        $('#usbCardsContainer').html(html);
                    });
                }

                window.selectUsb = function(usbId, serialNumber, status, cardEl) {
                    if ($(cardEl).hasClass('active')) {
                        $(cardEl).removeClass('active');
                        usbIdInput.value = "";
                        oldStatusDisplay.value = "Select a device first";
                    } else {
                        $('#usbCardsContainer .selection-card').removeClass('active');
                        $(cardEl).addClass('active');
                        usbIdInput.value = usbId;
                        oldStatusDisplay.value = status;
                    }
                };

                // Restore category on validation redisplay
                if (simIdInput.value) {
                    deviceCategorySelect.value = "SIM";
                    showCategory("SIM");
                } else if (usbIdInput.value) {
                    deviceCategorySelect.value = "USB";
                    showCategory("USB");
                }
            });
    </script>
</body>

</html>